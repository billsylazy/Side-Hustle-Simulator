      <Item class="ModuleScript" referent="10">
        <Properties>
          <string name="Name">Mechanics</string>
          <string name="Source"><![CDATA[--!strict
-- Mechanics: PURE helpers shared by server and client (no services, no state).
-- The server resolves outcomes with these; the client renders previews with
-- the same functions so what the player sees matches what they get paid.

local GameConfig = require(script.Parent.GameConfig)

local Mechanics = {}

-- 0..1 hype/market factor for a Timing zone at a given server time
-- (workspace:GetServerTimeNow()). Smooth sine; both sides compute identically.
function Mechanics.marketFactor(zone: GameConfig.ZoneDef, serverTime: number): number
	local period = zone.MarketPeriod
	if period <= 0 then
		return 1
	end
	local phase = (serverTime % period) / period
	return (math.sin(phase * math.pi * 2) + 1) / 2
end

-- Cash multiplier for a Timing zone at a given server time.
function Mechanics.marketMult(zone: GameConfig.ZoneDef, serverTime: number): number
	local timing = GameConfig.Mechanics.Timing
	local factor = Mechanics.marketFactor(zone, serverTime)
	return timing.MinMult + (timing.MaxMult - timing.MinMult) * factor
end

-- Ring position of a zone center on the ground plane (Y = 0).
-- MapBuilder MUST place zones with this so nearestZoneId is accurate.
function Mechanics.zoneCenter(zoneOrder: number): Vector3
	local angle = math.rad((zoneOrder - 1) * GameConfig.Map.ZoneAngleStep)
	local radius = GameConfig.Map.ZoneRadius
	return Vector3.new(math.cos(angle) * radius, 0, math.sin(angle) * radius)
end

-- CFrame at a zone's center with -Z facing the plaza (origin).
function Mechanics.zoneGroundCFrame(zoneOrder: number): CFrame
	local pos = Mechanics.zoneCenter(zoneOrder)
	return CFrame.lookAt(pos, Vector3.new(0, 0, 0))
end

-- Id of the zone whose center is closest to a world position (XZ plane).
function Mechanics.nearestZoneId(position: Vector3): string
	local bestId = GameConfig.StartingZoneId
	local bestDistance = math.huge
	local flat = Vector3.new(position.X, 0, position.Z)
	for _, zone in GameConfig.Zones do
		local distance = (Mechanics.zoneCenter(zone.Order) - flat).Magnitude
		if distance < bestDistance then
			bestDistance = distance
			bestId = zone.Id
		end
	end
	return bestId
end

-- Effective cooldown for a zone given the player's upgrades table.
function Mechanics.cooldownFor(zone: GameConfig.ZoneDef, upgradesTable: any): number
	local speed = GameConfig.UpgradeEffects.Speed
	local level = GameConfig.getZoneEffectLevel(upgradesTable, zone.Id, "Speed")
	local factor = math.max(speed.MinCooldownFactor, 1 - speed.PerLevel * level)
	return zone.HustleCooldown * factor
end

-- Automation payout fraction for an Auto upgrade level (0 when level is 0).
function Mechanics.autoPercent(autoLevel: number): number
	if autoLevel <= 0 then
		return 0
	end
	local auto = GameConfig.UpgradeEffects.Auto
	return auto.BasePercent + auto.PercentPerLevel * (autoLevel - 1)
end

return Mechanics
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="11">
        <Properties>
          <string name="Name">Types</string>
          <string name="Source"><![CDATA[--!strict
-- Shared type definitions (v2). See ARCHITECTURE.md "Data schema v2".

export type WorkerEntry = {
	Uid: string,
	Id: string, -- currently the rarity id
	Rarity: string, -- "Intern" | "Employee" | "Manager" | "CEO"
	Crate: string, -- crate id the worker was hired from
	Name: string,
	Equipped: boolean,
}

export type PlayerStats = {
	HustleCount: number,
	AutoHustleCount: number,
	TotalCashEarned: number,
	WorkersHired: number,
	HighestLevel: number,
	TotalRebirths: number,
	PlayTime: number,
}

export type PlayerData = {
	DataVersion: number,
	Cash: number,
	Level: number,
	Xp: number,
	Rebirths: number,
	Upgrades: { [string]: { [string]: number } }, -- zoneId -> upgradeId -> level
	Perks: { [string]: number },
	Workers: { WorkerEntry },
	Stats: PlayerStats,
	ClaimedQuests: { [string]: boolean },
	LastSeen: number,
}

export type HustleKind = "Manual" | "Auto" | "Burst" | "Peak"

export type HustleResultPayload = {
	Amount: number,
	Xp: number,
	Kind: HustleKind,
	Mult: number,
	Combo: number?,
	Charge: number?,
	ChargeMax: number?,
}

export type ToastKind = "error" | "info" | "success"

-- A ModuleScript must return exactly one non-nil value in Roblox.
return {}
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="12">
        <Properties>
          <string name="Name">VehicleRig</string>
          <string name="Source"><![CDATA[--!nonstrict
-- VehicleRig: chunky cartoon vehicles built from primitives (the ChibiRig of
-- cars). PURE builder: it only creates Instances (no services, no state, no
-- motion), so the client city life (CityLifeController via Shared/CityLifeSim)
-- and the offline render preview (tools/render/preview_life.luau) build the
-- exact same vehicles.
--
-- API
--   VehicleRig.KINDS[kind] -> { length, width, height, speed, maxPitch? }  (studs, studs/s)
--       kinds: "Car" | "Taxi" | "Bus" | "IceCreamVan" | "Truck" (delivery box truck) |
--       "Police" (white car, blue hood + doors with "POLICE" painted on both doors,
--       roof lightbar whose Neon halves are named "LightbarRed" / "LightbarBlue":
--       CityLifeSim flashes them by Transparency)
--   VehicleRig.build(kind, color?) -> Model
--       UNPARENTED; tire bottoms at y = 0, centered on X/Z, nose toward -Z
--       (+X = the vehicle's right side). Parts named "Wheel" / "Hubcap" stay
--       on the road; every other part rides the suspension (CityLifeSim bobs and
--       pitches it). Every part is Anchored, CanCollide / CanQuery / CanTouch
--       false; only the chassis (bus: its body; truck: cab + cargo box) casts a shadow.
--   VehicleRig.buildBlimp() -> Model
--       UNPARENTED "SIDE HUSTLE CITY" blimp centered on the origin, nose toward -Z
--       (54 long, 14 thick, banner boards on both sides).
--   VehicleRig.buildBalloon(color) -> Model
--       UNPARENTED hot-air balloon (5 parts) centered on its 14-dia envelope:
--       white equator band, wooden basket 5 studs below the envelope bottom
--       (basket bottom VehicleRig.BALLOON_DROP = 14.4 below the center), 2 ropes.
--   VehicleRig.isWheel(part) -> boolean

local VehicleRig = {}

local RAD_90 = math.pi / 2

local WHITE = Color3.fromRGB(248, 248, 244)
local NAVY = Color3.fromRGB(4, 4, 53)
local GLASS = Color3.fromRGB(170, 225, 255)
local TIRE = Color3.fromRGB(38, 38, 42)
local HUBCAP = Color3.fromRGB(235, 235, 240)
local BUMPER = Color3.fromRGB(230, 230, 236)
local HEADLIGHT = Color3.fromRGB(255, 248, 210)
local TAILLIGHT = Color3.fromRGB(255, 60, 60)
local TAXI_YELLOW = Color3.fromRGB(255, 206, 40)
local BUS_ORANGE = Color3.fromRGB(255, 150, 40)
local VAN_PINK = Color3.fromRGB(255, 180, 220)

VehicleRig.TAXI_YELLOW = TAXI_YELLOW
VehicleRig.BUS_ORANGE = BUS_ORANGE
VehicleRig.VAN_PINK = VAN_PINK

-- length / width include bumpers and wheels; speed is the cruise speed;
-- maxPitch (radians, optional) caps the brake / accelerate pitch.
VehicleRig.KINDS = {
	Car = { length = 12, width = 7.3, height = 5.4, speed = 20 },
	Taxi = { length = 12, width = 7.3, height = 6.3, speed = 20 },
	IceCreamVan = { length = 12, width = 7.3, height = 13, speed = 18 },
	Bus = { length = 23, width = 8, height = 7.7, speed = 14 },
	-- tall box: a gentle pitch keeps its roof under the signal heads (bottom Y 10.2)
	Truck = { length = 19.6, width = 8, height = 9.0, speed = 13, maxPitch = 0.02 },
	-- the Car's dimensions + a 1.05-tall roof lightbar
	Police = { length = 12, width = 7.3, height = 6.45, speed = 20 },
}
VehicleRig.POLICE_RED = Color3.fromRGB(255, 60, 60)
VehicleRig.POLICE_BLUE = Color3.fromRGB(60, 120, 255)

----------------------------------------------------------------------
-- Part helpers
----------------------------------------------------------------------

local function addPart(
	model: Model,
	name: string,
	shape: Enum.PartType,
	size: Vector3,
	cf: CFrame,
	color: Color3,
	material: Enum.Material?,
	castShadow: boolean?
): Part
	local part = Instance.new("Part")
	part.Name = name
	part.Shape = shape
	part.Size = size
	part.CFrame = cf
	part.Color = color
	part.Material = material or Enum.Material.SmoothPlastic
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.CastShadow = castShadow == true
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Parent = model
	return part
end

local function block(model: Model, name: string, size: Vector3, pos: Vector3, color: Color3, material: Enum.Material?, castShadow: boolean?): Part
	return addPart(model, name, Enum.PartType.Block, size, CFrame.new(pos), color, material, castShadow)
end

local function ball(model: Model, name: string, diameter: number, pos: Vector3, color: Color3, material: Enum.Material?): Part
	return addPart(model, name, Enum.PartType.Ball, Vector3.new(diameter, diameter, diameter), CFrame.new(pos), color, material)
end

-- Cylinder along X (native axis): `length` x `diameter`.
local function cylinderX(model: Model, name: string, length: number, diameter: number, pos: Vector3, color: Color3): Part
	return addPart(model, name, Enum.PartType.Cylinder, Vector3.new(length, diameter, diameter), CFrame.new(pos), color)
end

-- Upright cylinder (axis rolled onto Y).
local function cylinderY(model: Model, name: string, height: number, diameter: number, pos: Vector3, color: Color3): Part
	return addPart(
		model,
		name,
		Enum.PartType.Cylinder,
		Vector3.new(height, diameter, diameter),
		CFrame.new(pos) * CFrame.Angles(0, 0, RAD_90),
		color
	)
end

local function wedge(model: Model, name: string, size: Vector3, cf: CFrame, color: Color3): WedgePart
	local part = Instance.new("WedgePart")
	part.Name = name
	part.Size = size
	part.CFrame = cf
	part.Color = color
	part.Material = Enum.Material.SmoothPlastic
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.CastShadow = false
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Parent = model
	return part
end

local function surfaceText(part: BasePart, face: Enum.NormalId, text: string, color: Color3, font: Enum.Font?, pixelsPerStud: number?)
	local gui = Instance.new("SurfaceGui")
	gui.Name = "Text" .. face.Name
	gui.Face = face
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = pixelsPerStud or 40
	gui.LightInfluence = 0
	gui.Parent = part
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Position = UDim2.fromScale(0.04, 0.06)
	label.Size = UDim2.fromScale(0.92, 0.88)
	label.Font = font or Enum.Font.FredokaOne
	label.Text = text
	label.TextColor3 = color
	label.TextScaled = true
	label.TextStrokeColor3 = NAVY
	label.TextStrokeTransparency = 0
	label.Parent = gui
end

local function wheels(model: Model, x: number, y: number, zs: { number })
	for _, z in zs do
		for _, side in { -1, 1 } do
			cylinderX(model, "Wheel", 1.2, 2.6, Vector3.new(side * x, y, z), TIRE)
			cylinderX(model, "Hubcap", 0.12, 1.2, Vector3.new(side * (x + 0.62), y, z), HUBCAP)
		end
	end
end

local function lights(model: Model, x: number, y: number, zFront: number, zBack: number, size: Vector3)
	for _, side in { -1, 1 } do
		block(model, "Headlight", size, Vector3.new(side * x, y, zFront), HEADLIGHT, Enum.Material.Neon)
		block(model, "Taillight", size, Vector3.new(side * x, y, zBack), TAILLIGHT, Enum.Material.Neon)
	end
end

local function bumpers(model: Model, width: number, y: number, z: number)
	for _, side in { -1, 1 } do
		block(model, "Bumper", Vector3.new(width, 0.8, 0.6), Vector3.new(0, y, side * z), BUMPER)
	end
end

----------------------------------------------------------------------
-- Vehicles
----------------------------------------------------------------------

-- Car recipe (~20 parts): chunky chassis, cabin set back toward the rear,
-- glass-blue windows, oversized wheels with white hubcaps, neon lights.
local function buildCarBody(model: Model, color: Color3)
	block(model, "Chassis", Vector3.new(6, 2.2, 11), Vector3.new(0, 1.9, 0), color, nil, true)
	block(model, "Cabin", Vector3.new(5.2, 2.4, 6), Vector3.new(0, 4.2, 0.5), VehicleRig.cabinColor(color))
	block(model, "Windshield", Vector3.new(4.6, 1.7, 0.2), Vector3.new(0, 4.3, -2.55), GLASS)
	block(model, "RearWindow", Vector3.new(4.6, 1.5, 0.2), Vector3.new(0, 4.35, 3.55), GLASS)
	for _, side in { -1, 1 } do
		block(model, "SideWindow", Vector3.new(0.2, 1.5, 4.8), Vector3.new(side * 2.65, 4.35, 0.5), GLASS)
	end
	wheels(model, 3.0, 1.3, { -3.6, 3.6 })
	lights(model, 2.0, 2.3, -5.6, 5.6, Vector3.new(1, 0.7, 0.3))
	bumpers(model, 6.2, 1.1, 5.7)
end

local function buildTaxi(model: Model, color: Color3)
	buildCarBody(model, color)
	local sign = block(model, "TaxiSign", Vector3.new(2.4, 0.9, 1.1), Vector3.new(0, 5.85, 0.5), Color3.fromRGB(255, 250, 230))
	surfaceText(sign, Enum.NormalId.Front, "TAXI", Color3.fromRGB(30, 30, 40), Enum.Font.LuckiestGuy, 50)
	surfaceText(sign, Enum.NormalId.Back, "TAXI", Color3.fromRGB(30, 30, 40), Enum.Font.LuckiestGuy, 50)
	for _, side in { -1, 1 } do
		block(model, "CheckerStripe", Vector3.new(0.1, 0.45, 9.6), Vector3.new(side * 3.02, 2.55, 0), Color3.fromRGB(30, 30, 36))
	end
end

-- Bus (~26 parts): 7 x 6.2 x 22 orange body, white window band with blue
-- window strips, door on the right (curb) side, destination sign, 6 wheels.
local function buildBus(model: Model, color: Color3)
	block(model, "BusBody", Vector3.new(7, 6.2, 22), Vector3.new(0, 4.1, 0), color, nil, true)
	block(model, "WindowBand", Vector3.new(7.1, 2.2, 22.1), Vector3.new(0, 5.4, 0), WHITE)
	for _, side in { -1, 1 } do
		block(model, "BusWindows", Vector3.new(0.15, 1.6, 17.2), Vector3.new(side * 3.58, 5.4, 1.9), GLASS)
	end
	block(model, "BusDoor", Vector3.new(0.15, 4.6, 2.4), Vector3.new(3.58, 3.6, -8.4), Color3.fromRGB(60, 64, 96))
	block(model, "Windshield", Vector3.new(6.2, 2.6, 0.15), Vector3.new(0, 5.1, -11.05), GLASS)
	block(model, "RearWindow", Vector3.new(5.6, 1.6, 0.15), Vector3.new(0, 5.5, 11.05), GLASS)
	block(model, "BusRoof", Vector3.new(6.4, 0.5, 20), Vector3.new(0, 7.45, 0), color:Lerp(WHITE, 0.35))
	local sign = block(model, "BusSign", Vector3.new(4.6, 0.9, 0.2), Vector3.new(0, 6.95, -11.12), NAVY)
	surfaceText(sign, Enum.NormalId.Front, "CITY BUS", BUS_ORANGE, Enum.Font.LuckiestGuy, 40)
	wheels(model, 3.4, 1.3, { -7.4, 5.0, 7.9 })
	lights(model, 2.5, 2.4, -11.1, 11.1, Vector3.new(1.2, 0.8, 0.3))
	bumpers(model, 7.2, 1.2, 11.25)
end

-- Ice-cream van (~26 parts): short cab + tall box with a serving window and
-- a giant cone (cylinder + ball scoop + cherry) on the roof.
local function buildIceCreamVan(model: Model, color: Color3)
	block(model, "Chassis", Vector3.new(6, 2.2, 11), Vector3.new(0, 1.9, 0), color, nil, true)
	block(model, "VanBox", Vector3.new(5.8, 4.2, 7), Vector3.new(0, 5.1, 1.7), color:Lerp(WHITE, 0.3))
	block(model, "VanStripe", Vector3.new(5.9, 0.6, 7.1), Vector3.new(0, 6.6, 1.7), Color3.fromRGB(255, 110, 180))
	block(model, "Cab", Vector3.new(5.4, 2.4, 3.6), Vector3.new(0, 4.2, -3.4), color)
	block(model, "Windshield", Vector3.new(4.8, 1.7, 0.2), Vector3.new(0, 4.3, -5.25), GLASS)
	for _, side in { -1, 1 } do
		block(model, "SideWindow", Vector3.new(0.2, 1.4, 2.4), Vector3.new(side * 2.75, 4.35, -3.4), GLASS)
		block(model, "ServingWindow", Vector3.new(0.15, 1.8, 3.8), Vector3.new(side * 2.95, 5.2, 1.7), GLASS)
	end
	cylinderY(model, "Cone", 3, 1.6, Vector3.new(0, 8.7, 1.7), Color3.fromRGB(230, 180, 110))
	ball(model, "Scoop", 3, Vector3.new(0, 10.9, 1.7), Color3.fromRGB(255, 240, 200))
	ball(model, "Cherry", 0.9, Vector3.new(0, 12.6, 1.7), Color3.fromRGB(235, 40, 60))
	wheels(model, 3.0, 1.3, { -3.6, 3.6 })
	lights(model, 2.0, 2.3, -5.6, 5.6, Vector3.new(1, 0.7, 0.3))
	bumpers(model, 6.2, 1.1, 5.7)
end

-- Delivery box truck (~28 parts): orange 7 x 5 x 5 cab up front, a WHITE
-- 7 x 7.5 x 13 cargo box with an orange side stripe (and a "SPEEDY
-- DELIVERY" label on both flanks), 6 wheels. The box sits low (bottom 1.5,
-- top 9.0) so the roof clears the ring-road signal heads with margin.
local function buildTruck(model: Model, color: Color3)
	local boxWhite = Color3.fromRGB(248, 248, 244)
	block(model, "TruckFrame", Vector3.new(5.6, 1.0, 18.6), Vector3.new(0, 1.6, 0), Color3.fromRGB(70, 74, 96))
	-- cab (front, -Z): z -9.25..-4.25
	block(model, "Cab", Vector3.new(7, 5, 5), Vector3.new(0, 4.1, -6.75), color, nil, true)
	block(model, "CabRoof", Vector3.new(6.4, 0.4, 4.4), Vector3.new(0, 6.8, -6.75), color:Lerp(boxWhite, 0.35))
	block(model, "Windshield", Vector3.new(6, 2, 0.15), Vector3.new(0, 4.9, -9.3), GLASS)
	for _, side in { -1, 1 } do
		block(model, "SideWindow", Vector3.new(0.15, 1.8, 2.6), Vector3.new(side * 3.53, 4.9, -7.1), GLASS)
	end
	-- cargo box (rear): z -4.0..9.0
	block(model, "CargoBox", Vector3.new(7, 7.5, 13), Vector3.new(0, 5.25, 2.5), boxWhite, nil, true)
	for _, side in { -1, 1 } do
		local stripe = block(model, "CargoStripe", Vector3.new(0.12, 1.6, 13.05), Vector3.new(side * 3.55, 4.3, 2.5), color)
		surfaceText(stripe, if side > 0 then Enum.NormalId.Right else Enum.NormalId.Left, "SPEEDY DELIVERY", Color3.fromRGB(255, 255, 255), Enum.Font.LuckiestGuy, 30)
	end
	block(model, "CargoDoor", Vector3.new(6.2, 6.6, 0.12), Vector3.new(0, 5.25, 9.05), boxWhite:Lerp(color, 0.15))
	wheels(model, 3.4, 1.3, { -6.6, 4.6, 7.4 })
	lights(model, 2.6, 2.4, -9.35, 9.15, Vector3.new(1.1, 0.8, 0.3))
	bumpers(model, 7.2, 1.2, 9.5)
end

-- Police car (~24 parts): the Car recipe in WHITE with a blue hood, blue
-- doors painted on the chassis flanks with "POLICE" in white (SurfaceGui
-- frames: 0 parts) and a roof lightbar (dark base + red / blue Neon halves,
-- flashed by CityLifeSim through Transparency).
local POLICE_NAVY = Color3.fromRGB(40, 70, 170)
local function paintDoor(part: BasePart, face: Enum.NormalId, x0: number, x1: number)
	-- x0..x1: the door's span as a fraction of the face width, left to right
	-- as seen from outside (Right face: +Z -> -Z; Left face: -Z -> +Z)
	local gui = Instance.new("SurfaceGui")
	gui.Name = "Door" .. face.Name
	gui.Face = face
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 30
	gui.LightInfluence = 0.6
	gui.Parent = part
	local door = Instance.new("Frame")
	door.Name = "Door"
	door.BorderSizePixel = 0
	door.BackgroundColor3 = POLICE_NAVY
	door.Position = UDim2.fromScale(x0, 0.08)
	door.Size = UDim2.fromScale(x1 - x0, 0.84)
	door.Parent = gui
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Position = UDim2.fromScale(0.06, 0.12)
	label.Size = UDim2.fromScale(0.88, 0.76)
	label.Font = Enum.Font.LuckiestGuy
	label.Text = "POLICE"
	label.TextColor3 = WHITE
	label.TextScaled = true
	label.TextStrokeColor3 = NAVY
	label.TextStrokeTransparency = 0
	label.Parent = door
end

local function buildPolice(model: Model, color: Color3)
	buildCarBody(model, color)
	block(model, "Hood", Vector3.new(5.8, 0.12, 2.9), Vector3.new(0, 3.06, -4.0), POLICE_NAVY)
	local chassis = model:FindFirstChild("Chassis") :: BasePart
	-- the cabin spans z -2.5..3.5 over the 11-long chassis (z -5.5..5.5)
	paintDoor(chassis, Enum.NormalId.Right, (5.5 - 3.5) / 11, (5.5 + 2.5) / 11)
	paintDoor(chassis, Enum.NormalId.Left, (-2.5 + 5.5) / 11, (3.5 + 5.5) / 11)
	block(model, "LightbarBase", Vector3.new(4.4, 0.6, 1.2), Vector3.new(0, 5.7, 0.5), Color3.fromRGB(60, 60, 80))
	block(model, "LightbarRed", Vector3.new(2.0, 0.45, 1.0), Vector3.new(-1.1, 6.225, 0.5), VehicleRig.POLICE_RED, Enum.Material.Neon)
	block(model, "LightbarBlue", Vector3.new(2.0, 0.45, 1.0), Vector3.new(1.1, 6.225, 0.5), VehicleRig.POLICE_BLUE, Enum.Material.Neon)
end

local BUILDERS = {
	Car = buildCarBody,
	Taxi = buildTaxi,
	Bus = buildBus,
	IceCreamVan = buildIceCreamVan,
	Truck = buildTruck,
	Police = buildPolice,
}

local DEFAULT_COLORS = {
	Car = Color3.fromRGB(255, 90, 90),
	Taxi = TAXI_YELLOW,
	Bus = BUS_ORANGE,
	IceCreamVan = VAN_PINK,
	Truck = BUS_ORANGE,
	Police = WHITE,
}

function VehicleRig.build(kind: string, color: Color3?): Model
	local builder = BUILDERS[kind] or buildCarBody
	local model = Instance.new("Model")
	model.Name = kind
	builder(model, color or DEFAULT_COLORS[kind] or DEFAULT_COLORS.Car)
	return model
end

function VehicleRig.isWheel(part: BasePart): boolean
	return part.Name == "Wheel" or part.Name == "Hubcap"
end

-- Cabin color of a body color (the Car recipe: 15% toward white), so a sim
-- can repaint a car (car-wash passes) without rebuilding it.
function VehicleRig.cabinColor(color: Color3): Color3
	return color:Lerp(WHITE, 0.15)
end

----------------------------------------------------------------------
-- Blimp
----------------------------------------------------------------------

function VehicleRig.buildBlimp(): Model
	local model = Instance.new("Model")
	model.Name = "Blimp"
	local body = WHITE
	local red = Color3.fromRGB(255, 90, 90)
	-- 40-long envelope along Z (native cylinder axis X yawed 90 degrees) + round caps
	addPart(model, "Envelope", Enum.PartType.Cylinder, Vector3.new(40, 14, 14), CFrame.Angles(0, RAD_90, 0), body)
	ball(model, "EnvelopeCap", 14, Vector3.new(0, 0, -20), body)
	ball(model, "EnvelopeCap", 14, Vector3.new(0, 0, 20), body)
	-- Four tail fins: wedges are tall at +Z (the tail) and slope toward the nose
	local fin = Vector3.new(0.8, 6, 9)
	wedge(model, "Fin", fin, CFrame.new(0, 9, 22), red)
	wedge(model, "Fin", fin, CFrame.new(0, -9, 22) * CFrame.Angles(0, 0, math.pi), red)
	wedge(model, "Fin", fin, CFrame.new(9, 0, 22) * CFrame.Angles(0, 0, -RAD_90), red)
	wedge(model, "Fin", fin, CFrame.new(-9, 0, 22) * CFrame.Angles(0, 0, RAD_90), red)
	-- Gondola with a window band
	block(model, "Gondola", Vector3.new(5, 2.6, 9), Vector3.new(0, -8.1, -2), Color3.fromRGB(64, 70, 120))
	block(model, "GondolaWindows", Vector3.new(5.1, 0.9, 7), Vector3.new(0, -7.9, -2), GLASS)
	-- Banner boards on both flanks + neon trims
	local yellow = Color3.fromRGB(255, 212, 31)
	local pink = Color3.fromRGB(255, 110, 190)
	for _, side in { -1, 1 } do
		local board = block(model, "Banner", Vector3.new(0.4, 4.6, 24), Vector3.new(side * 7.05, 0.4, -1), NAVY)
		surfaceText(board, if side > 0 then Enum.NormalId.Right else Enum.NormalId.Left, "SIDE HUSTLE CITY", yellow, Enum.Font.FredokaOne, 12)
		for _, dy in { -2.55, 2.55 } do
			block(model, "BannerTrim", Vector3.new(0.5, 0.45, 24.6), Vector3.new(side * 7.1, 0.4 + dy, -1), pink, Enum.Material.Neon)
		end
	end
	return model
end

----------------------------------------------------------------------
-- Hot-air balloon
----------------------------------------------------------------------

local BALLOON_WOOD = Color3.fromRGB(133, 94, 62)
VehicleRig.BALLOON_BASKET_GAP = 5 -- studs between the envelope bottom and the basket top
VehicleRig.BALLOON_DROP = 7 + 5 + 2.4 -- envelope center to basket bottom

-- 5 parts: a 14-dia envelope ball in `color`, a WHITE equator band (vertical-
-- axis cylinder 14.4 dia x 1.4), a 3 x 2.4 x 3 wooden basket hanging 5 studs
-- below the envelope bottom, and 2 thin ropes from opposite basket corners up
-- to the envelope. Centered on the envelope center (basket at -Z / +Z free).
function VehicleRig.buildBalloon(color: Color3): Model
	local model = Instance.new("Model")
	model.Name = "HotAirBalloon"
	ball(model, "BalloonEnvelope", 14, Vector3.new(0, 0, 0), color)
	cylinderY(model, "BalloonBand", 1.4, 14.4, Vector3.new(0, 0, 0), WHITE)
	local basketTop = -VehicleRig.BALLOON_BASKET_GAP - 7
	block(model, "BalloonBasket", Vector3.new(3, 2.4, 3), Vector3.new(0, basketTop - 1.2, 0), BALLOON_WOOD)
	for _, side in { -1, 1 } do
		-- from the basket's top corner up to the envelope surface (~5.6 long)
		local from = Vector3.new(side * 1.35, basketTop, side * 1.35)
		local to = Vector3.new(side * 2, -math.sqrt(49 - 8), side * 2)
		local length = (to - from).Magnitude
		local mid = (from + to) / 2
		local up = (to - from).Unit
		local right = up:Cross(Vector3.new(side, 0, -side)).Unit
		local back = right:Cross(up)
		addPart(
			model,
			"BalloonRope",
			Enum.PartType.Block,
			Vector3.new(0.15, length, 0.15),
			CFrame.fromMatrix(mid, right, up, back),
			Color3.fromRGB(110, 84, 60)
		)
	end
	return model
end

return VehicleRig
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="13">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Script" referent="14">
      <Properties>
        <string name="Name">GameManager</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[--[[
	GameManager.server.luau (v2)
	Server entry point (ARCHITECTURE.md "Service pattern"):
	1. Build the map + lighting (MapBuilder.build(), idempotent).
	2. Create every remote (RemoteService.init()).
	3. Require all 9 services, init(services) all, then start() all.
	4. Player lifecycle: load/sync on join, unload + per-service cleanup on leave.
	5. Auto-save loop every GameConfig.Data.SaveInterval.
	game:BindToClose is handled inside DataService.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GameConfig = require(ReplicatedStorage.Shared.GameConfig)

-- 1. Build the world FIRST so zones, prompts and spawns exist before any
--    service connects to them and before any player spawns.
local MapBuilder = require(script.Parent.World.MapBuilder)
MapBuilder.build()

-- 2. Remotes must exist before services register handlers against them.
local servicesFolder = script.Parent.Services
local RemoteService = require(servicesFolder.RemoteService)
RemoteService.init()

-- 3. Require all services, inject the services table, init all, start all.
--    Order matters only loosely (DataService/RemoteService first so every
--    other service's start() can register remotes and query data; LevelService
--    before the services that delegate zone-unlock queries to it).
local SERVICE_ORDER = {
	"DataService",
	"RemoteService",
	"LevelService",
	"ZoneService",
	"HustleService",
	"WorkerService",
	"UpgradeService",
	"RebirthService",
	"QuestService",
}

local services: { [string]: any } = {}
for _, name in SERVICE_ORDER do
	local moduleScript = servicesFolder:FindFirstChild(name)
	assert(moduleScript ~= nil, `[GameManager] Missing service module: Services.{name}`)
	local service = require(moduleScript)
	assert(typeof(service) == "table", `[GameManager] Services.{name} must return a table`)
	services[name] = service
end

for _, name in SERVICE_ORDER do
	local service = services[name]
	if typeof(service.init) == "function" then
		service.init(services)
	end
end

for _, name in SERVICE_ORDER do
	local service = services[name]
	if typeof(service.start) == "function" then
		service.start()
	end
end

local DataService = services.DataService

-- 4. Player lifecycle.
local function onPlayerAdded(player: Player)
	DataService.loadPlayer(player)
	DataService.sync(player)
end

local function onPlayerRemoving(player: Player)
	DataService.unloadPlayer(player)
	for _, name in SERVICE_ORDER do
		local service = services[name]
		if typeof(service.cleanupPlayer) == "function" then
			service.cleanupPlayer(player)
		end
	end
end

Players.PlayerAdded:Connect(onPlayerAdded)
Players.PlayerRemoving:Connect(onPlayerRemoving)

-- Handle players already present (Studio fast-start edge case).
for _, player in Players:GetPlayers() do
	task.spawn(onPlayerAdded, player)
end

-- 5. Auto-save loop.
task.spawn(function()
	while true do
		task.wait(GameConfig.Data.SaveInterval)
		DataService.saveAll()
	end
end)

print(`[GameManager] Side Hustle Simulator v{GameConfig.Data.Version} server ready ({#SERVICE_ORDER} services)`)
]]></string>
      </Properties>
    </Item>
    <Item class="Folder" referent="15">
      <Properties>
        <string name="Name">Services</string>
      </Properties>
      <Item class="ModuleScript" referent="16">
        <Properties>
          <string name="Name">DataService</string>
          <string name="Source"><![CDATA[--[[
	DataService.luau (v2)
	Persistence + the ONLY cash mutation API (ARCHITECTURE.md "Data schema v2").

	- DataStore GameConfig.Data.StoreName ("SideHustleData_v2"), key "Player_" .. UserId.
	- UpdateAsync-based session locking: stored value is
	  { Data = PlayerData, Lock = { JobId, SessionId, Time }? } owned by SessionId.
	- Load retry/kick flow when a foreign lock is fresh (SE-1).
	- 60s lock refresh loop for loaded players.
	- Stored Data whose DataVersion ~= GameConfig.Data.Version is replaced by
	  GameConfig.Data.Defaults() (fresh game); everything else is reconciled
	  against the v2 defaults (Upgrades is a map of per-zone tables).
	- Validation before every save; corrupt data is never written.
	- Final save on leave clears the lock; BindToClose drains in-flight saves.
	- DataService is the ONLY creator of leaderstats (Cash, Level, Rebirths IntValues).
	- XP is written by LevelService only (contract); rebirth reset by RebirthService.
]]

local Players = game:GetService("Players")
local DataStoreService = game:GetService("DataStoreService")
local HttpService = game:GetService("HttpService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GameConfig = require(ReplicatedStorage.Shared.GameConfig)
local Types = require(ReplicatedStorage.Shared.Types)

type PlayerData = Types.PlayerData

local DataService = {}

local LOAD_ATTEMPTS = 5
local LOAD_RETRY_DELAY = 2
local SAVE_ATTEMPTS = 3
local SAVE_RETRY_DELAY = 2
local SHUTDOWN_DEADLINE = 25 -- leave buffer before Roblox's 30s BindToClose hard limit

local LOCK_KICK_MESSAGE = "Your data is still saving from another server — rejoin in a minute."
local LOAD_FAIL_KICK_MESSAGE = "Failed to load your data. Please rejoin."

local dataStore = DataStoreService:GetDataStore(GameConfig.Data.StoreName)

local services: { [string]: any }? = nil
local loaded: { [Player]: PlayerData } = {}
local joinClocks: { [Player]: number } = {}
local started = false
local shuttingDown = false

-- Each load claims the lock under a unique session GUID, so a stale lock left
-- by the player's PREVIOUS session on this same server is still recognized as
-- not ours (JobId alone cannot tell the two apart on a fast same-server rejoin).
local sessionIds: { [number]: string } = {} -- UserId -> active session GUID
-- UserId -> true while that player's final (leave-time) save is in flight, so
-- a fast rejoin waits for it instead of loading a pre-save snapshot.
local savingUserIds: { [number]: boolean } = {}
-- Writes currently in flight anywhere (auto-save, leave, shutdown); BindToClose
-- holds the server open until this drains or the deadline passes.
local pendingSaves = 0

----------------------------------------------------------------------
-- Helpers
----------------------------------------------------------------------

local function keyFor(userId: number): string
	return "Player_" .. userId
end

local function isFiniteNumber(value: any): boolean
	return typeof(value) == "number"
		and value == value -- NaN check
		and value ~= math.huge
		and value ~= -math.huge
end

local function deepClone(original: { [any]: any }): { [any]: any }
	local clone = {}
	for key, value in original do
		if typeof(value) == "table" then
			clone[key] = deepClone(value)
		else
			clone[key] = value
		end
	end
	return clone
end

-- Fill missing keys recursively from the template (GameConfig.Data.Defaults()).
-- v2: Upgrades is a map zoneId -> { upgradeId -> level }; the template holds
-- one empty table per zone, so recursing creates every missing zone table.
-- A stored value whose type does not match the template (or a non-finite
-- number) is replaced by the default rather than left to block every save.
local function reconcile(data: { [any]: any }, template: { [any]: any })
	for key, default in template do
		local value = data[key]
		if typeof(default) == "table" then
			if typeof(value) ~= "table" then
				data[key] = deepClone(default)
			else
				reconcile(value, default)
			end
		elseif typeof(default) == "number" then
			if not isFiniteNumber(value) then
				data[key] = default
			end
		elseif value == nil or typeof(value) ~= typeof(default) then
			data[key] = default
		end
	end
end

-- True when every value of a table is a finite, non-negative number.
local function allNonNegativeNumbers(levels: any): boolean
	if typeof(levels) ~= "table" then
		return false
	end
	for _, level in levels do
		if not isFiniteNumber(level) or level < 0 then
			return false
		end
	end
	return true
end

-- Reject corrupt data before it ever reaches the DataStore (v2 fields).
local function validate(data: any): boolean
	if typeof(data) ~= "table" then
		return false
	end
	if not isFiniteNumber(data.Cash) or data.Cash < 0 then
		return false
	end
	if not isFiniteNumber(data.Level) or data.Level < 1 then
		return false
	end
	if not isFiniteNumber(data.Xp) or data.Xp < 0 then
		return false
	end
	if not isFiniteNumber(data.Rebirths) or data.Rebirths < 0 then
		return false
	end
	-- Upgrades: zoneId -> { upgradeId -> level }
	if typeof(data.Upgrades) ~= "table" then
		return false
	end
	for _, zoneUpgrades in data.Upgrades do
		if not allNonNegativeNumbers(zoneUpgrades) then
			return false
		end
	end
	-- Perks: perkId -> level
	if not allNonNegativeNumbers(data.Perks) then
		return false
	end
	if typeof(data.Workers) ~= "table" then
		return false
	end
	if typeof(data.Stats) ~= "table" then
		return false
	end
	for _, value in data.Stats do
		if not isFiniteNumber(value) then
			return false
		end
	end
	if typeof(data.ClaimedQuests) ~= "table" then
		return false
	end
	return true
end

local function setIntValue(parent: Instance, name: string, value: number)
	local child = parent:FindFirstChild(name)
	if child and child:IsA("IntValue") then
		child.Value = math.floor(value)
	end
end

local function updateLeaderstats(player: Player, data: PlayerData)
	local leaderstats = player:FindFirstChild("leaderstats")
	if not leaderstats then
		return
	end
	setIntValue(leaderstats, "Cash", data.Cash)
	setIntValue(leaderstats, "Level", data.Level)
	setIntValue(leaderstats, "Rebirths", data.Rebirths)
end

local function newIntValue(name: string, value: number, parent: Instance)
	local intValue = Instance.new("IntValue")
	intValue.Name = name
	intValue.Value = math.floor(value)
	intValue.Parent = parent
end

-- DataService is the ONLY creator of leaderstats.
local function createLeaderstats(player: Player, data: PlayerData)
	if player:FindFirstChild("leaderstats") then
		updateLeaderstats(player, data)
		return
	end

	local leaderstats = Instance.new("Folder")
	leaderstats.Name = "leaderstats"

	newIntValue("Cash", data.Cash, leaderstats)
	newIntValue("Level", data.Level, leaderstats)
	newIntValue("Rebirths", data.Rebirths, leaderstats)

	leaderstats.Parent = player
end

----------------------------------------------------------------------
-- DataStore writes
----------------------------------------------------------------------

-- A stored lock blocks us when it belongs to a DIFFERENT session (by GUID)
-- and is still fresh. Sessions are compared by GUID, not JobId, so a stale
-- lock from the player's previous visit to this same server never passes.
local function isForeignLock(lock: any, sessionId: string): boolean
	return typeof(lock) == "table"
		and lock.SessionId ~= sessionId
		and typeof(lock.Time) == "number"
		and os.time() - lock.Time < GameConfig.Data.LockTimeout
end

-- Write a player's data under its session GUID. Keeps the session lock unless
-- clearLock is true, and never re-asserts a lock for a session that has ended
-- meanwhile (an auto-save finishing after the leave-time save must not lock
-- the key again). Never clobbers a fresh lock owned by another session.
local function writeDataInner(userId: number, data: PlayerData, sessionId: string, clearLock: boolean): boolean
	if not validate(data) then
		warn(`[DataService] Data for user {userId} failed validation, skipping save`)
		return false
	end

	data.LastSeen = os.time()
	local key = keyFor(userId)

	for attempt = 1, SAVE_ATTEMPTS do
		local foreignLock = false
		local ok, err = pcall(function()
			dataStore:UpdateAsync(key, function(stored)
				stored = if typeof(stored) == "table" then stored else {}
				if isForeignLock(stored.Lock, sessionId) then
					foreignLock = true
					return nil -- abort: another live session owns this key
				end

				local entry: { [string]: any } = { Data = data }
				if not clearLock and sessionIds[userId] == sessionId then
					entry.Lock = { JobId = game.JobId, SessionId = sessionId, Time = os.time() }
				end
				return entry
			end)
		end)

		if foreignLock then
			warn(`[DataService] Skipped save for user {userId}: session owned elsewhere`)
			return false
		end
		if ok then
			return true
		end

		warn(`[DataService] Save attempt {attempt}/{SAVE_ATTEMPTS} failed for user {userId}: {err}`)
		if attempt < SAVE_ATTEMPTS then
			task.wait(SAVE_RETRY_DELAY)
		end
	end

	warn(`[DataService] All save retries exhausted for user {userId}`)
	return false
end

local function writeData(userId: number, data: PlayerData, sessionId: string, clearLock: boolean): boolean
	pendingSaves += 1
	local ok, result = pcall(writeDataInner, userId, data, sessionId, clearLock)
	pendingSaves -= 1
	if not ok then
		warn(`[DataService] Save for user {userId} raised: {result}`)
		return false
	end
	return result
end

-- Release this session's lock without touching Data (player left during load).
local function releaseLock(userId: number, sessionId: string)
	pcall(function()
		dataStore:UpdateAsync(keyFor(userId), function(stored)
			if typeof(stored) ~= "table" then
				return nil
			end
			local lock = stored.Lock
			if typeof(lock) ~= "table" or lock.SessionId ~= sessionId then
				return nil -- not this session's lock; leave untouched
			end
			stored.Lock = nil
			return stored
		end)
	end)
end

-- Bump Lock.Time so other servers keep seeing this session as alive.
local function refreshLock(player: Player)
	local sessionId = sessionIds[player.UserId]
	if not sessionId then
		return
	end
	local ok, err = pcall(function()
		dataStore:UpdateAsync(keyFor(player.UserId), function(stored)
			if typeof(stored) ~= "table" then
				return nil
			end
			local lock = stored.Lock
			if typeof(lock) ~= "table" or lock.SessionId ~= sessionId then
				return nil -- we lost the lock; do not fight over it
			end
			lock.Time = os.time()
			return stored
		end)
	end)
	if not ok then
		warn(`[DataService] Lock refresh failed for {player.Name}: {err}`)
	end
end

----------------------------------------------------------------------
-- Public API
----------------------------------------------------------------------

function DataService.getData(player: Player): PlayerData?
	return loaded[player]
end

function DataService.getLoadedPlayers(): { Player }
	local result: { Player } = {}
	for player in loaded do
		table.insert(result, player)
	end
	return result
end

-- Fires the full data snapshot to the client and refreshes leaderstats
-- (Cash, Level, Rebirths).
function DataService.sync(player: Player)
	local data = loaded[player]
	if not data then
		return
	end
	updateLeaderstats(player, data)
	if services and services.RemoteService then
		services.RemoteService.fireClient("DataSync", player, data)
	end
end

-- Adds to Cash and Stats.TotalCashEarned, then syncs. Server-only.
-- Pass deferSync = true only when the caller syncs right after (e.g. a
-- LevelService.addXp that follows), so one action sends one DataSync.
function DataService.addCash(player: Player, amount: number, deferSync: boolean?)
	local data = loaded[player]
	if not data then
		return
	end
	if not isFiniteNumber(amount) or amount <= 0 then
		return
	end
	data.Cash += amount
	data.Stats.TotalCashEarned += amount
	if not deferSync then
		DataService.sync(player)
	end
end

-- Returns false if the player cannot afford it. Server-only.
function DataService.spendCash(player: Player, amount: number): boolean
	local data = loaded[player]
	if not data then
		return false
	end
	if not isFiniteNumber(amount) or amount < 0 then
		return false
	end
	if data.Cash < amount then
		return false
	end
	data.Cash -= amount
	DataService.sync(player)
	return true
end

-- Claim the session lock (retrying against a fresh foreign lock), load,
-- version-check + reconcile against defaults, create leaderstats.
function DataService.loadPlayer(player: Player)
	if loaded[player] then
		return
	end

	local userId = player.UserId

	-- A leave-time save from this player's previous session on THIS server may
	-- still be in flight (it retries on DataStore errors). Wait for it so we
	-- never read the pre-save snapshot; bounded so a wedged save cannot block
	-- the join forever (the lock check below still guards correctness).
	local waitDeadline = os.clock() + SAVE_ATTEMPTS * (SAVE_RETRY_DELAY + 8)
	while savingUserIds[userId] and os.clock() < waitDeadline do
		task.wait(0.1)
	end
	if not player:IsDescendantOf(Players) then
		return
	end

	local key = keyFor(userId)
	local sessionId = HttpService:GenerateGUID(false)
	local lockBusy = false
	local storedData: any = nil
	local claimed = false

	for attempt = 1, LOAD_ATTEMPTS do
		lockBusy = false
		local ok, err = pcall(function()
			dataStore:UpdateAsync(key, function(stored)
				stored = if typeof(stored) == "table" then stored else {}
				if isForeignLock(stored.Lock, sessionId) then
					lockBusy = true
					return nil -- abort: session still owned elsewhere
				end
				stored.Lock = { JobId = game.JobId, SessionId = sessionId, Time = os.time() }
				storedData = stored.Data
				return stored
			end)
		end)

		if ok and not lockBusy then
			claimed = true
			break
		end

		if not ok then
			warn(`[DataService] Load attempt {attempt}/{LOAD_ATTEMPTS} failed for {player.Name}: {err}`)
		end
		if attempt < LOAD_ATTEMPTS then
			task.wait(LOAD_RETRY_DELAY)
		end
	end

	if not claimed then
		player:Kick(if lockBusy then LOCK_KICK_MESSAGE else LOAD_FAIL_KICK_MESSAGE)
		return
	end

	sessionIds[userId] = sessionId

	-- Player may have left during the async load: release the lock and bail.
	if not player:IsDescendantOf(Players) then
		if sessionIds[userId] == sessionId then
			sessionIds[userId] = nil
		end
		task.spawn(releaseLock, userId, sessionId)
		return
	end

	-- v2 schema: anything stored under a different DataVersion (including a
	-- v1 table with no DataVersion at all) is a fresh game.
	local data: PlayerData
	if typeof(storedData) == "table" and storedData.DataVersion == GameConfig.Data.Version then
		data = storedData :: PlayerData
	else
		if typeof(storedData) == "table" then
			warn(`[DataService] {player.Name} had DataVersion {tostring(storedData.DataVersion)}; resetting to v{GameConfig.Data.Version} defaults`)
		end
		data = GameConfig.Data.Defaults() :: PlayerData
	end
	reconcile(data :: any, GameConfig.Data.Defaults())

	loaded[player] = data
	joinClocks[player] = os.clock()
	createLeaderstats(player, data)
	print(`[DataService] Loaded data for {player.Name}`)
end

-- Fold in PlayTime, final save, clear the lock.
function DataService.unloadPlayer(player: Player)
	local data = loaded[player]
	loaded[player] = nil
	local joinedAt = joinClocks[player]
	joinClocks[player] = nil

	if not data then
		return
	end

	local userId = player.UserId
	local sessionId = sessionIds[userId]
	if not sessionId then
		return
	end

	if joinedAt then
		data.Stats.PlayTime += math.max(0, math.floor(os.clock() - joinedAt + 0.5))
	end

	-- Mark the final save in flight so a fast same-server rejoin waits for it
	-- instead of loading a stale snapshot. Clearing sessionIds first also stops
	-- any in-flight auto-save from re-asserting the lock after we clear it.
	savingUserIds[userId] = true
	sessionIds[userId] = nil
	writeData(userId, data, sessionId, true)
	savingUserIds[userId] = nil
	print(`[DataService] Unloaded data for {player.Name}`)
end

-- Auto-save every loaded player (keeps the session lock). Non-blocking.
function DataService.saveAll()
	for player, data in loaded do
		local sessionId = sessionIds[player.UserId]
		if sessionId then
			task.spawn(writeData, player.UserId, data, sessionId, false)
		end
	end
end

----------------------------------------------------------------------
-- Lifecycle
----------------------------------------------------------------------

function DataService.init(injectedServices: { [string]: any })
	services = injectedServices
end

function DataService.start()
	if started then
		return
	end
	started = true

	-- Session lock refresh loop (keeps Lock.Time fresh while we own the session).
	task.spawn(function()
		while not shuttingDown do
			task.wait(GameConfig.Data.LockRefreshInterval)
			if shuttingDown then
				break
			end
			for player in loaded do
				task.spawn(refreshLock, player)
			end
		end
	end)

	-- Shutdown: parallel final saves (clearing locks) with a deadline (SE-6).
	game:BindToClose(function()
		shuttingDown = true

		local toSave: { [Player]: PlayerData } = {}
		local total = 0
		for player, data in loaded do
			toSave[player] = data
			total += 1
		end
		if total == 0 then
			-- Nothing left to start, but saves begun from PlayerRemoving may
			-- still be in flight: drain them before letting the server close.
			local deadline = os.clock() + SHUTDOWN_DEADLINE
			while pendingSaves > 0 and os.clock() < deadline do
				task.wait(0.1)
			end
			return
		end

		local finished = 0
		for player, data in toSave do
			loaded[player] = nil
			local joinedAt = joinClocks[player]
			joinClocks[player] = nil
			local userId = player.UserId
			local sessionId = sessionIds[userId]
			sessionIds[userId] = nil
			task.spawn(function()
				if joinedAt then
					data.Stats.PlayTime += math.max(0, math.floor(os.clock() - joinedAt + 0.5))
				end
				if sessionId then
					writeData(userId, data, sessionId, true)
				end
				finished += 1
			end)
		end

		-- Hold the server open for this batch AND for saves already in flight
		-- elsewhere (a PlayerRemoving final save, a late auto-save) until they
		-- commit or the deadline passes.
		local deadline = os.clock() + SHUTDOWN_DEADLINE
		while (finished < total or pendingSaves > 0) and os.clock() < deadline do
			task.wait(0.1)
		end

		if finished < total then
			warn(`[DataService] Shutdown saved {finished}/{total} players before the deadline`)
		else
			print(`[DataService] Shutdown save complete ({total} players)`)
		end
	end)
end

return DataService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="17">
        <Properties>
          <string name="Name">HustleService</string>
          <string name="Source"><![CDATA[-- HustleService: the core "hustle" action via each zone's HustleStation
-- ProximityPrompt, the four mechanics, cash/XP grants and the automation tick.
-- Contract: ARCHITECTURE.md "Earnings, XP and mechanics" + "Map contract".
--
-- Per zone: base = zone.HustleEarn, xpBase = zone.XpPerHustle, U = data.Upgrades[zoneId]
--   earnMult = 1 + Earn.PerLevel * U[Earn], xpMult = 1 + Xp.PerLevel * U[Xp]
--   cooldown = Mechanics.cooldownFor(zone, data.Upgrades)
--   manualCash = floor(base * earnMult * mechMult * rebirthCash)
--   manualXp   = floor(xpBase * xpMult * mechXpMult * rebirthXp)
-- Mechanics (all resolved HERE, never on the client):
--   Tap    - combo stacks while hits land within ComboWindow of the last ACCEPTED hit
--   Hold   - one hit per completed hold (prompt HoldDuration), mechMult = Hold.PayoutMult
--   Timing - shared server clock, mechMult = Mechanics.marketMult; >= PeakThreshold = "Peak"
--   Charge - every hit pays HitPercent of manual; the ChargeMax-th hit is the "Burst"
-- Automation: every Auto.Interval seconds each unlocked zone with Auto level > 0 pays
--   floor(manualCash_noMech * autoPercent) cash + the same fraction of XP, Kind "Auto".
-- Server-authoritative: validates data loaded, zone unlocked by level, distance
-- (< 20 studs from the prompt part) and per-player per-zone cooldown.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local GameConfig = require(ReplicatedStorage.Shared.GameConfig)
local Mechanics = require(ReplicatedStorage.Shared.Mechanics)
local Types = require(ReplicatedStorage.Shared.Types)

type HustleResultPayload = Types.HustleResultPayload
type PlayerData = Types.PlayerData

local HustleService = {}

-- Injected via init(services) -- never require sibling services directly.
local DataService
local RemoteService
local LevelService
local ZoneService

local started = false

local MAX_PROMPT_DISTANCE = 20 -- studs; re-validated server-side per contract
local LOCKED_TOAST_THROTTLE = 2 -- seconds between "locked zone" toasts, per player
local MAP_WAIT_TIMEOUT = 30 -- MapBuilder runs before start(); this is a safety net
local CHILD_WAIT_TIMEOUT = 5

-- Per-player per-zone mechanic state. lastHit doubles as the cooldown stamp:
-- it only ever records ACCEPTED hits, so an early (ignored) tap can neither
-- reset a combo nor extend a cooldown.
type ZoneState = {
	lastHit: number, -- os.clock() of the last accepted hit (0 = never)
	combo: number, -- Tap zones: current stack, 0..ComboMax
	charge: number, -- Charge zones: hits banked toward the next burst
	nextDue: number, -- Hold zones: os.clock() the next hit is scheduled for
}

-- Player -> zoneId -> ZoneState; cleared in cleanupPlayer.
local zoneStates: { [Player]: { [string]: ZoneState } } = {}
-- Player -> os.clock() of the last "locked zone" toast (throttle).
local lockedToastAt: { [Player]: number } = {}
-- Mechanic names we already warned about (unknown zone.Mechanic strings).
local warnedMechanics: { [string]: boolean } = {}

----------------------------------------------------------------------
-- Helpers
----------------------------------------------------------------------

-- Payouts round to nearest: flooring small bases (Lemonade's $5) would make
-- the first +25% upgrade and early combo stacks pay exactly nothing extra.
local function round(x: number): number
	return math.floor(x + 0.5)
end

local function toast(player: Player, message: string, kind: string)
	RemoteService.fireClient("Toast", player, message, kind)
end

local function fireHustleResult(player: Player, zoneId: string, payload: HustleResultPayload)
	RemoteService.fireClient("HustleResult", player, zoneId, payload)
end

local function getZoneState(player: Player, zoneId: string): ZoneState
	local perPlayer = zoneStates[player]
	if not perPlayer then
		perPlayer = {}
		zoneStates[player] = perPlayer
	end
	local state = perPlayer[zoneId]
	if not state then
		state = { lastHit = 0, combo = 0, charge = 0, nextDue = 0 }
		perPlayer[zoneId] = state
	end
	return state
end

-- Upgrade/rebirth multipliers for one zone (everything except the mechanic).
local function getZoneMultipliers(data: PlayerData, zoneId: string): (number, number, number, number)
	local effects = GameConfig.UpgradeEffects
	local earnLevel = GameConfig.getZoneEffectLevel(data.Upgrades, zoneId, "Earn")
	local xpLevel = GameConfig.getZoneEffectLevel(data.Upgrades, zoneId, "Xp")
	local earnMult = 1 + effects.Earn.PerLevel * earnLevel
	local xpMult = 1 + effects.Xp.PerLevel * xpLevel
	local rebirthCash = GameConfig.getRebirthCashMultiplier(data.Rebirths)
	local rebirthXp = GameConfig.getRebirthXpMultiplier(data.Rebirths)
	return earnMult, xpMult, rebirthCash, rebirthXp
end

-- manualCash / manualXp for a zone at the given mechanic multipliers.
local function computeManual(zone: GameConfig.ZoneDef, data: PlayerData, mechMult: number, mechXpMult: number): (number, number)
	local earnMult, xpMult, rebirthCash, rebirthXp = getZoneMultipliers(data, zone.Id)
	local cash = round(zone.HustleEarn * earnMult * mechMult * rebirthCash)
	local xp = round(zone.XpPerHustle * xpMult * mechXpMult * rebirthXp)
	return math.max(0, cash), math.max(0, xp)
end

-- Resolves the zone's mechanic for one accepted hit: mutates the per-zone
-- state and returns the full HustleResult payload (Amount/Xp included).
local function resolveMechanic(zone: GameConfig.ZoneDef, data: PlayerData, state: ZoneState, now: number): HustleResultPayload
	local mechanic = zone.Mechanic
	local params = GameConfig.Mechanics

	if mechanic == "Tap" then
		local tap = params.Tap
		-- Combo continues only when this hit lands within ComboWindow of the
		-- previous ACCEPTED hit; a first-ever hit (lastHit = 0) starts at 0.
		if state.lastHit > 0 and now - state.lastHit <= tap.ComboWindow then
			state.combo = math.min(state.combo + 1, tap.ComboMax)
		else
			state.combo = 0
		end
		local mechMult = 1 + tap.ComboBonusPerStack * state.combo
		local cash, xp = computeManual(zone, data, mechMult, 1)
		return {
			Amount = cash,
			Xp = xp,
			Kind = "Manual",
			Mult = mechMult,
			Combo = state.combo,
		}
	elseif mechanic == "Timing" then
		local timing = params.Timing
		-- Shared clock: the client previews the same curve with the same function.
		-- The trigger arrives one-way latency after the press, so judge the
		-- flip at arrival OR PeakGrace earlier: a press the client saw inside
		-- the green window must not land off-peak and wipe the streak.
		local serverNow = Workspace:GetServerTimeNow()
		local marketMult = math.max(
			Mechanics.marketMult(zone, serverNow),
			Mechanics.marketMult(zone, serverNow - timing.PeakGrace)
		)
		local isPeak = marketMult >= timing.PeakThreshold
		-- Peak flips build a streak (stored in state.combo) that multiplies
		-- cash and XP; an off-peak flip sells cheap and resets it, so timing
		-- beats spamming at every cooldown.
		local mechMult: number
		local mechXpMult: number
		if isPeak then
			state.combo = math.min(state.combo + 1, timing.StreakMax)
			local streakMult = 1 + timing.StreakBonusPerStack * (state.combo - 1)
			mechMult = marketMult * streakMult
			mechXpMult = (1 + timing.PeakXpBonus) * streakMult
		else
			state.combo = 0
			mechMult = marketMult * timing.OffPeakMult
			mechXpMult = timing.OffPeakMult
		end
		local cash, xp = computeManual(zone, data, mechMult, mechXpMult)
		return {
			Amount = cash,
			Xp = xp,
			Kind = if isPeak then "Peak" else "Manual",
			Mult = mechMult,
			Combo = state.combo,
		}
	elseif mechanic == "Charge" then
		local charge = params.Charge
		local chargeMax = math.max(1, zone.ChargeMax)
		local manualCash, manualXp = computeManual(zone, data, 1, 1)
		state.charge += 1
		if state.charge >= chargeMax then
			-- The ChargeMax-th hit IS the burst: it pays the burst instead of a
			-- partial hit, then the bar empties.
			state.charge = 0
			local burstMult = chargeMax * charge.BurstMult
			return {
				Amount = round(manualCash * burstMult),
				Xp = round(manualXp * chargeMax * (1 + charge.BurstXpBonus)),
				Kind = "Burst",
				Mult = burstMult,
				Charge = 0,
				ChargeMax = chargeMax,
			}
		end
		return {
			Amount = round(manualCash * charge.HitPercent),
			Xp = round(manualXp * charge.HitPercent),
			Kind = "Manual",
			Mult = 1,
			Charge = state.charge,
			ChargeMax = chargeMax,
		}
	end

	-- Hold (and any unknown mechanic, which degrades to a plain hit).
	if mechanic ~= "Hold" and not warnedMechanics[mechanic] then
		warnedMechanics[mechanic] = true
		warn("[HustleService] Unknown Mechanic '" .. tostring(mechanic) .. "' on zone " .. zone.Id .. "; treating as Hold")
	end
	local mechMult = if mechanic == "Hold" then params.Hold.PayoutMult else 1
	local cash, xp = computeManual(zone, data, mechMult, 1)
	return {
		Amount = cash,
		Xp = xp,
		Kind = "Manual",
		Mult = mechMult,
	}
end

----------------------------------------------------------------------
-- Manual hustle (ProximityPrompt.Triggered)
----------------------------------------------------------------------

local function onHustleTriggered(zone: GameConfig.ZoneDef, promptPart: BasePart, player: Player)
	-- Data must be loaded.
	local data = DataService.getData(player)
	if not data then
		return
	end

	-- Zone must be unlocked by level. Locked-zone prompts stay visible on the
	-- client (ProximityPrompt.Enabled cannot be set per-player), so the server
	-- is the real gate: reject + toast, throttled to one toast per 2 s per player.
	if not ZoneService.isZoneUnlocked(player, zone.Id) then
		local now = os.clock()
		if now - (lockedToastAt[player] or 0) >= LOCKED_TOAST_THROTTLE then
			lockedToastAt[player] = now
			toast(player, "Reach level " .. zone.UnlockLevel .. " to unlock " .. zone.Name .. "!", "error")
		end
		return
	end

	-- Re-validate distance server-side (< 20 studs), per contract.
	local character = player.Character
	local rootPart = character and character:FindFirstChild("HumanoidRootPart")
	if not rootPart or not rootPart:IsA("BasePart") then
		return
	end
	if (rootPart.Position - promptPart.Position).Magnitude >= MAX_PROMPT_DISTANCE then
		return
	end

	-- Per-player, per-zone cooldown (Speed upgrade shortens it); early
	-- triggers are silently ignored and leave the mechanic state untouched.
	local state = getZoneState(player, zone.Id)
	local now = os.clock()
	local cooldown = Mechanics.cooldownFor(zone, data.Upgrades)
	if zone.Mechanic == "Hold" then
		-- HoldPromptController stretches the local hold to the full cooldown,
		-- so legit triggers are >= cooldown + re-press time apart. TriggerGrace
		-- absorbs network jitter, and the schedule advances a full cooldown per
		-- accepted hit, so the grace never compounds: the long-run rate stays
		-- capped at 1/cooldown even for a client that skips the hold.
		if now < state.nextDue - GameConfig.Mechanics.Hold.TriggerGrace then
			return
		end
		state.nextDue = math.max(now, state.nextDue) + cooldown
	elseif state.lastHit > 0 and now - state.lastHit < cooldown then
		return
	end

	-- All checks passed: resolve the mechanic, then stamp this accepted hit.
	local payload = resolveMechanic(zone, data, state, now)
	state.lastHit = now

	-- Bump the lifetime stat before addCash so the DataSync snapshot that
	-- addCash fires already carries the new HustleCount (quests read it).
	data.Stats.HustleCount += 1
	if payload.Amount > 0 then
		-- addXp below syncs, so skip addCash's own sync when XP follows.
		DataService.addCash(player, payload.Amount, payload.Xp > 0)
	end
	if payload.Xp > 0 then
		LevelService.addXp(player, payload.Xp)
	end
	if payload.Amount <= 0 and payload.Xp <= 0 then
		DataService.sync(player)
	end

	-- Client plays money popup / combo / peak / burst juice off this.
	fireHustleResult(player, zone.Id, payload)
end

-- Resolves one zone's hustle prompt and connects it. Each step uses
-- WaitForChild with a timeout and warns + skips on failure, so one missing
-- part never kills the server or the other zones.
local function connectHustleStation(zonesFolder: Instance, zone: GameConfig.ZoneDef)
	local zoneModel = zonesFolder:WaitForChild(zone.Id, CHILD_WAIT_TIMEOUT)
	if not zoneModel then
		warn("[HustleService] Zone model missing for " .. zone.Id .. "; hustle prompt skipped")
		return
	end

	local station = zoneModel:WaitForChild("HustleStation", CHILD_WAIT_TIMEOUT)
	if not station then
		warn("[HustleService] HustleStation missing for zone " .. zone.Id .. "; hustle prompt skipped")
		return
	end

	local promptPart = station:WaitForChild("PromptPart", CHILD_WAIT_TIMEOUT)
	if not promptPart or not promptPart:IsA("BasePart") then
		warn("[HustleService] HustleStation PromptPart missing for zone " .. zone.Id .. "; hustle prompt skipped")
		return
	end

	local prompt = promptPart:WaitForChild("HustlePrompt", CHILD_WAIT_TIMEOUT)
	if not prompt or not prompt:IsA("ProximityPrompt") then
		warn("[HustleService] HustlePrompt missing for zone " .. zone.Id .. "; hustle prompt skipped")
		return
	end

	-- Prompt connections live for the server's lifetime; per-player state is
	-- cleared in cleanupPlayer instead.
	prompt.Triggered:Connect(function(player: Player)
		onHustleTriggered(zone, promptPart, player)
	end)
end

----------------------------------------------------------------------
-- Automation tick
----------------------------------------------------------------------

-- One automation tick for one player: cash for ALL zones first (one addCash
-- -> one DataSync), then XP once with the total (one addXp -> one sync, plus
-- any level-ups), then one HustleResult per zone so the client can float a
-- "+$50" at each station.
local function tickAutomationFor(player: Player)
	local data = DataService.getData(player)
	if not data then
		return
	end

	local totalCash = 0
	local totalXp = 0
	local zonesTicked = 0
	local results: { { zoneId: string, payload: HustleResultPayload } } = {}

	for _, zone in GameConfig.Zones do
		local autoLevel = GameConfig.getZoneEffectLevel(data.Upgrades, zone.Id, "Auto")
		if autoLevel > 0 and LevelService.isZoneUnlocked(player, zone.Id) then
			local percent = Mechanics.autoPercent(autoLevel)
			local manualCash, manualXp = computeManual(zone, data, 1, 1)
			local amount = round(manualCash * percent)
			local xp = round(manualXp * percent)
			totalCash += amount
			totalXp += xp
			zonesTicked += 1
			table.insert(results, {
				zoneId = zone.Id,
				payload = {
					Amount = amount,
					Xp = xp,
					Kind = "Auto",
					Mult = 1,
				},
			})
		end
	end

	if zonesTicked == 0 then
		return
	end

	-- Stat first so the snapshot addCash fires already carries it.
	data.Stats.AutoHustleCount += zonesTicked
	if totalCash > 0 then
		DataService.addCash(player, totalCash, totalXp > 0)
	end
	if totalXp > 0 then
		LevelService.addXp(player, totalXp)
	end
	if totalCash <= 0 and totalXp <= 0 then
		-- Nothing else synced the stat bump; keep the client honest.
		DataService.sync(player)
	end

	for _, result in results do
		fireHustleResult(player, result.zoneId, result.payload)
	end
end

local function automationLoop()
	local interval = GameConfig.UpgradeEffects.Auto.Interval
	while true do
		task.wait(interval)
		for _, player in DataService.getLoadedPlayers() do
			-- One player's failure must never stall everyone else's rigs.
			local ok, err = pcall(tickAutomationFor, player)
			if not ok then
				warn("[HustleService] Automation tick failed for " .. player.Name .. ": " .. tostring(err))
			end
		end
	end
end

----------------------------------------------------------------------
-- Public API
----------------------------------------------------------------------

-- What ONE plain manual hit (mechMult 1) in this zone pays the player right
-- now, plus the effective cooldown. nil when the zone is unknown or the
-- player's data is not loaded. For UI/debug use.
function HustleService.getManualPreview(player: Player, zoneId: string): { Cash: number, Xp: number, Cooldown: number }?
	local zone = GameConfig.getZone(zoneId)
	if not zone then
		return nil
	end
	local data = DataService.getData(player)
	if not data then
		return nil
	end
	local cash, xp = computeManual(zone, data, 1, 1)
	return {
		Cash = cash,
		Xp = xp,
		Cooldown = Mechanics.cooldownFor(zone, data.Upgrades),
	}
end

----------------------------------------------------------------------
-- Lifecycle
----------------------------------------------------------------------

function HustleService.init(services: { [string]: any })
	DataService = services.DataService
	RemoteService = services.RemoteService
	LevelService = services.LevelService
	ZoneService = services.ZoneService
end

function HustleService.start()
	if started then
		return
	end
	started = true

	-- Automation runs regardless of whether the map resolved: it pays from
	-- data, not from world instances.
	task.spawn(automationLoop)

	local map = Workspace:WaitForChild("SideHustleMap", MAP_WAIT_TIMEOUT)
	if not map then
		warn("[HustleService] Workspace.SideHustleMap missing; no hustle prompts connected")
		return
	end

	local zonesFolder = map:WaitForChild("Zones", CHILD_WAIT_TIMEOUT)
	if not zonesFolder then
		warn("[HustleService] SideHustleMap.Zones missing; no hustle prompts connected")
		return
	end

	-- EVERY zone has a hustle station, including the free starting zone.
	for _, zone in GameConfig.Zones do
		task.spawn(connectHustleStation, zonesFolder, zone)
	end
end

function HustleService.cleanupPlayer(player: Player)
	zoneStates[player] = nil
	lockedToastAt[player] = nil
end

return HustleService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="18">
        <Properties>
          <string name="Name">LevelService</string>
          <string name="Source"><![CDATA[-- LevelService: XP + levels (ARCHITECTURE.md "Levels").
-- The ONLY writer of data.Xp / data.Level outside RebirthService's reset.
--   addXp(player, amount): Xp += amount; while Xp >= need and Level < MaxLevel:
--     Xp -= need, Level += 1, Stats.HighestLevel high-water mark, fire
--     LevelUp(newLevel, unlockedZoneId or nil) + Toast per level gained.
--     At MaxLevel XP is capped at need - 1. One DataService.sync at the end.
--   Zone unlock state is DERIVED: unlocked <=> data.Level >= zone.UnlockLevel.
-- WalkSpeed is untouched here (perks own it); level-ups never change it.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GameConfig = require(ReplicatedStorage.Shared.GameConfig)

local LevelService = {}

-- Injected via init(services) -- never require sibling services directly.
local DataService
local RemoteService

local started = false

----------------------------------------------------------------------
-- Helpers
----------------------------------------------------------------------

local function isFiniteNumber(value: any): boolean
	return typeof(value) == "number"
		and value == value -- NaN check
		and value ~= math.huge
		and value ~= -math.huge
end

local function toast(player: Player, message: string, kind: string)
	RemoteService.fireClient("Toast", player, message, kind)
end

-- Announces ONE gained level: LevelUp remote (with the zone that unlocks
-- exactly at this level, if any) and a success Toast.
local function announceLevel(player: Player, newLevel: number)
	local unlockedZone = GameConfig.getZoneUnlockedAtLevel(newLevel)
	local unlockedZoneId: string? = if unlockedZone then unlockedZone.Id else nil

	RemoteService.fireClient("LevelUp", player, newLevel, unlockedZoneId)

	if unlockedZone then
		toast(player, "Level " .. newLevel .. " - " .. unlockedZone.Name .. " unlocked!", "success")
	else
		toast(player, "Level " .. newLevel .. "!", "success")
	end
end

----------------------------------------------------------------------
-- Public API
----------------------------------------------------------------------

-- Grants XP and resolves every level-up it causes. Safe to call with any
-- amount: non-finite or non-positive amounts are ignored.
function LevelService.addXp(player: Player, amount: number)
	local data = DataService.getData(player)
	if not data then
		return
	end
	if not isFiniteNumber(amount) or amount <= 0 then
		return
	end

	local maxLevel = GameConfig.Levels.MaxLevel
	data.Xp += amount

	-- Multi-level loop: a single big grant (burst, auto tick) may cross
	-- several thresholds; each one fires its own LevelUp + Toast.
	local gainedLevels: { number } = {}
	while data.Level < maxLevel do
		local need = GameConfig.getXpForLevel(data.Level)
		if data.Xp < need then
			break
		end
		data.Xp -= need
		data.Level += 1
		table.insert(gainedLevels, data.Level)
	end

	-- At MaxLevel the bar can fill but never roll over.
	if data.Level >= maxLevel then
		data.Level = maxLevel
		local need = GameConfig.getXpForLevel(maxLevel)
		data.Xp = math.clamp(data.Xp, 0, math.max(0, need - 1))
	end

	if #gainedLevels > 0 then
		data.Stats.HighestLevel = math.max(data.Stats.HighestLevel or 1, data.Level)
		for _, newLevel in gainedLevels do
			announceLevel(player, newLevel)
		end
	end

	-- One snapshot per grant, after every level-up has been resolved, so the
	-- client's DataSync already carries the final Level/Xp/HighestLevel.
	DataService.sync(player)
end

-- Current level; 0 when the player's data is not loaded (so gates stay shut).
function LevelService.getLevel(player: Player): number
	local data = DataService.getData(player)
	if not data then
		return 0
	end
	return data.Level
end

-- unlocked <=> Level >= zone.UnlockLevel (unknown zone / unloaded data -> false).
function LevelService.isZoneUnlocked(player: Player, zoneId: string): boolean
	local data = DataService.getData(player)
	if not data then
		return false
	end
	return GameConfig.isZoneUnlockedAtLevel(zoneId, data.Level)
end

-- XP still needed to reach the next level (0 at MaxLevel or when unloaded).
function LevelService.xpToNext(player: Player): number
	local data = DataService.getData(player)
	if not data then
		return 0
	end
	if data.Level >= GameConfig.Levels.MaxLevel then
		return 0
	end
	local need = GameConfig.getXpForLevel(data.Level)
	return math.max(0, need - data.Xp)
end

----------------------------------------------------------------------
-- Lifecycle
----------------------------------------------------------------------

function LevelService.init(services: { [string]: any })
	DataService = services.DataService
	RemoteService = services.RemoteService
end

function LevelService.start()
	if started then
		return
	end
	started = true
	-- Stateless beyond player data; nothing to schedule.
end

function LevelService.cleanupPlayer(_player: Player)
	-- No per-player runtime state: everything lives in DataService's PlayerData.
end

return LevelService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="19">
        <Properties>
          <string name="Name">QuestService</string>
          <string name="Source"><![CDATA[-- QuestService (v2): one-time quest claiming. Progress is never tracked here --
-- quests read the lifetime Stats that other services already maintain via
-- quest.Stat, which must be one of the v2 stat names (HustleCount,
-- AutoHustleCount, TotalCashEarned, WorkersHired, HighestLevel, TotalRebirths),
-- so the client renders progress straight from DataSync and the server only
-- validates claims. Stats survive rebirth, so claimed quests stay claimed.
-- Contract: ARCHITECTURE.md "Remotes" + GameConfig.Quests.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GameConfig = require(ReplicatedStorage.Shared.GameConfig)

local QuestService = {}

-- Injected via init(services) -- never require sibling services directly.
local DataService
local RemoteService

local started = false

----------------------------------------------------------------------
-- Helpers
----------------------------------------------------------------------

local function toast(player: Player, message: string, kind: string)
	RemoteService.fireClient("Toast", player, message, kind)
end

-- Progress for a quest from the lifetime Stats table (missing/corrupt -> 0).
-- Generic over quest.Stat so adding a v2 stat name in GameConfig needs no
-- change here.
local function questProgress(data: any, quest: GameConfig.QuestDef): number
	local stats = data.Stats
	if typeof(stats) ~= "table" then
		return 0
	end
	local progress = stats[quest.Stat]
	return if typeof(progress) == "number" then progress else 0
end

----------------------------------------------------------------------
-- Remote handler
----------------------------------------------------------------------

local function onClaimQuest(player: Player, questId: string)
	-- Data must be loaded.
	local data = DataService.getData(player)
	if not data then
		return
	end

	-- Existence re-checked here even though the validator already did (defense
	-- in depth; the handler must stand on its own).
	local quest = GameConfig.getQuest(questId)
	if not quest then
		return
	end

	-- One-time only. A legit client disables claimed rows, so drop silently.
	if data.ClaimedQuests[questId] then
		return
	end

	-- Progress comes from lifetime Stats (survive rebirth).
	if questProgress(data, quest) < quest.Target then
		toast(player, "Quest not complete yet!", "error")
		return
	end

	-- Mark claimed BEFORE paying out so a re-entrant claim can never double-pay.
	data.ClaimedQuests[questId] = true
	DataService.addCash(player, quest.Reward)
	toast(player, "Quest complete: +$" .. quest.Reward .. "!", "success")
	DataService.sync(player)
end

----------------------------------------------------------------------
-- Lifecycle
----------------------------------------------------------------------

function QuestService.init(services: { [string]: any })
	DataService = services.DataService
	RemoteService = services.RemoteService
end

function QuestService.start()
	if started then
		return
	end
	started = true

	-- Cooldown per the ARCHITECTURE.md remotes table; RemoteService adds
	-- rate limiting and violation kicks on top.
	RemoteService.register({
		Name = "ClaimQuest",
		Cooldown = 0.3,
		Validator = function(_player: Player, questId: any): (boolean, string?)
			if typeof(questId) ~= "string" then
				return false, "questId must be a string"
			end
			if GameConfig.getQuest(questId) == nil then
				return false, "unknown questId"
			end
			return true
		end,
		Handler = onClaimQuest,
	})
end

function QuestService.cleanupPlayer(_player: Player)
	-- No per-player state here: cooldown/rate bookkeeping is owned by
	-- RemoteService, claim state by DataService. Kept for the uniform shape.
end

return QuestService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="20">
        <Properties>
          <string name="Name">RebirthService</string>
          <string name="Source"><![CDATA[-- RebirthService (v2): level-gated rebirth validation, reset and multiplier
-- queries. Contract: ARCHITECTURE.md "Rebirth" + "Remotes".
-- Requires Level >= GameConfig.Rebirth.RequiredLevel and Rebirths < MaxRebirths.
-- Rebirth RESETS: Cash, Level, Xp, Upgrades (fresh per-zone empty tables),
-- Perks (all 0), WalkSpeed back to base, workers unequipped beyond the base cap.
-- KEEPS: Workers, Stats, ClaimedQuests. Rebirths += 1, Stats.TotalRebirths += 1.
-- C->S traffic goes through RemoteService.register (RequestRebirth, 2 s
-- cooldown, no args); result goes back on the RebirthResult RemoteEvent:
--   "SUCCESS", newRebirths, cashMult   |   "INSUFFICIENT", requiredLevel

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GameConfig = require(ReplicatedStorage.Shared.GameConfig)

local RebirthService = {}

-- Injected via init(services) -- never require sibling services directly.
local DataService
local RemoteService

local started = false

-- Fires a S->C RemoteEvent to one player via RemoteService.fireClient(name,
-- player, ...); falls back to the contract-pinned ReplicatedStorage.Remotes
-- folder so player feedback never silently drops.
local function fireClient(player: Player, remoteName: string, ...: any)
	if RemoteService ~= nil and typeof(RemoteService.fireClient) == "function" then
		RemoteService.fireClient(remoteName, player, ...)
		return
	end
	local remotes = ReplicatedStorage:FindFirstChild("Remotes")
	local remote = remotes and remotes:FindFirstChild(remoteName)
	if remote and remote:IsA("RemoteEvent") then
		remote:FireClient(player, ...)
	end
end

local function onRequestRebirth(player: Player)
	-- Data must be loaded.
	local data = DataService.getData(player)
	if not data then
		return
	end

	local requiredLevel = GameConfig.Rebirth.RequiredLevel
	local level = if typeof(data.Level) == "number" then data.Level else 1

	-- Must be below the rebirth cap and have reached the required level.
	if data.Rebirths >= GameConfig.Rebirth.MaxRebirths or level < requiredLevel then
		fireClient(player, "RebirthResult", "INSUFFICIENT", requiredLevel)
		return
	end

	-- Apply the reset (see header). This is the contract's carve-out: the
	-- rebirth reset may assign data fields directly, then DataService.sync.
	local defaults = GameConfig.Data.Defaults()
	data.Cash = 0
	data.Level = 1
	data.Xp = 0
	data.Upgrades = defaults.Upgrades -- fresh per-zone empty tables
	data.Perks = defaults.Perks -- WalkSpeed / WorkerSlots / WorkerEfficiency = 0
	data.Rebirths += 1
	data.Stats.TotalRebirths += 1

	-- WorkerSlots just reset to 0, so the equip cap shrank back to the base.
	-- Unequip any workers beyond the new cap or they would keep earning
	-- against a cap the player no longer owns (WorkerService also clamps the
	-- income tick defensively, but the data should be honest too).
	local cap = GameConfig.Workers.BaseEquipSlots
	local equipped = 0
	for _, worker in data.Workers do
		if worker.Equipped then
			equipped += 1
			if equipped > cap then
				worker.Equipped = false
			end
		end
	end

	-- WalkSpeed perk just reset to level 0 -> back to base walk speed.
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		humanoid.WalkSpeed = GameConfig.BaseWalkSpeed
	end

	-- Push the fresh snapshot; sync also refreshes leaderstats (Cash, Level, Rebirths).
	DataService.sync(player)

	-- RebirthWatcher plays the full-screen celebration off this.
	fireClient(
		player,
		"RebirthResult",
		"SUCCESS",
		data.Rebirths,
		GameConfig.getRebirthCashMultiplier(data.Rebirths)
	)
end

function RebirthService.init(services: { [string]: any })
	DataService = services.DataService
	RemoteService = services.RemoteService
end

function RebirthService.start()
	if started then
		return
	end
	started = true

	-- RemoteService.register handles type validation, the per-remote cooldown
	-- (2 s, per the remotes table), rate limiting and violation kicks.
	RemoteService.register({
		Name = "RequestRebirth",
		Cooldown = 2,
		Handler = onRequestRebirth,
	})
end

-- cashMult = 1 + GameConfig.Rebirth.CashBonusPerRebirth * rebirths.
-- Delegates to GameConfig so there is exactly one source of truth.
function RebirthService.getCashMultiplier(rebirths: number): number
	return GameConfig.getRebirthCashMultiplier(rebirths)
end

-- xpMult = 1 + GameConfig.Rebirth.XpBonusPerRebirth * rebirths.
function RebirthService.getXpMultiplier(rebirths: number): number
	return GameConfig.getRebirthXpMultiplier(rebirths)
end

-- True when the player could rebirth right now (UI/other services may ask).
function RebirthService.canRebirth(player: Player): boolean
	local data = DataService.getData(player)
	if not data then
		return false
	end
	return data.Rebirths < GameConfig.Rebirth.MaxRebirths and data.Level >= GameConfig.Rebirth.RequiredLevel
end

function RebirthService.cleanupPlayer(_player: Player)
	-- No per-player state here: the RequestRebirth cooldown bookkeeping is
	-- owned by RemoteService. Kept for the uniform service module shape.
end

return RebirthService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="21">
        <Properties>
          <string name="Name">RemoteService</string>
          <string name="Source"><![CDATA[--[[
	RemoteService.luau
	Creates ReplicatedStorage.Remotes and every remote named in ARCHITECTURE.md,
	and wraps all C->S handlers with validation, per-remote cooldown, rate
	limiting (timestamps pruned over a 10s window) and violation kicks (SE-5).

	Usage from other services (in start()):
		services.RemoteService.register({
			Name = "BuyUpgrade",
			Cooldown = 0.3,
			Validator = function(player, upgradeId)
				return typeof(upgradeId) == "string", "upgradeId must be a string"
			end,
			Handler = function(player, upgradeId)
				...
			end,
		})
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local RemoteService = {}

export type RemoteConfig = {
	Name: string,
	Handler: (player: Player, ...any) -> (),
	-- Return false (optionally with a reason) to reject; rejections count as violations.
	Validator: ((player: Player, ...any) -> (boolean, string?))?,
	Cooldown: number?, -- seconds between accepted fires (default 0 = none)
	RateLimit: number?, -- max fires per RATE_WINDOW (default DEFAULT_MAX_PER_WINDOW)
}

local RATE_WINDOW = 10 -- seconds
-- Generous enough that honest button-mashing (e.g. equip spam at the 0.2 s
-- cooldown) never accrues violations; the cooldown runs first and absorbs it.
local DEFAULT_MAX_PER_WINDOW = 60
local KICK_AFTER_VIOLATIONS = 5

-- Every remote in the ARCHITECTURE.md table. All are RemoteEvents.
local REMOTE_NAMES = {
	-- S -> C
	"DataSync",
	"HustleResult",
	"LevelUp",
	"Toast",
	"WorkerHired",
	"RebirthResult",
	-- C -> S
	"HireWorker",
	"EquipWorker",
	"UnequipWorker",
	"BuyUpgrade",
	"BuyPerk",
	"RequestRebirth",
	"ClaimQuest",
}

local initialized = false
local remotes: { [string]: RemoteEvent } = {}

-- Per-player, per-remote request timestamps within the rate window.
local rateTimestamps: { [Player]: { [string]: { number } } } = {}
-- Per-player, per-remote time of the last accepted fire.
local lastAccepted: { [Player]: { [string]: number } } = {}
-- Per-player violation counts (rate limit breaches + validator failures).
local violations: { [Player]: number } = {}

----------------------------------------------------------------------
-- Internals
----------------------------------------------------------------------

local function recordViolation(player: Player, remoteName: string, reason: string)
	local count = (violations[player] or 0) + 1
	violations[player] = count
	warn(`[RemoteService] {player.Name} violation #{count} on "{remoteName}": {reason}`)
	if count >= KICK_AFTER_VIOLATIONS then
		task.defer(function()
			player:Kick("Too many bad requests. Please rejoin.")
		end)
	end
end

local function checkRateLimit(player: Player, remoteName: string, maxPerWindow: number): boolean
	local now = os.clock()

	local perPlayer = rateTimestamps[player]
	if not perPlayer then
		perPlayer = {}
		rateTimestamps[player] = perPlayer
	end

	local timestamps = perPlayer[remoteName]
	if not timestamps then
		timestamps = {}
		perPlayer[remoteName] = timestamps
	end

	-- Prune timestamps that fell out of the window.
	local windowStart = now - RATE_WINDOW
	local pruned: { number } = {}
	for _, ts in timestamps do
		if ts > windowStart then
			table.insert(pruned, ts)
		end
	end
	perPlayer[remoteName] = pruned

	if #pruned >= maxPerWindow then
		recordViolation(player, remoteName, "rate limit exceeded")
		return false
	end

	table.insert(pruned, now)
	return true
end

-- Cooldown misses are dropped silently (double-clicks are not malicious).
local function checkCooldown(player: Player, remoteName: string, cooldown: number): boolean
	local now = os.clock()

	local perPlayer = lastAccepted[player]
	if not perPlayer then
		perPlayer = {}
		lastAccepted[player] = perPlayer
	end

	local last = perPlayer[remoteName]
	if last and now - last < cooldown then
		return false
	end
	perPlayer[remoteName] = now
	return true
end

----------------------------------------------------------------------
-- Public API
----------------------------------------------------------------------

-- Creates the Remotes folder and every remote. Idempotent: GameManager calls
-- this before service init, and it is called again via the services loop.
function RemoteService.init(_injectedServices: { [string]: any }?)
	if initialized then
		return
	end
	initialized = true

	local folder = ReplicatedStorage:FindFirstChild("Remotes")
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = "Remotes"
		folder.Parent = ReplicatedStorage
	end

	for _, name in REMOTE_NAMES do
		local existing = folder:FindFirstChild(name)
		if existing and existing:IsA("RemoteEvent") then
			remotes[name] = existing
		else
			local remote = Instance.new("RemoteEvent")
			remote.Name = name
			remote.Parent = folder
			remotes[name] = remote
		end
	end

	print(`[RemoteService] Created {#REMOTE_NAMES} remotes`)
end

function RemoteService.start() end

-- Wrap a C->S RemoteEvent handler with rate limit + cooldown + validation.
function RemoteService.register(config: RemoteConfig)
	local remote = remotes[config.Name]
	if not remote then
		error(`[RemoteService] register: unknown remote "{config.Name}" — add it to ARCHITECTURE.md and REMOTE_NAMES first`)
	end

	local cooldown = config.Cooldown or 0
	local maxPerWindow = config.RateLimit or DEFAULT_MAX_PER_WINDOW

	remote.OnServerEvent:Connect(function(player: Player, ...: any)
		-- Cooldown first: fires inside the cooldown are a normal result of fast
		-- clicking and drop silently, without ever counting toward the rate
		-- limit (which exists to catch floods, not enthusiastic players).
		if cooldown > 0 and not checkCooldown(player, config.Name, cooldown) then
			return
		end
		if not checkRateLimit(player, config.Name, maxPerWindow) then
			return
		end
		if config.Validator then
			local ok, reason = config.Validator(player, ...)
			if not ok then
				recordViolation(player, config.Name, reason or "invalid arguments")
				return
			end
		end
		config.Handler(player, ...)
	end)
end

-- S->C helper. Never errors on a missing remote; warns instead.
function RemoteService.fireClient(name: string, player: Player, ...: any)
	local remote = remotes[name]
	if not remote then
		warn(`[RemoteService] fireClient: unknown remote "{name}"`)
		return
	end
	remote:FireClient(player, ...)
end

-- Accessor for services that need the instance itself.
function RemoteService.get(name: string): RemoteEvent
	local remote = remotes[name]
	if not remote then
		error(`[RemoteService] get: unknown remote "{name}"`)
	end
	return remote
end

function RemoteService.cleanupPlayer(player: Player)
	rateTimestamps[player] = nil
	lastAccepted[player] = nil
	violations[player] = nil
end

return RemoteService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="22">
        <Properties>
          <string name="Name">UpgradeService</string>
          <string name="Source"><![CDATA[-- UpgradeService (v2): per-zone hustle upgrades + global perks, and the ONLY
-- place (besides RebirthService's reset) that applies the WalkSpeed perk to
-- the live Humanoid -- both on purchase and on every spawn.
-- Contract: ARCHITECTURE.md "Remotes" + "Upgrades & perks".
--   BuyUpgrade(zoneId, upgradeId): zone unlocked by level, level < MaxLevel,
--     cost = GameConfig.getZoneUpgradeCost(zoneId, upgradeId, level) (nil = maxed),
--     data.Upgrades[zoneId][upgradeId] += 1.
--   BuyPerk(perkId): cost = GameConfig.getPerkCost(perkId, level) (nil = maxed),
--     data.Perks[perkId] += 1. humanoid WalkSpeed = BaseWalkSpeed + Perks.WalkSpeed.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GameConfig = require(ReplicatedStorage.Shared.GameConfig)

local UpgradeService = {}

-- Injected via init(services) -- never require sibling services directly.
local DataService
local RemoteService
local LevelService

local started = false

local HUMANOID_WAIT_TIMEOUT = 10
local DATA_POLL_INTERVAL = 0.5
-- A load can retry a busy lock and wait out a same-server leave save, so
-- allow well past the worst case before giving up on the spawn's WalkSpeed.
local DATA_POLL_TIMEOUT = 60

-- Player -> CharacterAdded connection; disconnected in cleanupPlayer so no
-- connection outlives its player (contract convention).
local characterConnections: { [Player]: RBXScriptConnection } = {}

----------------------------------------------------------------------
-- Helpers
----------------------------------------------------------------------

local function toast(player: Player, message: string, kind: string)
	RemoteService.fireClient("Toast", player, message, kind)
end

-- Perk level from a data table (missing/corrupt -> 0).
function UpgradeService.getPerkLevel(data: any, perkId: string): number
	if typeof(data) ~= "table" or typeof(data.Perks) ~= "table" then
		return 0
	end
	local level = data.Perks[perkId]
	return if typeof(level) == "number" then level else 0
end

-- Effective walk speed for a data table: BaseWalkSpeed + WalkSpeed perk level.
function UpgradeService.getWalkSpeed(data: any): number
	return GameConfig.BaseWalkSpeed + UpgradeService.getPerkLevel(data, "WalkSpeed")
end

local function applyWalkSpeed(humanoid: Humanoid, data: any)
	humanoid.WalkSpeed = UpgradeService.getWalkSpeed(data)
end

-- Zone unlock is derived from level. LevelService owns the query; fall back to
-- the identical GameConfig rule if it is not injected (never trust the client
-- either way).
local function isZoneUnlocked(player: Player, data: any, zoneId: string): boolean
	if LevelService ~= nil and typeof(LevelService.isZoneUnlocked) == "function" then
		return LevelService.isZoneUnlocked(player, zoneId) == true
	end
	local level = if typeof(data.Level) == "number" then data.Level else 1
	return GameConfig.isZoneUnlockedAtLevel(zoneId, level)
end

-- Applies the WalkSpeed perk to a freshly spawned character. Data may still
-- be loading (DataStore), so poll briefly before giving up.
local function applyWalkSpeedOnSpawn(player: Player, character: Model)
	local humanoid = character:WaitForChild("Humanoid", HUMANOID_WAIT_TIMEOUT)
	if not humanoid or not humanoid:IsA("Humanoid") then
		return
	end

	local data = DataService.getData(player)
	local deadline = os.clock() + DATA_POLL_TIMEOUT
	while not data and os.clock() < deadline do
		task.wait(DATA_POLL_INTERVAL)
		if not player:IsDescendantOf(Players) then
			return -- player left while we waited
		end
		data = DataService.getData(player)
	end
	if not data then
		return -- data never loaded (DataService will have kicked the player)
	end

	-- The player may have respawned while we waited; only touch the humanoid
	-- if this character is still the live one.
	if player.Character == character and humanoid.Parent == character then
		applyWalkSpeed(humanoid, data)
	end
end

local function watchPlayer(player: Player)
	if characterConnections[player] then
		return
	end
	characterConnections[player] = player.CharacterAdded:Connect(function(character: Model)
		task.spawn(applyWalkSpeedOnSpawn, player, character)
	end)
	-- Character may already exist (players present before start()).
	if player.Character then
		task.spawn(applyWalkSpeedOnSpawn, player, player.Character)
	end
end

----------------------------------------------------------------------
-- Remote handlers
----------------------------------------------------------------------

local function onBuyUpgrade(player: Player, zoneId: string, upgradeId: string)
	-- Data must be loaded.
	local data = DataService.getData(player)
	if not data then
		return
	end

	-- Existence re-checked here even though the validator already did (defense
	-- in depth; the handler must stand on its own).
	local zone = GameConfig.getZone(zoneId)
	local def = GameConfig.getZoneUpgrade(zoneId, upgradeId)
	if not zone or not def then
		return
	end

	-- Zone must be unlocked by level (the client hides locked tabs, but never
	-- trust it).
	if not isZoneUnlocked(player, data, zoneId) then
		toast(player, "Unlock " .. zone.Name .. " first!", "error")
		return
	end

	local level = GameConfig.getZoneUpgradeLevel(data.Upgrades, zoneId, upgradeId)
	local cost = GameConfig.getZoneUpgradeCost(zoneId, upgradeId, level)
	if cost == nil then
		toast(player, "Maxed out!", "error")
		return
	end

	if not DataService.spendCash(player, cost) then
		toast(player, "Not enough cash!", "error")
		return
	end

	-- Upgrades is a map zoneId -> upgradeId -> level; create the zone table on
	-- first purchase (reconcile normally pre-creates it, but stand alone).
	if typeof(data.Upgrades) ~= "table" then
		data.Upgrades = {}
	end
	local zoneUpgrades = data.Upgrades[zoneId]
	if typeof(zoneUpgrades) ~= "table" then
		zoneUpgrades = {}
		data.Upgrades[zoneId] = zoneUpgrades
	end

	local newLevel = level + 1
	zoneUpgrades[upgradeId] = newLevel

	DataService.sync(player)

	-- The automation tier going 0 -> 1 is a hire, everything else is a level.
	if def.Effect == "Auto" and newLevel == 1 then
		toast(player, def.Name .. " hired!", "success")
	else
		toast(player, def.Name .. " Lv " .. newLevel .. "!", "success")
	end
end

local function onBuyPerk(player: Player, perkId: string)
	-- Data must be loaded.
	local data = DataService.getData(player)
	if not data then
		return
	end

	-- Existence re-checked here (defense in depth).
	local def = GameConfig.Perks[perkId]
	if not def then
		return
	end

	local level = UpgradeService.getPerkLevel(data, perkId)
	local cost = GameConfig.getPerkCost(perkId, level)
	if cost == nil then
		toast(player, "Maxed out!", "error")
		return
	end

	if not DataService.spendCash(player, cost) then
		toast(player, "Not enough cash!", "error")
		return
	end

	if typeof(data.Perks) ~= "table" then
		data.Perks = {}
	end
	local newLevel = level + 1
	data.Perks[perkId] = newLevel

	-- Fast Shoes applies instantly to the live character (feel guide: every
	-- purchase should be felt immediately).
	if perkId == "WalkSpeed" then
		local character = player.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		if humanoid then
			applyWalkSpeed(humanoid, data)
		end
	end

	DataService.sync(player)
	toast(player, def.Name .. " Lv " .. newLevel .. "!", "success")
end

----------------------------------------------------------------------
-- Lifecycle
----------------------------------------------------------------------

function UpgradeService.init(services: { [string]: any })
	DataService = services.DataService
	RemoteService = services.RemoteService
	LevelService = services.LevelService
end

function UpgradeService.start()
	if started then
		return
	end
	started = true

	-- Cooldowns per the ARCHITECTURE.md remotes table; RemoteService adds
	-- rate limiting and violation kicks on top.
	RemoteService.register({
		Name = "BuyUpgrade",
		Cooldown = 0.25,
		Validator = function(_player: Player, zoneId: any, upgradeId: any): (boolean, string?)
			if typeof(zoneId) ~= "string" then
				return false, "zoneId must be a string"
			end
			if typeof(upgradeId) ~= "string" then
				return false, "upgradeId must be a string"
			end
			if GameConfig.getZoneUpgrade(zoneId, upgradeId) == nil then
				return false, "unknown zone upgrade"
			end
			return true
		end,
		Handler = onBuyUpgrade,
	})

	RemoteService.register({
		Name = "BuyPerk",
		Cooldown = 0.3,
		Validator = function(_player: Player, perkId: any): (boolean, string?)
			if typeof(perkId) ~= "string" then
				return false, "perkId must be a string"
			end
			if GameConfig.Perks[perkId] == nil then
				return false, "unknown perkId"
			end
			return true
		end,
		Handler = onBuyPerk,
	})

	-- Apply the WalkSpeed perk on every spawn, for joiners and for players
	-- already present when the service starts.
	Players.PlayerAdded:Connect(watchPlayer)
	for _, player in Players:GetPlayers() do
		watchPlayer(player)
	end
end

function UpgradeService.cleanupPlayer(player: Player)
	local connection = characterConnections[player]
	if connection then
		connection:Disconnect()
		characterConnections[player] = nil
	end
end

return UpgradeService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="23">
        <Properties>
          <string name="Name">WorkerService</string>
          <string name="Source"><![CDATA[-- WorkerService (v2): crate hiring (weighted RNG), equip/unequip, passive income tick.
-- Contract: ARCHITECTURE.md "Remotes" + "Upgrades & perks" + "Data schema v2".
-- Equip cap = GameConfig.Workers.BaseEquipSlots + data.Perks.WorkerSlots.
-- Worker income/sec = sum(getWorkerIncome(Rarity, Crate) for the first `cap`
--   equipped workers) * (1 + WorkerEfficiencyPerLevel * Perks.WorkerEfficiency)
--   * GameConfig.getRebirthCashMultiplier(Rebirths), floored, applied every
--   GameConfig.Workers.IncomeTickSeconds via DataService.addCash (which syncs).
-- Server-authoritative: crate existence is checked in the validator (a crate id
-- outside GameConfig can only come from a tampered client), storage/cost/slot
-- caps re-checked in the handlers. All C->S traffic goes through
-- RemoteService.register (rate limit + per-remote cooldown + violation kicks).

local HttpService = game:GetService("HttpService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GameConfig = require(ReplicatedStorage.Shared.GameConfig)
local Types = require(ReplicatedStorage.Shared.Types)

type WorkerEntry = Types.WorkerEntry

local WorkerService = {}

-- Injected via init(services) -- never require sibling services directly.
local DataService
local RemoteService

local started = false

----------------------------------------------------------------------
-- Helpers
----------------------------------------------------------------------

local function toast(player: Player, message: string, kind: string)
	RemoteService.fireClient("Toast", player, message, kind)
end

-- Perk level from a data table (missing/corrupt -> 0).
local function perkLevel(data: any, perkId: string): number
	local perks = data.Perks
	if typeof(perks) ~= "table" then
		return 0
	end
	local level = perks[perkId]
	return if typeof(level) == "number" then level else 0
end

-- Weighted RNG over crate.Weights. Weights need not sum to 100 (normalized
-- implicitly by rolling against their total). Iterates the ordered rarity
-- list so the roll is stable regardless of dictionary iteration order.
local function rollRarity(crate: GameConfig.CrateDef): GameConfig.RarityDef
	local total = 0
	for _, rarity in GameConfig.WorkerRarities do
		total += crate.Weights[rarity.Id] or 0
	end
	if total <= 0 then
		-- Misconfigured crate; fall back to the most common rarity.
		return GameConfig.WorkerRarities[1]
	end

	local roll = math.random() * total
	local cumulative = 0
	for _, rarity in GameConfig.WorkerRarities do
		cumulative += crate.Weights[rarity.Id] or 0
		if roll < cumulative then
			return rarity
		end
	end
	-- Float edge case (roll == total): rarest bucket.
	return GameConfig.WorkerRarities[#GameConfig.WorkerRarities]
end

local function findWorker(data: any, uid: string): WorkerEntry?
	for _, worker in data.Workers do
		if worker.Uid == uid then
			return worker
		end
	end
	return nil
end

local function countEquipped(data: any): number
	local count = 0
	for _, worker in data.Workers do
		if worker.Equipped then
			count += 1
		end
	end
	return count
end

-- Equipped worker cap = BaseEquipSlots + WorkerSlots perk level.
local function equipCap(data: any): number
	return GameConfig.Workers.BaseEquipSlots + perkLevel(data, "WorkerSlots")
end

-- Public so UI-facing services can show the cap; reads the loaded data only.
function WorkerService.getEquipCap(player: Player): number
	local data = DataService.getData(player)
	if not data then
		return GameConfig.Workers.BaseEquipSlots
	end
	return equipCap(data)
end

----------------------------------------------------------------------
-- Remote handlers
----------------------------------------------------------------------

local function onHireWorker(player: Player, crateId: string)
	-- Data must be loaded.
	local data = DataService.getData(player)
	if not data then
		return
	end

	-- Existence re-checked here even though the validator already did (defense
	-- in depth; the handler must stand on its own).
	local crate = GameConfig.WorkerCrates[crateId]
	if not crate then
		return
	end

	if #data.Workers >= GameConfig.Workers.MaxStorage then
		toast(player, "Worker storage full!", "error")
		return
	end

	if not DataService.spendCash(player, crate.Cost) then
		toast(player, "Not enough cash!", "error")
		return
	end

	local rarity = rollRarity(crate)
	local firstName = GameConfig.WorkerNames[math.random(#GameConfig.WorkerNames)]

	local worker: WorkerEntry = {
		Uid = HttpService:GenerateGUID(false),
		Id = rarity.Id, -- reserved for future distinct characters; currently rarity id
		Rarity = rarity.Id,
		Crate = crateId,
		Name = firstName .. " the " .. rarity.Name,
		Equipped = false,
	}

	-- Auto-equip when a slot is free: nicer first-time UX (hire -> instant income).
	if countEquipped(data) < equipCap(data) then
		worker.Equipped = true
	end

	table.insert(data.Workers, worker)
	data.Stats.WorkersHired += 1

	-- Client plays the crate-open juice off this (art & feel guide).
	RemoteService.fireClient("WorkerHired", player, worker)
	toast(player, "Hired " .. worker.Name .. "!", "success")
	DataService.sync(player)
end

local function onEquipWorker(player: Player, workerUid: string)
	local data = DataService.getData(player)
	if not data then
		return
	end

	local worker = findWorker(data, workerUid)
	if not worker or worker.Equipped then
		-- Unknown uid or already equipped: stale UI, drop silently.
		return
	end

	if countEquipped(data) >= equipCap(data) then
		toast(player, "No free worker slots!", "error")
		return
	end

	worker.Equipped = true
	DataService.sync(player)
end

local function onUnequipWorker(player: Player, workerUid: string)
	local data = DataService.getData(player)
	if not data then
		return
	end

	local worker = findWorker(data, workerUid)
	if not worker or not worker.Equipped then
		return
	end

	worker.Equipped = false
	DataService.sync(player)
end

----------------------------------------------------------------------
-- Passive income tick
----------------------------------------------------------------------

-- Income for one tick: sum of equipped workers' base income, scaled by the
-- WorkerEfficiency perk and the rebirth cash multiplier, floored.
local function computeTickIncome(data: any): number
	-- Count at most equipCap(data) equipped workers: saved data can hold more
	-- Equipped flags than the current cap (the WorkerSlots perk resets on
	-- rebirth), and the extra ones must not earn.
	local base = 0
	local counted = 0
	local cap = equipCap(data)
	for _, worker in data.Workers do
		if worker.Equipped then
			counted += 1
			if counted > cap then
				break
			end
			base += GameConfig.getWorkerIncome(worker.Rarity, worker.Crate)
		end
	end
	if base <= 0 then
		return 0
	end

	local efficiencyMult = 1 + GameConfig.WorkerEfficiencyPerLevel * perkLevel(data, "WorkerEfficiency")
	local rebirths = if typeof(data.Rebirths) == "number" then data.Rebirths else 0
	return math.floor(base * efficiencyMult * GameConfig.getRebirthCashMultiplier(rebirths))
end

-- Public query so UI/other services can show "$/s" without duplicating the math.
function WorkerService.getIncomePerTick(player: Player): number
	local data = DataService.getData(player)
	if not data then
		return 0
	end
	return computeTickIncome(data)
end

----------------------------------------------------------------------
-- Lifecycle
----------------------------------------------------------------------

function WorkerService.init(services: { [string]: any })
	DataService = services.DataService
	RemoteService = services.RemoteService
end

function WorkerService.start()
	if started then
		return
	end
	started = true

	-- Cooldowns per the ARCHITECTURE.md remotes table; RemoteService adds
	-- rate limiting and violation kicks on top.
	RemoteService.register({
		Name = "HireWorker",
		Cooldown = 0.5,
		Validator = function(_player: Player, crateId: any): (boolean, string?)
			if typeof(crateId) ~= "string" then
				return false, "crateId must be a string"
			end
			if GameConfig.WorkerCrates[crateId] == nil then
				return false, "unknown crateId"
			end
			return true
		end,
		Handler = onHireWorker,
	})

	RemoteService.register({
		Name = "EquipWorker",
		Cooldown = 0.2,
		Validator = function(_player: Player, workerUid: any): (boolean, string?)
			if typeof(workerUid) ~= "string" then
				return false, "workerUid must be a string"
			end
			return true
		end,
		Handler = onEquipWorker,
	})

	RemoteService.register({
		Name = "UnequipWorker",
		Cooldown = 0.2,
		Validator = function(_player: Player, workerUid: any): (boolean, string?)
			if typeof(workerUid) ~= "string" then
				return false, "workerUid must be a string"
			end
			return true
		end,
		Handler = onUnequipWorker,
	})

	-- Passive income tick. addCash syncs (DataSync >= 1/s per player is fine
	-- per contract); players with zero income still get a sync every tick.
	task.spawn(function()
		while true do
			task.wait(GameConfig.Workers.IncomeTickSeconds)
			for _, player in DataService.getLoadedPlayers() do
				local data = DataService.getData(player)
				if data then
					local income = computeTickIncome(data)
					if income > 0 then
						DataService.addCash(player, income)
					else
						-- Keep the >=1/s DataSync cadence even with no income,
						-- so clients whose listeners connected after the load-time
						-- snapshot still receive their data within a second.
						DataService.sync(player)
					end
				end
			end
		end
	end)
end

function WorkerService.cleanupPlayer(_player: Player)
	-- No per-player state here: cooldown/rate bookkeeping is owned by
	-- RemoteService, worker data by DataService. Kept for the uniform shape.
end

return WorkerService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="24">
        <Properties>
          <string name="Name">ZoneService</string>
          <string name="Source"><![CDATA[-- ZoneService: level-based zone unlock queries + nearest-zone helper.
-- Contract: ARCHITECTURE.md "Map contract" (v2: NO UnlockPrompt, no cash gates).
-- Zone unlock state is derived from the player's level, so this service owns
-- no data of its own: isZoneUnlocked delegates to LevelService and the gate
-- visuals open per-player on the client (ZoneGateController reacting to
-- DataSync). The server still rejects hustles in locked zones (HustleService).

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GameConfig = require(ReplicatedStorage.Shared.GameConfig)
local Mechanics = require(ReplicatedStorage.Shared.Mechanics)

local ZoneService = {}

-- Injected via init(services) -- never require sibling services directly.
local LevelService

----------------------------------------------------------------------
-- Public API
----------------------------------------------------------------------

-- unlocked <=> data.Level >= zone.UnlockLevel (unknown zone / unloaded -> false).
function ZoneService.isZoneUnlocked(player: Player, zoneId: string): boolean
	if GameConfig.getZone(zoneId) == nil then
		return false
	end
	return LevelService.isZoneUnlocked(player, zoneId)
end

-- Id of the zone whose ring center is closest to a world position.
function ZoneService.getZoneForPosition(position: Vector3): string
	return Mechanics.nearestZoneId(position)
end

-- Level a zone needs (nil for an unknown zone).
function ZoneService.getUnlockLevel(zoneId: string): number?
	local zone = GameConfig.getZone(zoneId)
	return if zone then zone.UnlockLevel else nil
end

----------------------------------------------------------------------
-- Lifecycle
----------------------------------------------------------------------

function ZoneService.init(services: { [string]: any })
	LevelService = services.LevelService
end

function ZoneService.start()
	-- v2 has no gate prompts to connect: gates are purely visual and open on
	-- the client once the player's level reaches zone.UnlockLevel.
end

function ZoneService.cleanupPlayer(_player: Player)
	-- No per-player state.
end

return ZoneService
]]></string>
        </Properties>
      </Item>
    </Item>
    <Item class="Folder" referent="25">
      <Properties>
        <string name="Name">World</string>
      </Properties>
      <Item class="ModuleScript" referent="26">
        <Properties>
          <string name="Name">CityBuilder</string>
          <string name="Source"><![CDATA[--!nonstrict
-- CityBuilder: the cartoon downtown around the plaza, built from primitives
-- and laid out ENTIRELY by Shared/CityLayout (the client city-life system
-- walks and drives on the same data).
--
--   SideHustleMap.City (Model)
--     Street     curbs, PAINTED lane dashes (yellow center + white dividers on
--                8 invisible MarkingDeck<k> decks, a SurfaceGui frame per dash),
--                zebra crosswalks on every zone axis, TrafficLight models (ZoneId
--                attr, cobalt mast, yellow head, Neon SignalRed / SignalAmber /
--                SignalGreen), Back Avenue dashes (8 BackMarkingDeck<k>)
--     Skyline    48 chunky pastel buildings in two rings (r 220..244, 277..307):
--                mid-ring fronts carry part window bands + vertical neon-edged
--                blade signs, their backs a giant painted Mural over a Back
--                Avenue shopfront; every outer-ring front carries a shopfront and
--                PAINTED window bands (fronts + sides; mid-ring sides too); two
--                outer roofs carry slewing tower cranes (CitySpin); six outer
--                slots are landmark hero towers (Stepped / Round / Billboard)
--                + 24 rowhouse infills closing the mid-ring gaps
--     Shops      16 storefronts in the gaps between zones (awnings, accent name
--                boards, warm-lit windows, flower boxes, 20 x 8.5 rooftop
--                billboards never in a neighbouring zone's hue)
--     Anchors    one landmark per zone right behind its pad, in the zone's
--                signature color with a giant 40 x 11.5 rooftop name sign (the
--                largest board in its sector; white neon marquee) + a giant icon
--                Model that spins (CitySpin)
--     Furniture  street trees in planters, 24 tall lamps with zone-colored
--                festival banners, hydrants, trash cans, news boxes, bus stops
--                (outer sidewalk furniture strip, r 105..112)
--     GapBlocks  café terraces (checkered CafeTerrace rug, tables, stools) in
--                front of every Shop A + street trees beside both shops of every gap
--     Parks      pocket-park lawns behind the shops
--     BackPockets trees in planters + lamp posts behind the rowhouses
--     PlazaBuzz  food carts, balloon vendor, colored plaza inlay + sunburst,
--                raised round flower planters
--
-- Street hardware is toy-city cobalt (MapKit.STREET_POLE / STREET_BASE), never
-- gunmetal or near-black. Rules: buildings / bodies / poles collide; every small decor part is
-- CanCollide false + CastShadow false. Nothing here enters a zone pad, the
-- zone-axis walkway corridor (|zone-local x| < 10 from the plaza to the gate)
-- or the spawn (tools/check_map.luau audits all three). Every Block sign
-- board gets an unlit Face frame in its own color (MapKit.addSurfaceText
-- faceColor). Faces seen only from >= 150 studs are painted (MapKit.paintBands
-- / murals / marking decks: zero parts). ~3,250 parts.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GameConfig = require(ReplicatedStorage.Shared.GameConfig)
local CityLayout = require(ReplicatedStorage.Shared.CityLayout)
local MapKit = require(script.Parent.MapKit)

local makeBlock = MapKit.makeBlock
local makeBall = MapKit.makeBall
local makeCylinder = MapKit.makeCylinder
local makeWedge = MapKit.makeWedge
local makeModel = MapKit.makeModel
local addSurfaceText = MapKit.addSurfaceText
local addPointLight = MapKit.addPointLight

local CityBuilder = {}

local S = CityLayout.Street
local ringPos = CityLayout.ringPos
local facingCFrame = CityLayout.facingCFrame
local RAD_90 = MapKit.RAD_90

----------------------------------------------------------------------
-- Palette
----------------------------------------------------------------------

local NAVY = MapKit.NAVY
local WHITE = MapKit.WHITE
local NEON_WHITE = MapKit.NEON_WHITE -- marquee frames around signature-colored boards
local FLOWER_COLORS = MapKit.FLOWER_COLORS
local zoneSignFace = MapKit.zoneSignFace
local SIDEWALK = Color3.fromRGB(236, 226, 208)
local CORNICE = Color3.fromRGB(248, 248, 244)
local PLINTH_DARK = Color3.fromRGB(40, 40, 70)
-- Street hardware (signal masts, lamp poles, legs, posts): toy-city cobalt,
-- foot plates a deeper cobalt; never gunmetal / near-black (art guide).
local POLE = MapKit.STREET_POLE
local POLE_BASE = MapKit.STREET_BASE
local SIGNAL_YELLOW = Color3.fromRGB(255, 200, 40) -- cartoon traffic-light housing
local WINDOW_BLUE = Color3.fromRGB(160, 220, 255)
local WINDOW_WARM = Color3.fromRGB(255, 236, 170)
local GLASS_BLUE = Color3.fromRGB(170, 225, 255)
local LAMP_GLOBE = Color3.fromRGB(255, 236, 180)

-- Soft pastels for buildings (the zones keep the saturated signature colors).
local PASTELS = {
	Color3.fromRGB(255, 150, 135), -- coral
	Color3.fromRGB(255, 190, 130), -- peach
	Color3.fromRGB(255, 228, 140), -- butter
	Color3.fromRGB(150, 226, 190), -- mint
	Color3.fromRGB(120, 206, 214), -- teal
	Color3.fromRGB(140, 192, 255), -- sky
	Color3.fromRGB(170, 170, 255), -- periwinkle
	Color3.fromRGB(206, 172, 255), -- lavender
	Color3.fromRGB(255, 170, 210), -- bubblegum
	Color3.fromRGB(196, 236, 120), -- lime (was cream: cream read khaki in shade)
}

-- Saturated accents (awnings, neon signs, billboards).
local ACCENTS = {
	Color3.fromRGB(255, 90, 90),
	Color3.fromRGB(255, 170, 40),
	Color3.fromRGB(60, 200, 255),
	Color3.fromRGB(255, 110, 190),
	Color3.fromRGB(120, 220, 90),
	Color3.fromRGB(170, 110, 255),
}

local ROOF_SIGNS = { "HUSTLE", "CASH CO", "BIG BANK", "PIZZA", "HOTEL", "24/7" }

-- Shop B rooftop billboard per gap: chosen so no billboard shares a hue with
-- either neighbouring zone (gap k sits between zone k and zone k + 1), so a
-- zone's own rooftop board is the only one in its color in its sector.
local SHOP_B_BILLBOARD = {
	Color3.fromRGB(170, 110, 255), -- gap 1: Lemonade | Dog
	Color3.fromRGB(255, 170, 40), -- gap 2: Dog | Sneaker
	Color3.fromRGB(255, 110, 190), -- gap 3: Sneaker | Car Wash
	Color3.fromRGB(120, 220, 90), -- gap 4: Car Wash | Food Truck
	Color3.fromRGB(60, 200, 255), -- gap 5: Food Truck | Creator
	Color3.fromRGB(255, 90, 90), -- gap 6: Creator | Stock
	Color3.fromRGB(255, 170, 40), -- gap 7: Stock | Startup
	Color3.fromRGB(255, 110, 190), -- gap 8: Startup | Lemonade
}

----------------------------------------------------------------------
-- Helpers
----------------------------------------------------------------------

-- Small decor: never collides, never casts a shadow (unless told otherwise).
local function deco(props)
	if props.canCollide == nil then
		props.canCollide = false
	end
	if props.castShadow == nil then
		props.castShadow = false
	end
	return props
end

local function decoBlock(props)
	return makeBlock(deco(props))
end
local function decoBall(props)
	return makeBall(deco(props))
end
local function decoCylinder(props)
	return makeCylinder(deco(props))
end
local function decoWedge(props)
	return makeWedge(deco(props))
end

-- Neon accent for a zone: AccentColor, unless it is too dark to glow.
local function neonAccent(zone: GameConfig.ZoneDef): Color3
	local c = zone.AccentColor
	local luminance = 0.299 * c.R + 0.587 * c.G + 0.114 * c.B
	return if luminance < 0.25 then zone.SignColor else c
end

-- Four neon bars framing a board of size (w, h) centered at `cf` (board
-- plane = local XY, the frame sits flush with it, `depth` deep).
local function neonFrame(parent: Instance, cf: CFrame, w: number, h: number, depth: number, color: Color3, bar: number)
	for _, y in { -(h + bar) / 2, (h + bar) / 2 } do
		decoBlock({
			name = "NeonFrame", parent = parent, size = Vector3.new(w + bar * 2, bar, depth),
			cframe = cf * CFrame.new(0, y, 0), color = color, material = Enum.Material.Neon,
		})
	end
	for _, x in { -(w + bar) / 2, (w + bar) / 2 } do
		decoBlock({
			name = "NeonFrame", parent = parent, size = Vector3.new(bar, h, depth),
			cframe = cf * CFrame.new(x, 0, 0), color = color, material = Enum.Material.Neon,
		})
	end
end

-- Window bands on the plaza face (local -Z face) of a W x H x D box whose
-- ground center is `cf`: one band every `spacing` studs from `y0`, the top
-- band clear of the cornice. Returns the band heights used.
local function bandHeights(height: number, y0: number, maxBands: number): { number }
	local usable = height - y0 - 4
	if usable < 0 then
		return {}
	end
	local count = math.floor(usable / 9) + 1
	local spacing = 9
	if count > maxBands then
		count = maxBands
		spacing = usable / (maxBands - 1)
	end
	local ys = {}
	for i = 0, count - 1 do
		table.insert(ys, y0 + i * spacing)
	end
	return ys
end

-- Colored roof cap inside the white cornice so the city reads as candy
-- colors from above too (not a sea of white roofs).
local ROOF_TINT = Color3.fromRGB(80, 80, 112)
local function roofCap(parent: Instance, cf: CFrame, w: number, d: number, topOfCornice: number, body: Color3)
	decoBlock({
		name = "RoofCap", parent = parent, size = Vector3.new(w - 0.6, 0.2, d - 0.6),
		cframe = cf * CFrame.new(0, topOfCornice + 0.1, 0), color = body:Lerp(ROOF_TINT, 0.3),
	})
end

----------------------------------------------------------------------
-- Street details: curbs, markings, crosswalks, traffic lights
----------------------------------------------------------------------

local function buildCurbRing(parent: Instance, radius: number, segments: number, length: number, topY: number)
	for i = 0, segments - 1 do
		decoBlock({
			name = "Curb", parent = parent, size = Vector3.new(length, S.CurbHeight, S.CurbWidth),
			cframe = facingCFrame(radius, i * 360 / segments, topY + S.CurbHeight / 2),
			color = Color3.fromRGB(250, 250, 245),
		})
	end
end

local DASH_COLORS = {
	Center = Color3.fromRGB(255, 214, 50),
	Lane = Color3.fromRGB(250, 250, 250),
	Back = Color3.fromRGB(255, 214, 50),
}

-- PAINTED lane dashes: one invisible flat deck per gap octant
-- (CityLayout.markingDecks / backMarkingDecks) whose lit SurfaceGui
-- "Markings" holds one Frame per dash (same size, color, center and tangent
-- as the old 0.1-thick dash parts), so the markings shade like the asphalt
-- and cost 1 part per octant instead of 15 (ring) / 9 (Back Avenue).
local function buildMarkingDecks(parent: Instance, decks)
	for _, deck in decks do
		local _, gui = MapKit.makeGroundDeck(parent, deck.name, deck.cframe, deck.width, deck.depth, deck.pixelsPerStud, "Markings", 1, 1)
		-- scale (float) positions and sizes: UDim offsets are whole pixels
		local pps = deck.pixelsPerStud
		local gw, gh = deck.width * pps, deck.depth * pps
		for _, dash in deck.dashes do
			local px, py = MapKit.deckPixel(deck.cframe, deck.width, deck.depth, pps, dash.cframe.Position)
			MapKit.makeGuiFrame({
				name = "Dash", parent = gui, anchor = Vector2.new(0.5, 0.5),
				position = UDim2.fromScale(px / gw, py / gh),
				size = UDim2.fromScale(dash.length / deck.width, dash.width / deck.depth),
				rotation = MapKit.deckRotation(deck.cframe, dash.cframe.RightVector),
				color = DASH_COLORS[dash.kind] or WHITE,
			})
		end
	end
end

local function buildMarkings(parent: Instance)
	-- Painted dashes (no dash comes within 9 degrees of a zone axis: the
	-- crosswalks live there), then the zebra crosswalks on every zone axis.
	buildMarkingDecks(parent, CityLayout.markingDecks)
	local markingY = S.MarkingTop - 0.05
	for _, cw in CityLayout.crosswalks do
		for j = 0, S.CrosswalkBars - 1 do
			decoBlock({
				name = "CrosswalkBar", parent = parent,
				size = Vector3.new(S.CrosswalkWidth, 0.1, S.CrosswalkBarDepth),
				cframe = facingCFrame(S.CrosswalkFirstRadius + S.CrosswalkStep * j, cw.angle, markingY),
				color = Color3.fromRGB(250, 250, 250),
			})
		end
	end
end

-- Mast-arm traffic light: cobalt pole on the outer sidewalk, arm reaching
-- over the outer lanes toward the plaza, a cartoon-yellow head with red /
-- amber / green Neon lamps on both tangential faces (traffic runs both ways
-- past it; dimmed lenses read as dark discs on the yellow housing).
local function buildTrafficLight(parent: Instance, spec)
	local model = makeModel("TrafficLight", parent)
	model:SetAttribute("ZoneId", spec.zoneId)
	local cf = spec.cframe -- pole base on the sidewalk, -Z toward the plaza
	decoCylinder({
		name = "SignalBase", parent = model, diameter = 1.8, height = 0.6,
		cframe = cf * CFrame.new(0, 0.3, 0), color = POLE_BASE,
	})
	makeCylinder({
		name = "SignalPole", parent = model, diameter = 0.9, height = 16,
		cframe = cf * CFrame.new(0, 8, 0), color = POLE, castShadow = false,
	})
	decoBlock({
		name = "SignalArm", parent = model, size = Vector3.new(0.6, 0.6, 10),
		cframe = cf * CFrame.new(0, 15, -5), color = POLE,
	})
	local headCF = cf * CFrame.new(0, 12.2, -10)
	decoBlock({
		name = "SignalHead", parent = model, size = Vector3.new(1.8, 5, 1.8),
		cframe = headCF, color = SIGNAL_YELLOW,
	})
	decoBlock({
		name = "SignalHanger", parent = model, size = Vector3.new(0.4, 0.6, 0.4),
		cframe = headCF * CFrame.new(0, 2.8, 0), color = POLE,
	})
	local lamps = {
		{ name = "SignalRed", y = 1.55, color = Color3.fromRGB(255, 70, 70) },
		{ name = "SignalAmber", y = 0, color = Color3.fromRGB(255, 200, 40) },
		{ name = "SignalGreen", y = -1.55, color = Color3.fromRGB(80, 230, 120) },
	}
	for _, side in { -0.95, 0.95 } do
		for _, lamp in lamps do
			decoBall({
				name = lamp.name, parent = model, diameter = 1.2,
				cframe = headCF * CFrame.new(side, lamp.y, 0), color = lamp.color, material = Enum.Material.Neon,
			})
		end
	end
end

local function buildStreet(city: Instance)
	local street = makeModel("Street", city)
	-- Curbs on both asphalt edges (outer on the outer sidewalk, inner on the
	-- inner sidewalk).
	buildCurbRing(street, S.RoadCurbRadius, 48, 13.6, S.OuterSidewalkTop)
	buildCurbRing(street, S.InnerCurbRadius, 32, 12.8, S.InnerSidewalkTop)
	buildMarkings(street)
	-- Back Avenue (between the skyline rings): painted yellow center dashes
	-- every 5 degrees (the asphalt + white edge rings are MapBuilder's discs)
	buildMarkingDecks(street, CityLayout.backMarkingDecks)
	for _, spec in CityLayout.trafficLights do
		buildTrafficLight(street, spec)
	end
end

----------------------------------------------------------------------
-- Skyline: chunky pastel toy buildings, every one facing the plaza
----------------------------------------------------------------------

local function buildRoofProp(model: Instance, cf: CFrame, spec, variant: number, accent: Color3, pastel: Color3)
	local W, H, D = spec.width, spec.height, spec.depth
	local roofY = H + 1
	if variant == 0 then
		-- Setback penthouse + antenna with a red neon tip
		local setH = math.floor(0.3 * H)
		decoBlock({
			name = "Setback", parent = model, size = Vector3.new(0.65 * W, setH, 0.65 * D),
			cframe = cf * CFrame.new(0, roofY + setH / 2, 1), color = pastel:Lerp(WHITE, 0.25), castShadow = true,
		})
		decoCylinder({
			name = "Antenna", parent = model, diameter = 0.6, height = 10,
			cframe = cf * CFrame.new(0, roofY + setH + 5, 1), color = Color3.fromRGB(200, 204, 220),
		})
		decoBall({
			name = "AntennaTip", parent = model, diameter = 1.4,
			cframe = cf * CFrame.new(0, roofY + setH + 10.3, 1), color = Color3.fromRGB(255, 70, 70),
			material = Enum.Material.Neon,
		})
	elseif variant == 1 then
		-- Cartoon water tower on four legs
		local base = cf * CFrame.new(W * 0.2, roofY, D * 0.12)
		for _, off in { Vector3.new(-2.6, 0, -2.6), Vector3.new(2.6, 0, -2.6), Vector3.new(-2.6, 0, 2.6), Vector3.new(2.6, 0, 2.6) } do
			decoBlock({
				name = "TowerLeg", parent = model, size = Vector3.new(0.6, 4, 0.6),
				cframe = base * CFrame.new(off.X, 2, off.Z), color = Color3.fromRGB(90, 96, 130),
			})
		end
		decoCylinder({
			name = "WaterTank", parent = model, diameter = 8, height = 7,
			cframe = base * CFrame.new(0, 7.5, 0), color = Color3.fromRGB(255, 120, 100), castShadow = true,
		})
		decoBall({
			name = "WaterTankCap", parent = model, diameter = 8,
			cframe = base * CFrame.new(0, 11, 0), color = Color3.fromRGB(230, 80, 80),
		})
	elseif variant == 2 then
		-- Rooftop neon sign facing the plaza
		local signCF = cf * CFrame.new(0, roofY + 4.3, -D / 2 + 2)
		for _, x in { -7, 7 } do
			decoBlock({
				name = "RoofSignLeg", parent = model, size = Vector3.new(0.8, 2, 0.8),
				cframe = cf * CFrame.new(x, roofY + 1, -D / 2 + 2), color = POLE,
			})
		end
		local board = decoBlock({
			name = "RoofSign", parent = model, size = Vector3.new(20, 5, 1),
			cframe = signCF, color = WHITE,
		})
		addSurfaceText(board, ROOF_SIGNS[math.floor(spec.index / 4) % #ROOF_SIGNS + 1], Enum.Font.LuckiestGuy, accent, Enum.NormalId.Front, 20, WHITE)
		decoBlock({
			name = "RoofSignNeon", parent = model, size = Vector3.new(20.4, 0.5, 0.4),
			cframe = signCF * CFrame.new(0, -2.75, -0.4), color = accent, material = Enum.Material.Neon,
		})
	else
		-- Big candy dome + neon finial
		local d = 0.45 * W
		decoBall({
			name = "RoofDome", parent = model, diameter = d,
			cframe = cf * CFrame.new(0, roofY - 0.5, 0), color = pastel, castShadow = true,
		})
		decoBall({
			name = "DomeFinial", parent = model, diameter = 1.6,
			cframe = cf * CFrame.new(0, roofY - 0.5 + d / 2 + 0.5, 0), color = accent, material = Enum.Material.Neon,
		})
	end
end

-- Vertical blade signs on the mid-ring street wall (one per MidBuilding<k>,
-- in ring order): one letter per line on both faces.
local BLADE_WORDS = {
	"CAFE", "TOYS", "GYM", "DINER", "BOOKS", "PETS", "DONUT", "SHOES", "GAMES", "MUSIC", "CANDY", "PIZZA",
	"TACO", "BAKE", "ART", "SPA", "BOBA", "DELI", "SURF", "FILM", "JUICE", "TECH", "ARCADE", "HOTEL",
}

-- Blade sign perpendicular to the plaza face of a mid-ring building: a 1 x
-- 14 x 4.5 accent board (y 12..26, clear of the awning <= 9.2 and the corner
-- pillars) standing out from the wall at building-local x, white LuckiestGuy
-- letters on both (unlit) faces, a white neon strip on its outer edge.
local function buildBladeSign(model: Instance, cf: CFrame, spec)
	local W, D, k = spec.width, spec.depth, spec.index
	local side = if k % 2 == 0 then 1 else -1
	local color = ACCENTS[(k % #ACCENTS) + 1]
	local word = BLADE_WORDS[k % #BLADE_WORDS + 1]
	local x = side * (W / 2 - 4)
	local blade = decoBlock({
		name = "BladeSign", parent = model, size = Vector3.new(1, 14, 4.5),
		cframe = cf * CFrame.new(x, 19, -D / 2 - 0.05 - 2.25), color = color,
	})
	local letters = {}
	for i = 1, #word do
		table.insert(letters, string.sub(word, i, i))
	end
	local text = table.concat(letters, "\n")
	for _, face in { Enum.NormalId.Left, Enum.NormalId.Right } do
		addSurfaceText(blade, text, Enum.Font.LuckiestGuy, WHITE, face, 20, color)
	end
	decoBlock({
		name = "BladeSignNeon", parent = model, size = Vector3.new(0.4, 14.4, 0.4),
		cframe = cf * CFrame.new(x, 19, -D / 2 - 0.05 - 4.5 - 0.2), color = NEON_WHITE, material = Enum.Material.Neon,
	})
end

-- Ground-floor shopfront on an outer-ring building's plaza face (the face
-- that lines the Back Avenue, r ~277): accent awning, door, warm display
-- window. `front` = local z of the face the door + window stand on (the
-- plinth face). Awning bottom 8.0, door / window in front of the plinth:
-- the BackOuter sidewalk loop (r 273.4 +- 1.45) stays clear below 4.9.
local function buildOuterShopfront(model: Instance, cf: CFrame, W: number, D: number, front: number, accent: Color3)
	decoWedge({
		name = "Awning", parent = model, size = Vector3.new(W - 6, 1.2, 3),
		cframe = cf * CFrame.new(0, 8.6, -D / 2 - 2), color = accent,
	})
	decoBlock({
		name = "Door", parent = model, size = Vector3.new(5, 6.5, 0.4),
		cframe = cf * CFrame.new(W / 4, 3.25, front - 0.2), color = accent:Lerp(NAVY, 0.35),
	})
	decoBlock({
		name = "DisplayWindow", parent = model, size = Vector3.new(W / 2 - 5, 4, 0.3),
		cframe = cf * CFrame.new(-(W / 4 + 1), 4, front - 0.15), color = WINDOW_WARM,
	})
end

-- Giant painted wall ad (zero parts) on a mid-ring building's back face, the
-- inner wall of the Back Avenue: SurfaceGui "Mural" (5 px/stud, LightInfluence
-- 0.4, Brightness 1.4) with an accent Panel from x 3 .. W-3 and y 11 (over the
-- BackAwning / BackDoor) .. H-3, three soft circles + a diagonal stripe
-- clipped to it and a two-line LuckiestGuy slogan. The panel color is two
-- steps along the accent wheel from the building's blade sign and awning.
local MURAL_SLOGANS = {
	"DREAM\nBIG", "HUSTLE\nHARD", "BOSS\nMODE", "LEVEL\nUP!", "CASH\nFLOW", "GO GET\nIT!",
	"BIG\nMONEY", "TO THE\nMOON", "STAY\nHUNGRY", "SIDE\nHUSTLE", "GRIND\nTIME", "YOU GOT\nTHIS",
}
local MURAL_PPS = 5
local BUTTER = Color3.fromRGB(255, 228, 140)
local SKY = Color3.fromRGB(140, 192, 255)
local function buildMural(body: BasePart, spec)
	local W, H, k = spec.width, spec.height, spec.index
	local gui = Instance.new("SurfaceGui")
	gui.Name = "Mural"
	gui.Face = Enum.NormalId.Back
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = MURAL_PPS
	gui.LightInfluence = 0.4
	gui.Brightness = 1.4
	gui.ClipsDescendants = true
	gui.Parent = body
	local x0, x1, y0, y1 = 3, W - 3, 11, H - 3
	local pw, ph = x1 - x0, y1 - y0
	local panel = MapKit.makeGuiFrame({
		name = "Panel", parent = gui,
		position = UDim2.fromScale(x0 / W, (H - y1) / H), size = UDim2.fromScale(pw / W, ph / H),
		color = ACCENTS[((k + 2) % #ACCENTS) + 1], corner = 0.06, zIndex = 1, clips = true,
	})
	-- circles: diameter d * ph (square in studs), centers in panel scale
	local function circle(name: string, d: number, cx: number, cy: number, color: Color3, transparency: number)
		MapKit.makeGuiFrame({
			name = name, parent = panel, anchor = Vector2.new(0.5, 0.5),
			position = UDim2.fromScale(cx, cy), size = UDim2.fromScale(d * ph / pw, d),
			color = color, transparency = transparency, corner = 0.5, zIndex = 2,
		})
	end
	circle("BigDot", 0.6, 0, 0, WHITE, 0.75)
	circle("ButterDot", 0.32, 1 - 0.14 * ph / pw, 0.86, BUTTER, 0.3)
	circle("SkyDot", 0.16, 1 - 0.2 * ph / pw, 0.17, SKY, 0.1)
	MapKit.makeGuiFrame({
		name = "Stripe", parent = panel, anchor = Vector2.new(0.5, 0.5),
		position = UDim2.fromScale(0.5, 0.5), size = UDim2.fromScale(0.96, 0.08),
		color = WHITE, transparency = 0.8, rotation = 18, zIndex = 3,
	})
	local label = MapKit.makeTextLabel(
		panel, MURAL_SLOGANS[k % #MURAL_SLOGANS + 1], Enum.Font.LuckiestGuy, WHITE,
		UDim2.fromScale(0.08, 0.22), UDim2.fromScale(0.84, 0.56)
	)
	label.ZIndex = 4
	-- chunky navy sticker outline sized to the two text lines (4..6 px)
	local stroke = label:FindFirstChildOfClass("UIStroke")
	if stroke then
		local linePx = ph * MURAL_PPS * 0.56 / 2
		stroke.Thickness = math.clamp(math.floor(0.14 * linePx + 0.5), 4, 6)
	end
	return gui
end

-- Slewing yellow tower crane on an outer-ring roof (CityLayout.TowerCranes /
-- CityLayout.Crane): a static mast with white collars from the roof to
-- C.mastTop (y 136), and a Model "CraneTop" (attribute CitySpin, WorldPivot
-- on the mast axis at C.pivotY) that the client city-life sim turns: slew
-- ring, cab, 50-long jib (crane-local x -12 .. +38, y 141.5..144.1), apex +
-- tie bars (to y 153.1), counterweight, trolley + hook line at x C.trolleyX,
-- a two-plank load (down to y 125.8) and a red neon jib-tip light. Low enough
-- that the jib shows in the spawn view over the Lemonade axis; the load
-- hangs >= 18 studs (radially) off the blimp path. Crane-local +X (the jib)
-- starts tangential (building-local +X) so it reads as a long line from the
-- plaza. Everything is Anchored, CanCollide false, CastShadow false.
local CRANE_YELLOW = Color3.fromRGB(255, 196, 40)
local CRANE_SLATE = Color3.fromRGB(64, 70, 120)
local CRANE_WHITE = Color3.fromRGB(248, 248, 244)
local function buildCrane(model: Instance, cf: CFrame, spec, crane)
	local roofTop = spec.height + 1
	local C = CityLayout.Crane
	local base = cf * CFrame.new(0, 0, C.mastZ)
	local y0 = C.mastTop
	local mastH = y0 - roofTop
	decoBlock({
		name = "CraneMast", parent = model, size = Vector3.new(4, mastH, 4),
		cframe = base * CFrame.new(0, roofTop + mastH / 2, 0), color = CRANE_YELLOW,
	})
	for i = 1, 3 do
		decoBlock({
			name = "CraneCollar", parent = model, size = Vector3.new(4.4, 0.8, 4.4),
			cframe = base * CFrame.new(0, roofTop + mastH * i / 4, 0), color = CRANE_WHITE,
		})
	end
	local top = makeModel("CraneTop", model)
	local function at(x: number, dy: number): CFrame
		return base * CFrame.new(x, y0 + dy, 0)
	end
	local tx = C.trolleyX
	decoCylinder({ name = "SlewRing", parent = top, diameter = 6, height = 1, cframe = at(0, 0.5), color = CRANE_SLATE })
	decoBlock({ name = "CraneCab", parent = top, size = Vector3.new(5, 4.5, 5), cframe = at(3, 3.25), color = CRANE_WHITE })
	decoBlock({ name = "CabWindow", parent = top, size = Vector3.new(0.3, 1.8, 4), cframe = at(5.65, 3.7), color = Color3.fromRGB(90, 200, 255) })
	decoBlock({ name = "CraneJib", parent = top, size = Vector3.new(50, 2.6, 2.6), cframe = at(13, 6.8), color = CRANE_YELLOW })
	decoBlock({ name = "CraneApex", parent = top, size = Vector3.new(2.2, 9, 2.2), cframe = at(0, 12.6), color = CRANE_YELLOW })
	local apex = Vector3.new(0, 17.1, 0)
	for _, tipX in { 38, -12 } do
		local tip = Vector3.new(tipX, 8.1, 0)
		local delta = tip - apex
		local mid = (apex + tip) / 2
		decoBlock({
			name = "CraneTie", parent = top, size = Vector3.new(0.35, 0.35, delta.Magnitude),
			cframe = at(mid.X, mid.Y) * CFrame.Angles(0, if tipX > 0 then RAD_90 else -RAD_90, 0)
				* CFrame.Angles(math.atan2(-delta.Y, math.abs(delta.X)), 0, 0),
			color = CRANE_WHITE,
		})
	end
	decoBlock({ name = "Counterweight", parent = top, size = Vector3.new(6, 5, 4.6), cframe = at(-9, 4.5), color = Color3.fromRGB(120, 128, 160) })
	decoBlock({ name = "CraneTrolley", parent = top, size = Vector3.new(3, 1.2, 3), cframe = at(tx, 4.9), color = CRANE_SLATE })
	decoBlock({ name = "HookLine", parent = top, size = Vector3.new(0.3, 12, 0.3), cframe = at(tx, -1.7), color = CRANE_SLATE })
	decoBlock({ name = "CraneLoad", parent = top, size = Vector3.new(7, 1.2, 2.4), cframe = at(tx, -8.4), color = Color3.fromRGB(255, 150, 40) })
	decoBlock({ name = "CraneLoad", parent = top, size = Vector3.new(7, 1.2, 2.4), cframe = at(tx, -9.6), color = Color3.fromRGB(90, 200, 255) })
	decoBall({
		name = "JibTipLight", parent = top, diameter = 1, cframe = at(38, 8.6),
		color = Color3.fromRGB(255, 60, 60), material = Enum.Material.Neon,
	})
	top.WorldPivot = base * CFrame.new(0, C.pivotY, 0)
	top:SetAttribute("CitySpin", crane.rate)
end

----------------------------------------------------------------------
-- Landmark hero towers (CityLayout.HeroTowers: six outer-ring slots)
----------------------------------------------------------------------

local HERO_STYLE = {
	[2] = { body = Color3.fromRGB(170, 170, 255), accent = Color3.fromRGB(255, 110, 190) }, -- periwinkle / hot pink
	[14] = { body = Color3.fromRGB(150, 226, 190), accent = Color3.fromRGB(255, 214, 50) }, -- mint / yellow
	[7] = { body = Color3.fromRGB(120, 206, 214), dome = Color3.fromRGB(255, 228, 140), accent = Color3.fromRGB(60, 200, 255) },
	[19] = { body = Color3.fromRGB(255, 150, 135), dome = Color3.fromRGB(206, 172, 255), accent = Color3.fromRGB(255, 214, 50) },
	[10] = { body = Color3.fromRGB(255, 170, 210), accent = Color3.fromRGB(255, 214, 50), text = "HUSTLE CITY" },
	[22] = { body = Color3.fromRGB(140, 192, 255), accent = Color3.fromRGB(255, 90, 170), text = "GO BIG!" },
}
local HERO_FALLBACK = { body = PASTELS[7], dome = PASTELS[3], accent = ACCENTS[4], text = "HUSTLE CITY" }
local SPIRE_RED = Color3.fromRGB(255, 70, 70)

-- "Stepped": three setback tiers (all collide) with white cornices, a neon
-- band under every cornice, blue window bands 5 / 3 / 2, a white spire with
-- a red neon ball on top (y 150 .. 185.25).
local function buildSteppedTower(model: Instance, cf: CFrame, style)
	local body = style.body
	decoBlock({
		name = "Plinth", parent = model, size = Vector3.new(37, 8, 29),
		cframe = cf * CFrame.new(0, 4, 0), color = body:Lerp(PLINTH_DARK, 0.18),
	})
	local tiers = {
		{ w = 36, h = 80, d = 28, y0 = 0, bands = 5, first = 14 },
		{ w = 28, h = 45, d = 22, y0 = 80, bands = 3, first = 88 },
		{ w = 20, h = 25, d = 16, y0 = 125, bands = 2, first = 133 },
	}
	for i, t in tiers do
		local top = t.y0 + t.h
		makeBlock({
			name = if i == 1 then "Body" else "BodyTier" .. i, parent = model, size = Vector3.new(t.w, t.h, t.d),
			cframe = cf * CFrame.new(0, t.y0 + t.h / 2, 0), color = if i == 2 then body:Lerp(WHITE, 0.15) else body,
		})
		decoBlock({
			name = "Cornice", parent = model, size = Vector3.new(t.w + 2, 1.6, t.d + 2),
			cframe = cf * CFrame.new(0, top + 0.2, 0), color = CORNICE,
		})
		decoBlock({
			name = "NeonBand", parent = model, size = Vector3.new(t.w + 1, 0.8, 0.6),
			cframe = cf * CFrame.new(0, top - 1.2, -t.d / 2 - 0.35), color = style.accent, material = Enum.Material.Neon,
		})
		local last = top - 6
		for b = 0, t.bands - 1 do
			local y = if t.bands > 1 then t.first + b * (last - t.first) / (t.bands - 1) else t.first
			decoBlock({
				name = "WindowBand", parent = model, size = Vector3.new(t.w - 6, 3.6, 0.6),
				cframe = cf * CFrame.new(0, y, -t.d / 2 - 0.25), color = WINDOW_BLUE,
			})
		end
	end
	decoCylinder({
		name = "Spire", parent = model, diameter = 2, height = 32,
		cframe = cf * CFrame.new(0, 150 + 16, 0), color = WHITE, castShadow = true,
	})
	decoBall({
		name = "SpireTip", parent = model, diameter = 3.5,
		cframe = cf * CFrame.new(0, 182 + 1.45, 0), color = SPIRE_RED, material = Enum.Material.Neon,
	})
	buildOuterShopfront(model, cf, 36, 28, -28 / 2 - 0.5, style.accent)
end

-- "Round": a 30-dia drum (the collider) on a 33-dia plinth, six blue window
-- rings, a neon ring under a big candy dome ("RoofDome") with a neon
-- "DomeFinial" (the client city-life sim floats a spinning coin over it) and
-- an antenna behind it. Door + display window sit tangent to the plinth.
local function buildRoundTower(model: Instance, cf: CFrame, style)
	local body = style.body
	decoCylinder({
		name = "Plinth", parent = model, diameter = 33, height = 8,
		cframe = cf * CFrame.new(0, 4, 0), color = body:Lerp(PLINTH_DARK, 0.18),
	})
	makeCylinder({
		name = "Body", parent = model, diameter = 30, height = 140,
		cframe = cf * CFrame.new(0, 70, 0), color = body,
	})
	for _, y in { 24, 44, 64, 84, 104, 124 } do
		decoCylinder({
			name = "WindowRing", parent = model, diameter = 30.8, height = 3.2,
			cframe = cf * CFrame.new(0, y, 0), color = WINDOW_BLUE,
		})
	end
	decoCylinder({
		name = "NeonRing", parent = model, diameter = 31.2, height = 1,
		cframe = cf * CFrame.new(0, 136, 0), color = style.accent, material = Enum.Material.Neon,
	})
	decoBall({
		name = "RoofDome", parent = model, diameter = 30,
		cframe = cf * CFrame.new(0, 140, 0), color = style.dome or body:Lerp(WHITE, 0.4), castShadow = true,
	})
	decoBall({
		name = "DomeFinial", parent = model, diameter = 1.6,
		cframe = cf * CFrame.new(0, 140 + 15 + 0.5, 0), color = style.accent, material = Enum.Material.Neon,
	})
	-- antenna on the back of the dome (dome surface at z +8 is y ~152.7),
	-- clear of the coin that spins over the finial
	decoCylinder({
		name = "Antenna", parent = model, diameter = 1.2, height = 22,
		cframe = cf * CFrame.new(0, 152 + 11, 8), color = Color3.fromRGB(200, 204, 220),
	})
	decoBall({
		name = "AntennaTip", parent = model, diameter = 1.6,
		cframe = cf * CFrame.new(0, 174.6, 8), color = SPIRE_RED, material = Enum.Material.Neon,
	})
	-- Shopfront tangent to the round plinth (r 16.5): door right of center,
	-- display window left, a small accent awning over each.
	local function tangent(degrees: number, radius: number, y: number): CFrame
		return cf * CFrame.Angles(0, math.rad(degrees), 0) * CFrame.new(0, y, -radius)
	end
	decoBlock({
		name = "Door", parent = model, size = Vector3.new(5, 6.5, 0.4),
		cframe = tangent(-18, 16.5 + 0.2, 3.25), color = style.accent:Lerp(NAVY, 0.35),
	})
	decoBlock({
		name = "DisplayWindow", parent = model, size = Vector3.new(7, 4, 0.3),
		cframe = tangent(22, 16.5 + 0.15, 4), color = WINDOW_WARM,
	})
	for _, degrees in { -18, 22 } do
		decoWedge({
			name = "Awning", parent = model, size = Vector3.new(8, 1.2, 3),
			cframe = tangent(degrees, 15 - 0.2 + 1.5, 8.6), color = style.accent,
		})
	end
end

-- "Billboard": a tall slab with corner pillars, eight window bands, a
-- stepped crown (accent / white / accent) and a giant unlit rooftop
-- billboard on two legs facing the plaza inside a white neon marquee.
local function buildBillboardTower(model: Instance, cf: CFrame, style)
	local W, H, D = 34, 130, 26
	local body = style.body
	makeBlock({
		name = "Body", parent = model, size = Vector3.new(W, H, D),
		cframe = cf * CFrame.new(0, H / 2, 0), color = body,
	})
	decoBlock({
		name = "Plinth", parent = model, size = Vector3.new(W + 1, 8, D + 1),
		cframe = cf * CFrame.new(0, 4, 0), color = body:Lerp(PLINTH_DARK, 0.18),
	})
	for _, x in { -W / 2, W / 2 } do
		decoCylinder({
			name = "Pillar", parent = model, diameter = 3, height = H,
			cframe = cf * CFrame.new(x, H / 2, -D / 2), color = body:Lerp(WHITE, 0.3),
		})
	end
	for _, y in bandHeights(H, 12, 8) do
		decoBlock({
			name = "WindowBand", parent = model, size = Vector3.new(W - 6, 3.6, 0.6),
			cframe = cf * CFrame.new(0, y, -D / 2 - 0.25), color = WINDOW_BLUE,
		})
	end
	decoBlock({
		name = "Cornice", parent = model, size = Vector3.new(W + 2, 1.6, D + 2),
		cframe = cf * CFrame.new(0, H + 0.2, 0), color = CORNICE,
	})
	local crown = { { 26, 20, style.accent }, { 18, 14, WHITE }, { 10, 8, style.accent } }
	for i, c in crown do
		decoBlock({
			name = "Crown", parent = model, size = Vector3.new(c[1], 5, c[2]),
			cframe = cf * CFrame.new(0, H + 1 + (i - 0.5) * 5, 3), color = c[3], castShadow = true,
		})
	end
	for _, x in { -10, 10 } do
		decoBlock({
			name = "BillboardLeg", parent = model, size = Vector3.new(1, 4.5, 1),
			cframe = cf * CFrame.new(x, H + 1 + 2.25, -10), color = POLE,
		})
	end
	local boardCF = cf * CFrame.new(0, H + 5.5 + 6, -10)
	local board = decoBlock({
		name = "Billboard", parent = model, size = Vector3.new(30, 12, 1.2),
		cframe = boardCF, color = style.accent, castShadow = true,
	})
	addSurfaceText(board, style.text or "HUSTLE CITY", Enum.Font.LuckiestGuy, WHITE, Enum.NormalId.Front, 16, style.accent)
	neonFrame(model, boardCF, 30, 12, 1.5, NEON_WHITE, 0.7)
	buildOuterShopfront(model, cf, W, D, -D / 2 - 0.5, style.accent)
end

local function buildHeroTower(parent: Instance, spec)
	local model = makeModel(spec.name, parent)
	local style = HERO_STYLE[spec.index] or HERO_FALLBACK
	if spec.hero == "Round" then
		buildRoundTower(model, spec.cframe, style)
	elseif spec.hero == "Billboard" then
		buildBillboardTower(model, spec.cframe, style)
	else
		buildSteppedTower(model, spec.cframe, style)
	end
end

local function buildSkylineBuilding(parent: Instance, spec)
	if spec.hero then
		buildHeroTower(parent, spec)
		return
	end
	local W, H, D = spec.width, spec.height, spec.depth
	local k = spec.index
	local isMid = spec.ring == "Mid"
	local body = if isMid then PASTELS[(k * 3) % #PASTELS + 1] else PASTELS[(k * 7 + 5) % #PASTELS + 1]
	local pastelAlt = PASTELS[(k * 3 + 4) % #PASTELS + 1]
	local accent = ACCENTS[(k + (if isMid then 0 else 3)) % #ACCENTS + 1]
	local windowColor = if k % 3 == 2 then WINDOW_WARM else WINDOW_BLUE
	local cf = spec.cframe
	local model = makeModel(spec.name, parent)

	-- (1) body: the only collider
	local bodyPart = makeBlock({
		name = "Body", parent = model, size = Vector3.new(W, H, D),
		cframe = cf * CFrame.new(0, H / 2, 0), color = body,
	})
	-- (2) plinth (a light tint: dark plinths read as grime under pastels)
	decoBlock({
		name = "Plinth", parent = model, size = Vector3.new(W + 1, 8, D + 1),
		cframe = cf * CFrame.new(0, 4, 0), color = body:Lerp(PLINTH_DARK, 0.18),
	})
	-- (3) rounded front-corner pillars (the chunky toy look)
	for _, x in { -W / 2, W / 2 } do
		decoCylinder({
			name = "Pillar", parent = model, diameter = 3, height = H,
			cframe = cf * CFrame.new(x, H / 2, -D / 2), color = body:Lerp(WHITE, 0.3),
		})
	end
	-- (4) window bands on the plaza face + (5) mullions -> a window grid.
	-- Mid ring (seen up close from the street): chunky 0.6-stud part bands
	-- and part mullions. Outer ring (seen only from >= 150 studs, mostly over
	-- the mid ring): the same bands, sills and mullions PAINTED on the body
	-- (MapKit.paintBands, zero parts).
	local bands = bandHeights(H, 12, 8)
	if isMid then
		for _, y in bands do
			decoBlock({
				name = "WindowBand", parent = model, size = Vector3.new(W - 6, 3.6, 0.6),
				cframe = cf * CFrame.new(0, y, -D / 2 - 0.25), color = windowColor,
			})
		end
		if #bands > 0 then
			local top = bands[#bands] + 2.6
			local bottom = 9.5
			for _, x in { -W / 4, 0, W / 4 } do
				decoBlock({
					name = "Mullion", parent = model, size = Vector3.new(1.2, top - bottom, 0.8),
					cframe = cf * CFrame.new(x, (top + bottom) / 2, -D / 2 - 0.4), color = body,
				})
			end
		end
	else
		MapKit.paintBands(bodyPart, Enum.NormalId.Front, bands, {
			width = W - 6, color = windowColor, mullions = { -W / 4, 0, W / 4 }, body = body,
		})
	end
	-- (6) painted bands on both side faces (zero parts). Outer ring: every
	-- band. Mid ring: the bands above the 20-tall rowhouses that hide the
	-- lowest one (y 12).
	local sideBands = {}
	for i, y in bands do
		if not isMid or i > 1 then
			table.insert(sideBands, y)
		end
	end
	if #sideBands > 0 then
		for _, face in { Enum.NormalId.Left, Enum.NormalId.Right } do
			MapKit.paintBands(bodyPart, face, sideBands, { width = D - 6, color = windowColor })
		end
	end
	-- (6b) mid ring: a giant painted wall ad (Mural, zero parts) over a back
	-- shop door under an accent awning, so the Back Avenue between the rings
	-- is lined by shopfronts and color on both sides, not blank walls (door
	-- in front of the plinth: r <= 245.2, inside the BackInner sidewalk at
	-- 247.3 - 1.45; awning bottom 8.0 over the walkers; mural from y 11)
	if isMid then
		buildMural(bodyPart, spec)
		decoWedge({
			name = "BackAwning", parent = model, size = Vector3.new(W - 8, 1.2, 3),
			cframe = cf * CFrame.new(0, 8.6, D / 2 + 2) * CFrame.Angles(0, math.pi, 0), color = accent,
		})
		decoBlock({
			name = "BackDoor", parent = model, size = Vector3.new(5, 6.5, 0.4),
			cframe = cf * CFrame.new(-W / 4, 3.25, D / 2 + 0.7), color = accent:Lerp(NAVY, 0.35),
		})
	end
	-- (7) cornice + colored roof cap
	decoBlock({
		name = "Cornice", parent = model, size = Vector3.new(W + 2, 1.6, D + 2),
		cframe = cf * CFrame.new(0, H + 0.2, 0), color = CORNICE,
	})
	roofCap(model, cf, W + 2, D + 2, H + 1, body)
	-- (8) roof prop
	local crane = if isMid then nil else CityLayout.TowerCranes[k]
	if crane then
		-- (8) a slewing tower crane replaces this roof's water tower
		buildCrane(model, cf, spec, crane)
	else
		buildRoofProp(model, cf, spec, k % 4, accent, pastelAlt)
	end
	if isMid then
		-- (9) mid ring: ground-floor awning + door (shops at street level)
		-- and a vertical blade sign on the street wall
		decoWedge({
			name = "Awning", parent = model, size = Vector3.new(W - 4, 1.2, 3),
			cframe = cf * CFrame.new(0, 8.6, -D / 2 - 2), color = accent,
		})
		decoBlock({
			name = "Door", parent = model, size = Vector3.new(5, 6.5, 0.4),
			cframe = cf * CFrame.new(0, 3.25, -D / 2 - 0.6), color = body:Lerp(NAVY, 0.45),
		})
		buildBladeSign(model, cf, spec)
	else
		-- (9) outer ring: shopfront on the Back Avenue
		buildOuterShopfront(model, cf, W, D, -D / 2 - 0.5, accent)
	end
end

-- Narrow rowhouse infill between two mid-ring buildings: a pastel body (the
-- only collider), a warm-lit window band, a 3-stripe awning over a colored
-- door, white cornice + roof cap. Front flush with the mid ring (r 220).
local function buildRowhouse(parent: Instance, spec)
	local W, H, D = spec.width, spec.height, spec.depth
	local k = spec.index
	local cf = spec.cframe
	local body = PASTELS[(k * 5 + 2) % #PASTELS + 1]
	local accent = ACCENTS[(k * 5 + 4) % #ACCENTS + 1]
	local model = makeModel(spec.name, parent)
	makeBlock({
		name = "Body", parent = model, size = Vector3.new(W, H, D),
		cframe = cf * CFrame.new(0, H / 2, 0), color = body,
	})
	decoBlock({
		name = "WindowBand", parent = model, size = Vector3.new(W - 3, 3.6, 0.6),
		cframe = cf * CFrame.new(0, 13, -D / 2 - 0.25), color = WINDOW_WARM,
	})
	local stripe = (W - 2) / 3
	for i = 0, 2 do
		decoWedge({
			name = "AwningStripe", parent = model, size = Vector3.new(stripe, 1.4, 3),
			cframe = cf * CFrame.new((i - 1) * stripe, 8.6, -D / 2 - 1.5),
			color = if i == 1 then CORNICE else accent,
		})
	end
	decoBlock({
		name = "Door", parent = model, size = Vector3.new(4, 6.5, 0.4),
		cframe = cf * CFrame.new(0, 3.25, -D / 2 - 0.2), color = accent:Lerp(NAVY, 0.35),
	})
	decoBlock({
		name = "Cornice", parent = model, size = Vector3.new(W + 0.6, 1.4, D + 1),
		cframe = cf * CFrame.new(0, H + 0.1, 0), color = CORNICE,
	})
	roofCap(model, cf, W + 0.6, D + 1, H + 0.8, body)
end

local function buildSkyline(city: Instance)
	local skyline = makeModel("Skyline", city)
	for _, spec in CityLayout.skyline do
		buildSkylineBuilding(skyline, spec)
	end
	for _, spec in CityLayout.rowhouses do
		buildRowhouse(skyline, spec)
	end
end

----------------------------------------------------------------------
-- Storefronts between the zones
----------------------------------------------------------------------

-- Striped awning of `count` wedges (each `stripe` wide), high edge against
-- the wall (local +Z), sloping down toward the plaza.
local function buildAwning(parent: Instance, cf: CFrame, count: number, stripe: number, depth: number, accent: Color3)
	for i = 0, count - 1 do
		local x = (i - (count - 1) / 2) * stripe
		decoWedge({
			name = "AwningStripe", parent = parent, size = Vector3.new(stripe, 1.4, depth),
			cframe = cf * CFrame.new(x, 0, 0), color = if i % 2 == 0 then CORNICE else accent,
		})
	end
end

local function buildShopFront(model: Instance, cf: CFrame, spec, frontWidth: number, accent: Color3, body: Color3)
	local D = spec.depth
	local front = -D / 2
	local doorX = if spec.kind == "A" then 8.5 else 13
	local windowW = if spec.kind == "A" then 16 else 22
	local windowX = if spec.kind == "A" then -2.5 else -3
	-- plinth band (1 stud proud, darker)
	decoBlock({
		name = "Plinth", parent = model, size = Vector3.new(spec.width + 1, 1.2, D + 1),
		cframe = cf * CFrame.new(0, 0.6, 0), color = body:Lerp(PLINTH_DARK, 0.35),
	})
	-- display window (Glass) with a white frame, and the door
	decoBlock({
		name = "WindowFrame", parent = model, size = Vector3.new(windowW + 1, 8, 0.3),
		cframe = cf * CFrame.new(windowX, 4.9, front - 0.1), color = CORNICE,
	})
	-- warm "lights on inside" panel, seen through the glass (its face sits
	-- between the glass front and the white frame)
	decoBlock({
		name = "WindowGlow", parent = model, size = Vector3.new(windowW, 6.6, 0.1),
		cframe = cf * CFrame.new(windowX, 4.9, front - 0.3), color = WINDOW_WARM,
	})
	decoBlock({
		name = "DisplayWindow", parent = model, size = Vector3.new(windowW, 7, 0.4),
		cframe = cf * CFrame.new(windowX, 4.9, front - 0.3), color = GLASS_BLUE,
		material = Enum.Material.Glass, transparency = 0.55,
	})
	decoBlock({
		name = "Door", parent = model, size = Vector3.new(4, 7, 0.4),
		cframe = cf * CFrame.new(doorX, 4.7, front - 0.2), color = accent:Lerp(NAVY, 0.35),
	})
	decoBlock({
		name = "DoorLight", parent = model, size = Vector3.new(4.4, 0.4, 0.5),
		cframe = cf * CFrame.new(doorX, 8.4, front - 0.25), color = accent, material = Enum.Material.Neon,
	})
	-- striped awning across the ground floor
	local stripes = if spec.kind == "A" then 6 else 8
	buildAwning(model, cf * CFrame.new(0, 9.6, front - 1.85), stripes, frontWidth / stripes, 3.5, accent)
	-- name board + neon underline
	local boardW = if spec.kind == "A" then 18 else 24
	local board = decoBlock({
		name = "ShopSign", parent = model, size = Vector3.new(boardW, 3.4, 0.8),
		cframe = cf * CFrame.new(0, 12.4, front - 0.4), color = accent,
	})
	addSurfaceText(board, spec.name, Enum.Font.FredokaOne, WHITE, Enum.NormalId.Front, 24, accent)
	decoBlock({
		name = "ShopSignNeon", parent = model, size = Vector3.new(boardW, 0.4, 0.3),
		cframe = cf * CFrame.new(0, 10.5, front - 0.7), color = NEON_WHITE, material = Enum.Material.Neon,
	})
end

local function buildShopA(parent: Instance, spec)
	local W, H, D = spec.width, spec.height, spec.depth
	local cf = spec.cframe
	local body = PASTELS[(spec.gapIndex * 2) % #PASTELS + 1]
	local accent = ACCENTS[spec.accentIndex]
	local model = makeModel("Shop" .. spec.name:gsub(" ", ""), parent)
	makeBlock({
		name = "Body", parent = model, size = Vector3.new(W, H, D),
		cframe = cf * CFrame.new(0, H / 2, 0), color = body,
	})
	buildShopFront(model, cf, spec, W, accent, body)
	-- small upstairs windows
	for _, x in { -6, 6 } do
		decoBlock({
			name = "UpperWindow", parent = model, size = Vector3.new(6, 2.6, 0.4),
			cframe = cf * CFrame.new(x, 15.6, -D / 2 - 0.2), color = WINDOW_BLUE,
		})
	end
	decoBlock({
		name = "Cornice", parent = model, size = Vector3.new(W + 1.5, 1.2, D + 1.5),
		cframe = cf * CFrame.new(0, H + 0.1, 0), color = CORNICE,
	})
	roofCap(model, cf, W + 1.5, D + 1.5, H + 0.7, body)
	for _, x in { -5, 5 } do
		decoBlock({
			name = "ACUnit", parent = model, size = Vector3.new(3, 2, 3),
			cframe = cf * CFrame.new(x, H + 1.7, 2.5), color = Color3.fromRGB(200, 206, 220),
		})
	end
end

local function buildShopB(parent: Instance, spec)
	local W, H, D = spec.width, spec.height, spec.depth
	local cf = spec.cframe
	local body = PASTELS[(spec.gapIndex * 2 + 5) % #PASTELS + 1]
	local accent = ACCENTS[spec.accentIndex]
	local model = makeModel("Shop" .. spec.name:gsub(" ", ""), parent)
	makeBlock({
		name = "Body", parent = model, size = Vector3.new(W, H, D),
		cframe = cf * CFrame.new(0, H / 2, 0), color = body,
	})
	buildShopFront(model, cf, spec, 30, accent, body)
	-- rounded corner pillars
	for _, x in { -W / 2, W / 2 } do
		decoCylinder({
			name = "Pillar", parent = model, diameter = 3, height = H,
			cframe = cf * CFrame.new(x, H / 2, -D / 2), color = body:Lerp(WHITE, 0.3),
		})
	end
	-- two window bands (upper floors)
	for _, y in { 17.5, 23.5 } do
		decoBlock({
			name = "WindowBand", parent = model, size = Vector3.new(W - 6, 3.6, 0.6),
			cframe = cf * CFrame.new(0, y, -D / 2 - 0.25), color = WINDOW_BLUE,
		})
	end
	decoBlock({
		name = "Cornice", parent = model, size = Vector3.new(W + 2, 1.4, D + 2),
		cframe = cf * CFrame.new(0, H + 0.1, 0), color = CORNICE,
	})
	roofCap(model, cf, W + 2, D + 2, H + 0.8, body)
	-- rooftop billboard facing the plaza: 2 legs, a saturated board (per
	-- gap, never a neighbouring zone's hue: SHOP_B_BILLBOARD) with white
	-- slogan text, unlit so it glows from any sun angle, inside a white neon
	-- marquee. 20 x 8.5: smaller than every zone's 40 x 11.5 anchor board.
	local roofY = H + 0.8
	for _, x in { -7, 7 } do
		decoBlock({
			name = "BillboardLeg", parent = model, size = Vector3.new(1, 6, 1),
			cframe = cf * CFrame.new(x, roofY + 3, -D / 2 + 3), color = POLE,
		})
	end
	local boardCF = cf * CFrame.new(0, roofY + 10, -D / 2 + 3)
	local billboardColor = SHOP_B_BILLBOARD[spec.gapIndex] or ACCENTS[(spec.gapIndex % #ACCENTS) + 1]
	local board = decoBlock({
		name = "Billboard", parent = model, size = Vector3.new(20, 8.5, 1),
		cframe = boardCF, color = billboardColor, castShadow = true,
	})
	addSurfaceText(board, spec.slogan or "$$$", Enum.Font.LuckiestGuy, WHITE, Enum.NormalId.Front, 20, billboardColor)
	neonFrame(model, boardCF, 20, 8.5, 1.3, NEON_WHITE, 0.6)
	-- flower boxes under the first upper-floor window band
	for i, x in { -10, 10 } do
		local boxCF = cf * CFrame.new(x, 15.2, -D / 2 - 0.6)
		decoBlock({
			name = "FlowerBox", parent = model, size = Vector3.new(8, 1, 1.2),
			cframe = boxCF, color = accent:Lerp(WHITE, 0.3),
		})
		for f = 0, 3 do
			decoBall({
				name = "Flower", parent = model, diameter = 1,
				cframe = boxCF * CFrame.new(-3 + f * 2, 0.75, -0.05),
				color = FLOWER_COLORS[(spec.gapIndex + i * 2 + f) % #FLOWER_COLORS + 1],
			})
		end
	end
end

local function buildShops(city: Instance)
	local shops = makeModel("Shops", city)
	for _, spec in CityLayout.shops do
		if spec.kind == "A" then
			buildShopA(shops, spec)
		else
			buildShopB(shops, spec)
		end
	end
end

----------------------------------------------------------------------
-- Zone anchor buildings: signature-colored landmark + giant name + icon
----------------------------------------------------------------------

-- Giant rooftop icons; `cf` = icon base on the roof (local -Z to the plaza).
local ICONS: { [string]: (Instance, CFrame, GameConfig.ZoneDef) -> () } = {}

ICONS.LemonadeStand = function(parent, cf, zone)
	local lemonCF = cf * CFrame.new(0, 8, 0) * CFrame.Angles(0, 0, math.rad(12))
	decoBall({ name = "IconLemon", parent = parent, diameter = 16, cframe = lemonCF, color = zone.SignColor, castShadow = true })
	for _, x in { -8.4, 8.4 } do
		decoBall({ name = "IconLemonTip", parent = parent, diameter = 3.4, cframe = lemonCF * CFrame.new(x, 0, 0), color = Color3.fromRGB(235, 190, 28) })
	end
	for _, spec in { { x = -1.5, roll = 30 }, { x = 1.8, roll = -25 } } do
		decoBlock({
			name = "IconLeaf", parent = parent, size = Vector3.new(4.5, 0.8, 2.2),
			cframe = lemonCF * CFrame.new(spec.x, 8.3, 0) * CFrame.Angles(0, 0, math.rad(spec.roll)),
			color = Color3.fromRGB(96, 200, 80),
		})
	end
end

ICONS.DogWalking = function(parent, cf, _zone)
	local boneWhite = Color3.fromRGB(250, 248, 240)
	decoCylinder({ name = "IconPole", parent = parent, diameter = 1.2, height = 6, cframe = cf * CFrame.new(0, 3, 0), color = POLE })
	local boneCF = cf * CFrame.new(0, 10, 0) * CFrame.Angles(0, 0, math.rad(28))
	decoBlock({ name = "IconBone", parent = parent, size = Vector3.new(14, 3.5, 3.5), cframe = boneCF, color = boneWhite, castShadow = true })
	for _, x in { -7, 7 } do
		for _, y in { -1.7, 1.7 } do
			decoBall({ name = "IconBoneKnob", parent = parent, diameter = 5, cframe = boneCF * CFrame.new(x, y, 0), color = boneWhite })
		end
	end
end

ICONS.SneakerFlipping = function(parent, cf, zone)
	decoBlock({ name = "IconStand", parent = parent, size = Vector3.new(14, 3, 8), cframe = cf * CFrame.new(0, 1.5, 0), color = zone.AccentColor })
	local shoe = cf * CFrame.new(0, 3, 0)
	decoBlock({ name = "IconSole", parent = parent, size = Vector3.new(16, 2, 7), cframe = shoe * CFrame.new(0, 1, 0), color = WHITE, castShadow = true })
	decoBlock({ name = "IconUpper", parent = parent, size = Vector3.new(11, 5, 6.5), cframe = shoe * CFrame.new(-2.5, 4.5, 0), color = zone.SignColor })
	decoBall({ name = "IconToe", parent = parent, diameter = 6.5, cframe = shoe * CFrame.new(3.6, 3.4, 0), color = zone.SignColor })
	decoBlock({ name = "IconCollar", parent = parent, size = Vector3.new(4, 1.4, 6.8), cframe = shoe * CFrame.new(-5.2, 7.4, 0), color = WHITE })
	decoBlock({
		name = "IconSwoosh", parent = parent, size = Vector3.new(8, 1.1, 0.4),
		cframe = shoe * CFrame.new(-1, 4.2, -3.45) * CFrame.Angles(0, 0, math.rad(-14)),
		color = zone.AccentColor, material = Enum.Material.Neon,
	})
end

ICONS.CarWash = function(parent, cf, _zone)
	local bubbles = {
		{ Vector3.new(-2, 4.5, 0), 8 },
		{ Vector3.new(4, 8.5, 1), 6 },
		{ Vector3.new(-1, 12.5, -1), 5 },
		{ Vector3.new(-6, 9.5, 1), 4.2 },
		{ Vector3.new(5, 2.8, -1.5), 4.6 },
	}
	for _, b in bubbles do
		decoBall({
			name = "IconBubble", parent = parent, diameter = b[2], cframe = cf * CFrame.new(b[1]),
			color = Color3.fromRGB(140, 230, 255), transparency = 0.3,
		})
		decoBall({
			name = "IconBubbleShine", parent = parent, diameter = b[2] * 0.22,
			cframe = cf * CFrame.new(b[1] + Vector3.new(-b[2] * 0.22, b[2] * 0.22, -b[2] * 0.35)),
			color = Color3.fromRGB(255, 255, 255), material = Enum.Material.Neon,
		})
	end
end

ICONS.FoodTruck = function(parent, cf, _zone)
	local bun = Color3.fromRGB(230, 150, 60)
	decoCylinder({ name = "IconBunBottom", parent = parent, diameter = 14, height = 3, cframe = cf * CFrame.new(0, 1.5, 0), color = bun, castShadow = true })
	decoCylinder({ name = "IconPatty", parent = parent, diameter = 15, height = 2, cframe = cf * CFrame.new(0, 4, 0), color = Color3.fromRGB(110, 60, 30) })
	decoBlock({
		name = "IconCheese", parent = parent, size = Vector3.new(13, 0.6, 13),
		cframe = cf * CFrame.new(0, 5.3, 0) * CFrame.Angles(0, math.rad(45), 0), color = Color3.fromRGB(255, 200, 40),
	})
	decoCylinder({ name = "IconLettuce", parent = parent, diameter = 15.5, height = 0.8, cframe = cf * CFrame.new(0, 5.9, 0), color = Color3.fromRGB(120, 220, 80) })
	decoBall({ name = "IconBunTop", parent = parent, diameter = 14, cframe = cf * CFrame.new(0, 6.2, 0), color = bun })
	for _, off in { Vector3.new(-3, 12.4, -2), Vector3.new(2.5, 12.8, -1.5), Vector3.new(0, 13, 1.5), Vector3.new(-4.5, 11, 2) } do
		decoBall({ name = "IconSesame", parent = parent, diameter = 1, cframe = cf * CFrame.new(off), color = Color3.fromRGB(255, 244, 214) })
	end
end

ICONS.ContentCreator = function(parent, cf, zone)
	decoCylinder({ name = "IconPole", parent = parent, diameter = 1.2, height = 3, cframe = cf * CFrame.new(0, 1.5, 0), color = POLE })
	local ringCF = cf * CFrame.new(0, 10.5, 0)
	decoCylinder({
		name = "IconRing", parent = parent, diameter = 16, height = 1.6, axis = "Z",
		cframe = ringCF, color = zone.SignColor, material = Enum.Material.Neon,
	})
	decoCylinder({ name = "IconRingInner", parent = parent, diameter = 12, height = 1.8, axis = "Z", cframe = ringCF, color = Color3.fromRGB(245, 60, 90) })
	-- white play triangle on the plaza face (two mirrored wedges)
	decoWedge({
		name = "IconPlay", parent = parent, size = Vector3.new(0.4, 2.6, 5),
		cframe = ringCF * CFrame.new(0, 1.3, -1.1) * CFrame.Angles(0, RAD_90, 0), color = WHITE,
	})
	decoWedge({
		name = "IconPlay", parent = parent, size = Vector3.new(0.4, 2.6, 5),
		cframe = ringCF * CFrame.new(0, -1.3, -1.1) * CFrame.Angles(0, RAD_90, 0) * CFrame.Angles(0, 0, math.rad(180)), color = WHITE,
	})
end

ICONS.StockDesk = function(parent, cf, zone)
	local green = zone.SignColor
	decoBlock({ name = "IconArrowShaft", parent = parent, size = Vector3.new(4, 12, 2), cframe = cf * CFrame.new(0, 6, 0), color = green, material = Enum.Material.Neon })
	decoWedge({
		name = "IconArrowHead", parent = parent, size = Vector3.new(2, 6, 5),
		cframe = cf * CFrame.new(-2.5, 15, 0) * CFrame.Angles(0, RAD_90, 0), color = green, material = Enum.Material.Neon,
	})
	decoWedge({
		name = "IconArrowHead", parent = parent, size = Vector3.new(2, 6, 5),
		cframe = cf * CFrame.new(2.5, 15, 0) * CFrame.Angles(0, -RAD_90, 0), color = green, material = Enum.Material.Neon,
	})
	-- candlestick bars beside it
	decoBlock({ name = "IconCandle", parent = parent, size = Vector3.new(2, 5, 2), cframe = cf * CFrame.new(-6, 2.5, 0), color = Color3.fromRGB(255, 80, 80) })
	decoBlock({ name = "IconCandle", parent = parent, size = Vector3.new(2, 8, 2), cframe = cf * CFrame.new(6, 4, 0), color = green })
end

ICONS.StartupHQ = function(parent, cf, zone)
	local blue = zone.AccentColor
	local bodyCF = cf * CFrame.new(0, 10.5, 0)
	decoCylinder({ name = "IconRocket", parent = parent, diameter = 5, height = 16, cframe = bodyCF, color = WHITE, castShadow = true })
	decoBall({ name = "IconRocketNose", parent = parent, diameter = 5, cframe = bodyCF * CFrame.new(0, 7.6, 0), color = blue })
	decoBall({ name = "IconRocketWindow", parent = parent, diameter = 2.2, cframe = bodyCF * CFrame.new(0, 3, -2.1), color = blue, material = Enum.Material.Neon })
	for i = 0, 2 do
		local yaw = math.rad(i * 120)
		decoWedge({
			name = "IconRocketFin", parent = parent, size = Vector3.new(0.6, 4, 3),
			cframe = bodyCF * CFrame.Angles(0, yaw, 0) * CFrame.new(0, -6, -3.6), color = blue,
		})
	end
	decoBall({
		name = "IconRocketFlame", parent = parent, diameter = 3.6, cframe = bodyCF * CFrame.new(0, -8.6, 0),
		color = Color3.fromRGB(255, 150, 40), material = Enum.Material.Neon,
	})
end

local function buildAnchor(parent: Instance, spec, zone: GameConfig.ZoneDef)
	local W, H, D = spec.width, spec.height, spec.depth
	local cf = spec.cframe
	local model = makeModel("Anchor" .. zone.Id, parent)
	model:SetAttribute("ZoneId", zone.Id)
	local sc = zone.SignColor
	local luminance = 0.299 * sc.R + 0.587 * sc.G + 0.114 * sc.B
	-- Body: a rich tint of the signature color (32% white). A bright yellow
	-- signature (luminance 0.75-0.85, Lemonade) goes 50% toward pure white =
	-- a warm butter (255,234,143), never cream / khaki; a near-white one
	-- (Startup HQ, > 0.85) is keyed to its AccentColor blue instead: a sky
	-- blue body (accent 60% white = (177,205,255)), accent glass bands, white
	-- pillars, an accent plinth, the accent neon trim.
	local PURE_WHITE = Color3.new(1, 1, 1)
	local isPale = luminance > 0.85
	local isBright = not isPale and luminance > 0.75
	local body = if isPale
		then zone.AccentColor:Lerp(PURE_WHITE, 0.6)
		elseif isBright then sc:Lerp(PURE_WHITE, 0.5)
		else sc:Lerp(WHITE, 0.32)
	local neon = if isPale then zone.AccentColor else neonAccent(zone)
	local windowColor = if isPale then zone.AccentColor else WINDOW_BLUE
	local pillarColor = if isPale
		then Color3.fromRGB(248, 250, 255)
		elseif isBright then Color3.fromRGB(255, 246, 205)
		else body:Lerp(WHITE, 0.3)
	local plinthColor = if isPale then zone.AccentColor:Lerp(NAVY, 0.3) else zone.SignColor:Lerp(NAVY, 0.3)
	-- Sign frame: the signature color, unless it is near-white (Startup HQ),
	-- where a white neon frame would just blow out: use the accent instead.
	local frameColor = if luminance > 0.85 then zone.AccentColor else sc

	makeBlock({
		name = "Body", parent = model, size = Vector3.new(W, H, D),
		cframe = cf * CFrame.new(0, H / 2, 0), color = body,
	})
	decoBlock({
		name = "Plinth", parent = model, size = Vector3.new(W + 1, 6, D + 1),
		cframe = cf * CFrame.new(0, 3, 0), color = plinthColor,
	})
	for _, x in { -W / 2, W / 2 } do
		decoCylinder({
			name = "Pillar", parent = model, diameter = 3, height = H,
			cframe = cf * CFrame.new(x, H / 2, -D / 2), color = pillarColor,
		})
	end
	local bands = bandHeights(H - 2, 10, 6)
	for _, y in bands do
		decoBlock({
			name = "WindowBand", parent = model, size = Vector3.new(W - 8, 3.6, 0.6),
			cframe = cf * CFrame.new(0, y, -D / 2 - 0.25), color = windowColor,
		})
	end
	if #bands > 0 then
		local top, bottom = bands[#bands] + 2.6, 7.5
		for _, x in { -W / 4, 0, W / 4 } do
			decoBlock({
				name = "Mullion", parent = model, size = Vector3.new(1.4, top - bottom, 0.8),
				cframe = cf * CFrame.new(x, (top + bottom) / 2, -D / 2 - 0.4), color = body,
			})
		end
	end
	decoBlock({
		name = "Cornice", parent = model, size = Vector3.new(W + 2, 1.6, D + 2),
		cframe = cf * CFrame.new(0, H + 0.2, 0), color = CORNICE,
	})
	roofCap(model, cf, W + 2, D + 2, H + 1, body)
	decoBlock({
		name = "NeonTrim", parent = model, size = Vector3.new(W + 2, 0.8, 0.6),
		cframe = cf * CFrame.new(0, H - 1.2, -D / 2 - 1.2), color = neon, material = Enum.Material.Neon,
	})

	-- Giant rooftop name sign (left) + icon (right), facing the plaza: a
	-- signature-colored board with white lettering inside a white neon
	-- marquee (the glow light stays in the signature color). 40 x 11.5: the
	-- largest rooftop board in its sector and the only one in its color.
	local roofY = H + 1
	local signX = -8
	local boardCF = cf * CFrame.new(signX, roofY + 4 + 5.75, -D / 2 + 2.5)
	for _, x in { -14, 14 } do
		decoBlock({
			name = "SignPost", parent = model, size = Vector3.new(1, 4, 1),
			cframe = cf * CFrame.new(signX + x, roofY + 2, -D / 2 + 2.5), color = NEON_WHITE, material = Enum.Material.Neon,
		})
	end
	local board = decoBlock({
		name = "AnchorSign", parent = model, size = Vector3.new(40, 11.5, 1.2),
		cframe = boardCF, color = zoneSignFace(zone), castShadow = true,
	})
	addSurfaceText(board, zone.Name, Enum.Font.FredokaOne, WHITE, Enum.NormalId.Front, 20, board.Color)
	addPointLight(board, frameColor, 20, 0.8)
	neonFrame(model, boardCF, 40, 11.5, 1.5, NEON_WHITE, 0.8)

	-- The giant icon is its own Model, pivoted at the icon base and tagged
	-- CitySpin (deg/s): the client city-life sim turns it about world Y. The
	-- base sits right of / behind the board's center line so a full turn of
	-- the widest icon (lemon tips reach ~10.1) never sweeps through the
	-- marquee (nearest frame point is ~10.6 from the pivot).
	local iconBuilder = ICONS[zone.Id]
	if iconBuilder then
		local iconCF = cf * CFrame.new(20.5, roofY, 1.5)
		local icon = makeModel("Icon", model)
		iconBuilder(icon, iconCF, zone)
		icon.WorldPivot = iconCF
		icon:SetAttribute("CitySpin", 25)
	end
end

local function buildAnchors(city: Instance)
	local anchors = makeModel("Anchors", city)
	for _, spec in CityLayout.anchors do
		local zone = GameConfig.getZone(spec.zoneId)
		if zone then
			buildAnchor(anchors, spec, zone)
		end
	end
end

----------------------------------------------------------------------
-- Street furniture (outer sidewalk) + bus stops
----------------------------------------------------------------------

local function groundCF(position: Vector3): CFrame
	-- -Z faces the plaza (toward the road)
	local r = Vector3.new(position.X, 0, position.Z).Magnitude
	return facingCFrame(r, CityLayout.angleOf(position), position.Y)
end

local FURNITURE: { [string]: (Instance, CFrame, any?) -> () } = {}

FURNITURE.Planter = function(parent, cf)
	decoCylinder({ name = "Planter", parent = parent, diameter = 5.6, height = 1.4, cframe = cf * CFrame.new(0, 0.7, 0), color = Color3.fromRGB(226, 214, 192) })
	decoCylinder({ name = "PlanterRim", parent = parent, diameter = 6, height = 0.3, cframe = cf * CFrame.new(0, 1.45, 0), color = Color3.fromRGB(250, 248, 240) })
	decoCylinder({ name = "PlanterSoil", parent = parent, diameter = 4.8, height = 0.2, cframe = cf * CFrame.new(0, 1.5, 0), color = Color3.fromRGB(110, 80, 60) })
	MapKit.buildTree(parent, cf.Position + Vector3.new(0, 1.5, 0), 1.1)
end

FURNITURE.Hydrant = function(parent, cf)
	local red = Color3.fromRGB(235, 60, 60)
	decoCylinder({ name = "HydrantBase", parent = parent, diameter = 1.7, height = 0.3, cframe = cf * CFrame.new(0, 0.15, 0), color = red })
	decoCylinder({ name = "Hydrant", parent = parent, diameter = 1.3, height = 2.2, cframe = cf * CFrame.new(0, 1.1, 0), color = red })
	decoBall({ name = "HydrantCap", parent = parent, diameter = 1.4, cframe = cf * CFrame.new(0, 2.2, 0), color = red })
	decoCylinder({ name = "HydrantNubs", parent = parent, diameter = 0.55, height = 2, axis = "X", cframe = cf * CFrame.new(0, 1.5, 0), color = Color3.fromRGB(255, 214, 60) })
end

FURNITURE.TrashCan = function(parent, cf)
	decoCylinder({ name = "TrashCan", parent = parent, diameter = 1.8, height = 2.6, cframe = cf * CFrame.new(0, 1.3, 0), color = Color3.fromRGB(70, 180, 110) })
	decoCylinder({ name = "TrashLid", parent = parent, diameter = 2, height = 0.3, cframe = cf * CFrame.new(0, 2.75, 0), color = Color3.fromRGB(50, 140, 86) })
end

FURNITURE.NewsBox = function(parent, cf)
	decoBlock({ name = "NewsBox", parent = parent, size = Vector3.new(1.8, 2.8, 1.6), cframe = cf * CFrame.new(0, 1.4, 0), color = Color3.fromRGB(70, 140, 255) })
	decoBlock({ name = "NewsPaper", parent = parent, size = Vector3.new(1.2, 0.8, 0.1), cframe = cf * CFrame.new(0, 2, 0.82), color = WHITE })
end

-- Tall double lamp (15-tall pole, 6-wide arm, 2 neon globes; the light only
-- when item.light ~= false) with zone-colored festival banners when the item
-- names item.bannerZones = { lower-angle zone id, higher-angle zone id }: a
-- BannerBar at y 12.7 and two 1.9 x 4.4 Banners (y 8.1 .. 12.5) hanging in
-- the tangential plane (radial extent +-0.1) at lamp-local x +1.25 (the
-- lower-angle side, the plaza viewer's left) and -1.25.
local BANNER_FACE: { [string]: Color3 } = {}
for _, zone in GameConfig.Zones do
	BANNER_FACE[zone.Id] = zoneSignFace(zone)
end
FURNITURE.Lamp = function(parent, cf, item)
	decoCylinder({ name = "LampBase", parent = parent, diameter = 1.6, height = 0.5, cframe = cf * CFrame.new(0, 0.25, 0), color = POLE_BASE })
	makeCylinder({ name = "LampPole", parent = parent, diameter = 0.9, height = 15, cframe = cf * CFrame.new(0, 7.5, 0), color = POLE, castShadow = false })
	decoBlock({ name = "LampArm", parent = parent, size = Vector3.new(6, 0.6, 0.6), cframe = cf * CFrame.new(0, 14.6, 0), color = POLE })
	for i, x in { -3, 3 } do
		local globe = decoBall({ name = "LampGlobe", parent = parent, diameter = 2.2, cframe = cf * CFrame.new(x, 13.6, 0), color = LAMP_GLOBE, material = Enum.Material.Neon })
		if i == 1 and not (item and item.light == false) then
			addPointLight(globe, MapKit.LAMP_WARM, 18, 0.9)
		end
	end
	local zones = item and item.bannerZones
	if zones then
		decoBlock({ name = "BannerBar", parent = parent, size = Vector3.new(4.6, 0.3, 0.3), cframe = cf * CFrame.new(0, 12.7, 0), color = POLE })
		for j, x in { 1.25, -1.25 } do
			decoBlock({
				name = "Banner", parent = parent, size = Vector3.new(1.9, 4.4, 0.2),
				cframe = cf * CFrame.new(x, 10.3, 0), color = BANNER_FACE[zones[j]] or WHITE,
			})
		end
	end
end

local function buildBusStop(parent: Instance, stop)
	local model = makeModel(stop.name, parent)
	local cf = stop.cframe -- -Z faces the road
	local orange = Color3.fromRGB(255, 150, 40)
	decoBlock({ name = "BusRoof", parent = model, size = Vector3.new(14, 0.8, 6), cframe = cf * CFrame.new(0, 8.4, 0), color = orange, castShadow = true })
	decoBlock({ name = "BusRoofTrim", parent = model, size = Vector3.new(14.2, 0.4, 0.4), cframe = cf * CFrame.new(0, 8.1, -3.1), color = WHITE, material = Enum.Material.Neon })
	for _, x in { -6.4, 6.4 } do
		decoBlock({ name = "BusPost", parent = model, size = Vector3.new(0.6, 8, 0.6), cframe = cf * CFrame.new(x, 4, 2.4), color = POLE })
	end
	decoBlock({
		name = "BusGlass", parent = model, size = Vector3.new(13, 6, 0.3), cframe = cf * CFrame.new(0, 4.2, 2.6),
		color = GLASS_BLUE, material = Enum.Material.Glass, transparency = 0.4,
	})
	decoBlock({ name = "BusBench", parent = model, size = Vector3.new(10, 0.8, 2), cframe = cf * CFrame.new(-1, 1.8, 1.3), color = MapKit.WOOD })
	for _, x in { -5, 3 } do
		decoBlock({ name = "BusBenchLeg", parent = model, size = Vector3.new(0.5, 1.4, 1.6), cframe = cf * CFrame.new(x, 0.7, 1.3), color = POLE })
	end
	-- Neon-framed ad panel on the glass
	local adCF = cf * CFrame.new(4.4, 4.4, 2.3)
	local ad = decoBlock({ name = "BusAd", parent = model, size = Vector3.new(4, 6, 0.3), cframe = adCF, color = WHITE })
	addSurfaceText(ad, "HUSTLE\nBUS", Enum.Font.LuckiestGuy, Color3.fromRGB(255, 110, 190), Enum.NormalId.Front, 24, WHITE)
	neonFrame(model, adCF, 4, 6, 0.4, Color3.fromRGB(255, 110, 190), 0.3)
	-- round BUS sign on a pole at the curb end
	decoCylinder({ name = "BusSignPole", parent = model, diameter = 0.4, height = 10, cframe = cf * CFrame.new(-8.5, 5, -2), color = POLE })
	local disc = decoCylinder({
		name = "BusSign", parent = model, diameter = 2.6, height = 0.3, axis = "Z",
		cframe = cf * CFrame.new(-8.5, 9.6, -2), color = Color3.fromRGB(60, 160, 255),
	})
	addSurfaceText(disc, "BUS", Enum.Font.LuckiestGuy, WHITE, Enum.NormalId.Right, 30)
end

local function buildFurniture(city: Instance)
	local furniture = makeModel("Furniture", city)
	for _, item in CityLayout.streetFurniture do
		local builder = FURNITURE[item.kind]
		if builder then
			builder(furniture, groundCF(item.position), item)
		end
	end
	for _, stop in CityLayout.busStops do
		buildBusStop(furniture, stop)
	end
end

----------------------------------------------------------------------
-- Gap blocks: café terraces in front of every Shop A, street trees in round
-- planters beside both shops (positions from CityLayout.cafes / gapTrees)
----------------------------------------------------------------------

-- One café set: white table on a pole under a two-tone umbrella, a stool on
-- each side. `cf` = table center on the ground, -Z toward the plaza.
local function buildCafeSet(parent: Instance, cf: CFrame, accent: Color3)
	local C = CityLayout.Cafe
	decoCylinder({
		name = "CafeTable", parent = parent, diameter = 4, height = 0.4,
		cframe = cf * CFrame.new(0, C.tableTop - 0.2, 0), color = WHITE,
	})
	decoCylinder({
		name = "CafePole", parent = parent, diameter = 0.5, height = C.canopyY,
		cframe = cf * CFrame.new(0, C.canopyY / 2, 0), color = WHITE,
	})
	decoCylinder({
		name = "CafeUmbrella", parent = parent, diameter = C.canopyDiameter, height = 0.5,
		cframe = cf * CFrame.new(0, C.canopyY, 0), color = accent, castShadow = true,
	})
	decoCylinder({
		name = "CafeUmbrellaTop", parent = parent, diameter = 5, height = 0.52,
		cframe = cf * CFrame.new(0, C.canopyY, 0), color = WHITE,
	})
	decoBall({
		name = "CafeFinial", parent = parent, diameter = 1.2,
		cframe = cf * CFrame.new(0, C.canopyY + 0.6, 0), color = accent,
	})
	for _, side in { -1, 1 } do
		decoCylinder({
			name = "CafeStool", parent = parent, diameter = 1.6, height = C.stoolTop,
			cframe = cf * CFrame.new(side * C.stoolOffset, C.stoolTop / 2, 0), color = accent:Lerp(WHITE, 0.4),
		})
	end
end

-- Checkered patio rug under a Shop A café (CityLayout.cafeTerraces): a flat
-- 0.08 slab in the shop's accent 45% toward white, its lit Top SurfaceGui
-- painting a 0.4-stud white border and a checker of 2 x 2-stud white squares
-- (pizzeria rug), so the café frontage is a destination, not bare pavement.
-- (A Top-face gui: the pattern reads the same either way round.)
local function buildCafeTerrace(parent: Instance, terrace)
	local accent = ACCENTS[terrace.accentIndex] or ACCENTS[1]
	local size = terrace.size
	local slab = decoBlock({
		name = "CafeTerrace", parent = parent, size = size, cframe = terrace.cframe,
		color = accent:Lerp(WHITE, 0.45),
	})
	slab.CanQuery = false
	local gui = Instance.new("SurfaceGui")
	gui.Name = "Checker"
	gui.Face = Enum.NormalId.Top
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 8
	gui.LightInfluence = 1
	gui.Brightness = 1
	local w, d = size.X, size.Z
	local border = 0.4
	for _, edge in {
		{ 0.5, border / 2 / d, 1, border / d },
		{ 0.5, 1 - border / 2 / d, 1, border / d },
		{ border / 2 / w, 0.5, border / w, 1 },
		{ 1 - border / 2 / w, 0.5, border / w, 1 },
	} do
		MapKit.makeGuiFrame({
			name = "Border", parent = gui, anchor = Vector2.new(0.5, 0.5),
			position = UDim2.fromScale(edge[1], edge[2]), size = UDim2.fromScale(edge[3], edge[4]),
			color = WHITE, zIndex = 2,
		})
	end
	local cell = 2
	local cols, rows = math.floor(w / cell), math.floor(d / cell)
	local x0, z0 = (w - cols * cell) / 2, (d - rows * cell) / 2
	for i = 0, cols - 1 do
		for j = 0, rows - 1 do
			if (i + j) % 2 == 0 then
				MapKit.makeGuiFrame({
					name = "Check", parent = gui,
					position = UDim2.fromScale((x0 + i * cell) / w, (z0 + j * cell) / d),
					size = UDim2.fromScale(cell / w, cell / d),
					color = WHITE, transparency = 0.15, zIndex = 1,
				})
			end
		end
	end
	gui.Parent = slab
end

-- Street tree in a round planter whose rim takes the shop's accent.
local function buildGapTree(parent: Instance, position: Vector3, accent: Color3)
	local cf = CFrame.new(position.X, 0, position.Z)
	decoCylinder({
		name = "GapPlanter", parent = parent, diameter = 4.5, height = 1.2,
		cframe = cf * CFrame.new(0, 0.6, 0), color = Color3.fromRGB(240, 232, 214),
	})
	decoCylinder({
		name = "GapPlanterRim", parent = parent, diameter = 5, height = 0.3,
		cframe = cf * CFrame.new(0, 1.25, 0), color = accent:Lerp(WHITE, 0.5),
	})
	decoCylinder({
		name = "GapPlanterSoil", parent = parent, diameter = 4, height = 0.1,
		cframe = cf * CFrame.new(0, 1.43, 0), color = Color3.fromRGB(110, 80, 60),
	})
	MapKit.buildTree(parent, Vector3.new(position.X, 1.45, position.Z), 1.0)
end

local function buildGapBlocks(city: Instance)
	local blocks = makeModel("GapBlocks", city)
	local gapModels = {}
	local shopAByGap = {}
	for _, spec in CityLayout.shops do
		if spec.kind == "A" then
			shopAByGap[spec.gapIndex] = spec
		end
		if not gapModels[spec.gapIndex] then
			gapModels[spec.gapIndex] = makeModel("Gap" .. spec.gapIndex, blocks)
		end
	end
	for _, terrace in CityLayout.cafeTerraces do
		buildCafeTerrace(gapModels[terrace.gapIndex], terrace)
	end
	for _, cafe in CityLayout.cafes do
		local shop = shopAByGap[cafe.gapIndex]
		buildCafeSet(gapModels[cafe.gapIndex], cafe.cframe, ACCENTS[shop and shop.accentIndex or 1])
	end
	-- gapTrees are listed per shop (CityLayout.shops order), two per shop
	for i, spec in CityLayout.shops do
		for j = 1, 2 do
			local pos = CityLayout.gapTrees[(i - 1) * 2 + j]
			if pos then
				buildGapTree(gapModels[spec.gapIndex], pos, ACCENTS[spec.accentIndex])
			end
		end
	end
end

----------------------------------------------------------------------
-- Back pockets: a tree in a planter / a lamp post in every pocket behind
-- the rowhouses (CityLayout.pocketTrees / pocketLamps, r 241.5), so the
-- Back Avenue's inner side reads as a leafy side street
----------------------------------------------------------------------

local function buildBackPockets(city: Instance)
	local pockets = makeModel("BackPockets", city)
	local P = CityLayout.Pocket
	for i, pos in CityLayout.pocketTrees do
		local cf = CFrame.new(pos.X, pos.Y, pos.Z)
		local accent = ACCENTS[(i % #ACCENTS) + 1]
		decoCylinder({
			name = "PocketPlanter", parent = pockets, diameter = P.planterDiameter, height = 1.1,
			cframe = cf * CFrame.new(0, 0.55, 0), color = Color3.fromRGB(240, 232, 214),
		})
		decoCylinder({
			name = "PocketPlanterRim", parent = pockets, diameter = P.planterDiameter + 0.4, height = 0.3,
			cframe = cf * CFrame.new(0, 1.1, 0), color = accent:Lerp(WHITE, 0.45),
		})
		decoCylinder({
			name = "PocketPlanterSoil", parent = pockets, diameter = P.planterDiameter - 0.4, height = 0.1,
			cframe = cf * CFrame.new(0, 1.25, 0), color = Color3.fromRGB(110, 80, 60),
		})
		MapKit.buildTree(pockets, pos + Vector3.new(0, 1.25, 0), P.treeScale)
	end
	for _, pos in CityLayout.pocketLamps do
		MapKit.buildLampPost(pockets, CFrame.new(pos))
	end
end

----------------------------------------------------------------------
-- Pocket parks behind the shops (lawn, trees, a bench, a flower bed)
----------------------------------------------------------------------

local function buildParks(city: Instance)
	local parksModel = makeModel("Parks", city)
	local P = CityLayout.Park
	local treeIndex = 0
	for k, park in CityLayout.parks do
		local model = makeModel(park.name, parksModel)
		local cf = park.cframe
		decoBlock({
			name = "ParkCurb", parent = model, size = Vector3.new(P.width + 1.2, P.top - 0.05, P.depth + 1.2),
			cframe = cf * CFrame.new(0, (P.top - 0.05) / 2, 0), color = Color3.fromRGB(250, 248, 240), canCollide = true,
		})
		decoBlock({
			name = "ParkLawn", parent = model, size = Vector3.new(P.width, P.top, P.depth),
			cframe = cf * CFrame.new(0, P.top / 2, 0), color = Color3.fromRGB(108, 200, 76), canCollide = true,
		})
		for j = 1, 3 do
			treeIndex += 1
			local pos = CityLayout.parkTrees[treeIndex]
			MapKit.buildTree(model, pos, if j == 3 then 1.6 else (if (k + j) % 2 == 0 then 1.25 else 1.05))
		end
		-- bench facing the plaza side of the lawn
		local bench = cf * CFrame.new(-3, P.top, -7)
		decoBlock({ name = "ParkBench", parent = model, size = Vector3.new(5.5, 0.55, 1.8), cframe = bench * CFrame.new(0, 1.35, 0), color = MapKit.WOOD })
		decoBlock({ name = "ParkBenchBack", parent = model, size = Vector3.new(5.5, 1.6, 0.45), cframe = bench * CFrame.new(0, 2.3, 0.8), color = MapKit.WOOD })
		-- round flower bed
		local bed = cf * CFrame.new(11, P.top, 5)
		decoCylinder({ name = "FlowerBed", parent = model, diameter = 4, height = 0.5, cframe = bed * CFrame.new(0, 0.25, 0), color = Color3.fromRGB(120, 80, 60) })
		local flowerColors = { ACCENTS[(k % 6) + 1], ACCENTS[((k + 2) % 6) + 1], WHITE }
		for f = 0, 2 do
			local a = math.rad(f * 120 + k * 20)
			decoBall({ name = "Flower", parent = model, diameter = 1.1, cframe = bed * CFrame.new(math.cos(a) * 0.9, 0.8, math.sin(a) * 0.9), color = flowerColors[f + 1] })
		end
	end
end

----------------------------------------------------------------------
-- Plaza buzz: food carts, balloon vendor, colored inlay + sunburst
----------------------------------------------------------------------

local CARTS = {
	IceCream = { color = Color3.fromRGB(255, 140, 200), label = "ICE CREAM" },
	HotDog = { color = Color3.fromRGB(235, 70, 70), label = "HOT DOGS" },
	Popcorn = { color = Color3.fromRGB(255, 210, 60), label = "POPCORN" },
	Drinks = { color = Color3.fromRGB(80, 210, 210), label = "DRINKS" },
}

local CART_ITEMS: { [string]: (Instance, CFrame) -> () } = {}

CART_ITEMS.IceCream = function(parent, cf)
	decoCylinder({ name = "ItemCone", parent = parent, diameter = 1.6, height = 3, cframe = cf * CFrame.new(0, 1.5, 0), color = Color3.fromRGB(226, 170, 100) })
	decoBall({ name = "ItemScoop", parent = parent, diameter = 3, cframe = cf * CFrame.new(0, 3.7, 0), color = Color3.fromRGB(255, 140, 200) })
	decoBall({ name = "ItemScoop", parent = parent, diameter = 2.6, cframe = cf * CFrame.new(0, 5.8, 0), color = Color3.fromRGB(170, 240, 210) })
	decoBall({ name = "ItemCherry", parent = parent, diameter = 0.9, cframe = cf * CFrame.new(0, 7.3, 0), color = Color3.fromRGB(235, 40, 60) })
end

CART_ITEMS.HotDog = function(parent, cf)
	decoBlock({ name = "ItemBun", parent = parent, size = Vector3.new(5, 1, 2), cframe = cf * CFrame.new(0, 0.5, 0), color = Color3.fromRGB(230, 170, 90) })
	decoCylinder({ name = "ItemSausage", parent = parent, diameter = 1.4, height = 5.6, axis = "X", cframe = cf * CFrame.new(0, 1.3, 0), color = Color3.fromRGB(200, 80, 60) })
	decoBlock({ name = "ItemMustard", parent = parent, size = Vector3.new(4.4, 0.25, 0.4), cframe = cf * CFrame.new(0, 2.05, 0), color = Color3.fromRGB(255, 220, 40), material = Enum.Material.Neon })
end

CART_ITEMS.Popcorn = function(parent, cf)
	decoCylinder({ name = "ItemBucket", parent = parent, diameter = 3, height = 3, cframe = cf * CFrame.new(0, 1.5, 0), color = Color3.fromRGB(235, 60, 60) })
	decoCylinder({ name = "ItemBucketStripe", parent = parent, diameter = 3.05, height = 1, cframe = cf * CFrame.new(0, 1.5, 0), color = WHITE })
	for _, off in { Vector3.new(0, 3.4, 0), Vector3.new(0.8, 3.1, 0.5), Vector3.new(-0.8, 3.1, -0.4), Vector3.new(0.3, 3.2, -0.9), Vector3.new(-0.4, 3.9, 0.6) } do
		decoBall({ name = "ItemPopcorn", parent = parent, diameter = 1.2, cframe = cf * CFrame.new(off), color = Color3.fromRGB(255, 244, 200) })
	end
end

CART_ITEMS.Drinks = function(parent, cf)
	decoCylinder({ name = "ItemCup", parent = parent, diameter = 2, height = 3.5, cframe = cf * CFrame.new(0, 1.75, 0), color = Color3.fromRGB(80, 210, 210) })
	decoCylinder({ name = "ItemLid", parent = parent, diameter = 2.2, height = 0.3, cframe = cf * CFrame.new(0, 3.6, 0), color = WHITE })
	decoBlock({
		name = "ItemStraw", parent = parent, size = Vector3.new(0.3, 3, 0.3),
		cframe = cf * CFrame.new(0.3, 4.9, 0) * CFrame.Angles(0, 0, math.rad(-15)), color = Color3.fromRGB(255, 110, 190), material = Enum.Material.Neon,
	})
end

local function buildFoodCart(parent: Instance, prop)
	local cart = CARTS[prop.kind]
	if not cart then
		return
	end
	local model = makeModel("FoodCart" .. prop.kind, parent)
	local cf = facingCFrame(Vector3.new(prop.position.X, 0, prop.position.Z).Magnitude, prop.angle, prop.position.Y)
	-- the cart faces the plaza center (-Z): tangential 6 wide, radial 3.4 deep
	makeBlock({ name = "CartBody", parent = model, size = Vector3.new(6, 3, 3.4), cframe = cf * CFrame.new(0, 2.3, 0), color = cart.color })
	decoBlock({ name = "CartTop", parent = model, size = Vector3.new(6.4, 0.4, 3.8), cframe = cf * CFrame.new(0, 4, 0), color = WHITE })
	decoBlock({ name = "CartStripe", parent = model, size = Vector3.new(6.05, 0.5, 3.45), cframe = cf * CFrame.new(0, 3.2, 0), color = WHITE })
	for _, z in { -1.95, 1.95 } do
		decoCylinder({ name = "CartWheel", parent = model, diameter = 2.2, height = 0.5, axis = "Z", cframe = cf * CFrame.new(-1.6, 1.1, z), color = MapKit.WHEEL_DARK })
	end
	decoBlock({ name = "CartLeg", parent = model, size = Vector3.new(0.4, 0.9, 2.8), cframe = cf * CFrame.new(2.4, 0.45, 0), color = POLE })
	local plate = decoBlock({ name = "CartSign", parent = model, size = Vector3.new(4.6, 1.1, 0.2), cframe = cf * CFrame.new(0, 2.1, -1.8), color = WHITE })
	addSurfaceText(plate, cart.label, Enum.Font.FredokaOne, cart.color, Enum.NormalId.Front, 30, WHITE)
	-- umbrella: pole + white disc + accent disc + finial
	decoCylinder({ name = "UmbrellaPole", parent = model, diameter = 0.3, height = 9, cframe = cf * CFrame.new(1.8, 8.7, 0.6), color = POLE })
	decoCylinder({ name = "UmbrellaCanopy", parent = model, diameter = 8, height = 0.4, cframe = cf * CFrame.new(1.8, 12.9, 0.6), color = WHITE, castShadow = true })
	decoCylinder({ name = "UmbrellaTop", parent = model, diameter = 6, height = 0.5, cframe = cf * CFrame.new(1.8, 13.3, 0.6), color = cart.color })
	decoBall({ name = "UmbrellaFinial", parent = model, diameter = 0.7, cframe = cf * CFrame.new(1.8, 13.7, 0.6), color = WHITE })
	-- giant item on the counter (front-left of the umbrella pole)
	local itemBuilder = CART_ITEMS[prop.kind]
	if itemBuilder then
		itemBuilder(model, cf * CFrame.new(-1.6, 4.2, -0.2))
	end
end

local function buildBalloonVendor(parent: Instance, prop)
	local model = makeModel("BalloonVendor", parent)
	local base = CFrame.new(prop.position)
	decoCylinder({ name = "BalloonWeight", parent = model, diameter = 1.6, height = 0.6, cframe = base * CFrame.new(0, 0.3, 0), color = POLE })
	decoCylinder({ name = "BalloonPole", parent = model, diameter = 0.3, height = 8, cframe = base * CFrame.new(0, 4.3, 0), color = POLE })
	local colors = {
		Color3.fromRGB(255, 70, 70), Color3.fromRGB(255, 160, 40), Color3.fromRGB(255, 220, 50),
		Color3.fromRGB(100, 220, 90), Color3.fromRGB(70, 180, 255), Color3.fromRGB(160, 110, 255),
		Color3.fromRGB(255, 120, 200),
	}
	local tie = Vector3.new(0, 8.3, 0)
	for i, color in colors do
		local a = math.rad(i * 360 / #colors)
		local radius = if i % 2 == 0 then 2.2 else 1.4
		local pos = Vector3.new(math.cos(a) * radius, 10 + (i % 3) * 1.1, math.sin(a) * radius)
		decoBall({ name = "Balloon", parent = model, diameter = 2, cframe = base * CFrame.new(pos), color = color, reflectance = 0.1 })
		local from, to = tie, pos - Vector3.new(0, 1, 0)
		local mid = (from + to) / 2
		local dir = (to - from)
		decoBlock({
			name = "BalloonString", parent = model, size = Vector3.new(0.1, dir.Magnitude, 0.1),
			cframe = base * CFrame.new(mid) * CFrame.fromAxisAngle(Vector3.new(dir.Z, 0, -dir.X).Unit, math.acos(dir.Unit.Y)),
			color = WHITE,
		})
	end
end

local function buildPlazaBuzz(city: Instance)
	local buzz = makeModel("PlazaBuzz", city)
	-- Colored inlay on the plaza floor (thin non-colliding discs, no height change)
	local peach = Color3.fromRGB(255, 186, 140)
	local cream = Color3.fromRGB(247, 238, 214)
	-- Layers are >= 0.03 apart so they never z-fight at a distance.
	for _, disc in { { r = 50, top = 1.54, color = peach }, { r = 44, top = 1.58, color = cream }, { r = 24, top = 1.62, color = peach } } do
		decoCylinder({
			name = "PlazaInlay", parent = buzz, diameter = disc.r * 2, height = 0.06,
			cframe = CFrame.new(0, disc.top - 0.03, 0), color = disc.color,
		})
	end
	-- Sunburst: 16 triangular rays across the cream ring (apex at r 26, an
	-- 8-stud base at r 43), alternating colors. Each ray is two WedgeParts
	-- laid flat (rolled 90 degrees so the wedge profile lies in the floor).
	local rayColors = { Color3.fromRGB(255, 158, 112), Color3.fromRGB(112, 214, 200) }
	for i = 0, 15 do
		local rayCF = facingCFrame(34.5, 11.25 + i * 22.5, 1.59) -- top 1.61: over the cream ring
		for _, side in { -1, 1 } do
			decoWedge({
				name = "PlazaRay", parent = buzz, size = Vector3.new(0.04, 4, 17),
				cframe = rayCF * CFrame.new(side * 2, 0, 0) * CFrame.Angles(0, 0, -side * RAD_90),
				color = rayColors[i % 2 + 1],
			})
		end
	end
	for _, prop in CityLayout.plazaProps do
		if prop.kind == "BalloonVendor" then
			buildBalloonVendor(buzz, prop)
		else
			buildFoodCart(buzz, prop)
		end
	end
	-- Raised round flower planters: candy-colored wall (collides), white rim,
	-- soil, a tree and a ring of six flower heads.
	local planterColors = {
		Color3.fromRGB(255, 150, 135), -- coral
		Color3.fromRGB(150, 226, 190), -- mint
		Color3.fromRGB(255, 228, 140), -- butter
		Color3.fromRGB(140, 192, 255), -- sky
		Color3.fromRGB(255, 170, 210), -- bubblegum
	}
	for _, planter in CityLayout.plazaPlanters do
		local model = makeModel("PlazaPlanter", buzz)
		local base = CFrame.new(planter.position) -- on the plaza floor
		makeCylinder({
			name = "PlanterWall", parent = model, diameter = 9, height = 2.4,
			cframe = base * CFrame.new(0, 1.2, 0), color = planterColors[(planter.colorIndex - 1) % #planterColors + 1],
		})
		decoCylinder({
			name = "PlanterRim", parent = model, diameter = 9.6, height = 0.4,
			cframe = base * CFrame.new(0, 2.4, 0), color = WHITE,
		})
		decoCylinder({
			name = "PlanterSoil", parent = model, diameter = 8.2, height = 0.2,
			cframe = base * CFrame.new(0, 2.7, 0), color = Color3.fromRGB(110, 80, 60),
		})
		MapKit.buildTree(model, planter.position + Vector3.new(0, 2.8, 0), 0.9)
		for f = 0, 5 do
			local a = math.rad(f * 60 + 30)
			decoBall({
				name = "Flower", parent = model, diameter = 1.4,
				cframe = base * CFrame.new(math.cos(a) * 3, 3.3, math.sin(a) * 3),
				color = FLOWER_COLORS[(planter.colorIndex + f) % #FLOWER_COLORS + 1],
			})
		end
	end
end

----------------------------------------------------------------------
-- Public API
----------------------------------------------------------------------

-- Builds SideHustleMap.City under `map` (call once per map build).
function CityBuilder.build(map: Instance): Model
	local city = makeModel("City", map)
	buildStreet(city)
	buildSkyline(city)
	buildShops(city)
	buildAnchors(city)
	buildFurniture(city)
	buildGapBlocks(city)
	buildParks(city)
	buildBackPockets(city)
	buildPlazaBuzz(city)
	return city
end

-- Exposed for unit use (not required by the map).
CityBuilder.SIDEWALK_COLOR = SIDEWALK

return CityBuilder
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="27">
        <Properties>
          <string name="Name">MapBuilder</string>
          <string name="Source"><![CDATA[--!nonstrict
-- MapBuilder (v3 "downtown"): constructs the entire Side Hustle Simulator world
-- from primitives (Blocks / Balls / Cylinders / Wedges only — no meshes, no
-- Toolbox, no asset ids) plus Terrain, Lighting, PointLights and ParticleEmitters.
--
-- Contract (ARCHITECTURE.md "Map contract" + "Graphics"):
--   Workspace.SideHustleMap (Folder)
--     Ground (Model: terrain-backed island; road-side signposts)
--     Plaza (Model with SpawnLocation on a gold medallion + a painted START mat
--       (SpawnWelcomeMat deck), ground/street discs incl. the Back Avenue, coin fountain
--       with the spinning "SpinCoin" model (CitySpin), cobalt lamps with pennant bunting)
--     Zones (Folder) > <ZoneId> (Model, attribute ZoneId)
--       HustleStation (Model)
--         PromptPart (Part) > ProximityPrompt "HustlePrompt"
--           (ActionText zone.HustleVerb.."!", ObjectText zone.Name,
--            HoldDuration = zone.HoldDuration, MaxActivationDistance 12, no LoS)
--         FeedbackPart (Part, invisible, ~6 studs above the counter; client billboard)
--         AutoAnchor (Part, invisible, beside the counter, facing it; client rig)
--       MechanicProp (Model) — static dressing that tells the mechanic from afar
--       Dressing (Model) — themed clutter on the pad (World/ZoneDressing)
--       EntranceLamp (Model) x2 — lamp posts at zone-local (+-16, -35) in the zone's colors
--       Gate (Model, only UnlockLevel > 1) > GateWall / GatePost / SignPart (BillboardGui)
--     City (Model) — the downtown (World/CityBuilder, laid out by Shared/CityLayout):
--       Street (painted lane dashes on MarkingDeck decks, curbs, crosswalks, yellow-head
--       traffic lights on cobalt masts), Skyline (48 buildings incl. 6
--       landmark hero towers + 24 rowhouses), Shops (16 storefronts), Anchors (a landmark
--       behind every zone, spinning rooftop icon), Furniture, GapBlocks (cafés on checkered
--       terrace rugs, street trees), Parks, BackPockets (trees + lamps), PlazaBuzz
--   Every zone is placed with Mechanics.zoneGroundCFrame(zone.Order) so the
--   client's nearest-zone lookup matches the world exactly. No UnlockPrompt.
--
-- Graphics: Lighting (Technology = Future is set by the Rojo project) with
-- Atmosphere, SunRays, Bloom, ColorCorrection and the built-in Sky; a Terrain
-- island (warm cream Pavement city ground, a thin Grass belt at the rim, Sand
-- beach, a shallow Water ring over a sand seabed; terrain material colors are
-- set here); per-zone materials; ParticleEmitters that keep the default sparkle
-- texture; warm PointLights in lamps and behind neon signs. Bright and cartoony.
--
-- Heights: the terrain top is world Y = 0. The ground is stacked discs
-- (Shared/CityLayout.Street): Back Avenue edges 0.08 / asphalt 0.12 / edge 0.16,
-- city-block ground 0.2, white trim 0.3, outer sidewalk top ROAD_TOP (0.5),
-- asphalt 0.6, inner sidewalk 0.75, plaza rim 1.3, plaza floor and every zone
-- pad PAD_TOP.
--
-- MapBuilder.build() is idempotent: it returns early if the map already exists
-- and every Lighting child is found by name/class before one is created.
-- Terrain runs once per server start (inside build) and is a handful of big
-- fills (well under 1s). Part count is ~4,340 incl. invisible markers
-- (round-5 envelope: <= 4,400 map parts; <= 7,000 with the client-life
-- preview). Far faces carry painted SurfaceGui windows (MapKit.paintBands)
-- instead of part bands, and every lane dash is painted (MapKit.makeGroundDeck).

local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local GameConfig = require(ReplicatedStorage.Shared.GameConfig)
local Mechanics = require(ReplicatedStorage.Shared.Mechanics)
local CityLayout = require(ReplicatedStorage.Shared.CityLayout)
local MapKit = require(script.Parent.MapKit)
local CityBuilder = require(script.Parent.CityBuilder)
local ZoneDressing = require(script.Parent.ZoneDressing)

local makeBlock = MapKit.makeBlock
local makeBall = MapKit.makeBall
local makeCylinder = MapKit.makeCylinder
local makeWedge = MapKit.makeWedge
local makeModel = MapKit.makeModel
local makeMarker = MapKit.makeMarker
local makeTextLabel = MapKit.makeTextLabel
local addSurfaceText = MapKit.addSurfaceText
local addPointLight = MapKit.addPointLight
local ringPos = MapKit.ringPos

local MapBuilder = {}

----------------------------------------------------------------------
-- Layout constants (terrain top / ground is world Y = 0)
----------------------------------------------------------------------

local STREET = CityLayout.Street
local PAD_SIZE = 64
local PAD_TOP = 1.5 -- top of plaza disc and of every zone pad
local ROAD_TOP = STREET.OuterSidewalkTop -- 0.5: outer sidewalk (entrance lamps, signposts)
-- Outer sidewalk disc: reaches 2 studs under the front edge of every pad
-- (pad front = ZoneRadius - PAD_SIZE / 2 = 118 with the default config).
local ROAD_RADIUS = STREET.OuterSidewalkRadius
local PLAZA_RADIUS = STREET.PlazaRadius
local LAMP_RADIUS = 44 -- plaza lamp ring (string lights run between them)

-- Island rings (laid out for the default ZoneRadius 150: pads cover radius
-- 118 .. 185 around each zone axis, the skyline reaches r 307).
local CITY_GROUND_RADIUS = 314 -- Pavement city ground (terrain top Y = 0)
local ISLAND_RADIUS = 330 -- thin Grass belt between the city and the beach
local BEACH_RADIUS = 360 -- sand rim (terrain top Y = 0)
local WATER_HALF = 700 -- half-size of the water square
local WATER_TOP = -2 -- water surface sits a little below the beach
local SEABED_TOP = -10 -- sand floor under the water

local RAD_90 = MapKit.RAD_90

-- Shared palette
local NAVY = MapKit.NAVY -- text outlines, tires, the gate lock panel and darkened tints only
local WHITE = MapKit.WHITE
local NEON_WHITE = MapKit.NEON_WHITE
local zoneSignFace = MapKit.zoneSignFace
local CREAM = MapKit.CREAM
local WOOD = MapKit.WOOD
local DARK_WOOD = MapKit.DARK_WOOD
local PAVEMENT_CREAM = Color3.fromRGB(226, 216, 200)
local SIDEWALK = Color3.fromRGB(236, 226, 208)
local CURB_WHITE = Color3.fromRGB(250, 248, 240)
local STONE = Color3.fromRGB(225, 214, 188)
local STONE_LIGHT = Color3.fromRGB(242, 236, 222)
local METAL_DARK = MapKit.METAL_DARK
local WHEEL_DARK = MapKit.WHEEL_DARK
local LEAF_GREEN = MapKit.LEAF_GREEN

local FLOWER_COLORS = MapKit.FLOWER_COLORS
-- Stock Desk "screen" / body color (a local override of its near-black
-- AccentColor; ZoneDressing's ticker pillars use MapKit.STOCK_DEEP_GREEN too)
local STOCK_DEEP_GREEN = MapKit.STOCK_DEEP_GREEN

----------------------------------------------------------------------
-- Primitive helpers
----------------------------------------------------------------------

-- Invisible anchored part that carries a ProximityPrompt (keeps CanQuery so
-- the prompt behaves like any other prompt part).
local function makePromptPart(parent: Instance, cf: CFrame): Part
	local part = Instance.new("Part")
	part.Name = "PromptPart"
	part.Size = Vector3.new(2, 2, 2)
	part.CFrame = cf
	part.Transparency = 1
	part.CanCollide = false
	part.CanTouch = false
	part.CastShadow = false
	part.Anchored = true
	part.Parent = parent
	return part
end

local function makePrompt(
	parent: BasePart,
	name: string,
	actionText: string,
	objectText: string,
	holdDuration: number,
	maxDistance: number
): ProximityPrompt
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = name
	prompt.ActionText = actionText
	prompt.ObjectText = objectText
	prompt.HoldDuration = holdDuration
	prompt.MaxActivationDistance = maxDistance
	prompt.RequiresLineOfSight = false
	prompt.Parent = parent
	return prompt
end

type ParticleProps = {
	color: ColorSequence,
	size: NumberSequence,
	transparency: NumberSequence?,
	rate: number,
	lifetime: NumberRange,
	speed: NumberRange,
	spread: Vector2?,
	acceleration: Vector3?,
	lightEmission: number?,
	drag: number?,
	rotSpeed: NumberRange?,
}

-- The face of a part that currently points closest to world up. Cylinders
-- built upright are rotated 90 degrees about Z, so their "Top" points along
-- world X; emitters use this so smoke / sparkle always rises.
local FACE_NORMALS: { { face: Enum.NormalId, normal: Vector3 } } = {
	{ face = Enum.NormalId.Top, normal = Vector3.new(0, 1, 0) },
	{ face = Enum.NormalId.Bottom, normal = Vector3.new(0, -1, 0) },
	{ face = Enum.NormalId.Right, normal = Vector3.new(1, 0, 0) },
	{ face = Enum.NormalId.Left, normal = Vector3.new(-1, 0, 0) },
	{ face = Enum.NormalId.Back, normal = Vector3.new(0, 0, 1) },
	{ face = Enum.NormalId.Front, normal = Vector3.new(0, 0, -1) },
}

local function upwardFace(part: BasePart): Enum.NormalId
	local best = Enum.NormalId.Top
	local bestY = -math.huge
	for _, entry in FACE_NORMALS do
		local worldY = part.CFrame:VectorToWorldSpace(entry.normal).Y
		if worldY > bestY then
			best = entry.face
			bestY = worldY
		end
	end
	return best
end

-- ParticleEmitter that keeps the engine default (sparkle) texture.
local function addParticles(parent: BasePart, name: string, props: ParticleProps): ParticleEmitter
	local emitter = Instance.new("ParticleEmitter")
	emitter.Name = name
	emitter.Color = props.color
	emitter.Size = props.size
	emitter.Transparency = props.transparency or NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.2),
		NumberSequenceKeypoint.new(0.7, 0.4),
		NumberSequenceKeypoint.new(1, 1),
	})
	emitter.Rate = props.rate
	emitter.Lifetime = props.lifetime
	emitter.Speed = props.speed
	emitter.SpreadAngle = props.spread or Vector2.new(25, 25)
	emitter.Acceleration = props.acceleration or Vector3.new(0, 1.5, 0)
	emitter.LightEmission = if props.lightEmission ~= nil then props.lightEmission else 0.8
	emitter.LightInfluence = 0.2
	emitter.Drag = props.drag or 0.5
	emitter.RotSpeed = props.rotSpeed or NumberRange.new(-40, 40)
	emitter.Rotation = NumberRange.new(0, 360)
	emitter.EmissionDirection = upwardFace(parent)
	emitter.Parent = parent
	return emitter
end

-- Gentle two-color sparkle preset (motes drifting up).
local function addSparkle(parent: BasePart, name: string, colorA: Color3, colorB: Color3, rate: number, sizeMin: number, sizeMax: number)
	addParticles(parent, name, {
		color = ColorSequence.new(colorA, colorB),
		size = NumberSequence.new(sizeMin, sizeMax),
		rate = rate,
		lifetime = NumberRange.new(1.2, 2.0),
		speed = NumberRange.new(0.6, 1.6),
		lightEmission = 1,
	})
end

-- Chunky sign board with SurfaceGui text (navy-outlined, see MapKit), a neon
-- underline (`glowColor`, default white) and a glow light in the board color.
-- Zone name boards: signature-colored face (MapKit.zoneSignFace) + WHITE text.
local function addSignBoard(
	parent: Instance,
	cf: CFrame,
	width: number,
	height: number,
	text: string,
	boardColor: Color3,
	textColor: Color3,
	glowColor: Color3?
): Part
	local board = makeBlock({
		name = "NameBoard",
		parent = parent,
		size = Vector3.new(width, height, 0.5),
		cframe = cf,
		color = boardColor,
	})
	addSurfaceText(board, text, Enum.Font.FredokaOne, textColor, Enum.NormalId.Front, nil, boardColor)
	makeBlock({
		name = "NameBoardGlow", parent = parent, size = Vector3.new(width + 0.4, 0.3, 0.6),
		cframe = cf * CFrame.new(0, -height / 2 - 0.15, 0), color = glowColor or NEON_WHITE,
		material = Enum.Material.Neon, canCollide = false,
	})
	addPointLight(board, boardColor, 12, 0.6)
	return board
end

----------------------------------------------------------------------
-- Lighting: bright cheerful day, soft blue haze, gentle bloom for the neon
----------------------------------------------------------------------

-- Returns the Lighting child with this name (and class), else any existing
-- instance of that class (so a place that already has e.g. a Bloom never ends
-- up with two stacked), else a new one. Properties are (re)applied by the
-- caller so repeat runs converge.
local function ensureLightingChild(className: string, name: string): Instance
	local existing = Lighting:FindFirstChild(name)
	if existing and existing.ClassName == className then
		return existing
	end
	local byClass = Lighting:FindFirstChildOfClass(className)
	if byClass then
		return byClass
	end
	local child = Instance.new(className)
	child.Name = name
	child.Parent = Lighting
	return child
end

local function setupLighting()
	-- Technology = Future comes from default.project.json (not scriptable).
	Lighting.ClockTime = 13
	Lighting.Brightness = 2.6
	Lighting.GlobalShadows = true
	Lighting.ShadowSoftness = 0.6
	Lighting.EnvironmentDiffuseScale = 0.85
	Lighting.EnvironmentSpecularScale = 0.6
	-- Warm, bright fill so shaded facades stay sunny pastel instead of going
	-- khaki / maroon (the sun is nearly overhead at ClockTime 13).
	Lighting.Ambient = Color3.fromRGB(162, 154, 146)
	Lighting.OutdoorAmbient = Color3.fromRGB(206, 198, 188)
	Lighting.ExposureCompensation = 0.15

	local atmosphere = ensureLightingChild("Atmosphere", "SideHustleAtmosphere") :: Atmosphere
	-- Light, crisp air: the far half of the downtown ring keeps its candy
	-- colors against a blue sky instead of bleaching into haze.
	atmosphere.Density = 0.2
	atmosphere.Offset = 0.2
	atmosphere.Color = Color3.fromRGB(199, 222, 255)
	atmosphere.Decay = Color3.fromRGB(255, 214, 170)
	atmosphere.Glare = 0.15
	atmosphere.Haze = 0.2

	local sunRays = ensureLightingChild("SunRaysEffect", "SideHustleSunRays") :: SunRaysEffect
	sunRays.Intensity = 0.08
	sunRays.Spread = 0.6

	-- Subtle: only the neon accents bloom, not the sunlit plastic.
	local bloom = ensureLightingChild("BloomEffect", "SideHustleBloom") :: BloomEffect
	bloom.Intensity = 0.35
	bloom.Size = 24
	bloom.Threshold = 1.5

	local colorCorrection = ensureLightingChild("ColorCorrectionEffect", "SideHustleColorCorrection") :: ColorCorrectionEffect
	colorCorrection.Saturation = 0.3
	colorCorrection.Contrast = 0.08
	colorCorrection.Brightness = 0.02
	colorCorrection.TintColor = Color3.fromRGB(255, 255, 255)

	local sky = ensureLightingChild("Sky", "SideHustleSky") :: Sky
	sky.SkyboxBk = "rbxasset://textures/sky/sky512_bk.tex"
	sky.SkyboxDn = "rbxasset://textures/sky/sky512_dn.tex"
	sky.SkyboxFt = "rbxasset://textures/sky/sky512_ft.tex"
	sky.SkyboxLf = "rbxasset://textures/sky/sky512_lf.tex"
	sky.SkyboxRt = "rbxasset://textures/sky/sky512_rt.tex"
	sky.SkyboxUp = "rbxasset://textures/sky/sky512_up.tex"
	sky.SunAngularSize = 18
	sky.MoonAngularSize = 8
	sky.StarCount = 0
	sky.CelestialBodiesShown = true
end

----------------------------------------------------------------------
-- Terrain: Pavement city island, thin grass belt, sand rim, water beyond
----------------------------------------------------------------------

local ISLAND_BOTTOM = -12

local function buildTerrain()
	local terrain = Workspace.Terrain
	terrain:Clear()

	local waterSize = WATER_HALF * 2
	-- Sand seabed, then shallow water above it (surface at WATER_TOP).
	terrain:FillBlock(
		CFrame.new(0, SEABED_TOP - 2, 0),
		Vector3.new(waterSize, 4, waterSize),
		Enum.Material.Sand
	)
	terrain:FillBlock(
		CFrame.new(0, (SEABED_TOP + WATER_TOP) / 2, 0),
		Vector3.new(waterSize, WATER_TOP - SEABED_TOP, waterSize),
		Enum.Material.Water
	)

	-- The island: Sand beach disc, a Grass belt, then the Pavement city
	-- ground on top. All span ISLAND_BOTTOM .. 0 so the terrain top is exactly
	-- world Y = 0. Pavement has no animated blades, so nothing can poke up
	-- through the street discs, pads or buildings.
	-- FillCylinder(cframe, height, radius, material); axis = cframe Y.
	local islandHeight = -ISLAND_BOTTOM
	local islandCF = CFrame.new(0, ISLAND_BOTTOM / 2, 0)
	terrain:FillCylinder(islandCF, islandHeight, BEACH_RADIUS, Enum.Material.Sand)
	terrain:FillCylinder(islandCF, islandHeight, ISLAND_RADIUS, Enum.Material.Grass)
	terrain:FillCylinder(islandCF, islandHeight, CITY_GROUND_RADIUS, Enum.Material.Pavement)
end

-- Terrain styling: warm cream pavement tiles, golden sand, bright grass and a
-- cartoon lagoon (bright turquoise, clear, small lazy waves). Kept out of
-- buildTerrain so a styling error can never trigger the ground fallback.
-- (Animated grass, Terrain.Decoration, is not scriptable: the Rojo project
-- sets it on the place.)
local function styleTerrain()
	local terrain = Workspace.Terrain
	terrain:SetMaterialColor(Enum.Material.Pavement, PAVEMENT_CREAM)
	terrain:SetMaterialColor(Enum.Material.Sand, Color3.fromRGB(250, 224, 156))
	terrain:SetMaterialColor(Enum.Material.Grass, Color3.fromRGB(108, 200, 76))
	terrain.WaterColor = Color3.fromRGB(52, 182, 230)
	terrain.WaterTransparency = 0.55
	terrain.WaterWaveSize = 0.18
	terrain.WaterWaveSpeed = 14
	terrain.WaterReflectance = 0.35
end

----------------------------------------------------------------------
-- Ground: the terrain island is the visible ground; this model holds the
-- beach / road-side decor (and a flat slab only if terrain generation failed)
----------------------------------------------------------------------

local function buildGround(map: Folder, terrainOk: boolean): Model
	local ground = makeModel("Ground", map)
	if not terrainOk then
		-- Fallback only: a flat pavement slab (top at Y = 0) so players never
		-- fall into the void if the terrain fills errored.
		makeCylinder({
			name = "FallbackGround", parent = ground, diameter = ISLAND_RADIUS * 2, height = 2,
			cframe = CFrame.new(0, -1, 0), color = PAVEMENT_CREAM,
		})
	end
	return ground
end

----------------------------------------------------------------------
-- Plaza pieces: lamp posts, benches, coin fountain, billboard, string lights
----------------------------------------------------------------------

local buildLampPost = MapKit.buildLampPost

local function buildBench(parent: Instance, cf: CFrame)
	makeBlock({
		name = "BenchSeat", parent = parent, size = Vector3.new(5.5, 0.55, 1.8),
		cframe = cf * CFrame.new(0, 1.35, 0), color = WOOD, material = Enum.Material.WoodPlanks,
	})
	for _, xOff in { -2.2, 2.2 } do
		makeBlock({
			name = "BenchLeg", parent = parent, size = Vector3.new(0.5, 1.1, 1.6),
			cframe = cf * CFrame.new(xOff, 0.55, 0), color = DARK_WOOD, material = Enum.Material.Wood,
		})
	end
	makeBlock({
		name = "BenchBack", parent = parent, size = Vector3.new(5.5, 1.6, 0.45),
		cframe = cf * CFrame.new(0, 2.3, 0.8) * CFrame.Angles(math.rad(-8), 0, 0), color = WOOD,
		material = Enum.Material.WoodPlanks,
	})
end

-- Giant spinning gold coin on a banded white column rising out of a marble
-- fountain (plaza centerpiece, coin center 21.5 studs up).
local function buildCoinFountain(parent: Instance)
	local gold = Color3.fromRGB(235, 184, 52)
	local brightGold = Color3.fromRGB(255, 215, 95)
	local bronze = Color3.fromRGB(110, 78, 28)
	local marble = Color3.fromRGB(226, 220, 206)
	local waterColor = Color3.fromRGB(110, 205, 235)

	-- Basin floor + translucent water disc
	makeCylinder({
		name = "FountainFloor", parent = parent, diameter = 22, height = 0.6,
		cframe = CFrame.new(0, PAD_TOP + 0.3, 0), color = marble, material = Enum.Material.Marble,
	})
	makeCylinder({
		name = "FountainWater", parent = parent, diameter = 20.4, height = 0.8,
		cframe = CFrame.new(0, PAD_TOP + 1.0, 0), color = waterColor,
		material = Enum.Material.Glass, transparency = 0.35, reflectance = 0.2, canCollide = false,
	})
	-- Rim: 12 chunky marble blocks in a ring (local X radial, Z tangential)
	for i = 0, 11 do
		local angle = math.rad(i * 30)
		local pos = Vector3.new(math.cos(angle) * 10.6, PAD_TOP + 0.75, math.sin(angle) * 10.6)
		makeBlock({
			name = "FountainRim", parent = parent, size = Vector3.new(1.3, 1.5, 5.8),
			cframe = CFrame.new(pos) * CFrame.Angles(0, -angle, 0), color = marble,
			material = Enum.Material.Marble,
		})
	end
	-- Four water jets (rising spray that falls back into the basin)
	for i = 0, 3 do
		local angle = math.rad(45 + i * 90)
		local jet = makeMarker(
			parent, "FountainJet",
			CFrame.new(math.cos(angle) * 6.8, PAD_TOP + 1.4, math.sin(angle) * 6.8),
			Vector3.new(0.6, 0.4, 0.6)
		)
		addParticles(jet, "Spray", {
			color = ColorSequence.new(Color3.fromRGB(190, 235, 255), Color3.fromRGB(255, 255, 255)),
			size = NumberSequence.new(0.5, 0.9),
			transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 0.25),
				NumberSequenceKeypoint.new(0.8, 0.5),
				NumberSequenceKeypoint.new(1, 1),
			}),
			rate = 7,
			lifetime = NumberRange.new(1.1, 1.4),
			speed = NumberRange.new(12, 15),
			spread = Vector2.new(6, 6),
			acceleration = Vector3.new(0, -22, 0),
			lightEmission = 0.4,
			drag = 0,
		})
	end

	-- Pedestal rising out of the water
	makeCylinder({
		name = "StatuePedestal", parent = parent, diameter = 10, height = 2,
		cframe = CFrame.new(0, PAD_TOP + 1, 0), color = Color3.fromRGB(205, 198, 182),
		material = Enum.Material.Marble,
	})
	makeCylinder({
		name = "StatuePedestalTop", parent = parent, diameter = 7.5, height = 1.5,
		cframe = CFrame.new(0, PAD_TOP + 2.75, 0), color = Color3.fromRGB(190, 182, 165),
		material = Enum.Material.Marble,
	})
	-- White column with gold bands lifting the coin 12 studs higher, so the
	-- hub's landmark reads over the traffic from every zone gate.
	local columnBottom, columnHeight = PAD_TOP + 2.75, 12
	makeCylinder({
		name = "StatueColumn", parent = parent, diameter = 4, height = columnHeight,
		cframe = CFrame.new(0, columnBottom + columnHeight / 2, 0), color = WHITE,
	})
	for _, f in { 0.25, 0.5, 0.75 } do
		makeCylinder({
			name = "StatueColumnBand", parent = parent, diameter = 4.6, height = 0.8,
			cframe = CFrame.new(0, columnBottom + columnHeight * f, 0), color = brightGold, canCollide = false,
		})
	end
	-- Giant gold coin standing on its edge (cylinder axis along X), scaled
	-- x1.4, grouped as Model "SpinCoin" (pivot = coin center) that the client
	-- city-life sim turns about world Y at CitySpin degrees/s.
	local scale = 1.4
	local coinY = PAD_TOP + 8 + 12
	local spin = makeModel("SpinCoin", parent)
	makeCylinder({
		name = "StatueCoin", parent = spin, diameter = 9 * scale, height = 1.4 * scale, axis = "X",
		cframe = CFrame.new(0, coinY, 0), color = gold, canCollide = false,
	})
	local coinCore = makeCylinder({
		name = "StatueCoinCore", parent = spin, diameter = 6 * scale, height = 1.5 * scale, axis = "X",
		cframe = CFrame.new(0, coinY, 0), color = brightGold,
		material = Enum.Material.Neon, canCollide = false,
	})
	addPointLight(coinCore, brightGold, 20, 0.7)
	-- Dollar-sign-ish bar + serifs across the coin face
	makeBlock({
		name = "StatueDollarBar", parent = spin, size = Vector3.new(1.7, 7.5, 1) * scale,
		cframe = CFrame.new(0, coinY, 0), color = bronze, canCollide = false,
	})
	makeBlock({
		name = "StatueDollarTop", parent = spin, size = Vector3.new(1.8, 0.8, 2.4) * scale,
		cframe = CFrame.new(0, coinY + 3.1 * scale, -0.6 * scale), color = bronze, canCollide = false,
	})
	makeBlock({
		name = "StatueDollarBottom", parent = spin, size = Vector3.new(1.8, 0.8, 2.4) * scale,
		cframe = CFrame.new(0, coinY - 3.1 * scale, 0.6 * scale), color = bronze, canCollide = false,
	})
	spin.WorldPivot = CFrame.new(0, coinY, 0)
	spin:SetAttribute("CitySpin", 40)
	-- Gentle gold sparkle above the coin
	local sparkle = makeMarker(parent, "CoinSparkle", CFrame.new(0, coinY + 5.6 * scale, 0), Vector3.new(7, 1.5, 3) * scale)
	addSparkle(sparkle, "GoldSparkle", brightGold, WHITE, 4, 0.4, 0.8)
end

local function buildTitleBillboard(parent: Instance)
	local baseCF = CFrame.lookAt(ringPos(47, 157.5), Vector3.new(0, 0, 0))
	local postColor = Color3.fromRGB(60, 62, 110)
	for _, xOff in { -9, 9 } do
		makeBlock({
			name = "BillboardPost", parent = parent, size = Vector3.new(1.2, 9, 1.2),
			cframe = baseCF * CFrame.new(xOff, PAD_TOP + 4.5, 0), color = postColor,
			material = Enum.Material.Metal,
		})
	end
	local gold = Color3.fromRGB(255, 206, 40)
	local board = makeBlock({
		name = "BillboardBoard", parent = parent, size = Vector3.new(24, 7, 1),
		cframe = baseCF * CFrame.new(0, PAD_TOP + 11.5, 0), color = gold,
	})
	-- White neon marquee around the gold board
	local trim = NEON_WHITE
	for _, yOff in { -3.8, 3.8 } do
		makeBlock({
			name = "BillboardTrim", parent = parent, size = Vector3.new(25.2, 0.6, 1.2),
			cframe = baseCF * CFrame.new(0, PAD_TOP + 11.5 + yOff, 0), color = trim,
			material = Enum.Material.Neon, canCollide = false,
		})
	end
	for _, xOff in { -12.3, 12.3 } do
		makeBlock({
			name = "BillboardTrim", parent = parent, size = Vector3.new(0.6, 8.2, 1.2),
			cframe = baseCF * CFrame.new(xOff, PAD_TOP + 11.5, 0), color = trim,
			material = Enum.Material.Neon, canCollide = false,
		})
	end
	addSurfaceText(board, "SIDE HUSTLE\nSIMULATOR", Enum.Font.LuckiestGuy, WHITE, Enum.NormalId.Front, nil, gold)
	addPointLight(board, gold, 16, 0.7)
end

-- Festive bunting: a sagging white wire between each pair of plaza lamp
-- posts (two straight segments per span) hung with point-down pennant flags
-- in cycling candy colors (one WedgePart each, top edge on the wire).
local PENNANT_COLORS = {
	Color3.fromRGB(255, 90, 90),
	Color3.fromRGB(255, 212, 31),
	Color3.fromRGB(60, 200, 255),
	Color3.fromRGB(120, 220, 90),
	Color3.fromRGB(255, 110, 190),
}
local function buildStringLights(parent: Instance)
	-- Wire on the lamp poles just under the bulbs with a shallow sag: the
	-- lowest flag tip stays ~5.8 above the plaza floor (over players' heads).
	local wireY = PAD_TOP + 8.3
	local sagY = PAD_TOP + 7.5
	local flagIndex = 0
	for i = 0, 5 do
		local p0 = ringPos(LAMP_RADIUS, 10 + i * 60, wireY)
		local p1 = ringPos(LAMP_RADIUS, 10 + (i + 1) * 60, wireY)
		local mid = (p0 + p1) / 2
		mid = Vector3.new(mid.X, sagY, mid.Z)
		for _, segment in { { p0, mid }, { mid, p1 } } do
			local from, to = segment[1], segment[2]
			local length = (to - from).Magnitude
			makeBlock({
				name = "StringWire", parent = parent, size = Vector3.new(0.18, 0.18, length),
				cframe = CFrame.lookAt((from + to) / 2, to), color = WHITE,
				canCollide = false, castShadow = false,
			})
			for k = 1, 5 do
				local pos = from:Lerp(to, k / 6)
				flagIndex += 1
				-- Wire frame (local Z along the wire, Y up), flag hung 0.95 below
				-- it and rolled 180 degrees so the wedge's long edge is on top.
				makeWedge({
					name = "Pennant", parent = parent, size = Vector3.new(0.12, 1.8, 1.4),
					cframe = CFrame.lookAt(pos, pos + (to - from)) * CFrame.new(0, -0.95, 0) * CFrame.Angles(0, 0, math.pi),
					color = PENNANT_COLORS[(flagIndex - 1) % #PENNANT_COLORS + 1],
					canCollide = false, castShadow = false,
				})
			end
		end
	end
end

-- Low green mound with a few tiny neon flowers on top.
local function buildFlowerCluster(parent: Instance, position: Vector3, seed: number)
	makeBall({
		name = "FlowerBed", parent = parent, diameter = 2.4,
		cframe = CFrame.new(position + Vector3.new(0, 0.5, 0)), color = LEAF_GREEN, canCollide = false,
	})
	local offsets = {
		Vector3.new(0.5, 1.35, 0.3),
		Vector3.new(-0.6, 1.3, 0.4),
		Vector3.new(0.1, 1.5, -0.6),
		Vector3.new(-0.3, 1.2, -0.1),
	}
	for i, offset in offsets do
		makeBall({
			name = "Flower", parent = parent, diameter = 0.55,
			cframe = CFrame.new(position + offset),
			color = FLOWER_COLORS[(seed + i - 1) % #FLOWER_COLORS + 1],
			material = Enum.Material.Neon, canCollide = false,
		})
	end
end

-- Painted START mat on the spawn slab (the very first thing a new player
-- sees): a sky-blue rounded mat with a white stroke, "START" in the half
-- nearer the fountain and a white chevron in the far half, both pointing at
-- the Lemonade Stand. Painted on an invisible ground deck lying on the slab
-- (MapKit.makeGroundDeck: the gui's up = the slab's -Z = its LookVector =
-- toward the starting zone, independent of Roblox's Top-face convention), so
-- the text reads upright from the default camera behind the player. The
-- deck is CanCollide / CanQuery / CanTouch false: the spawn stays clear.
local function buildWelcomeMat(parent: Instance, spawnLocation: BasePart)
	local size = spawnLocation.Size
	local deckCF = spawnLocation.CFrame * CFrame.new(0, size.Y / 2 + 0.03, 0)
	local _, gui = MapKit.makeGroundDeck(parent, "SpawnWelcomeMat", deckCF, size.X, size.Z, 40, "WelcomeMat", 0.4, 1.2)
	local mat = MapKit.makeGuiFrame({
		name = "Mat", parent = gui, anchor = Vector2.new(0.5, 0.5),
		position = UDim2.fromScale(0.5, 0.5), size = UDim2.fromScale(0.84, 0.84),
		color = Color3.fromRGB(100, 190, 255), corner = 0.12,
	})
	local matStroke = Instance.new("UIStroke")
	matStroke.Color = WHITE
	matStroke.Thickness = 8
	matStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	matStroke.LineJoinMode = Enum.LineJoinMode.Round
	matStroke.Parent = mat
	local label = MapKit.makeTextLabel(mat, "START", Enum.Font.LuckiestGuy, WHITE, UDim2.fromScale(0.07, 0.55), UDim2.fromScale(0.86, 0.34))
	label.ZIndex = 3
	local labelStroke = label:FindFirstChildOfClass("UIStroke")
	if labelStroke then
		labelStroke.Thickness = 6
	end
	-- chevron "^" (tip toward the gui top = the Lemonade Stand): two bars
	-- rotated -45 / +45 degrees whose inner ends overlap at the tip
	local barLength, barWidth = 0.34, 0.09
	local tipX, tipY = 0.5, 0.12
	local reach = (barLength / 2 - barWidth / 2) * math.sqrt(0.5)
	for _, side in { -1, 1 } do
		MapKit.makeGuiFrame({
			name = "Chevron", parent = mat, anchor = Vector2.new(0.5, 0.5),
			position = UDim2.fromScale(tipX + side * reach, tipY + barWidth * 0.5 + reach),
			size = UDim2.fromScale(barLength, barWidth), rotation = side * 45,
			color = WHITE, zIndex = 3,
		})
	end
end

local function buildPlaza(map: Folder)
	local plaza = makeModel("Plaza", map)

	-- Street: stacked SmoothPlastic discs (CityLayout.Street). From the
	-- outside in: the Back Avenue between the skyline rings (white edge ring
	-- r 270..270.6 top 0.08, asphalt r 250.6..270 top 0.12, white edge ring
	-- r 250..250.6 top 0.16), the city-block ground (r 122.5..250, top 0.2),
	-- white curb trim (top 0.3), outer sidewalk "RingRoad" (r 104..120, top
	-- ROAD_TOP 0.5), cartoon blue asphalt (r 66..104, top 0.6), inner sidewalk
	-- (r 58..66, top 0.75), then the plaza rim + floor. Every disc is 1 thick
	-- (or more) so tops stay >= 0.04 apart and never z-fight. Markings, curbs,
	-- crosswalks and traffic lights live in the City model.
	local backEdge = STREET.BackEdgeWidth
	for _, disc in {
		{ name = "BackEdgeOuter", radius = STREET.BackAsphaltOuter + backEdge, top = STREET.BackEdgeOuterTop, color = CURB_WHITE },
		{ name = "BackAsphalt", radius = STREET.BackAsphaltOuter, top = STREET.BackAsphaltTop, color = Color3.fromRGB(68, 72, 94) },
		{ name = "BackEdgeInner", radius = STREET.BackAsphaltInner + backEdge, top = STREET.BackEdgeInnerTop, color = CURB_WHITE },
		{ name = "BlockGround", radius = STREET.BlockGroundRadius, top = STREET.BlockGroundTop, color = SIDEWALK },
	} do
		makeCylinder({
			name = disc.name, parent = plaza, diameter = disc.radius * 2, height = 1,
			cframe = CFrame.new(0, disc.top - 0.5, 0), color = disc.color,
		})
	end
	makeCylinder({
		name = "RoadTrim", parent = plaza, diameter = STREET.OuterCurbRadius * 2, height = 1.8,
		cframe = CFrame.new(0, STREET.OuterCurbTop - 0.9, 0), color = CURB_WHITE,
	})
	makeCylinder({
		name = "RingRoad", parent = plaza, diameter = ROAD_RADIUS * 2, height = 2,
		cframe = CFrame.new(0, ROAD_TOP - 1, 0), color = SIDEWALK,
	})
	makeCylinder({
		name = "Asphalt", parent = plaza, diameter = STREET.AsphaltOuter * 2, height = 1,
		cframe = CFrame.new(0, STREET.AsphaltTop - 0.5, 0), color = Color3.fromRGB(68, 72, 94),
	})
	makeCylinder({
		name = "InnerSidewalk", parent = plaza, diameter = STREET.InnerSidewalkRadius * 2, height = 1,
		cframe = CFrame.new(0, STREET.InnerSidewalkTop - 0.5, 0), color = SIDEWALK,
	})
	-- Plaza disc (smooth cartoon stone) with a lighter step ring
	makeCylinder({
		name = "PlazaTrim", parent = plaza, diameter = (PLAZA_RADIUS + 3) * 2, height = 1.2,
		cframe = CFrame.new(0, 0.7, 0), color = STONE_LIGHT,
	})
	makeCylinder({
		name = "PlazaFloor", parent = plaza, diameter = PLAZA_RADIUS * 2, height = 1,
		cframe = CFrame.new(0, 1, 0), color = STONE,
	})

	-- Spawn (Neutral, plain — no decal clutter): on the plaza floor between
	-- the fountain and the starting zone, facing that zone so a new player's
	-- first view is their first hustle (the coin statue stays behind them).
	-- 12x1x12 slab resting on the floor top (Y PAD_TOP .. PAD_TOP + 1), its
	-- near edge 2.4 studs clear of the fountain rim (radius ~11.6).
	local startZone = GameConfig.getZone(GameConfig.StartingZoneId) or GameConfig.Zones[1]
	local startCenter = Mechanics.zoneCenter(startZone.Order)
	local spawnDir = Vector3.new(startCenter.X, 0, startCenter.Z).Unit
	local spawnPos = spawnDir * 20 + Vector3.new(0, PAD_TOP + 0.5, 0)
	local spawnLocation = Instance.new("SpawnLocation")
	spawnLocation.Name = "SpawnLocation"
	spawnLocation.Size = Vector3.new(12, 1, 12)
	spawnLocation.CFrame = CFrame.lookAt(spawnPos, spawnPos + spawnDir)
	spawnLocation.Color = Color3.fromRGB(236, 228, 205)
	spawnLocation.Material = Enum.Material.SmoothPlastic
	spawnLocation.Anchored = true
	spawnLocation.TopSurface = Enum.SurfaceType.Smooth
	spawnLocation.BottomSurface = Enum.SurfaceType.Smooth
	spawnLocation.Neutral = true
	spawnLocation.Duration = 0
	spawnLocation.Parent = plaza
	-- Gold spawn medallion: a flat disc under the slab (top 1.66, just over
	-- the r 24 plaza inlay at 1.62) + four neon strips on the slab's top
	-- edges. Flat, non-colliding, no shadows: the spawn stays unobstructed.
	local medallionGold = Color3.fromRGB(255, 206, 40)
	makeCylinder({
		name = "SpawnMedallion", parent = plaza, diameter = 17, height = 0.1,
		cframe = CFrame.new(spawnPos.X, PAD_TOP + 0.11, spawnPos.Z), color = medallionGold,
		canCollide = false, castShadow = false,
	})
	local slabTop = spawnLocation.CFrame * CFrame.new(0, 0.5 + 0.06, 0)
	for _, edge in { { 0, 5.825, 0 }, { 0, -5.825, 0 }, { 5.825, 0, 90 }, { -5.825, 0, 90 } } do
		makeBlock({
			name = "SpawnEdgeNeon", parent = plaza, size = Vector3.new(12.2, 0.12, 0.35),
			cframe = slabTop * CFrame.new(edge[1], 0, edge[2]) * CFrame.Angles(0, math.rad(edge[3]), 0),
			color = Color3.fromRGB(255, 236, 150), material = Enum.Material.Neon,
			canCollide = false, castShadow = false,
		})
	end
	buildWelcomeMat(plaza, spawnLocation)

	buildCoinFountain(plaza)

	-- Lamp posts around the plaza + string lights between them
	for i = 0, 5 do
		buildLampPost(plaza, CFrame.new(ringPos(LAMP_RADIUS, 10 + i * 60, PAD_TOP)))
	end
	buildStringLights(plaza)

	-- Benches facing the fountain
	for _, deg in { 55, 185, 300 } do
		local pos = ringPos(30, deg, PAD_TOP)
		buildBench(plaza, CFrame.lookAt(pos, Vector3.new(0, PAD_TOP, 0)))
	end

	-- Flower beds dotted around the plaza
	for i, deg in { 40, 100, 220, 280 } do
		buildFlowerCluster(plaza, ringPos(40, deg, PAD_TOP), i)
	end

	buildTitleBillboard(plaza)
end

----------------------------------------------------------------------
-- Shared zone pieces: hustle station + level gate
----------------------------------------------------------------------

type StationSpec = {
	pos: Vector3, -- counter center (zone-local, on the pad top)
	counter: boolean, -- build the generic counter (false when the zone prop is the counter)
	material: Enum.Material?,
	baseColor: Color3?,
	feedback: Vector3?, -- zone-local override for FeedbackPart
	anchor: Vector3?, -- zone-local override for AutoAnchor
	anchorLook: Vector3?, -- zone-local point the AutoAnchor faces
}

-- Neon accent for a zone: AccentColor, unless it is too dark to glow (Stock
-- Desk's accent is near-black), then the SignColor.
local function neonAccent(zone: GameConfig.ZoneDef): Color3
	local c = zone.AccentColor
	local luminance = 0.299 * c.R + 0.587 * c.G + 0.114 * c.B
	return if luminance < 0.25 then zone.SignColor else c
end

-- Default station layout around the counter center (zone-local offsets):
--   counter    7 wide base / 8 wide top, 3.5 tall, front face at -1.3 / -1.6
--   PromptPart 2.4 in front of the counter center at counter-top height
--   FeedbackPart 9.5 up = 6 studs above the counter top
--   AutoAnchor 8 to the side = 4.5 studs clear of the counter base, its
--     center 0.5 above the pad so its bottom rests on the pad (clients
--     raycast down from it and stand the rig on whatever they hit)
local DEFAULT_FEEDBACK_OFFSET = Vector3.new(0, 9.5, 0)
local DEFAULT_ANCHOR_OFFSET = Vector3.new(8, 0.5, 0)

local function buildHustleStation(zoneModel: Model, zoneCF: CFrame, zone: GameConfig.ZoneDef, spec: StationSpec)
	local station = makeModel("HustleStation", zoneModel)
	local baseCF = zoneCF * CFrame.new(spec.pos)
	if spec.counter then
		local material = spec.material or Enum.Material.SmoothPlastic
		makeBlock({
			name = "CounterBase", parent = station, size = Vector3.new(7, 3, 2.6),
			cframe = baseCF * CFrame.new(0, 1.5, 0), color = spec.baseColor or zone.SignColor,
			material = material,
		})
		makeBlock({
			name = "CounterTop", parent = station, size = Vector3.new(8, 0.5, 3.2),
			cframe = baseCF * CFrame.new(0, 3.25, 0), color = CREAM,
			material = if material == Enum.Material.WoodPlanks then material else Enum.Material.SmoothPlastic,
		})
		makeBlock({
			name = "CounterTrim", parent = station, size = Vector3.new(7.2, 0.6, 0.2),
			cframe = baseCF * CFrame.new(0, 1.5, -1.4), color = neonAccent(zone),
			material = Enum.Material.Neon, canCollide = false,
		})
		-- Verb plaque on the counter front ("WALK!", "TRADE!" ...)
		local plaque = makeBlock({
			name = "CounterPlaque", parent = station, size = Vector3.new(4.4, 1.0, 0.2),
			cframe = baseCF * CFrame.new(0, 2.5, -1.4), color = zoneSignFace(zone), canCollide = false,
		})
		addSurfaceText(plaque, string.upper(zone.HustleVerb) .. "!", Enum.Font.FredokaOne, WHITE, Enum.NormalId.Front, nil, plaque.Color)
	end

	-- The prompt (server connects HustlePrompt.Triggered)
	local promptPart = makePromptPart(station, baseCF * CFrame.new(0, 3, -2.4))
	makePrompt(promptPart, "HustlePrompt", zone.HustleVerb .. "!", zone.Name, zone.HoldDuration or 0, 12)

	-- FeedbackPart: ~6 studs above the counter top; the client parents its
	-- market needle / charge bar / combo BillboardGui here.
	local feedbackLocal = spec.feedback or (spec.pos + DEFAULT_FEEDBACK_OFFSET)
	makeMarker(station, "FeedbackPart", zoneCF * CFrame.new(feedbackLocal))

	-- AutoAnchor: at ground level beside the counter, on open pad (nothing
	-- overhead), facing it; the client stands the automation rig here.
	local anchorLocal = spec.anchor or (spec.pos + DEFAULT_ANCHOR_OFFSET)
	local lookLocal = spec.anchorLook or (spec.pos + Vector3.new(0, 0.5, 0))
	local anchorWorld = zoneCF:PointToWorldSpace(anchorLocal)
	local lookWorld = zoneCF:PointToWorldSpace(lookLocal)
	makeMarker(station, "AutoAnchor", CFrame.lookAt(anchorWorld, lookWorld))
end

local function buildGate(zoneModel: Model, zoneCF: CFrame, zone: GameConfig.ZoneDef)
	local gate = makeModel("Gate", zoneModel)
	-- Gate color: the signature color, except a near-white one (Startup HQ)
	-- whose white neon posts + bar + crest would blow out into a glare blob:
	-- then the AccentColor (MapKit.zoneSignFace).
	local gateColor = zoneSignFace(zone)

	-- Translucent zone-colored energy wall (client opens it per player)
	makeBlock({
		name = "GateWall", parent = gate, size = Vector3.new(26, 11, 1.2),
		cframe = zoneCF * CFrame.new(0, 5.5, -30.5), color = gateColor,
		material = Enum.Material.ForceField, transparency = 0.45, canCollide = true,
	})
	for _, xOff in { -13.4, 13.4 } do
		local post = makeBlock({
			name = "GatePost", parent = gate, size = Vector3.new(1.5, 12.5, 1.5),
			cframe = zoneCF * CFrame.new(xOff, 6.25, -30.5), color = gateColor,
			material = Enum.Material.Neon,
		})
		addPointLight(post, gateColor, 10, 0.5)
	end
	makeBlock({
		name = "GateTopBar", parent = gate, size = Vector3.new(28.5, 1, 1),
		cframe = zoneCF * CFrame.new(0, 12.2, -30.5), color = gateColor,
		material = Enum.Material.Neon, canCollide = false,
	})
	-- Grassy hedges sealing the pad's front edge out to its corners
	for _, xOff in { -23, 23 } do
		makeBlock({
			name = "GateHedge", parent = gate, size = Vector3.new(18, 2.6, 1.8),
			cframe = zoneCF * CFrame.new(xOff, 1.3, -30.5), color = LEAF_GREEN,
			material = Enum.Material.Grass,
		})
	end

	-- Level sign: a neon crest on the arch (SignPart, Y 12.9..15.5 above the
	-- pad) carrying a BillboardGui that floats just above it, readable from
	-- across the map. ZoneGateController hides the billboard once unlocked.
	local signPart = makeBlock({
		name = "SignPart", parent = gate, size = Vector3.new(11, 2.6, 0.9),
		cframe = zoneCF * CFrame.new(0, 14.2, -30.5), color = gateColor,
		material = Enum.Material.Neon, canCollide = false,
	})
	addPointLight(signPart, gateColor, 14, 0.6)
	local billboard = Instance.new("BillboardGui")
	billboard.Name = "GateSign"
	-- BillboardGui Size scale is in studs: an 18 x 5.6 stud sign whose bottom
	-- edge (offset 4.3 - 2.8 = 1.5 above the part center) clears the crest.
	billboard.Size = UDim2.fromScale(18, 5.6)
	billboard.StudsOffset = Vector3.new(0, 4.3, 0)
	billboard.MaxDistance = 400
	billboard.LightInfluence = 0
	billboard.AlwaysOnTop = false
	billboard.Parent = signPart

	-- A bright signature-colored badge (a near-black panel reads as a dead
	-- screen over the bright city). Near-white signatures (Startup HQ) use
	-- their accent so the white, navy-outlined text still reads.
	local sign = zone.SignColor
	local badgeColor = if 0.299 * sign.R + 0.587 * sign.G + 0.114 * sign.B > 0.8 then zone.AccentColor else sign
	local panel = Instance.new("Frame")
	panel.Name = "Panel"
	panel.Size = UDim2.fromScale(1, 1)
	panel.BackgroundColor3 = badgeColor
	panel.BackgroundTransparency = 0
	panel.BorderSizePixel = 0
	panel.Parent = billboard
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0.22, 0)
	corner.Parent = panel
	local border = Instance.new("UIStroke")
	border.Color = NAVY
	border.Thickness = 4
	border.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	border.Parent = panel
	local stripe = Instance.new("Frame")
	stripe.Name = "Stripe"
	stripe.AnchorPoint = Vector2.new(0.5, 0)
	stripe.Position = UDim2.fromScale(0.5, 0.56)
	stripe.Size = UDim2.fromScale(0.86, 0.04)
	stripe.BackgroundColor3 = WHITE
	stripe.BorderSizePixel = 0
	stripe.Parent = panel

	makeTextLabel(
		panel, zone.Name, Enum.Font.FredokaOne, WHITE,
		UDim2.fromScale(0.05, 0.06), UDim2.fromScale(0.9, 0.48)
	)
	makeTextLabel(
		panel, "\u{1F512} Reach Level " .. tostring(zone.UnlockLevel), Enum.Font.FredokaOne, WHITE,
		UDim2.fromScale(0.08, 0.62), UDim2.fromScale(0.84, 0.32)
	)
end

----------------------------------------------------------------------
-- Mechanic props: static dressing so each hustle reads from afar
-- (the live feedback is a client BillboardGui on FeedbackPart)
----------------------------------------------------------------------

-- Tap: big chunky neon button on the counter top ("SQUEEZE!" / "GRILL!").
-- cf = counter-top center (top surface), -Z toward the player; the counter
-- top is 3.2 deep, so its front lip is 1.6 in front of cf. `withLabel` adds a
-- verb plaque on that lip (stations with a generic counter already have one).
local function buildTapButton(parent: Instance, cf: CFrame, zone: GameConfig.ZoneDef, withLabel: boolean)
	local domeColor = if zone.Id == "FoodTruck" then zone.AccentColor else zone.SignColor
	makeCylinder({
		name = "TapButtonBase", parent = parent, diameter = 3.2, height = 0.7,
		cframe = cf * CFrame.new(0, 0.35, 0), color = METAL_DARK, material = Enum.Material.Metal,
	})
	makeCylinder({
		name = "TapButtonRim", parent = parent, diameter = 3.0, height = 0.2,
		cframe = cf * CFrame.new(0, 0.8, 0), color = WHITE, material = Enum.Material.Neon, canCollide = false,
	})
	local dome = makeBall({
		name = "TapButtonDome", parent = parent, diameter = 2.8,
		cframe = cf * CFrame.new(0, 1.0, 0), color = domeColor,
		material = Enum.Material.Neon, canCollide = false,
	})
	addPointLight(dome, domeColor, 9, 0.7)
	if withLabel then
		-- Flush against the front face of the counter-top lip, facing the player.
		local plate = makeBlock({
			name = "TapButtonLabel", parent = parent, size = Vector3.new(3.8, 1.1, 0.3),
			cframe = cf * CFrame.new(0, -0.25, -1.75), color = WHITE, canCollide = false,
		})
		addSurfaceText(plate, string.upper(zone.HustleVerb) .. "!", Enum.Font.LuckiestGuy, domeColor, Enum.NormalId.Front, nil, plate.Color)
	end
end

-- Hold (Dog Walking): a long sandy walking path with paw prints and
-- start/finish flags, running along X in front of the counter.
local function buildPawPath(parent: Instance, cf: CFrame, zone: GameConfig.ZoneDef)
	makeBlock({
		name = "WalkPath", parent = parent, size = Vector3.new(32, 0.3, 3.2),
		cframe = cf * CFrame.new(0, 0.35, 0), color = Color3.fromRGB(226, 208, 160),
		material = Enum.Material.Sand,
	})
	local pawColor = Color3.fromRGB(96, 66, 42)
	for i = 0, 6 do
		local pawCF = cf * CFrame.new(-12 + i * 4, 0.58, if i % 2 == 0 then -0.6 else 0.6)
		makeCylinder({
			name = "PawPad", parent = parent, diameter = 1.0, height = 0.16,
			cframe = pawCF, color = pawColor, canCollide = false,
		})
		for _, toe in { Vector3.new(-0.45, 0, -0.65), Vector3.new(0, 0, -0.8), Vector3.new(0.45, 0, -0.65) } do
			makeCylinder({
				name = "PawToe", parent = parent, diameter = 0.36, height = 0.14,
				cframe = pawCF * CFrame.new(toe), color = pawColor, canCollide = false,
			})
		end
	end
	for _, flag in { { x = -17, color = zone.SignColor }, { x = 17, color = WHITE } } do
		makeBlock({
			name = "FlagPost", parent = parent, size = Vector3.new(0.4, 3.4, 0.4),
			cframe = cf * CFrame.new(flag.x, 1.7, 0), color = DARK_WOOD, material = Enum.Material.Wood,
		})
		makeBlock({
			name = "Flag", parent = parent, size = Vector3.new(0.15, 1.1, 1.8),
			cframe = cf * CFrame.new(flag.x + 0.2, 2.85, 0.9), color = flag.color,
			material = Enum.Material.Neon, canCollide = false,
		})
	end
end

-- Hold (Car Wash): roller conveyor track running along X through the tunnel.
local function buildConveyor(parent: Instance, cf: CFrame, zone: GameConfig.ZoneDef)
	makeBlock({
		name = "ConveyorBase", parent = parent, size = Vector3.new(34, 0.5, 5),
		cframe = cf * CFrame.new(0, 0.25, 0), color = Color3.fromRGB(70, 72, 82),
		material = Enum.Material.DiamondPlate,
	})
	for i = 0, 8 do
		makeCylinder({
			name = "ConveyorRoller", parent = parent, diameter = 0.9, height = 4.6, axis = "Z",
			cframe = cf * CFrame.new(-16 + i * 4, 0.8, 0), color = Color3.fromRGB(120, 124, 136),
			material = Enum.Material.Metal,
		})
	end
	for _, zOff in { -2.7, 2.7 } do
		makeBlock({
			name = "ConveyorRail", parent = parent, size = Vector3.new(34, 0.3, 0.3),
			cframe = cf * CFrame.new(0, 0.65, zOff), color = zone.AccentColor,
			material = Enum.Material.Neon, canCollide = false,
		})
	end
	for _, xOff in { -17.3, 17.3 } do
		makeBlock({
			name = "ConveyorEnd", parent = parent, size = Vector3.new(1.2, 1.4, 5.4),
			cframe = cf * CFrame.new(xOff, 0.7, 0), color = Color3.fromRGB(50, 52, 60),
			material = Enum.Material.Metal,
		})
	end
end

-- Timing: tall black ticker/hype board with a climbing neon zig-zag and a
-- big arrow tip. cf = board base center on the pad top, front (-Z) to the plaza.
local function buildHypeBoard(parent: Instance, cf: CFrame, neon: Color3, title: string, boardColor: Color3?)
	local frame = Color3.fromRGB(48, 48, 58)
	for _, xOff in { -2.7, 2.7 } do
		makeBlock({
			name = "HypeBoardPost", parent = parent, size = Vector3.new(0.6, 9.4, 0.6),
			cframe = cf * CFrame.new(xOff, 4.7, 0), color = frame, material = Enum.Material.Metal,
		})
	end
	local board = makeBlock({
		name = "HypeBoard", parent = parent, size = Vector3.new(6.6, 6, 0.5),
		cframe = cf * CFrame.new(0, 7, 0), color = boardColor or Color3.fromRGB(14, 14, 18),
	})
	addPointLight(board, neon, 14, 0.8)
	-- Zig-zag line climbing left to right across the front face
	local points = {
		Vector3.new(-2.6, 4.9, 0),
		Vector3.new(-1.4, 6.1, 0),
		Vector3.new(-0.4, 5.4, 0),
		Vector3.new(0.8, 7.2, 0),
		Vector3.new(1.8, 6.6, 0),
		Vector3.new(2.6, 8.7, 0),
	}
	for i = 1, #points - 1 do
		local a, b = points[i], points[i + 1]
		local mid = (a + b) / 2
		local delta = b - a
		makeBlock({
			name = "TickerStrip", parent = parent, size = Vector3.new(delta.Magnitude, 0.28, 0.2),
			cframe = cf * CFrame.new(mid.X, mid.Y, -0.35) * CFrame.Angles(0, 0, math.atan2(delta.Y, delta.X)),
			color = neon, material = Enum.Material.Neon, canCollide = false,
		})
	end
	-- Arrow tip (diamond) at the end of the line
	makeBlock({
		name = "HypeArrowTip", parent = parent, size = Vector3.new(1.1, 1.1, 0.2),
		cframe = cf * CFrame.new(2.6, 8.9, -0.35) * CFrame.Angles(0, 0, math.rad(45)),
		color = neon, material = Enum.Material.Neon, canCollide = false,
	})
	local plate = makeBlock({
		name = "HypeBoardTitle", parent = parent, size = Vector3.new(6.6, 1.2, 0.4),
		cframe = cf * CFrame.new(0, 10.6, 0), color = WHITE,
	})
	addSurfaceText(plate, title, Enum.Font.LuckiestGuy, neon, Enum.NormalId.Front, nil, plate.Color)
end

-- Charge: hype meter column — 5 stacked neon segments on a dark core with a
-- glowing cap. cf = column base center on the pad top, front (-Z) to the plaza.
local function buildHypeColumn(parent: Instance, cf: CFrame, segColor: Color3, capColor: Color3, title: string, segments: number)
	local frame = Color3.fromRGB(40, 38, 45)
	makeCylinder({
		name = "HypeColumnBase", parent = parent, diameter = 3.4, height = 0.6,
		cframe = cf * CFrame.new(0, 0.3, 0), color = frame, material = Enum.Material.Metal,
	})
	makeBlock({
		name = "HypeColumnCore", parent = parent, size = Vector3.new(1.2, 9.2, 1.2),
		cframe = cf * CFrame.new(0, 5.2, 0), color = frame, material = Enum.Material.Metal,
	})
	-- One neon segment per charge step (zone.ChargeMax), packed into the
	-- same 8.5-stud span so the column height never changes.
	local count = math.max(1, segments)
	local step = 8.5 / count
	for i = 0, count - 1 do
		makeBlock({
			name = "HypeSegment", parent = parent, size = Vector3.new(2.4, step * 0.76, 1.5),
			cframe = cf * CFrame.new(0, 1.55 + step * (i + 0.5), 0),
			color = segColor:Lerp(WHITE, if count > 1 then i * 0.64 / (count - 1) else 0),
			material = Enum.Material.Neon, canCollide = false,
		})
	end
	local cap = makeBall({
		name = "HypeColumnCap", parent = parent, diameter = 1.9,
		cframe = cf * CFrame.new(0, 10.5, 0), color = capColor,
		material = Enum.Material.Neon, canCollide = false,
	})
	addPointLight(cap, segColor, 12, 0.8)
	local plate = makeBlock({
		name = "HypeColumnLabel", parent = parent, size = Vector3.new(3.0, 0.9, 0.25),
		cframe = cf * CFrame.new(0, 1.05, -0.75), color = WHITE, canCollide = false,
	})
	addSurfaceText(plate, title, Enum.Font.LuckiestGuy, segColor, Enum.NormalId.Front, nil, plate.Color)
end

local function buildMechanicProp(zoneModel: Model, cf: CFrame, zone: GameConfig.ZoneDef, hasCounterPlaque: boolean)
	local props = makeModel("MechanicProp", zoneModel)
	if zone.Mechanic == "Tap" then
		buildTapButton(props, cf, zone, not hasCounterPlaque)
	elseif zone.Mechanic == "Hold" then
		if zone.Id == "CarWash" then
			buildConveyor(props, cf, zone)
		else
			buildPawPath(props, cf, zone)
		end
	elseif zone.Mechanic == "Timing" then
		local isStock = zone.Id == "StockDesk"
		buildHypeBoard(
			props, cf, if isStock then Color3.fromRGB(70, 255, 130) else zone.SignColor, if isStock then "TICKER" else "HYPE",
			if isStock then STOCK_DEEP_GREEN else nil
		)
	elseif zone.Mechanic == "Charge" then
		local isStartup = zone.Id == "StartupHQ"
		buildHypeColumn(
			props, cf,
			if isStartup then zone.AccentColor else zone.SignColor,
			if isStartup then zone.SignColor else zone.AccentColor,
			if isStartup then "FUNDING" else "HYPE",
			zone.ChargeMax
		)
	end
end

----------------------------------------------------------------------
-- Zone 1: Lemonade Stand — wooden stand, fabric canopy, giant lemon
----------------------------------------------------------------------

local function buildLemonadeStand(zoneModel: Model, zoneCF: CFrame, zone: GameConfig.ZoneDef)
	local yellow = zone.SignColor
	makeBlock({
		name = "StandBase", parent = zoneModel, size = Vector3.new(10, 3.2, 2.6),
		cframe = zoneCF * CFrame.new(0, 1.6, 9), color = WOOD, material = Enum.Material.WoodPlanks,
	})
	makeBlock({
		name = "StandTop", parent = zoneModel, size = Vector3.new(11, 0.5, 3.2),
		cframe = zoneCF * CFrame.new(0, 3.45, 9), color = CREAM, material = Enum.Material.WoodPlanks,
	})
	-- Striped front skirt
	for i = 0, 4 do
		makeBlock({
			name = "StandStripe", parent = zoneModel, size = Vector3.new(1.9, 2.9, 0.2),
			cframe = zoneCF * CFrame.new(-3.8 + i * 1.9, 1.65, 7.65),
			color = if i % 2 == 0 then yellow else WHITE, canCollide = false,
		})
	end
	-- Canopy posts + striped fabric canopy
	for _, xOff in { -4.6, 4.6 } do
		makeBlock({
			name = "CanopyPost", parent = zoneModel, size = Vector3.new(0.8, 8.4, 0.8),
			cframe = zoneCF * CFrame.new(xOff, 4.2, 10.2), color = DARK_WOOD, material = Enum.Material.Wood,
		})
	end
	for i = 0, 4 do
		makeBlock({
			name = "CanopyStripe", parent = zoneModel, size = Vector3.new(2.3, 0.4, 6.5),
			cframe = zoneCF * CFrame.new(-4.6 + i * 2.3, 8.6, 9.1),
			color = if i % 2 == 0 then yellow else WHITE, material = Enum.Material.Fabric,
		})
	end
	-- GIANT lemon on the roof (ball + two tips, slightly tilted)
	local lemonCF = zoneCF * CFrame.new(0, 12.2, 9.1) * CFrame.Angles(0, 0, math.rad(10))
	makeBall({
		name = "GiantLemon", parent = zoneModel, diameter = 7.4,
		cframe = lemonCF, color = yellow, canCollide = false,
	})
	for _, xOff in { -4.0, 4.0 } do
		makeBall({
			name = "LemonTip", parent = zoneModel, diameter = 1.6,
			cframe = lemonCF * CFrame.new(xOff, 0, 0), color = Color3.fromRGB(235, 190, 28),
			canCollide = false,
		})
	end
	-- Glass pitcher of lemonade (with citrus sparkle) + cups on the counter
	local pitcher = makeCylinder({
		name = "Pitcher", parent = zoneModel, diameter = 1.5, height = 2.3,
		cframe = zoneCF * CFrame.new(2.6, 4.85, 9), color = Color3.fromRGB(255, 236, 150),
		material = Enum.Material.Glass, transparency = 0.3, canCollide = false,
	})
	addSparkle(pitcher, "CitrusSparkle", yellow, WHITE, 4, 0.25, 0.5)
	makeBlock({
		name = "PitcherHandle", parent = zoneModel, size = Vector3.new(0.35, 1.3, 0.9),
		cframe = zoneCF * CFrame.new(3.5, 4.85, 9), color = CREAM, canCollide = false,
	})
	for _, xOff in { -2.2, -3.1 } do
		makeCylinder({
			name = "LemonadeCup", parent = zoneModel, diameter = 0.8, height = 1,
			cframe = zoneCF * CFrame.new(xOff, 4.2, 8.8), color = yellow, canCollide = false,
		})
	end
	addSignBoard(zoneModel, zoneCF * CFrame.new(0, 7.6, 6.1), 9, 2, zone.Name, zoneSignFace(zone), WHITE)
end

----------------------------------------------------------------------
-- Zone 2: Dog Walking — park lawn, fence, dog house, giant bone, blocky dogs
----------------------------------------------------------------------

local function buildDog(parent: Instance, cf: CFrame, color: Color3)
	local darker = color:Lerp(Color3.new(0, 0, 0), 0.3)
	makeBlock({
		name = "DogBody", parent = parent, size = Vector3.new(1.5, 1.6, 2.8),
		cframe = cf * CFrame.new(0, 1.6, 0), color = color,
	})
	for _, offset in { Vector3.new(-0.45, 0.4, -0.95), Vector3.new(0.45, 0.4, -0.95), Vector3.new(-0.45, 0.4, 0.95), Vector3.new(0.45, 0.4, 0.95) } do
		makeBlock({
			name = "DogLeg", parent = parent, size = Vector3.new(0.45, 0.8, 0.45),
			cframe = cf * CFrame.new(offset), color = color, canCollide = false,
		})
	end
	makeBlock({
		name = "DogHead", parent = parent, size = Vector3.new(1.3, 1.2, 1.1),
		cframe = cf * CFrame.new(0, 2.7, -1.5), color = color,
	})
	makeBlock({
		name = "DogSnout", parent = parent, size = Vector3.new(0.7, 0.5, 0.6),
		cframe = cf * CFrame.new(0, 2.45, -2.3), color = darker, canCollide = false,
	})
	makeBall({
		name = "DogNose", parent = parent, diameter = 0.35,
		cframe = cf * CFrame.new(0, 2.5, -2.65), color = Color3.fromRGB(25, 22, 22), canCollide = false,
	})
	for _, xOff in { -0.4, 0.4 } do
		makeBlock({
			name = "DogEar", parent = parent, size = Vector3.new(0.35, 0.6, 0.2),
			cframe = cf * CFrame.new(xOff, 3.4, -1.4), color = darker, canCollide = false,
		})
	end
	makeBlock({
		name = "DogTail", parent = parent, size = Vector3.new(0.3, 1.1, 0.3),
		cframe = cf * CFrame.new(0, 2.5, 1.5) * CFrame.Angles(math.rad(30), 0, 0),
		color = darker, canCollide = false,
	})
end

local function buildDogWalking(zoneModel: Model, zoneCF: CFrame, zone: GameConfig.ZoneDef)
	local fenceWhite = Color3.fromRGB(242, 240, 234)
	-- Real grass lawn inside the fence
	makeBlock({
		name = "ParkLawn", parent = zoneModel, size = Vector3.new(52, 0.2, 44),
		cframe = zoneCF * CFrame.new(0, 0.1, 0), color = Color3.fromRGB(98, 184, 82),
		material = Enum.Material.Grass,
	})
	-- White wooden fence along both sides of the park
	for _, xOff in { -28, 28 } do
		for z = -20, 20, 10 do
			makeBlock({
				name = "FencePost", parent = zoneModel, size = Vector3.new(0.7, 2.8, 0.7),
				cframe = zoneCF * CFrame.new(xOff, 1.4, z), color = fenceWhite, material = Enum.Material.Wood,
			})
		end
		for _, yOff in { 1, 2 } do
			makeBlock({
				name = "FenceRail", parent = zoneModel, size = Vector3.new(0.4, 0.35, 42),
				cframe = zoneCF * CFrame.new(xOff, yOff, 0), color = fenceWhite,
				material = Enum.Material.Wood, canCollide = false,
			})
		end
	end
	-- Red dog house with gabled roof
	local houseRed = Color3.fromRGB(196, 60, 54)
	local roofRed = Color3.fromRGB(140, 40, 36)
	makeBlock({
		name = "DogHouse", parent = zoneModel, size = Vector3.new(8, 6, 7),
		cframe = zoneCF * CFrame.new(10, 3, 14), color = houseRed, material = Enum.Material.WoodPlanks,
	})
	makeWedge({
		name = "DogHouseRoof", parent = zoneModel, size = Vector3.new(7.5, 2, 4.5),
		cframe = zoneCF * CFrame.new(7.75, 7, 14) * CFrame.Angles(0, RAD_90, 0), color = roofRed,
	})
	makeWedge({
		name = "DogHouseRoof", parent = zoneModel, size = Vector3.new(7.5, 2, 4.5),
		cframe = zoneCF * CFrame.new(12.25, 7, 14) * CFrame.Angles(0, -RAD_90, 0), color = roofRed,
	})
	makeBlock({
		name = "DogHouseDoor", parent = zoneModel, size = Vector3.new(2.6, 3.4, 0.4),
		cframe = zoneCF * CFrame.new(10, 1.9, 10.4), color = Color3.fromRGB(30, 24, 22), canCollide = false,
	})
	-- Giant white bone (cylinder + two balls at each end)
	local boneWhite = Color3.fromRGB(250, 248, 240)
	local boneCF = zoneCF * CFrame.new(-8, 1.5, 2) * CFrame.Angles(0, math.rad(25), 0)
	makeCylinder({
		name = "BoneShaft", parent = zoneModel, diameter = 2, height = 7, axis = "X",
		cframe = boneCF, color = boneWhite,
	})
	for _, xOff in { -3.5, 3.5 } do
		for _, zOff in { -0.9, 0.9 } do
			makeBall({
				name = "BoneKnob", parent = zoneModel, diameter = 3,
				cframe = boneCF * CFrame.new(xOff, 0, zOff), color = boneWhite,
			})
		end
	end
	-- Two tiny blocky dogs
	buildDog(zoneModel, zoneCF * CFrame.new(-14, 0, 12) * CFrame.Angles(0, math.rad(140), 0), Color3.fromRGB(150, 103, 60))
	buildDog(zoneModel, zoneCF * CFrame.new(12, 0, -4) * CFrame.Angles(0, math.rad(-35), 0), Color3.fromRGB(240, 238, 230))
	-- Pink heart-ish motes drifting over the lawn
	local motes = makeMarker(zoneModel, "HeartMotes", zoneCF * CFrame.new(0, 4, 4), Vector3.new(24, 3, 20))
	addParticles(motes, "Hearts", {
		color = ColorSequence.new(Color3.fromRGB(255, 120, 170), Color3.fromRGB(255, 190, 215)),
		size = NumberSequence.new(0.5, 0.9),
		rate = 4,
		lifetime = NumberRange.new(2, 3),
		speed = NumberRange.new(0.6, 1.2),
		acceleration = Vector3.new(0, 0.8, 0),
		lightEmission = 0.9,
	})
	addSignBoard(zoneModel, zoneCF * CFrame.new(10, 9.3, 14), 10, 2.2, zone.Name, zoneSignFace(zone), WHITE)
end

----------------------------------------------------------------------
-- Zone 3: Sneaker Street — concrete storefront, glass window, giant sneaker
----------------------------------------------------------------------

local function buildSneakerFlipping(zoneModel: Model, zoneCF: CFrame, zone: GameConfig.ZoneDef)
	local wallPurple = Color3.fromRGB(74, 64, 120)
	makeBlock({
		name = "StoreBody", parent = zoneModel, size = Vector3.new(22, 14, 12),
		cframe = zoneCF * CFrame.new(0, 7, 16), color = wallPurple, material = Enum.Material.Concrete,
	})
	makeBlock({
		name = "StoreRoof", parent = zoneModel, size = Vector3.new(23, 0.8, 13),
		cframe = zoneCF * CFrame.new(0, 14.4, 16), color = Color3.fromRGB(50, 42, 84),
	})
	makeBlock({
		name = "StoreWindow", parent = zoneModel, size = Vector3.new(12, 5.5, 0.5),
		cframe = zoneCF * CFrame.new(-2, 5.2, 9.8), color = Color3.fromRGB(150, 170, 220),
		material = Enum.Material.Glass, transparency = 0.35, canCollide = false,
	})
	makeBlock({
		name = "StoreDoor", parent = zoneModel, size = Vector3.new(4, 7.5, 0.5),
		cframe = zoneCF * CFrame.new(7.5, 3.75, 9.8), color = zone.SignColor:Lerp(NAVY, 0.35), canCollide = false,
	})
	-- Neon purple trim
	makeBlock({
		name = "StoreTrim", parent = zoneModel, size = Vector3.new(22.8, 0.7, 0.7),
		cframe = zoneCF * CFrame.new(0, 14, 9.9), color = zone.SignColor,
		material = Enum.Material.Neon, canCollide = false,
	})
	for _, yOff in { 2.2, 8.2 } do
		makeBlock({
			name = "WindowTrim", parent = zoneModel, size = Vector3.new(12.6, 0.4, 0.3),
			cframe = zoneCF * CFrame.new(-2, yOff, 10), color = zone.SignColor,
			material = Enum.Material.Neon, canCollide = false,
		})
	end
	-- Giant sneaker on a marble display pedestal
	local pedestal = makeCylinder({
		name = "SneakerPedestal", parent = zoneModel, diameter = 7, height = 2.4,
		cframe = zoneCF * CFrame.new(-12, 1.2, -2), color = WHITE, material = Enum.Material.Marble,
	})
	addSparkle(pedestal, "HypeSparkle", zone.SignColor, zone.AccentColor, 2, 0.3, 0.6)
	local shoeCF = zoneCF * CFrame.new(-12, 0, -2)
	makeBlock({
		name = "SneakerSole", parent = zoneModel, size = Vector3.new(7.5, 0.9, 3),
		cframe = shoeCF * CFrame.new(0, 2.85, 0), color = WHITE,
		canCollide = false,
	})
	makeBlock({
		name = "SneakerHeel", parent = zoneModel, size = Vector3.new(2.4, 1.6, 2.9),
		cframe = shoeCF * CFrame.new(-2.3, 4.1, 0), color = zone.SignColor,
		canCollide = false,
	})
	makeBlock({
		name = "SneakerBody", parent = zoneModel, size = Vector3.new(4.5, 2.1, 2.9),
		cframe = shoeCF * CFrame.new(-0.4, 4.35, 0), color = zone.SignColor,
		canCollide = false,
	})
	makeWedge({
		name = "SneakerToe", parent = zoneModel, size = Vector3.new(2.9, 1.9, 2.4),
		cframe = shoeCF * CFrame.new(2.6, 4.25, 0) * CFrame.Angles(0, -RAD_90, 0), color = zone.SignColor,
		canCollide = false,
	})
	makeBlock({
		name = "SneakerSwoosh", parent = zoneModel, size = Vector3.new(2.8, 0.5, 0.2),
		cframe = shoeCF * CFrame.new(0, 4.4, -1.55) * CFrame.Angles(0, 0, math.rad(-14)),
		color = zone.AccentColor, material = Enum.Material.Neon, canCollide = false,
	})
	addSignBoard(zoneModel, zoneCF * CFrame.new(0, 11.8, 9.85), 14, 2.6, zone.Name, zoneSignFace(zone), WHITE)
end

----------------------------------------------------------------------
-- Zone 4: Car Wash — metal/glass tunnel, roller brushes, blocky car, foam
----------------------------------------------------------------------

local function buildCarWash(zoneModel: Model, zoneCF: CFrame, zone: GameConfig.ZoneDef)
	local aqua = zone.SignColor
	-- Tunnel: low front wall (so the inside is visible), full back wall, roof, columns
	makeBlock({
		name = "TunnelFrontWall", parent = zoneModel, size = Vector3.new(22, 4.5, 1.2),
		cframe = zoneCF * CFrame.new(0, 2.25, 2), color = aqua, material = Enum.Material.Metal,
	})
	makeBlock({
		name = "TunnelBackWall", parent = zoneModel, size = Vector3.new(22, 9, 1.2),
		cframe = zoneCF * CFrame.new(0, 4.5, 14), color = aqua, material = Enum.Material.Metal,
	})
	for _, xOff in { -10.5, 10.5 } do
		makeBlock({
			name = "TunnelColumn", parent = zoneModel, size = Vector3.new(1.6, 9, 1.6),
			cframe = zoneCF * CFrame.new(xOff, 4.5, 2), color = aqua, material = Enum.Material.Metal,
		})
	end
	makeBlock({
		name = "TunnelRoof", parent = zoneModel, size = Vector3.new(23, 1.2, 14),
		cframe = zoneCF * CFrame.new(0, 9.6, 8), color = Color3.fromRGB(44, 150, 170),
		material = Enum.Material.Metal,
	})
	makeBlock({
		name = "TunnelGlass", parent = zoneModel, size = Vector3.new(20, 3.6, 0.4),
		cframe = zoneCF * CFrame.new(0, 6.5, 2), color = Color3.fromRGB(160, 225, 245),
		material = Enum.Material.Glass, transparency = 0.45, canCollide = false,
	})
	makeBlock({
		name = "TunnelTrim", parent = zoneModel, size = Vector3.new(23, 0.8, 0.8),
		cframe = zoneCF * CFrame.new(0, 10.3, 1.4), color = zone.AccentColor,
		material = Enum.Material.Neon, canCollide = false,
	})
	-- Big fabric roller brushes hanging from the roof (Y 1.3..9.0): clear of
	-- the conveyor rollers (top 1.25) and of the car body (X -4..4, Z 5.9..10.1)
	for _, offset in { Vector3.new(-6, 0, 5.4), Vector3.new(0, 0, 11.7), Vector3.new(6, 0, 5.4) } do
		makeCylinder({
			name = "RollerBrush", parent = zoneModel, diameter = 3, height = 7.7,
			cframe = zoneCF * CFrame.new(offset.X, 5.15, offset.Z), color = Color3.fromRGB(30, 70, 115),
			material = Enum.Material.Fabric,
		})
	end
	-- Chunky blocky car riding the conveyor: raised 1.25 so the wheel bottoms
	-- (diameter 2 at local y 1) rest on the roller tops (0.8 + 0.45 = 1.25).
	local carCF = zoneCF * CFrame.new(0, 1.25, 0)
	makeBlock({
		name = "CarBody", parent = zoneModel, size = Vector3.new(8, 2.2, 4.2),
		cframe = carCF * CFrame.new(0, 2.1, 8), color = Color3.fromRGB(224, 82, 72),
	})
	makeBlock({
		name = "CarCabin", parent = zoneModel, size = Vector3.new(4, 1.8, 3.8),
		cframe = carCF * CFrame.new(-0.4, 4.1, 8), color = Color3.fromRGB(120, 170, 210),
		material = Enum.Material.Glass, transparency = 0.35,
	})
	for _, xOff in { -2.8, 2.8 } do
		for _, zOff in { -2.3, 2.3 } do
			makeCylinder({
				name = "CarWheel", parent = zoneModel, diameter = 2, height = 0.8, axis = "Z",
				cframe = carCF * CFrame.new(xOff, 1, 8 + zOff), color = WHEEL_DARK,
			})
		end
	end
	-- A few static foam blobs on the car + rising foam bubbles in the tunnel
	for _, bubble in { { Vector3.new(0, 3.6, 7), 1.8 }, { Vector3.new(2.4, 3.5, 9), 1.4 }, { Vector3.new(0.8, 5.3, 8.2), 1.6 }, { Vector3.new(-2.6, 3.4, 7.4), 1.3 } } do
		makeBall({
			name = "FoamBubble", parent = zoneModel, diameter = bubble[2],
			cframe = carCF * CFrame.new(bubble[1]), color = Color3.fromRGB(250, 250, 255),
			transparency = 0.2, canCollide = false,
		})
	end
	local foam = makeMarker(zoneModel, "FoamVolume", zoneCF * CFrame.new(0, 2.5, 8), Vector3.new(18, 2, 10))
	addParticles(foam, "FoamBubbles", {
		color = ColorSequence.new(Color3.fromRGB(255, 255, 255), Color3.fromRGB(225, 245, 255)),
		size = NumberSequence.new(0.6, 1.2),
		transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.15),
			NumberSequenceKeypoint.new(0.8, 0.3),
			NumberSequenceKeypoint.new(1, 1),
		}),
		rate = 8,
		lifetime = NumberRange.new(1.6, 2.4),
		speed = NumberRange.new(1, 2),
		acceleration = Vector3.new(0, 1.2, 0),
		lightEmission = 0.3,
	})
	addSignBoard(zoneModel, zoneCF * CFrame.new(0, 11.6, 2), 14, 2.4, zone.Name, zoneSignFace(zone), WHITE)
end

----------------------------------------------------------------------
-- Zone 5: Food Truck — metal truck, diamond-plate skirt, HUGE burger, smoke
----------------------------------------------------------------------

local function buildFoodTruck(zoneModel: Model, zoneCF: CFrame, zone: GameConfig.ZoneDef)
	local orange = zone.SignColor
	local truckCF = zoneCF * CFrame.new(0, 0, 8)
	makeBlock({
		name = "TruckBody", parent = zoneModel, size = Vector3.new(15, 5, 6),
		cframe = truckCF * CFrame.new(0, 3.9, 0), color = orange, material = Enum.Material.Metal,
	})
	makeBlock({
		name = "TruckSkirt", parent = zoneModel, size = Vector3.new(15.2, 1.0, 6.2),
		cframe = truckCF * CFrame.new(0, 1.7, 0), color = Color3.fromRGB(150, 150, 160),
		material = Enum.Material.DiamondPlate,
	})
	makeBlock({
		name = "TruckCab", parent = zoneModel, size = Vector3.new(4, 3.6, 5.6),
		cframe = truckCF * CFrame.new(-9.5, 3.2, 0), color = orange, material = Enum.Material.Metal,
	})
	makeBlock({
		name = "TruckWindshield", parent = zoneModel, size = Vector3.new(0.5, 1.8, 4.4),
		cframe = truckCF * CFrame.new(-11.3, 4.2, 0), color = Color3.fromRGB(120, 170, 210),
		material = Enum.Material.Glass, transparency = 0.3, canCollide = false,
	})
	for _, xOff in { -9, 5 } do
		for _, zOff in { -3.4, 3.4 } do
			makeCylinder({
				name = "TruckWheel", parent = zoneModel, diameter = 2.4, height = 0.9, axis = "Z",
				cframe = truckCF * CFrame.new(xOff, 1.2, zOff), color = WHEEL_DARK,
			})
		end
	end
	-- Serving window + counter lip + fabric awning (front side, facing the plaza)
	makeBlock({
		name = "ServingWindow", parent = zoneModel, size = Vector3.new(6, 2.4, 0.4),
		cframe = truckCF * CFrame.new(0.5, 4.4, -3.05), color = Color3.fromRGB(80, 90, 110),
		material = Enum.Material.Glass, transparency = 0.3, canCollide = false,
	})
	makeBlock({
		name = "WindowCounter", parent = zoneModel, size = Vector3.new(6.6, 0.4, 1),
		cframe = truckCF * CFrame.new(0.5, 3.1, -3.5), color = CREAM, material = Enum.Material.WoodPlanks,
	})
	makeBlock({
		name = "Awning", parent = zoneModel, size = Vector3.new(7, 0.4, 2.4),
		cframe = truckCF * CFrame.new(0.5, 5.9, -3.8) * CFrame.Angles(math.rad(-20), 0, 0),
		color = zone.AccentColor, material = Enum.Material.Fabric, canCollide = false,
	})
	-- Grill chimney with smoke
	local chimney = makeCylinder({
		name = "GrillChimney", parent = zoneModel, diameter = 1.2, height = 1.6,
		cframe = truckCF * CFrame.new(5.5, 7.2, 1.5), color = METAL_DARK, material = Enum.Material.Metal,
		canCollide = false,
	})
	addParticles(chimney, "GrillSmoke", {
		color = ColorSequence.new(Color3.fromRGB(150, 150, 155), Color3.fromRGB(205, 205, 210)),
		size = NumberSequence.new(1, 2.6),
		transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.4),
			NumberSequenceKeypoint.new(0.6, 0.7),
			NumberSequenceKeypoint.new(1, 1),
		}),
		rate = 5,
		lifetime = NumberRange.new(2, 3),
		speed = NumberRange.new(2, 3),
		spread = Vector2.new(10, 10),
		acceleration = Vector3.new(0, 1, 0),
		lightEmission = 0,
		rotSpeed = NumberRange.new(-20, 20),
	})
	-- HUGE burger on the roof: bun / patty / cheese / lettuce / dome bun
	makeCylinder({
		name = "BurgerBunBottom", parent = zoneModel, diameter = 7, height = 1.4,
		cframe = truckCF * CFrame.new(0, 7.1, 0), color = Color3.fromRGB(233, 170, 92), canCollide = false,
	})
	makeCylinder({
		name = "BurgerPatty", parent = zoneModel, diameter = 7.7, height = 1,
		cframe = truckCF * CFrame.new(0, 8.3, 0), color = Color3.fromRGB(118, 70, 36), canCollide = false,
	})
	makeBlock({
		name = "BurgerCheese", parent = zoneModel, size = Vector3.new(6.9, 0.35, 6.9),
		cframe = truckCF * CFrame.new(0, 8.95, 0) * CFrame.Angles(0, math.rad(20), 0),
		color = Color3.fromRGB(255, 196, 40), canCollide = false,
	})
	makeCylinder({
		name = "BurgerLettuce", parent = zoneModel, diameter = 8.1, height = 0.6,
		cframe = truckCF * CFrame.new(0, 9.4, 0), color = Color3.fromRGB(120, 212, 80), canCollide = false,
	})
	-- Dome bun: a sphere whose equator sits at the lettuce (lower half hidden)
	makeBall({
		name = "BurgerBunTop", parent = zoneModel, diameter = 6.6,
		cframe = truckCF * CFrame.new(0, 9.7, 0), color = Color3.fromRGB(233, 170, 92), canCollide = false,
	})
	for _, offset in { Vector3.new(-1.4, 12.5, 0.8), Vector3.new(1.2, 12.6, -0.6), Vector3.new(0.2, 12.8, 1.2) } do
		makeBall({
			name = "SesameSeed", parent = zoneModel, diameter = 0.45,
			cframe = truckCF * CFrame.new(offset), color = CREAM, canCollide = false,
		})
	end
	-- Menu board beside the truck
	addSignBoard(zoneModel, zoneCF * CFrame.new(10.5, 4, 2), 4.2, 3, "MENU", WHITE, zone.SignColor, zone.SignColor)
	makeBlock({
		name = "MenuPost", parent = zoneModel, size = Vector3.new(0.4, 3.2, 0.4),
		cframe = zoneCF * CFrame.new(10.5, 1.6, 2), color = DARK_WOOD, material = Enum.Material.Wood,
	})
	-- Name sign on two posts left of the truck (in front of the cab, clear of
	-- the counter so it reads from the plaza; board Y 5.6..7.6 above the pad)
	for _, xOff in { -20, -12 } do
		makeBlock({
			name = "NameSignPost", parent = zoneModel, size = Vector3.new(0.5, 5.8, 0.5),
			cframe = zoneCF * CFrame.new(xOff, 2.9, 0), color = DARK_WOOD, material = Enum.Material.Wood,
		})
	end
	addSignBoard(zoneModel, zoneCF * CFrame.new(-16, 6.6, 0), 9, 2, zone.Name, zoneSignFace(zone), WHITE)
end

----------------------------------------------------------------------
-- Zone 6: Creator Studio — pink neon, glass window, giant ring light, tripod
----------------------------------------------------------------------

local function buildContentCreator(zoneModel: Model, zoneCF: CFrame, zone: GameConfig.ZoneDef)
	local pink = zone.SignColor
	local studioDark = Color3.fromRGB(40, 38, 45)
	makeBlock({
		name = "StudioBody", parent = zoneModel, size = Vector3.new(20, 12, 12),
		cframe = zoneCF * CFrame.new(0, 6, 16), color = Color3.fromRGB(58, 48, 70),
	})
	makeBlock({
		name = "StudioRoof", parent = zoneModel, size = Vector3.new(21, 0.8, 13),
		cframe = zoneCF * CFrame.new(0, 12.4, 16), color = Color3.fromRGB(44, 36, 54),
	})
	makeBlock({
		name = "StudioWindow", parent = zoneModel, size = Vector3.new(9, 4.5, 0.5),
		cframe = zoneCF * CFrame.new(0, 6, 9.8), color = Color3.fromRGB(220, 150, 220),
		material = Enum.Material.Glass, transparency = 0.35, canCollide = false,
	})
	makeBlock({
		name = "StudioTrim", parent = zoneModel, size = Vector3.new(20.6, 0.7, 0.7),
		cframe = zoneCF * CFrame.new(0, 12.1, 10), color = pink,
		material = Enum.Material.Neon, canCollide = false,
	})
	for _, xOff in { -10.1, 10.1 } do
		makeBlock({
			name = "StudioCornerTrim", parent = zoneModel, size = Vector3.new(0.7, 12.4, 0.7),
			cframe = zoneCF * CFrame.new(xOff, 6.2, 10), color = pink,
			material = Enum.Material.Neon, canCollide = false,
		})
	end
	-- Giant ring light on a stand
	makeCylinder({
		name = "RingLightBase", parent = zoneModel, diameter = 3, height = 0.5,
		cframe = zoneCF * CFrame.new(-9, 0.25, -2), color = studioDark, material = Enum.Material.Metal,
	})
	makeCylinder({
		name = "RingLightPole", parent = zoneModel, diameter = 0.7, height = 5.5,
		cframe = zoneCF * CFrame.new(-9, 3.25, -2), color = studioDark, material = Enum.Material.Metal,
	})
	local ring = makeCylinder({
		name = "RingLight", parent = zoneModel, diameter = 9, height = 0.8, axis = "Z",
		cframe = zoneCF * CFrame.new(-9, 7, -2), color = pink,
		material = Enum.Material.Neon, canCollide = false,
	})
	addPointLight(ring, pink, 16, 0.9)
	makeCylinder({
		name = "RingLightInner", parent = zoneModel, diameter = 6.8, height = 0.7, axis = "Z",
		cframe = zoneCF * CFrame.new(-9, 7, -2.15), color = studioDark, canCollide = false,
	})
	-- Pink neon motes around the ring light
	local motes = makeMarker(zoneModel, "NeonMotes", zoneCF * CFrame.new(-9, 6, -2), Vector3.new(10, 8, 8))
	addSparkle(motes, "PinkMotes", pink, Color3.fromRGB(255, 180, 230), 5, 0.3, 0.7)
	-- Phone on a tripod, filming the ring light
	local tripodCF = zoneCF * CFrame.new(-9, 0, -8.5)
	for i = 0, 2 do
		makeBlock({
			name = "TripodLeg", parent = zoneModel, size = Vector3.new(0.35, 4.4, 0.35),
			cframe = tripodCF * CFrame.Angles(0, math.rad(i * 120), 0) * CFrame.new(0, 2.1, -1) * CFrame.Angles(math.rad(14), 0, 0),
			color = studioDark, material = Enum.Material.Metal,
		})
	end
	makeBlock({
		name = "TripodHead", parent = zoneModel, size = Vector3.new(0.8, 0.8, 0.8),
		cframe = tripodCF * CFrame.new(0, 4.3, 0), color = studioDark, canCollide = false,
	})
	makeBlock({
		name = "Phone", parent = zoneModel, size = Vector3.new(1.9, 3.4, 0.4),
		cframe = tripodCF * CFrame.new(0, 6.1, 0), color = Color3.fromRGB(20, 20, 24), canCollide = false,
	})
	makeBlock({
		name = "PhoneScreen", parent = zoneModel, size = Vector3.new(1.6, 3, 0.12),
		cframe = tripodCF * CFrame.new(0, 6.1, 0.23), color = Color3.fromRGB(255, 160, 220),
		material = Enum.Material.Neon, canCollide = false,
	})
	-- Big play-button prop: white triangle (two mirrored wedges) on a pink cube
	makeBlock({
		name = "PlayButtonBase", parent = zoneModel, size = Vector3.new(7, 0.7, 7),
		cframe = zoneCF * CFrame.new(9, 0.35, -1), color = WHITE,
	})
	makeBlock({
		name = "PlayButtonCube", parent = zoneModel, size = Vector3.new(5.5, 5.5, 5.5),
		cframe = zoneCF * CFrame.new(9, 3.45, -1), color = pink,
	})
	-- Yaw +90 puts each wedge's tall back face at zone-local +X, so the apex
	-- points to -X = the right-hand side of a viewer looking from the plaza.
	makeWedge({
		name = "PlayTriangleTop", parent = zoneModel, size = Vector3.new(0.8, 1.4, 2.8),
		cframe = zoneCF * CFrame.new(9, 4.15, -4.15) * CFrame.Angles(0, RAD_90, 0),
		color = WHITE, canCollide = false,
	})
	makeWedge({
		name = "PlayTriangleBottom", parent = zoneModel, size = Vector3.new(0.8, 1.4, 2.8),
		cframe = zoneCF * CFrame.new(9, 2.75, -4.15) * CFrame.Angles(0, RAD_90, 0) * CFrame.Angles(0, 0, math.rad(180)),
		color = WHITE, canCollide = false,
	})
	addSignBoard(zoneModel, zoneCF * CFrame.new(0, 10.4, 9.85), 14, 2.5, zone.Name, zoneSignFace(zone), WHITE)
end

----------------------------------------------------------------------
-- Zone 7: Stock Desk — dark metal office, neon ticker screens, big up arrow
----------------------------------------------------------------------

local function buildStockDesk(zoneModel: Model, zoneCF: CFrame, zone: GameConfig.ZoneDef)
	local neonGreen = Color3.fromRGB(70, 255, 130)
	-- Local override (GameConfig keeps its near-black AccentColor): the
	-- backdrop and screens are a deep ticker green, never the darkest shapes
	-- in the zone.
	local deepGreen = STOCK_DEEP_GREEN
	local screenGreen = deepGreen:Lerp(NAVY, 0.25)
	makeBlock({
		name = "OfficeBody", parent = zoneModel, size = Vector3.new(18, 12, 12),
		cframe = zoneCF * CFrame.new(0, 6, 14), color = deepGreen,
	})
	makeBlock({
		name = "OfficeRoof", parent = zoneModel, size = Vector3.new(19, 0.8, 13),
		cframe = zoneCF * CFrame.new(0, 12.4, 14), color = deepGreen:Lerp(WHITE, 0.2),
	})
	makeBlock({
		name = "OfficeDoor", parent = zoneModel, size = Vector3.new(3.5, 6, 0.5),
		cframe = zoneCF * CFrame.new(0, 3, 7.8), color = screenGreen, canCollide = false,
	})
	makeBlock({
		name = "OfficeTrim", parent = zoneModel, size = Vector3.new(18.6, 0.6, 0.6),
		cframe = zoneCF * CFrame.new(0, 12.1, 8), color = zone.SignColor,
		material = Enum.Material.Neon, canCollide = false,
	})
	for _, xOff in { -9.1, 9.1 } do
		makeBlock({
			name = "OfficeCornerStrip", parent = zoneModel, size = Vector3.new(0.6, 12.4, 0.6),
			cframe = zoneCF * CFrame.new(xOff, 6.2, 8), color = zone.SignColor,
			material = Enum.Material.Neon, canCollide = false,
		})
	end
	-- Green-on-black ticker screens on the front wall
	for _, xOff in { -4.5, 4.5 } do
		makeBlock({
			name = "TickerScreen", parent = zoneModel, size = Vector3.new(6.5, 3, 0.5),
			cframe = zoneCF * CFrame.new(xOff, 6.8, 7.8), color = screenGreen, canCollide = false,
		})
		makeBlock({
			name = "TickerLine", parent = zoneModel, size = Vector3.new(5.6, 0.4, 0.15),
			cframe = zoneCF * CFrame.new(xOff, 7.5, 7.5), color = neonGreen,
			material = Enum.Material.Neon, canCollide = false,
		})
		makeBlock({
			name = "TickerLine", parent = zoneModel, size = Vector3.new(4.2, 0.4, 0.15),
			cframe = zoneCF * CFrame.new(xOff - 0.6, 6.4, 7.5), color = neonGreen,
			material = Enum.Material.Neon, canCollide = false,
		})
	end
	-- Big green up arrow on the roof (block shaft + wedge head)
	makeBlock({
		name = "ArrowShaft", parent = zoneModel, size = Vector3.new(1.6, 6, 1.2),
		cframe = zoneCF * CFrame.new(0, 15.8, 14), color = zone.SignColor,
		material = Enum.Material.Neon, canCollide = false,
	})
	makeWedge({
		name = "ArrowHeadLeft", parent = zoneModel, size = Vector3.new(1.2, 2.8, 2.2),
		cframe = zoneCF * CFrame.new(-1.1, 20.2, 14) * CFrame.Angles(0, RAD_90, 0),
		color = zone.SignColor, material = Enum.Material.Neon, canCollide = false,
	})
	makeWedge({
		name = "ArrowHeadRight", parent = zoneModel, size = Vector3.new(1.2, 2.8, 2.2),
		cframe = zoneCF * CFrame.new(1.1, 20.2, 14) * CFrame.Angles(0, -RAD_90, 0),
		color = zone.SignColor, material = Enum.Material.Neon, canCollide = false,
	})
	-- Green money sparkle over the trading counter
	local sparkle = makeMarker(zoneModel, "MoneySparkle", zoneCF * CFrame.new(0, 7, -8), Vector3.new(8, 2, 4))
	addSparkle(sparkle, "MoneySparkle", Color3.fromRGB(60, 255, 120), Color3.fromRGB(180, 255, 200), 5, 0.4, 0.8)
	addSignBoard(zoneModel, zoneCF * CFrame.new(0, 10.6, 7.85), 13, 2.5, zone.Name, zoneSignFace(zone), WHITE)
end

----------------------------------------------------------------------
-- Zone 8: Startup HQ — sleek white tower with glass bands, logo cube, rocket
----------------------------------------------------------------------

local function buildStartupHQ(zoneModel: Model, zoneCF: CFrame, zone: GameConfig.ZoneDef)
	local glassBlue = Color3.fromRGB(90, 150, 255)
	local towerCF = zoneCF * CFrame.new(0, 0, 18)
	local tiers = {
		{ size = Vector3.new(16, 5, 16), y = 2.5, glass = false },
		{ size = Vector3.new(16.4, 1.8, 16.4), y = 6.4, glass = true },
		{ size = Vector3.new(14, 5, 14), y = 9.8, glass = false },
		{ size = Vector3.new(14.4, 1.8, 14.4), y = 13.2, glass = true },
		{ size = Vector3.new(12, 5, 12), y = 16.6, glass = false },
		{ size = Vector3.new(10, 2, 10), y = 20.1, glass = false },
	}
	for _, tier in tiers do
		makeBlock({
			name = if tier.glass then "TowerGlass" else "TowerTier", parent = zoneModel, size = tier.size,
			cframe = towerCF * CFrame.new(0, tier.y, 0),
			color = if tier.glass then glassBlue else WHITE,
			material = if tier.glass then Enum.Material.Glass else Enum.Material.SmoothPlastic,
			transparency = if tier.glass then 0.35 else 0,
		})
	end
	makeBlock({
		name = "TowerDoor", parent = zoneModel, size = Vector3.new(3.5, 5.5, 0.6),
		cframe = towerCF * CFrame.new(0, 2.75, -8.1), color = Color3.fromRGB(120, 170, 230),
		material = Enum.Material.Glass, transparency = 0.3, canCollide = false,
	})
	-- Blue neon logo cube on a small pole, tilted like a diamond
	makeBlock({
		name = "LogoPole", parent = zoneModel, size = Vector3.new(0.4, 1.6, 0.4),
		cframe = towerCF * CFrame.new(0, 21.9, 0), color = WHITE, canCollide = false,
	})
	local logo = makeBlock({
		name = "LogoCube", parent = zoneModel, size = Vector3.new(2.8, 2.8, 2.8),
		cframe = towerCF * CFrame.new(0, 23.2, 0) * CFrame.Angles(math.rad(35), math.rad(45), 0),
		color = zone.AccentColor, material = Enum.Material.Neon, canCollide = false,
	})
	addPointLight(logo, zone.AccentColor, 16, 0.8)
	-- Small rocket statue: cylinder body, crossed-wedge nose cone, wedge fins
	local rocketCF = zoneCF * CFrame.new(-12, 0, -4)
	makeCylinder({
		name = "RocketPedestal", parent = zoneModel, diameter = 5.5, height = 1.2,
		cframe = rocketCF * CFrame.new(0, 0.6, 0), color = Color3.fromRGB(205, 198, 182),
		material = Enum.Material.Marble,
	})
	makeCylinder({
		name = "RocketBody", parent = zoneModel, diameter = 3, height = 7,
		cframe = rocketCF * CFrame.new(0, 4.7, 0), color = Color3.fromRGB(244, 244, 248),
		material = Enum.Material.Metal,
	})
	makeBall({
		name = "RocketWindow", parent = zoneModel, diameter = 1.3,
		cframe = rocketCF * CFrame.new(0, 5.6, -1.4), color = zone.AccentColor,
		material = Enum.Material.Neon, canCollide = false,
	})
	-- Nose cone: two crossed wedge pairs
	local noseY = 9.6
	makeWedge({
		name = "RocketNose", parent = zoneModel, size = Vector3.new(2.4, 2.8, 1.5),
		cframe = rocketCF * CFrame.new(-0.75, noseY, 0) * CFrame.Angles(0, RAD_90, 0),
		color = zone.AccentColor, canCollide = false,
	})
	makeWedge({
		name = "RocketNose", parent = zoneModel, size = Vector3.new(2.4, 2.8, 1.5),
		cframe = rocketCF * CFrame.new(0.75, noseY, 0) * CFrame.Angles(0, -RAD_90, 0),
		color = zone.AccentColor, canCollide = false,
	})
	makeWedge({
		name = "RocketNose", parent = zoneModel, size = Vector3.new(2.4, 2.8, 1.5),
		cframe = rocketCF * CFrame.new(0, noseY, -0.75),
		color = zone.AccentColor, canCollide = false,
	})
	makeWedge({
		name = "RocketNose", parent = zoneModel, size = Vector3.new(2.4, 2.8, 1.5),
		cframe = rocketCF * CFrame.new(0, noseY, 0.75) * CFrame.Angles(0, math.rad(180), 0),
		color = zone.AccentColor, canCollide = false,
	})
	-- Fins (vertical face against the body, sloping down and out)
	local finSpecs = {
		{ offset = Vector3.new(2.2, 2.6, 0), yaw = -RAD_90 },
		{ offset = Vector3.new(-2.2, 2.6, 0), yaw = RAD_90 },
		{ offset = Vector3.new(0, 2.6, 2.2), yaw = math.rad(180) },
		{ offset = Vector3.new(0, 2.6, -2.2), yaw = 0 },
	}
	for _, fin in finSpecs do
		makeWedge({
			name = "RocketFin", parent = zoneModel, size = Vector3.new(0.5, 2.8, 1.9),
			cframe = rocketCF * CFrame.new(fin.offset) * CFrame.Angles(0, fin.yaw, 0),
			color = zone.AccentColor, canCollide = false,
		})
	end
	-- Blue sparkle around the rocket
	local sparkle = makeMarker(zoneModel, "RocketSparkle", rocketCF * CFrame.new(0, 5, 0), Vector3.new(5, 8, 5))
	addSparkle(sparkle, "BlueSparkle", zone.AccentColor, Color3.fromRGB(170, 210, 255), 5, 0.3, 0.7)
	addSignBoard(zoneModel, towerCF * CFrame.new(0, 8.5, -8.1), 12, 2.2, zone.Name, zoneSignFace(zone), WHITE)
end

----------------------------------------------------------------------
-- Generic fallback for any future zone id without a bespoke builder
----------------------------------------------------------------------

local function buildGenericZone(zoneModel: Model, zoneCF: CFrame, zone: GameConfig.ZoneDef)
	makeBlock({
		name = "Building", parent = zoneModel, size = Vector3.new(20, 12, 12),
		cframe = zoneCF * CFrame.new(0, 6, 16), color = zone.SignColor, material = Enum.Material.Concrete,
	})
	addSignBoard(zoneModel, zoneCF * CFrame.new(0, 10, 9.8), 14, 2.5, zone.Name, zoneSignFace(zone), WHITE)
end

local ZONE_BUILDERS: { [string]: (Model, CFrame, GameConfig.ZoneDef) -> () } = {
	LemonadeStand = buildLemonadeStand,
	DogWalking = buildDogWalking,
	SneakerFlipping = buildSneakerFlipping,
	CarWash = buildCarWash,
	FoodTruck = buildFoodTruck,
	ContentCreator = buildContentCreator,
	StockDesk = buildStockDesk,
	StartupHQ = buildStartupHQ,
}

-- Hustle station placement per zone (zone-local, on the pad top; -Z = plaza).
local STATIONS: { [string]: StationSpec } = {
	-- The stand itself is the counter (top Y 3.7, X -5.5..5.5, Z 7.4..10.6);
	-- PromptPart lands at (0, 3, 4.6) in front of it. FeedbackPart sits right
	-- above the prompt (6.3 over the stand top, in front of canopy + lemon);
	-- AutoAnchor stands on open pad 4 studs clear of the stand's +X side.
	LemonadeStand = {
		pos = Vector3.new(0, 0, 7), counter = false,
		feedback = Vector3.new(0, 10, 4.6),
		anchor = Vector3.new(9.5, 0.5, 8.5), anchorLook = Vector3.new(0, 0.5, 9),
	},
	DogWalking = { pos = Vector3.new(0, 0, -12), counter = true, material = Enum.Material.WoodPlanks, baseColor = WOOD },
	SneakerFlipping = { pos = Vector3.new(6, 0, -8), counter = true, material = Enum.Material.Concrete },
	CarWash = { pos = Vector3.new(0, 0, -12), counter = true, material = Enum.Material.Metal },
	FoodTruck = { pos = Vector3.new(0, 0, -2), counter = true, material = Enum.Material.DiamondPlate },
	ContentCreator = { pos = Vector3.new(0, 0, -8), counter = true, material = Enum.Material.SmoothPlastic },
	StockDesk = { pos = Vector3.new(0, 0, -8), counter = true, material = Enum.Material.Metal },
	StartupHQ = { pos = Vector3.new(6, 0, -8), counter = true, material = Enum.Material.SmoothPlastic, baseColor = WHITE },
}
local DEFAULT_STATION: StationSpec = { pos = Vector3.new(0, 0, -10), counter = true }

-- Mechanic prop anchor per zone (zone-local CFrame; see buildMechanicProp).
local MECHANIC_PROP_CF: { [string]: CFrame } = {
	LemonadeStand = CFrame.new(0, 3.7, 9), -- SQUEEZE! button on the stand top
	DogWalking = CFrame.new(0, 0, -19), -- paw-print path in front of the counter
	SneakerFlipping = CFrame.new(-4, 0, -6), -- hype board left of the counter
	CarWash = CFrame.new(0, 0, 8), -- roller conveyor through the tunnel
	FoodTruck = CFrame.new(0, 3.5, -2), -- GRILL! button on the counter top
	ContentCreator = CFrame.new(-6, 0, -9), -- hype meter column
	StockDesk = CFrame.new(-8, 0, -5), -- ticker board
	StartupHQ = CFrame.new(-1, 0, -9), -- funding meter column
}

local function buildZone(zonesFolder: Folder, zone: GameConfig.ZoneDef)
	-- Contract: the same function the client uses for nearest-zone lookups.
	local groundCF = Mechanics.zoneGroundCFrame(zone.Order)

	local zoneModel = Instance.new("Model")
	zoneModel.Name = zone.Id
	zoneModel:SetAttribute("ZoneId", zone.Id)
	zoneModel.Parent = zonesFolder

	-- Colored floor pad: the brightest ground in town (signature color mixed
	-- 35% toward white) striped like a carpet: five 9.6-wide stripes run from
	-- the gate to the back (local Z) over the middle 48 x 48, the center and
	-- outer stripes in the near-full signature color (10% white; Startup HQ's
	-- accent blue 25% white), the two between light (60% white), so even a
	-- pale signature (Car Wash aqua) reads as a bold carpet from the gate to
	-- the counter, never an empty pool floor. Chunky signature curbs with neon strips on the
	-- three non-entrance edges. Startup HQ's SignColor is near-white, so its
	-- pad, stripes and curbs are built from the AccentColor blue instead.
	-- The pad is 3 thick centered on Y=0: top at PAD_TOP, bottom buried.
	local signFace = zoneSignFace(zone)
	local isPaleSign = signFace ~= zone.SignColor
	local padColor = if isPaleSign then Color3.fromRGB(196, 220, 255) else zone.SignColor:Lerp(WHITE, 0.35)
	-- neon edge strips: the zone's neon accent; white on Startup HQ's blue curbs
	local edgeNeon = if isPaleSign then NEON_WHITE else neonAccent(zone)
	makeBlock({
		name = "ZonePad", parent = zoneModel, size = Vector3.new(PAD_SIZE, PAD_TOP * 2, PAD_SIZE),
		cframe = groundCF, color = padColor,
	})
	if zone.Id ~= "DogWalking" then -- the dog park's lawn already covers its pad
		local stripeBase = if isPaleSign then zone.AccentColor else zone.SignColor
		local rich, light = stripeBase:Lerp(WHITE, if isPaleSign then 0.25 else 0.1), stripeBase:Lerp(WHITE, 0.6)
		for i, x in { -19.2, -9.6, 0, 9.6, 19.2 } do
			makeBlock({
				name = "PadStripe", parent = zoneModel, size = Vector3.new(9.6, 0.06, PAD_SIZE - 16),
				cframe = groundCF * CFrame.new(x, PAD_TOP + 0.03, 0), color = if i % 2 == 1 then rich else light,
				canCollide = false, castShadow = false,
			})
		end
	end
	local curbW, curbH = 2, 0.5
	local edge = PAD_SIZE / 2 - curbW / 2
	-- front (entrance, toward the plaza) and back curbs run the full width;
	-- side curbs fit between them
	for _, zOff in { -edge, edge } do
		makeBlock({
			name = "PadCurb", parent = zoneModel, size = Vector3.new(PAD_SIZE, curbH, curbW),
			cframe = groundCF * CFrame.new(0, PAD_TOP + curbH / 2, zOff), color = signFace,
			canCollide = false, castShadow = false,
		})
	end
	for _, xOff in { -edge, edge } do
		makeBlock({
			name = "PadCurb", parent = zoneModel, size = Vector3.new(curbW, curbH, PAD_SIZE - curbW * 2),
			cframe = groundCF * CFrame.new(xOff, PAD_TOP + curbH / 2, 0), color = signFace,
			canCollide = false, castShadow = false,
		})
		makeBlock({
			name = "PadCurbNeon", parent = zoneModel, size = Vector3.new(0.6, 0.2, PAD_SIZE - curbW * 2),
			cframe = groundCF * CFrame.new(xOff, PAD_TOP + curbH + 0.1, 0), color = edgeNeon,
			material = Enum.Material.Neon, canCollide = false, castShadow = false,
		})
	end
	makeBlock({
		name = "PadCurbNeon", parent = zoneModel, size = Vector3.new(PAD_SIZE, 0.2, 0.6),
		cframe = groundCF * CFrame.new(0, PAD_TOP + curbH + 0.1, edge), color = edgeNeon,
		material = Enum.Material.Neon, canCollide = false, castShadow = false,
	})
	-- Entrance carpet on the outer sidewalk: links the zebra crossing to the
	-- gate (zone-local z -45..-32, r 105..118), flush enough (top <= ROAD_TOP
	-- + 0.08) for walkers and crossers to pass over it.
	makeBlock({
		name = "EntranceCarpet", parent = zoneModel, size = Vector3.new(14, 0.06, 13),
		cframe = groundCF * CFrame.new(0, ROAD_TOP + 0.03, -38.5), color = signFace,
		canCollide = false, castShadow = false,
	})
	for _, xOff in { -7.25, 7.25 } do
		makeBlock({
			name = "EntranceCarpetNeon", parent = zoneModel, size = Vector3.new(0.5, 0.08, 13),
			cframe = groundCF * CFrame.new(xOff, ROAD_TOP + 0.04, -38.5), color = edgeNeon,
			material = Enum.Material.Neon, canCollide = false, castShadow = false,
		})
	end

	local zoneCF = groundCF * CFrame.new(0, PAD_TOP, 0)
	local builder = ZONE_BUILDERS[zone.Id] or buildGenericZone
	builder(zoneModel, zoneCF, zone)

	local stationSpec = STATIONS[zone.Id] or DEFAULT_STATION
	buildHustleStation(zoneModel, zoneCF, zone, stationSpec)
	buildMechanicProp(zoneModel, zoneCF * (MECHANIC_PROP_CF[zone.Id] or CFrame.new(-6, 0, -6)), zone, stationSpec.counter)
	-- Themed clutter on the pad (keeps the gate -> counter walkway and the
	-- prompt / automation anchor clear; see ZoneDressing).
	ZoneDressing.build(zoneModel, zoneCF, zone)

	-- Entrance lamps on the sidewalk just in front of the pad, in the zone's
	-- own colors (pole = sign face 15% toward navy, base 35%), so every
	-- entrance is framed by a pair of lamps that point at its zone.
	local lampPole = signFace:Lerp(NAVY, 0.15)
	local lampBase = signFace:Lerp(NAVY, 0.35)
	for _, xOff in { -16, 16 } do
		local lamp = makeModel("EntranceLamp", zoneModel)
		buildLampPost(lamp, groundCF * CFrame.new(xOff, ROAD_TOP, -35), lampPole, lampBase)
	end

	if zone.UnlockLevel > 1 then
		buildGate(zoneModel, zoneCF, zone)
	end
end

----------------------------------------------------------------------
-- Decor: road-side signposts (the city lives in CityBuilder)
----------------------------------------------------------------------

-- Small signpost (warm brown post): a board in the zone's signature color with the zone
-- name in white and a diamond arrow tip on the board's +X end.
local function buildSignpost(parent: Instance, cf: CFrame, text: string, color: Color3)
	makeBlock({
		name = "SignpostPole", parent = parent, size = Vector3.new(0.5, 5.2, 0.5),
		cframe = cf * CFrame.new(0, 2.6, 0), color = MapKit.TRUNK, -- warm brown, never near-black at eye level
	})
	local board = makeBlock({
		name = "SignpostBoard", parent = parent, size = Vector3.new(6, 1.5, 0.35),
		cframe = cf * CFrame.new(1.2, 4.6, 0), color = color, canCollide = false,
	})
	addSurfaceText(board, text, Enum.Font.FredokaOne, WHITE, Enum.NormalId.Front, nil, color)
	makeBlock({
		name = "SignpostTip", parent = parent, size = Vector3.new(1.06, 1.06, 0.35),
		cframe = cf * CFrame.new(4.2, 4.6, 0) * CFrame.Angles(0, 0, math.rad(45)), color = color, canCollide = false,
	})
end

local function buildDecor(parent: Instance)
	-- (No beach palms: at r 347-350 they stood behind the 64-185-stud outer
	-- ring where no player ever saw them; their parts paid for city life.)
	-- Road-side signposts (CityLayout.signposts): a few degrees past each
	-- zone, board facing the plaza, arrow tip swung back toward the zone's pad.
	for _, post in CityLayout.signposts do
		local zone = GameConfig.getZone(post.zoneId)
		if zone then
			buildSignpost(parent, post.cframe, zone.Name, zoneSignFace(zone))
		end
	end
end

----------------------------------------------------------------------
-- Public API
----------------------------------------------------------------------

function MapBuilder.build(): ()
	if Workspace:FindFirstChild("SideHustleMap") then
		return
	end

	setupLighting()

	local okTerrain, terrainErr = pcall(buildTerrain)
	if not okTerrain then
		warn("[MapBuilder] Terrain generation failed: " .. tostring(terrainErr))
	end
	local okStyle, styleErr = pcall(styleTerrain)
	if not okStyle then
		warn("[MapBuilder] Terrain styling failed: " .. tostring(styleErr))
	end

	local map = Instance.new("Folder")
	map.Name = "SideHustleMap"

	local ground = buildGround(map, okTerrain)
	buildPlaza(map)

	local zonesFolder = Instance.new("Folder")
	zonesFolder.Name = "Zones"
	zonesFolder.Parent = map

	for _, zone in GameConfig.Zones do
		buildZone(zonesFolder, zone)
	end

	buildDecor(ground)

	-- The downtown: street markings + traffic lights, skyline, storefronts,
	-- zone anchor buildings, street furniture and plaza buzz.
	CityBuilder.build(map)

	map.Parent = Workspace
end

return MapBuilder
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="28">
        <Properties>
          <string name="Name">MapKit</string>
          <string name="Source"><![CDATA[--!nonstrict
-- MapKit: primitive part helpers + shared palette for the World builders
-- (MapBuilder, CityBuilder, ZoneDressing). Blocks / Balls / Cylinders /
-- Wedges / CornerWedges only: no meshes, no Toolbox, no asset ids. Every part
-- is Anchored, SmoothPlastic unless told otherwise, smooth surfaces.

local MapKit = {}

local RAD_90 = math.rad(90)
MapKit.RAD_90 = RAD_90

----------------------------------------------------------------------
-- Shared palette
----------------------------------------------------------------------

MapKit.NAVY = Color3.fromRGB(4, 4, 53)
MapKit.WHITE = Color3.fromRGB(248, 248, 244)
MapKit.CREAM = Color3.fromRGB(247, 238, 214)
MapKit.WOOD = Color3.fromRGB(133, 94, 62)
MapKit.DARK_WOOD = Color3.fromRGB(96, 66, 42)
MapKit.LEAF_GREEN = Color3.fromRGB(76, 160, 66)
MapKit.LAMP_WARM = Color3.fromRGB(255, 220, 160)
-- Cartoon slate blue, not near-black: dark hardware at eye level reads as
-- gritty next to the bright city (everything is SmoothPlastic, see applyCommon).
MapKit.METAL_DARK = Color3.fromRGB(78, 92, 140)
MapKit.WHEEL_DARK = Color3.fromRGB(38, 38, 42)
MapKit.NEON_WHITE = Color3.fromRGB(255, 255, 255) -- marquee frames around signature boards
-- Street hardware is toy-city cobalt, never gunmetal / near-black: poles,
-- arms, legs and posts in STREET_POLE, their foot plates in STREET_BASE.
MapKit.STREET_POLE = Color3.fromRGB(60, 96, 196)
MapKit.STREET_BASE = Color3.fromRGB(44, 72, 160)
-- Tree trunks: a warm cartoon brown (DARK_WOOD Wood rendered near-black in shade).
MapKit.TRUNK = Color3.fromRGB(150, 102, 64)
-- Stock Desk screens / backdrop / ticker pillars: a deep ticker green (a local
-- override of the zone's near-black AccentColor, which stays in GameConfig).
MapKit.STOCK_DEEP_GREEN = Color3.fromRGB(18, 84, 58)

-- Bright flower heads (plaza beds, planters, window boxes).
MapKit.FLOWER_COLORS = {
	Color3.fromRGB(255, 212, 31),
	Color3.fromRGB(255, 92, 180),
	Color3.fromRGB(64, 200, 224),
	Color3.fromRGB(255, 123, 34),
	Color3.fromRGB(180, 160, 255),
	Color3.fromRGB(250, 250, 255),
}

-- Face color for a zone's signature boards: the SignColor, except for a
-- near-white SignColor (Startup HQ) whose white text would vanish: then the
-- AccentColor.
function MapKit.zoneSignFace(zone): Color3
	local c = zone.SignColor
	local luminance = 0.299 * c.R + 0.587 * c.G + 0.114 * c.B
	return if luminance > 0.85 then zone.AccentColor else c
end

----------------------------------------------------------------------
-- Parts
----------------------------------------------------------------------

export type PartProps = {
	name: string?,
	parent: Instance,
	size: Vector3?,
	cframe: CFrame,
	color: Color3,
	material: Enum.Material?,
	transparency: number?,
	reflectance: number?,
	canCollide: boolean?,
	castShadow: boolean?, -- default true
	diameter: number?,
	height: number?,
	axis: string?, -- cylinders: "Y" (default), "X", "Z"
}

-- Art guide: "Mostly SmoothPlastic and Neon. Avoid realistic textures; they
-- clash with the style." Wood grain, brushed metal, marble etc. read as
-- realistic next to the cartoon city, so every other material falls back to
-- SmoothPlastic here (terrain materials are unaffected: they are not parts).
-- Keyed by name: EnumItem identity is not guaranteed outside Roblox (the
-- offline Lune check/render tools create a fresh EnumItem per access).
local STYLE_MATERIALS = {
	SmoothPlastic = true,
	Neon = true,
	Glass = true,
	ForceField = true,
}

local function applyCommon(part: BasePart, props: PartProps)
	part.Name = props.name or "Part"
	part.Color = props.color
	local material = props.material or Enum.Material.SmoothPlastic
	part.Material = if STYLE_MATERIALS[material.Name] then material else Enum.Material.SmoothPlastic
	part.Transparency = props.transparency or 0
	part.Reflectance = props.reflectance or 0
	part.CanCollide = if props.canCollide ~= nil then props.canCollide else true
	if props.castShadow == false then
		part.CastShadow = false
	end
	part.Anchored = true
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
end

function MapKit.makeBlock(props: PartProps): Part
	local part = Instance.new("Part")
	part.Shape = Enum.PartType.Block
	part.Size = props.size :: Vector3
	part.CFrame = props.cframe
	applyCommon(part, props)
	part.Parent = props.parent
	return part
end

-- Balls are always uniform (Roblox keeps Ball parts spherical); pass `diameter`
-- or a uniform `size`.
function MapKit.makeBall(props: PartProps): Part
	local part = Instance.new("Part")
	part.Shape = Enum.PartType.Ball
	local d = props.diameter or (props.size :: Vector3).X
	part.Size = Vector3.new(d, d, d)
	part.CFrame = props.cframe
	applyCommon(part, props)
	part.Parent = props.parent
	return part
end

-- Cylinder whose length axis is vertical ("Y", default), or along "X"/"Z".
function MapKit.makeCylinder(props: PartProps): Part
	local part = Instance.new("Part")
	part.Shape = Enum.PartType.Cylinder
	local diameter = props.diameter or 1
	local height = props.height or 1
	part.Size = Vector3.new(height, diameter, diameter)
	local axis = props.axis or "Y"
	if axis == "Y" then
		part.CFrame = props.cframe * CFrame.Angles(0, 0, RAD_90)
	elseif axis == "Z" then
		part.CFrame = props.cframe * CFrame.Angles(0, RAD_90, 0)
	else -- "X": native cylinder axis
		part.CFrame = props.cframe
	end
	applyCommon(part, props)
	part.Parent = props.parent
	return part
end

-- WedgePart: full height at local +Z (back face vertical), sloping down to -Z.
function MapKit.makeWedge(props: PartProps): WedgePart
	local part = Instance.new("WedgePart")
	part.Size = props.size :: Vector3
	part.CFrame = props.cframe
	applyCommon(part, props)
	part.Parent = props.parent
	return part
end

function MapKit.makeModel(name: string, parent: Instance): Model
	local model = Instance.new("Model")
	model.Name = name
	model.Parent = parent
	return model
end

-- Invisible, non-colliding, non-queryable anchor (FeedbackPart, AutoAnchor,
-- particle emitter volumes).
function MapKit.makeMarker(parent: Instance, name: string, cf: CFrame, size: Vector3?): Part
	local part = Instance.new("Part")
	part.Name = name
	part.Size = size or Vector3.new(1, 1, 1)
	part.CFrame = cf
	part.Transparency = 1
	part.CanCollide = false
	part.CanTouch = false
	part.CanQuery = false
	part.CastShadow = false
	part.Anchored = true
	part.Parent = parent
	return part
end

----------------------------------------------------------------------
-- Text + light
----------------------------------------------------------------------

function MapKit.makeTextLabel(
	parent: Instance,
	text: string,
	font: Enum.Font,
	textColor: Color3,
	position: UDim2,
	size: UDim2
): TextLabel
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Position = position
	label.Size = size
	label.Font = font
	label.Text = text
	label.TextColor3 = textColor
	label.TextScaled = true
	label.TextStrokeColor3 = MapKit.NAVY
	label.TextStrokeTransparency = 0
	-- Chunky navy outline (the art guide's sticker look) so light text reads
	-- on bright signature-colored boards from across the plaza. SurfaceGui
	-- labels scale it with the label's pixel height (labelPx = face height in
	-- studs x PixelsPerStud x the label's height scale, through any parent
	-- frames): clamp(round(0.055 * labelPx), 4, 9) px, so a big board's
	-- outline never goes sub-pixel at 150-200 studs. BillboardGui labels: 3 px.
	local surfaceGui = if parent:IsA("SurfaceGui") then parent else parent:FindFirstAncestorWhichIsA("SurfaceGui")
	local stroke = Instance.new("UIStroke")
	stroke.Color = MapKit.NAVY
	stroke.Thickness = 3
	if surfaceGui then
		local heightScale = size.Y.Scale
		local node: Instance? = parent
		while node and node ~= surfaceGui do
			if node:IsA("GuiObject") then
				heightScale *= (node :: GuiObject).Size.Y.Scale
			end
			node = node.Parent
		end
		local adornee = (surfaceGui :: SurfaceGui).Adornee or surfaceGui.Parent
		local faceHeight = 0
		if adornee and adornee:IsA("BasePart") then
			local _, h = MapKit.faceSize(adornee, (surfaceGui :: SurfaceGui).Face)
			faceHeight = h
		end
		local labelPx = faceHeight * (surfaceGui :: SurfaceGui).PixelsPerStud * heightScale
		stroke.Thickness = math.clamp(math.floor(0.055 * labelPx + 0.5), 4, 9)
	end
	stroke.LineJoinMode = Enum.LineJoinMode.Round
	stroke.Parent = label
	label.Parent = parent
	return label
end

-- Width / height (studs) of one face of a part as its SurfaceGui sees it
-- (Front/Back: X x Y, Left/Right: Z x Y, Top/Bottom: X x Z).
function MapKit.faceSize(part: BasePart, face: Enum.NormalId): (number, number)
	local s = part.Size
	if face == Enum.NormalId.Left or face == Enum.NormalId.Right then
		return s.Z, s.Y
	elseif face == Enum.NormalId.Top or face == Enum.NormalId.Bottom then
		return s.X, s.Z
	end
	return s.X, s.Y
end

-- Flat painted rectangle in a SurfaceGui (or a Frame): scale position /
-- size, borderless, optional transparency, rounded corners (UICorner scale)
-- and rotation (degrees).
export type GuiFrameProps = {
	name: string?,
	parent: Instance,
	position: UDim2,
	size: UDim2,
	color: Color3,
	anchor: Vector2?,
	transparency: number?,
	corner: number?, -- UICorner CornerRadius scale (0.5 = circle / pill)
	rotation: number?,
	zIndex: number?,
	clips: boolean?,
}

function MapKit.makeGuiFrame(props: GuiFrameProps): Frame
	local frame = Instance.new("Frame")
	frame.Name = props.name or "Frame"
	frame.AnchorPoint = props.anchor or Vector2.new(0, 0)
	frame.Position = props.position
	frame.Size = props.size
	frame.BackgroundColor3 = props.color
	frame.BackgroundTransparency = props.transparency or 0
	frame.BorderSizePixel = 0
	frame.Rotation = props.rotation or 0
	frame.ZIndex = props.zIndex or 1
	frame.ClipsDescendants = props.clips == true
	if props.corner then
		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(props.corner, 0)
		corner.Parent = frame
	end
	frame.Parent = props.parent
	return frame
end

-- PAINTED window bands (zero parts) on one face of a building body whose
-- bottom sits on the ground: a lit SurfaceGui "Windows" (LightInfluence 1,
-- so the paint shades with its wall; 2 px/stud, no Face frame) with one
-- Frame per band (centered at height y studs above the body's bottom,
-- opts.width wide, opts.height (3.6) tall, opts.color), a 0.3-stud sill in
-- the band color 35% toward navy under each, and optional mullions
-- (opts.mullions = face-local x offsets from the center, opts.mullionWidth
-- 1.2, from opts.mullionBottom to the top band's top + 0.8, opts.body color)
-- painted over the bands. For faces seen only from >= 150 studs, where flat
-- paint reads exactly like the 0.6-stud part bands it replaces.
export type PaintBandOpts = {
	width: number,
	height: number?,
	color: Color3,
	mullions: { number }?,
	mullionWidth: number?,
	mullionBottom: number?,
	body: Color3?,
}

function MapKit.paintBands(part: BasePart, face: Enum.NormalId, rows: { number }, opts: PaintBandOpts): SurfaceGui
	local fw, fh = MapKit.faceSize(part, face)
	local gui = Instance.new("SurfaceGui")
	gui.Name = "Windows"
	gui.Face = face
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 2
	gui.LightInfluence = 1
	gui.Brightness = 1
	local bandH = opts.height or 3.6
	local sill = opts.color:Lerp(MapKit.NAVY, 0.35)
	local topEdge = 0
	for _, y in rows do
		topEdge = math.max(topEdge, y + bandH / 2)
		MapKit.makeGuiFrame({
			name = "Band", parent = gui, anchor = Vector2.new(0.5, 0),
			position = UDim2.fromScale(0.5, (fh - y - bandH / 2) / fh),
			size = UDim2.fromScale(opts.width / fw, bandH / fh), color = opts.color, zIndex = 1,
		})
		MapKit.makeGuiFrame({
			name = "Sill", parent = gui, anchor = Vector2.new(0.5, 0),
			position = UDim2.fromScale(0.5, (fh - y + bandH / 2) / fh),
			size = UDim2.fromScale((opts.width + 0.6) / fw, 0.3 / fh), color = sill, zIndex = 1,
		})
	end
	if opts.mullions and #rows > 0 then
		local bottom = opts.mullionBottom or 9.5
		local top = topEdge + 0.8
		for _, x in opts.mullions do
			MapKit.makeGuiFrame({
				name = "Mullion", parent = gui, anchor = Vector2.new(0.5, 0),
				position = UDim2.fromScale(0.5 + x / fw, (fh - top) / fh),
				size = UDim2.fromScale((opts.mullionWidth or 1.2) / fw, (top - bottom) / fh),
				color = opts.body or MapKit.WHITE, zIndex = 2,
			})
		end
	end
	gui.Parent = part
	return gui
end

-- PAINTED ground deck (road markings, the spawn mat): an invisible, flat,
-- non-colliding, non-queryable part (Transparency 1, 0.05 thick) whose BACK
-- face points up and carries a SurfaceGui `guiName`. `cf` is a horizontal
-- frame at the deck's center (its Y = the deck's center height): the gui's
-- up runs along cf's -Z and its right along cf's +X. A side face is used on
-- purpose: Roblox orients side-face guis unambiguously (up = part +Y, Back
-- face right = part +X), so painted positions never depend on the Top-face
-- convention. Roblox renders SurfaceGuis on fully transparent parts.
-- Returns the part and the gui; place Frames with MapKit.deckPixel /
-- MapKit.deckRotation (pixels: divide by the gui's pixel size and use
-- UDim2 SCALE, since UDim offsets are whole pixels).
function MapKit.makeGroundDeck(
	parent: Instance,
	name: string,
	cf: CFrame,
	width: number,
	depth: number,
	pixelsPerStud: number,
	guiName: string,
	lightInfluence: number?,
	brightness: number?
): (Part, SurfaceGui)
	local part = Instance.new("Part")
	part.Name = name
	part.Shape = Enum.PartType.Block
	part.Size = Vector3.new(width, depth, 0.05)
	part.CFrame = cf * CFrame.Angles(-RAD_90, 0, 0)
	part.Transparency = 1
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.CastShadow = false
	part.Anchored = true
	part.Material = Enum.Material.SmoothPlastic
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	local gui = Instance.new("SurfaceGui")
	gui.Name = guiName
	gui.Face = Enum.NormalId.Back
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = pixelsPerStud
	gui.LightInfluence = lightInfluence or 1
	gui.Brightness = brightness or 1
	gui.Parent = part
	part.Parent = parent
	return part, gui
end

-- Gui pixel offset (x right, y down) of a world point on a ground deck made
-- from `cf` (width x depth studs at `pixelsPerStud`).
function MapKit.deckPixel(cf: CFrame, width: number, depth: number, pixelsPerStud: number, worldPos: Vector3): (number, number)
	local l = cf:PointToObjectSpace(worldPos)
	return (l.X + width / 2) * pixelsPerStud, (l.Z + depth / 2) * pixelsPerStud
end

-- Gui Rotation (degrees, clockwise on the deck) that lines a Frame's width
-- axis up with the world direction `dir` on a ground deck made from `cf`.
function MapKit.deckRotation(cf: CFrame, dir: Vector3): number
	local l = cf:VectorToObjectSpace(dir)
	return math.deg(math.atan2(l.Z, l.X))
end

-- SurfaceGui text on one face of a part. `pixelsPerStud` defaults to 30; big
-- far-away boards pass less to keep texture memory small.
-- `faceColor` (sign boards): a full-face Frame "Face" in that color under the
-- text. The gui is unlit (LightInfluence 0, Brightness 1.1), so the board
-- face shows its true color from every angle whatever the sun does: a sign
-- turned away from the sun never reads as a switched-off grey slab.
function MapKit.addSurfaceText(
	part: BasePart,
	text: string,
	font: Enum.Font,
	textColor: Color3,
	face: Enum.NormalId,
	pixelsPerStud: number?,
	faceColor: Color3?
): SurfaceGui
	local gui = Instance.new("SurfaceGui")
	gui.Face = face
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = pixelsPerStud or 30
	gui.LightInfluence = 0
	if faceColor then
		gui.Brightness = 1.1
		local frame = Instance.new("Frame")
		frame.Name = "Face"
		frame.Size = UDim2.fromScale(1, 1)
		frame.BackgroundColor3 = faceColor
		frame.BackgroundTransparency = 0
		frame.BorderSizePixel = 0
		frame.ZIndex = 1
		frame.Parent = gui
	end
	gui.Parent = part
	local label = MapKit.makeTextLabel(gui, text, font, textColor, UDim2.fromScale(0.03, 0.05), UDim2.fromScale(0.94, 0.9))
	label.ZIndex = 2
	return gui
end

function MapKit.addPointLight(parent: BasePart, color: Color3, range: number, brightness: number): PointLight
	local light = Instance.new("PointLight")
	light.Color = color
	light.Range = range
	light.Brightness = brightness
	light.Shadows = false
	light.Parent = parent
	return light
end

----------------------------------------------------------------------
-- Layout + shared decor
----------------------------------------------------------------------

-- Position on a ring around the origin (XZ plane).
function MapKit.ringPos(radius: number, degrees: number, y: number?): Vector3
	local angle = math.rad(degrees)
	return Vector3.new(math.cos(angle) * radius, y or 0, math.sin(angle) * radius)
end

-- Plaza-style lamp post (collidable base + pole, neon bulb with a warm
-- PointLight); `cf` = base center on the ground. SmoothPlastic, cobalt by
-- default (STREET_POLE pole, STREET_BASE foot); the zone entrance lamps pass
-- their zone's colors.
function MapKit.buildLampPost(parent: Instance, cf: CFrame, poleColor: Color3?, baseColor: Color3?)
	MapKit.makeCylinder({
		name = "LampBase", parent = parent, diameter = 2, height = 0.5,
		cframe = cf * CFrame.new(0, 0.25, 0), color = baseColor or MapKit.STREET_BASE,
	})
	MapKit.makeCylinder({
		name = "LampPole", parent = parent, diameter = 0.7, height = 8,
		cframe = cf * CFrame.new(0, 4.25, 0), color = poleColor or MapKit.STREET_POLE,
	})
	local bulb = MapKit.makeBall({
		name = "LampBulb", parent = parent, diameter = 2.4,
		cframe = cf * CFrame.new(0, 8.9, 0), color = Color3.fromRGB(255, 232, 170),
		material = Enum.Material.Neon, canCollide = false,
	})
	MapKit.addPointLight(bulb, MapKit.LAMP_WARM, 18, 0.9)
end

-- Cartoon lollipop tree (3 sizes): trunk + one to three leaf puffs.
-- Leaves never collide; `noShadow` drops the shadow of the whole tree.
function MapKit.buildTree(parent: Instance, position: Vector3, scale: number, noShadow: boolean?)
	local cf = CFrame.new(position)
	local shadow = if noShadow then false else nil
	local leaf = MapKit.LEAF_GREEN
	MapKit.makeCylinder({
		name = "TreeTrunk", parent = parent, diameter = 1.6 * scale, height = 6 * scale,
		cframe = cf * CFrame.new(0, 3 * scale, 0), color = MapKit.TRUNK,
		castShadow = shadow,
	})
	if scale < 0.9 then
		MapKit.makeBall({
			name = "TreeLeaves", parent = parent, diameter = 5.6 * scale,
			cframe = cf * CFrame.new(0, 6.6 * scale, 0), color = leaf, canCollide = false, castShadow = shadow,
		})
	elseif scale < 1.5 then
		MapKit.makeBall({
			name = "TreeLeaves", parent = parent, diameter = 6 * scale,
			cframe = cf * CFrame.new(0, 6.5 * scale, 0), color = leaf, canCollide = false, castShadow = shadow,
		})
		MapKit.makeBall({
			name = "TreeLeaves", parent = parent, diameter = 4.6 * scale,
			cframe = cf * CFrame.new(1.2 * scale, 8 * scale, 0.8 * scale), color = Color3.fromRGB(88, 176, 74),
			canCollide = false, castShadow = shadow,
		})
		MapKit.makeBall({
			name = "TreeLeaves", parent = parent, diameter = 4 * scale,
			cframe = cf * CFrame.new(-1.4 * scale, 7.4 * scale, -0.6 * scale), color = Color3.fromRGB(96, 188, 80),
			canCollide = false, castShadow = shadow,
		})
	else
		MapKit.makeBall({
			name = "TreeLeaves", parent = parent, diameter = 7 * scale,
			cframe = cf * CFrame.new(0, 6.4 * scale, 0), color = leaf, canCollide = false, castShadow = shadow,
		})
		MapKit.makeBall({
			name = "TreeLeaves", parent = parent, diameter = 5.2 * scale,
			cframe = cf * CFrame.new(0, 9.4 * scale, 0), color = Color3.fromRGB(88, 176, 74),
			canCollide = false, castShadow = shadow,
		})
		MapKit.makeBall({
			name = "TreeLeaves", parent = parent, diameter = 3.6 * scale,
			cframe = cf * CFrame.new(0, 11.6 * scale, 0), color = Color3.fromRGB(96, 188, 80),
			canCollide = false, castShadow = shadow,
		})
	end
end

return MapKit
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="29">
        <Properties>
          <string name="Name">ZoneDressing</string>
          <string name="Source"><![CDATA[--!nonstrict
-- ZoneDressing: themed clutter that turns each 64 x 64 zone pad into a busy
-- mini-district (cafe tables at the Lemonade Stand, agility hoops at Dog
-- Walking, a velvet-rope queue at Sneaker Street ...). Built into
-- <ZoneId>.Dressing in zone-local space (zoneCF = pad top center, -Z faces the
-- plaza, pad spans x / z -32..32).
--
-- Keep-outs (tools/check_map.luau audits the colliders): the walkway from the
-- gate (z -32) to the counter (|x| < 8, or the diagonal to an off-center
-- counter), 6 studs around PromptPart / AutoAnchor, and every existing prop.
-- Small parts never collide and never cast shadows; only a few big props far
-- from the walkway (parked cars, giant bottles) collide.

local MapKit = require(script.Parent.MapKit)

local makeBlock = MapKit.makeBlock
local makeBall = MapKit.makeBall
local makeCylinder = MapKit.makeCylinder
local makeModel = MapKit.makeModel
local addSurfaceText = MapKit.addSurfaceText

local ZoneDressing = {}

local NAVY = MapKit.NAVY
local WHITE = MapKit.WHITE
local WOOD = MapKit.WOOD
local DARK_WOOD = MapKit.DARK_WOOD
local POLE = MapKit.STREET_POLE -- toy-city cobalt hardware (table poles, posts, legs)

local function deco(props)
	if props.canCollide == nil then
		props.canCollide = false
	end
	if props.castShadow == nil then
		props.castShadow = false
	end
	return props
end
local function block(props)
	return makeBlock(deco(props))
end
local function ball(props)
	return makeBall(deco(props))
end
local function cylinder(props)
	return makeCylinder(deco(props))
end

-- Local CFrame helper: position (x, y, z) in zone space, optional yaw (deg).
local function at(zoneCF: CFrame, x: number, y: number, z: number, yawDeg: number?): CFrame
	local cf = zoneCF * CFrame.new(x, y, z)
	if yawDeg then
		cf *= CFrame.Angles(0, math.rad(yawDeg), 0)
	end
	return cf
end

-- A thin block spanning two points (wires, ropes, strings).
local function span(parent: Instance, name: string, from: Vector3, to: Vector3, thickness: number, color: Color3, material: Enum.Material?)
	local length = (to - from).Magnitude
	block({
		name = name, parent = parent, size = Vector3.new(thickness, thickness, length),
		cframe = CFrame.lookAt((from + to) / 2, to), color = color, material = material,
	})
end

----------------------------------------------------------------------
-- Shared small props
----------------------------------------------------------------------

-- Cartoon car (static). cf = ground center, car points along local +X.
local function buildCar(parent: Instance, cf: CFrame, color: Color3)
	makeBlock({
		name = "CarBody", parent = parent, size = Vector3.new(8, 2.2, 4.2),
		cframe = cf * CFrame.new(0, 2.1, 0), color = color, castShadow = true,
	})
	block({
		name = "CarCabin", parent = parent, size = Vector3.new(4.2, 1.9, 3.8),
		cframe = cf * CFrame.new(-0.5, 4.1, 0), color = Color3.fromRGB(170, 225, 255), castShadow = true,
	})
	block({
		name = "CarRoof", parent = parent, size = Vector3.new(4.4, 0.4, 4),
		cframe = cf * CFrame.new(-0.5, 5.2, 0), color = color,
	})
	for _, x in { -2.7, 2.7 } do
		for _, z in { -2.1, 2.1 } do
			cylinder({
				name = "CarWheel", parent = parent, diameter = 2, height = 0.8, axis = "Z",
				cframe = cf * CFrame.new(x, 1, z), color = MapKit.WHEEL_DARK,
			})
		end
	end
	for _, z in { -1.3, 1.3 } do
		ball({
			name = "CarHeadlight", parent = parent, diameter = 0.8,
			cframe = cf * CFrame.new(4, 2.4, z), color = Color3.fromRGB(255, 244, 190), material = Enum.Material.Neon,
		})
	end
end

-- Octagonal neon hoop standing upright, its opening facing local Z.
local function buildHoop(parent: Instance, cf: CFrame, radius: number, color: Color3)
	local side = 2 * radius * math.tan(math.rad(22.5))
	for i = 0, 7 do
		local a = math.rad(i * 45)
		block({
			name = "HoopBar", parent = parent, size = Vector3.new(side + 0.1, 0.35, 0.35),
			cframe = cf * CFrame.new(math.sin(a) * radius, math.cos(a) * radius, 0) * CFrame.Angles(0, 0, -a),
			color = color, material = Enum.Material.Neon,
		})
	end
end

----------------------------------------------------------------------
-- Per-zone dressing
----------------------------------------------------------------------

local DRESS: { [string]: (Instance, CFrame, any) -> () } = {}

-- Lemonade Stand: cafe tables with striped umbrellas, lemon crates, potted lemon trees
DRESS.LemonadeStand = function(parent, zoneCF, zone)
	local yellow = zone.SignColor
	for i, pos in { Vector3.new(-20, 0, -10), Vector3.new(-20, 0, 12), Vector3.new(20, 0, -10) } do
		local cf = at(zoneCF, pos.X, 0, pos.Z)
		cylinder({ name = "TableFoot", parent = parent, diameter = 2.2, height = 0.3, cframe = cf * CFrame.new(0, 0.15, 0), color = POLE })
		cylinder({ name = "TablePole", parent = parent, diameter = 0.4, height = 2.6, cframe = cf * CFrame.new(0, 1.4, 0), color = POLE })
		cylinder({ name = "TableTop", parent = parent, diameter = 5, height = 0.4, cframe = cf * CFrame.new(0, 2.9, 0), color = WHITE, castShadow = true })
		cylinder({ name = "UmbrellaPole", parent = parent, diameter = 0.25, height = 5.2, cframe = cf * CFrame.new(0, 5.6, 0), color = WHITE })
		cylinder({ name = "UmbrellaCanopy", parent = parent, diameter = 7, height = 0.5, cframe = cf * CFrame.new(0, 8.2, 0), color = yellow, castShadow = true })
		cylinder({ name = "UmbrellaStripe", parent = parent, diameter = 5, height = 0.55, cframe = cf * CFrame.new(0, 8.25, 0), color = WHITE })
		ball({ name = "UmbrellaFinial", parent = parent, diameter = 0.7, cframe = cf * CFrame.new(0, 8.75, 0), color = yellow })
		for j, x in { -3.4, 3.4 } do
			block({
				name = "Stool", parent = parent, size = Vector3.new(1.6, 1.6, 1.6),
				cframe = cf * CFrame.new(x, 0.8, 0), color = if (i + j) % 2 == 0 then Color3.fromRGB(255, 140, 120) else Color3.fromRGB(120, 210, 255),
			})
		end
	end
	-- Lemon crate stacks
	for i, pos in { Vector3.new(20, 0, 14), Vector3.new(24, 0, 20) } do
		local cf = at(zoneCF, pos.X, 0, pos.Z, i * 17)
		local levels = if i == 1 then 1 else 2
		for l = 1, levels do
			block({
				name = "LemonCrate", parent = parent, size = Vector3.new(3, 2, 3),
				cframe = cf * CFrame.new(0, 1 + (l - 1) * 2, 0) * CFrame.Angles(0, math.rad((l - 1) * 12), 0),
				color = WOOD, material = Enum.Material.WoodPlanks, castShadow = true,
			})
		end
		local top = levels * 2 + 0.5
		for _, off in { Vector3.new(-0.7, 0, -0.5), Vector3.new(0.7, 0, -0.4), Vector3.new(0, 0.3, 0.6) } do
			ball({ name = "Lemon", parent = parent, diameter = 1.4, cframe = cf * CFrame.new(off.X, top + off.Y, off.Z), color = yellow })
		end
	end
	-- Potted lemon trees in the four corners
	for _, x in { -27, 27 } do
		for _, z in { -27, 27 } do
			local cf = at(zoneCF, x, 0, z)
			cylinder({ name = "LemonPot", parent = parent, diameter = 3.2, height = 2, cframe = cf * CFrame.new(0, 1, 0), color = Color3.fromRGB(214, 120, 80) })
			cylinder({ name = "LemonTrunk", parent = parent, diameter = 0.7, height = 3, cframe = cf * CFrame.new(0, 3.3, 0), color = DARK_WOOD })
			ball({ name = "LemonLeaves", parent = parent, diameter = 4.6, cframe = cf * CFrame.new(0, 6, 0), color = Color3.fromRGB(96, 196, 80), castShadow = true })
			for _, off in { Vector3.new(1.6, 5.4, -1.4), Vector3.new(-1.7, 6.2, -1), Vector3.new(0.2, 7.3, -1.6) } do
				ball({ name = "LemonFruit", parent = parent, diameter = 0.9, cframe = cf * CFrame.new(off), color = yellow })
			end
		end
	end
end

-- Dog Walking: agility hoops + weave poles, a hydrant, dog bowls, a tennis-ball pit
DRESS.DogWalking = function(parent, zoneCF, zone)
	local lawn = 0.2 -- the park lawn sits 0.2 above the pad
	local green = Color3.fromRGB(80, 230, 110)
	for _, z in { -6, 4 } do
		local cf = at(zoneCF, -20, lawn, z)
		for _, x in { -2.6, 2.6 } do
			block({ name = "HoopPost", parent = parent, size = Vector3.new(0.4, 4.6, 0.4), cframe = cf * CFrame.new(x, 2.3, 0), color = WHITE })
		end
		buildHoop(parent, cf * CFrame.new(0, 2.6, 0), 2.1, green)
	end
	-- weave poles
	for i = 0, 4 do
		local cf = at(zoneCF, -22, lawn, 12 + i * 2.4)
		cylinder({
			name = "WeavePole", parent = parent, diameter = 0.4, height = 3.4,
			cframe = cf * CFrame.new(0, 1.7, 0), color = if i % 2 == 0 then zone.SignColor else WHITE,
		})
	end
	-- red hydrant (every dog's favorite)
	local hydrant = at(zoneCF, 20, lawn, 2)
	local red = Color3.fromRGB(235, 60, 60)
	cylinder({ name = "Hydrant", parent = parent, diameter = 1.5, height = 2.6, cframe = hydrant * CFrame.new(0, 1.3, 0), color = red, castShadow = true })
	ball({ name = "HydrantCap", parent = parent, diameter = 1.6, cframe = hydrant * CFrame.new(0, 2.6, 0), color = red })
	cylinder({ name = "HydrantNubs", parent = parent, diameter = 0.6, height = 2.3, axis = "X", cframe = hydrant * CFrame.new(0, 1.8, 0), color = Color3.fromRGB(255, 214, 60) })
	-- three dog bowls
	for i, x in { 16, 18.5, 21 } do
		local cf = at(zoneCF, x, lawn, -10)
		cylinder({
			name = "DogBowl", parent = parent, diameter = 1.7, height = 0.6, cframe = cf * CFrame.new(0, 0.3, 0),
			color = ({ Color3.fromRGB(255, 90, 90), Color3.fromRGB(60, 170, 255), Color3.fromRGB(255, 200, 40) })[i],
		})
		cylinder({ name = "DogFood", parent = parent, diameter = 1.2, height = 0.1, cframe = cf * CFrame.new(0, 0.6, 0), color = Color3.fromRGB(140, 90, 50) })
	end
	-- tennis-ball pit
	local pit = at(zoneCF, 21, lawn, 19)
	cylinder({ name = "BallPitWall", parent = parent, diameter = 8, height = 1.2, cframe = pit * CFrame.new(0, 0.6, 0), color = Color3.fromRGB(60, 150, 255) })
	cylinder({ name = "BallPitRim", parent = parent, diameter = 8.4, height = 0.3, cframe = pit * CFrame.new(0, 1.25, 0), color = WHITE })
	local tennis = Color3.fromRGB(214, 250, 60)
	for i = 0, 8 do
		local a = math.rad(i * 40)
		local r = if i == 8 then 0 else (if i % 2 == 0 then 2.4 else 1.3)
		ball({ name = "TennisBall", parent = parent, diameter = 1, cframe = pit * CFrame.new(math.cos(a) * r, 1.45 + (i % 3) * 0.25, math.sin(a) * r), color = tennis })
	end
end

-- Sneaker Street: shoe-box towers, display pedestals with mini sneakers, velvet-rope queue
DRESS.SneakerFlipping = function(parent, zoneCF, zone)
	local purple = zone.SignColor
	-- velvet-rope queue to the right of the store door
	local gold = Color3.fromRGB(255, 200, 60)
	local velvet = Color3.fromRGB(200, 30, 60)
	for _, z in { 3, 7 } do
		local tops = {}
		for _, x in { 13, 18, 23 } do
			local cf = at(zoneCF, x, 0, z)
			cylinder({ name = "Stanchion", parent = parent, diameter = 0.35, height = 2.6, cframe = cf * CFrame.new(0, 1.3, 0), color = gold })
			ball({ name = "StanchionTop", parent = parent, diameter = 0.6, cframe = cf * CFrame.new(0, 2.7, 0), color = gold })
			table.insert(tops, zoneCF:PointToWorldSpace(Vector3.new(x, 2.3, z)))
		end
		for i = 1, #tops - 1 do
			local mid = (tops[i] + tops[i + 1]) / 2 - Vector3.new(0, 0.35, 0)
			span(parent, "VelvetRope", tops[i], mid, 0.25, velvet)
			span(parent, "VelvetRope", mid, tops[i + 1], 0.25, velvet)
		end
	end
	-- display pedestals with mini sneakers (left column)
	local shoeColors = { Color3.fromRGB(255, 90, 90), Color3.fromRGB(60, 200, 255), purple }
	for i, z in { -16, -6, 6 } do
		local cf = at(zoneCF, -25, 0, z, 90)
		cylinder({ name = "DisplayPedestal", parent = parent, diameter = 3, height = 3, cframe = cf * CFrame.new(0, 1.5, 0), color = WHITE, castShadow = true })
		cylinder({ name = "DisplayRing", parent = parent, diameter = 3.1, height = 0.25, cframe = cf * CFrame.new(0, 2.6, 0), color = purple, material = Enum.Material.Neon })
		local shoe = cf * CFrame.new(0, 3, 0) * CFrame.Angles(0, math.rad(-20), 0)
		block({ name = "MiniSole", parent = parent, size = Vector3.new(2.6, 0.4, 1.1), cframe = shoe * CFrame.new(0, 0.2, 0), color = WHITE })
		block({ name = "MiniUpper", parent = parent, size = Vector3.new(1.7, 0.9, 1.05), cframe = shoe * CFrame.new(-0.35, 0.85, 0), color = shoeColors[i] })
		ball({ name = "MiniToe", parent = parent, diameter = 1.05, cframe = shoe * CFrame.new(0.65, 0.7, 0), color = shoeColors[i] })
	end
	-- shoe-box towers
	for t, pos in { Vector3.new(-18, 0, 15), Vector3.new(18, 0, 16), Vector3.new(24, 0, -19) } do
		local cf = at(zoneCF, pos.X, 0, pos.Z, t * 23)
		local height = 4 + t % 2
		for b = 0, height - 1 do
			block({
				name = "ShoeBox", parent = parent, size = Vector3.new(3, 1.5, 2),
				cframe = cf * CFrame.new(0, 0.75 + b * 1.5, 0) * CFrame.Angles(0, math.rad((b % 3 - 1) * 9), 0),
				color = if b % 2 == 0 then purple else WHITE, castShadow = b == 0,
			})
		end
	end
end

-- Car Wash: two queued cars, a giant soap bottle, floating bubbles, buckets
DRESS.CarWash = function(parent, zoneCF, zone)
	buildCar(parent, at(zoneCF, -23.5, 0, 8), Color3.fromRGB(255, 200, 50))
	buildCar(parent, at(zoneCF, -22, 0, -7, -25), Color3.fromRGB(150, 110, 255))
	-- giant soap bottle
	local bottle = at(zoneCF, 22, 0, -6)
	makeCylinder({ name = "SoapBottle", parent = parent, diameter = 4, height = 8, cframe = bottle * CFrame.new(0, 4, 0), color = zone.AccentColor, castShadow = true })
	cylinder({ name = "SoapLabel", parent = parent, diameter = 4.1, height = 2.4, cframe = bottle * CFrame.new(0, 4, 0), color = WHITE })
	cylinder({ name = "SoapNeck", parent = parent, diameter = 1.4, height = 1.2, cframe = bottle * CFrame.new(0, 8.6, 0), color = WHITE })
	block({ name = "SoapPump", parent = parent, size = Vector3.new(1, 1.4, 1), cframe = bottle * CFrame.new(0, 9.8, 0), color = WHITE })
	block({ name = "SoapNozzle", parent = parent, size = Vector3.new(0.6, 0.6, 2.2), cframe = bottle * CFrame.new(0, 10.2, -1.2), color = WHITE })
	-- bubbles drifting out of the tunnel exit
	for _, b in { { 19, 3, 6, 2.6 }, { 21.5, 5.5, 9, 1.8 }, { 24, 2.2, 12, 2.2 }, { 20, 7.5, 12.5, 1.4 }, { 26, 4.5, 7, 1.6 }, { 23, 9, 9, 1.2 } } do
		ball({
			name = "Bubble", parent = parent, diameter = b[4], cframe = at(zoneCF, b[1], b[2], b[3]),
			color = Color3.fromRGB(200, 240, 255), transparency = 0.3,
		})
	end
	-- buckets + sponges by the tunnel entrance
	for i, x in { -20, -17.5 } do
		local cf = at(zoneCF, x, 0, -1.5)
		cylinder({ name = "Bucket", parent = parent, diameter = 1.8, height = 1.8, cframe = cf * CFrame.new(0, 0.9, 0), color = if i == 1 then Color3.fromRGB(255, 120, 60) else zone.SignColor })
		block({ name = "Sponge", parent = parent, size = Vector3.new(1.2, 0.6, 0.8), cframe = cf * CFrame.new(0, 2, 0), color = Color3.fromRGB(255, 230, 80) })
	end
end

-- Food Truck: picnic tables, giant ketchup + mustard, a string-light canopy
DRESS.FoodTruck = function(parent, zoneCF, zone)
	local red = Color3.fromRGB(235, 60, 60)
	for _, pos in { Vector3.new(-21, 0, -16), Vector3.new(20, 0, -16), Vector3.new(20, 0, 21) } do
		local cf = at(zoneCF, pos.X, 0, pos.Z)
		for p = -1, 1 do
			block({
				name = "PicnicTop", parent = parent, size = Vector3.new(6, 0.4, 1),
				cframe = cf * CFrame.new(0, 2.6, p), color = if p == 0 then WHITE else red, castShadow = p == 0,
			})
		end
		for _, z in { -2.4, 2.4 } do
			block({ name = "PicnicBench", parent = parent, size = Vector3.new(6, 0.3, 1), cframe = cf * CFrame.new(0, 1.5, z), color = WOOD, material = Enum.Material.WoodPlanks })
		end
		for _, x in { -2.4, 2.4 } do
			block({ name = "PicnicLegs", parent = parent, size = Vector3.new(0.4, 2.4, 5.2), cframe = cf * CFrame.new(x, 1.2, 0), color = DARK_WOOD })
		end
	end
	-- giant ketchup + mustard bottles
	for i, pos in { Vector3.new(-23, 0, 15), Vector3.new(-18.5, 0, 18) } do
		local cf = at(zoneCF, pos.X, 0, pos.Z)
		local color = if i == 1 then red else Color3.fromRGB(255, 210, 40)
		makeCylinder({ name = "SauceBottle", parent = parent, diameter = 3, height = 8, cframe = cf * CFrame.new(0, 4, 0), color = color, castShadow = true })
		cylinder({ name = "SauceCap", parent = parent, diameter = 1.8, height = 1.2, cframe = cf * CFrame.new(0, 8.6, 0), color = WHITE })
		cylinder({ name = "SauceTip", parent = parent, diameter = 0.7, height = 1.4, cframe = cf * CFrame.new(0, 9.9, 0), color = color })
	end
	-- string-light canopy over the front-right dining spot
	local corners = {
		Vector3.new(14.5, 0, -24), Vector3.new(26, 0, -24), Vector3.new(26, 0, -9), Vector3.new(14.5, 0, -9),
	}
	local tops = {}
	for _, c in corners do
		local cf = at(zoneCF, c.X, 0, c.Z)
		cylinder({ name = "LightPost", parent = parent, diameter = 0.4, height = 8, cframe = cf * CFrame.new(0, 4, 0), color = DARK_WOOD })
		table.insert(tops, zoneCF:PointToWorldSpace(Vector3.new(c.X, 7.8, c.Z)))
	end
	local bulbColors = { Color3.fromRGB(255, 212, 31), Color3.fromRGB(255, 92, 180), Color3.fromRGB(64, 200, 224), Color3.fromRGB(255, 123, 34) }
	for i = 1, 4 do
		local from, to = tops[i], tops[i % 4 + 1]
		local mid = (from + to) / 2 - Vector3.new(0, 0.9, 0)
		span(parent, "LightWire", from, mid, 0.1, Color3.fromRGB(48, 48, 56))
		span(parent, "LightWire", mid, to, 0.1, Color3.fromRGB(48, 48, 56))
		for k = 1, 3 do
			local p = if k <= 1 then from:Lerp(mid, 0.6) elseif k == 2 then mid else mid:Lerp(to, 0.4)
			ball({ name = "LightBulb", parent = parent, diameter = 0.6, cframe = CFrame.new(p - Vector3.new(0, 0.3, 0)), color = bulbColors[(i + k) % 4 + 1], material = Enum.Material.Neon })
		end
	end
end

-- Creator Studio: pink couch on a rug, giant neon heart, two spotlights on tripods
DRESS.ContentCreator = function(parent, zoneCF, zone)
	local pink = zone.SignColor
	local couch = at(zoneCF, -22, 0, 4, -90) -- faces +X (toward the ring light)
	block({ name = "Rug", parent = parent, size = Vector3.new(12, 0.1, 8), cframe = couch * CFrame.new(0, 0.05, -2.5), color = Color3.fromRGB(255, 200, 230) })
	block({ name = "CouchSeat", parent = parent, size = Vector3.new(7, 1.4, 3), cframe = couch * CFrame.new(0, 0.9, 0), color = pink, castShadow = true })
	block({ name = "CouchBack", parent = parent, size = Vector3.new(7, 2.6, 0.9), cframe = couch * CFrame.new(0, 2, 1.2), color = pink })
	for _, x in { -3.6, 3.6 } do
		block({ name = "CouchArm", parent = parent, size = Vector3.new(0.9, 2, 3), cframe = couch * CFrame.new(x, 1.3, 0), color = pink:Lerp(Color3.new(1, 1, 1), 0.25) })
	end
	for _, x in { -1.6, 1.6 } do
		block({ name = "Cushion", parent = parent, size = Vector3.new(2.4, 0.5, 2.2), cframe = couch * CFrame.new(x, 1.85, -0.2), color = Color3.fromRGB(255, 180, 225) })
	end
	-- giant neon heart on a post, facing the plaza
	local heart = at(zoneCF, 22, 0, 9)
	cylinder({ name = "HeartPost", parent = parent, diameter = 0.6, height = 4.5, cframe = heart * CFrame.new(0, 2.25, 0), color = POLE })
	block({
		name = "HeartBody", parent = parent, size = Vector3.new(4, 4, 1),
		cframe = heart * CFrame.new(0, 6.8, 0) * CFrame.Angles(0, 0, math.rad(45)), color = pink, material = Enum.Material.Neon,
	})
	for _, x in { -1.42, 1.42 } do
		ball({ name = "HeartLobe", parent = parent, diameter = 4, cframe = heart * CFrame.new(x, 8.2, 0), color = pink, material = Enum.Material.Neon })
	end
	-- two spotlights on tripods aimed at the set
	for _, spec in { { x = -22, z = -14, yaw = 42 }, { x = 22, z = -14, yaw = -42 } } do
		local cf = at(zoneCF, spec.x, 0, spec.z, spec.yaw)
		for i = 0, 2 do
			block({
				name = "SpotTripodLeg", parent = parent, size = Vector3.new(0.3, 4.2, 0.3),
				cframe = cf * CFrame.Angles(0, math.rad(i * 120), 0) * CFrame.new(0, 2, -0.9) * CFrame.Angles(math.rad(14), 0, 0),
				color = POLE,
			})
		end
		local head = cf * CFrame.new(0, 4.6, 0) * CFrame.Angles(math.rad(-12), 0, 0)
		cylinder({ name = "SpotHead", parent = parent, diameter = 1.8, height = 2.2, axis = "Z", cframe = head, color = Color3.fromRGB(40, 38, 45) })
		cylinder({ name = "SpotLens", parent = parent, diameter = 1.5, height = 0.2, axis = "Z", cframe = head * CFrame.new(0, 0, 1.15), color = Color3.fromRGB(255, 240, 200), material = Enum.Material.Neon })
	end
end

-- Stock Desk: mini ticker pillars, money bags with $ labels, gold coin stacks
DRESS.StockDesk = function(parent, zoneCF, zone)
	local green = Color3.fromRGB(70, 255, 130)
	for i, pos in { Vector3.new(-22, 0, -16), Vector3.new(22, 0, -16), Vector3.new(-22, 0, 2), Vector3.new(22, 0, 2) } do
		local cf = at(zoneCF, pos.X, 0, pos.Z)
		block({ name = "TickerPillar", parent = parent, size = Vector3.new(2, 6, 2), cframe = cf * CFrame.new(0, 3, 0), color = MapKit.STOCK_DEEP_GREEN, castShadow = true })
		block({ name = "TickerStripe", parent = parent, size = Vector3.new(2.1, 0.6, 2.1), cframe = cf * CFrame.new(0, 4.6, 0), color = if i % 2 == 0 then green else Color3.fromRGB(255, 80, 80), material = Enum.Material.Neon })
		block({ name = "TickerCap", parent = parent, size = Vector3.new(2.3, 0.4, 2.3), cframe = cf * CFrame.new(0, 6.2, 0), color = zone.SignColor })
	end
	local bagColor = Color3.fromRGB(120, 190, 100)
	for _, pos in { Vector3.new(-22, 0, 16), Vector3.new(-18.5, 0, 19), Vector3.new(-25, 0, 21), Vector3.new(20, 0, 17), Vector3.new(23.5, 0, 20) } do
		local cf = at(zoneCF, pos.X, 0, pos.Z)
		ball({ name = "MoneyBag", parent = parent, diameter = 3.4, cframe = cf * CFrame.new(0, 1.6, 0), color = bagColor, castShadow = true })
		cylinder({ name = "MoneyBagTie", parent = parent, diameter = 1, height = 1, cframe = cf * CFrame.new(0, 3.4, 0), color = Color3.fromRGB(200, 160, 60) })
		local label = cylinder({ name = "MoneyBagLabel", parent = parent, diameter = 1.6, height = 0.2, axis = "Z", cframe = cf * CFrame.new(0, 1.7, -1.62), color = NAVY })
		addSurfaceText(label, "$", Enum.Font.LuckiestGuy, green, Enum.NormalId.Right, 30)
	end
	local gold = Color3.fromRGB(255, 205, 60)
	for _, pos in { Vector3.new(-14, 0, 20), Vector3.new(14, 0, 22) } do
		for c = 0, 3 do
			cylinder({
				name = "CoinStack", parent = parent, diameter = 2.2, height = 0.45,
				cframe = at(zoneCF, pos.X + (c % 2) * 0.25, 0.25 + c * 0.47, pos.Z), color = if c % 2 == 0 then gold else Color3.fromRGB(235, 180, 40),
			})
		end
	end
end

-- Startup HQ: ping-pong table, beanbags, scooters, a whiteboard
DRESS.StartupHQ = function(parent, zoneCF, zone)
	local blue = zone.AccentColor
	local tableCF = at(zoneCF, 21, 0, 12)
	block({ name = "PingPongTop", parent = parent, size = Vector3.new(9, 0.4, 5), cframe = tableCF * CFrame.new(0, 2.6, 0), color = Color3.fromRGB(40, 90, 200), castShadow = true })
	block({ name = "PingPongLine", parent = parent, size = Vector3.new(9, 0.42, 0.15), cframe = tableCF * CFrame.new(0, 2.6, 0), color = WHITE })
	block({ name = "PingPongNet", parent = parent, size = Vector3.new(0.12, 0.8, 5.2), cframe = tableCF * CFrame.new(0, 3.2, 0), color = WHITE })
	for _, x in { -3.4, 3.4 } do
		block({ name = "PingPongLegs", parent = parent, size = Vector3.new(0.4, 2.4, 4), cframe = tableCF * CFrame.new(x, 1.2, 0), color = POLE })
	end
	for _, x in { -2.5, 2.5 } do
		cylinder({ name = "Paddle", parent = parent, diameter = 1.2, height = 0.15, cframe = tableCF * CFrame.new(x, 2.9, 1.2), color = Color3.fromRGB(235, 60, 60) })
	end
	-- beanbags (squashy balls half sunk into the pad)
	for i, pos in { Vector3.new(-22, 0, 8), Vector3.new(-25.5, 0, 12.5), Vector3.new(-20, 0, 14.5), Vector3.new(-25, 0, 3.5) } do
		ball({ name = "Beanbag", parent = parent, diameter = 3.2, cframe = at(zoneCF, pos.X, 0.9, pos.Z), color = if i % 2 == 0 then WHITE else blue, castShadow = true })
	end
	-- two scooters
	for i, pos in { Vector3.new(-22, 0, -16), Vector3.new(-19, 0, -19) } do
		local cf = at(zoneCF, pos.X, 0, pos.Z, 30 + i * 20)
		local color = if i == 1 then Color3.fromRGB(255, 110, 190) else Color3.fromRGB(80, 220, 120)
		block({ name = "ScooterDeck", parent = parent, size = Vector3.new(3, 0.3, 0.8), cframe = cf * CFrame.new(0, 0.6, 0), color = color })
		cylinder({ name = "ScooterStem", parent = parent, diameter = 0.25, height = 3.4, cframe = cf * CFrame.new(1.4, 2.3, 0) * CFrame.Angles(0, 0, math.rad(-10)), color = POLE })
		block({ name = "ScooterBar", parent = parent, size = Vector3.new(0.2, 0.2, 1.8), cframe = cf * CFrame.new(1.7, 4, 0), color = POLE })
		for _, x in { -1.3, 1.4 } do
			cylinder({ name = "ScooterWheel", parent = parent, diameter = 0.8, height = 0.3, axis = "Z", cframe = cf * CFrame.new(x, 0.4, 0), color = MapKit.WHEEL_DARK })
		end
	end
	-- whiteboard with a hockey-stick growth chart, facing the plaza
	local board = at(zoneCF, 22, 0, -16)
	for _, x in { -3, 3 } do
		block({ name = "WhiteboardLeg", parent = parent, size = Vector3.new(0.3, 5.6, 0.3), cframe = board * CFrame.new(x, 2.8, 0), color = POLE })
	end
	block({ name = "Whiteboard", parent = parent, size = Vector3.new(7, 4, 0.3), cframe = board * CFrame.new(0, 4, 0), color = WHITE, castShadow = true })
	local lines = {
		{ Vector3.new(-2.8, -1.2, 0), Vector3.new(0.4, -0.8, 0), Color3.fromRGB(60, 130, 255) },
		{ Vector3.new(0.4, -0.8, 0), Vector3.new(2.6, 1.5, 0), Color3.fromRGB(60, 130, 255) },
		{ Vector3.new(-2.6, 1.2, 0), Vector3.new(-0.6, 1.2, 0), Color3.fromRGB(235, 60, 60) },
	}
	for _, line in lines do
		local a = (board * CFrame.new(0, 4, -0.2)):PointToWorldSpace(line[1])
		local b = (board * CFrame.new(0, 4, -0.2)):PointToWorldSpace(line[2])
		span(parent, "MarkerLine", a, b, 0.2, line[3])
	end
end

----------------------------------------------------------------------
-- Public API
----------------------------------------------------------------------

-- Builds <zoneModel>.Dressing for a zone (no-op for zones without a recipe).
function ZoneDressing.build(zoneModel: Model, zoneCF: CFrame, zone): Model?
	local recipe = DRESS[zone.Id]
	if not recipe then
		return nil
	end
	local dressing = makeModel("Dressing", zoneModel)
	recipe(dressing, zoneCF, zone)
	return dressing
end

-- Exposed so other builders can reuse the static car recipe.
ZoneDressing.buildCar = buildCar

return ZoneDressing
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
