      <Item class="ModuleScript" referent="6">
        <Properties>
          <string name="Name">FormatNumber</string>
          <string name="Source"><![CDATA[--!strict
-- Number abbreviation for chunky simulator UI: 1234 -> "1.2K", money(1234) -> "$1.2K"

local FormatNumber = {}

local SUFFIXES = { "", "K", "M", "B", "T", "Qd", "Qn" }

function FormatNumber.abbreviate(n: number): string
	if n ~= n or n == math.huge then
		return "0"
	end
	local negative = n < 0
	n = math.abs(n)
	local index = 1
	-- The 999.95 clause keeps "%.1f" from rounding up to "1000.0K" at suffix
	-- boundaries (999,999 -> 1M, not 1000.0K).
	while index < #SUFFIXES and (n >= 1000 or (index > 1 and n >= 999.95)) do
		n /= 1000
		index += 1
	end
	local text: string
	if index == 1 then
		text = tostring(math.floor(n))
	else
		text = string.format("%.1f", n)
		text = (text:gsub("%.0$", "")) .. SUFFIXES[index]
	end
	if negative then
		text = "-" .. text
	end
	return text
end

function FormatNumber.money(n: number): string
	return "$" .. FormatNumber.abbreviate(n)
end

-- Full comma formatting for gate signs etc: 1234567 -> "1,234,567"
function FormatNumber.commas(n: number): string
	local text = tostring(math.floor(math.abs(n)))
	local formatted = text:reverse():gsub("(%d%d%d)", "%1,"):reverse():gsub("^,", "")
	if n < 0 then
		formatted = "-" .. formatted
	end
	return formatted
end

return FormatNumber
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="7">
        <Properties>
          <string name="Name">GameConfig</string>
          <string name="Source"><![CDATA[--!strict
-- GameConfig (v2): single source of truth for ALL game tuning.
-- Server and client both read this. Balance lives here, logic lives in services.

local GameConfig = {}

----------------------------------------------------------------------
-- Map constants (MapBuilder and Mechanics.zoneCenter must agree)
----------------------------------------------------------------------

GameConfig.Map = {
	ZoneRadius = 150, -- distance of each zone center from the plaza origin
	ZoneAngleStep = 45, -- degrees between zones around the ring
}

----------------------------------------------------------------------
-- Upgrade effects (per-zone upgrades reference these by Effect)
----------------------------------------------------------------------

GameConfig.UpgradeEffects = {
	Earn = { PerLevel = 0.25 }, -- +25% cash per level
	Xp = { PerLevel = 0.2 }, -- +20% XP per level
	Speed = { PerLevel = 0.08, MinCooldownFactor = 0.5 }, -- -8% cooldown per level, floor 50%
	Auto = { Interval = 2, BasePercent = 0.4, PercentPerLevel = 0.25 }, -- auto hustle every 2s
}

----------------------------------------------------------------------
-- Mechanic parameters
----------------------------------------------------------------------

GameConfig.Mechanics = {
	Tap = { ComboWindow = 1.8, ComboMax = 10, ComboBonusPerStack = 0.1 }, -- up to x2
	-- Hold: the client stretches the prompt's hold to the zone's current
	-- cooldown (Speed upgrade = shorter hold); TriggerGrace absorbs jitter.
	Hold = { PayoutMult = 1, TriggerGrace = 0.2 },
	-- Timing: peak flips (marketMult >= PeakThreshold) build a streak worth
	-- +50% per stack (x3 at StreakMax); off-peak flips pay OffPeakMult and
	-- reset the streak. Simulated: timed play out-earns spamming ~2-3x.
	Timing = {
		MinMult = 0.5,
		MaxMult = 1.5,
		PeakThreshold = 1.35,
		PeakXpBonus = 0,
		OffPeakMult = 0.5,
		StreakMax = 5,
		StreakBonusPerStack = 0.5,
	},
	Charge = { HitPercent = 0.3, BurstMult = 1.5, BurstXpBonus = 2.0 },
}

----------------------------------------------------------------------
-- Zones (ordered). Each has a mechanic, level gate and 4 unique upgrades
-- (Effects: Earn, Xp, Speed, Auto). Costs scale with the zone's earn.
----------------------------------------------------------------------

export type ZoneUpgradeDef = {
	Id: string,
	Name: string,
	Description: string,
	Effect: string, -- "Earn" | "Xp" | "Speed" | "Auto"
	BaseCost: number,
	CostMultiplier: number,
	MaxLevel: number,
}

export type ZoneDef = {
	Id: string,
	Name: string,
	Order: number,
	UnlockLevel: number,
	Mechanic: string, -- "Tap" | "Hold" | "Timing" | "Charge"
	HustleEarn: number, -- base cash per manual action (before mechanic/upgrades)
	XpPerHustle: number, -- base XP per manual action
	HustleCooldown: number, -- seconds (reduced by the Speed upgrade)
	HoldDuration: number, -- Hold zones only (0 otherwise)
	MarketPeriod: number, -- Timing zones only (seconds per hype cycle)
	ChargeMax: number, -- Charge zones only (hits per burst)
	SignColor: Color3,
	AccentColor: Color3,
	HustleVerb: string,
	Tagline: string, -- mechanic hint shown in HustleGui
	Upgrades: { ZoneUpgradeDef },
}

local function upgrades(earn: number, defs: { { string } }, autoCostMult: number?): { ZoneUpgradeDef }
	-- defs: { {Id, Name, Description}, ... } in Effect order Earn, Xp, Speed, Auto
	local effects = { "Earn", "Xp", "Speed", "Auto" }
	local baseMult = { Earn = 40, Xp = 30, Speed = 60, Auto = 250 }
	local costMult = { Earn = 1.6, Xp = 1.6, Speed = 1.8, Auto = autoCostMult or 2.2 }
	local maxLevel = { Earn = 10, Xp = 10, Speed = 5, Auto = 5 }
	local result = {}
	for index, def in defs do
		local effect = effects[index]
		table.insert(result, {
			Id = def[1],
			Name = def[2],
			Description = def[3],
			Effect = effect,
			BaseCost = math.floor(earn * baseMult[effect]),
			CostMultiplier = costMult[effect],
			MaxLevel = maxLevel[effect],
		})
	end
	return result
end

