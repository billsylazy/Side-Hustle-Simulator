  </Item>
  <Item class="ServerScriptService" referent="8">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Script" referent="9">
      <Properties>
        <string name="Name">GameManager</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[--[[
	GameManager.server.luau
	Server entry point (ARCHITECTURE.md "Service pattern"):
	1. Build the map + lighting (MapBuilder.build(), idempotent).
	2. Create every remote (RemoteService.init()).
	3. Require all services, init(services) all, then start() all.
	4. Player lifecycle: load/sync on join, unload + per-service cleanup on leave.
	5. Auto-save loop every GameConfig.Data.SaveInterval.
	game:BindToClose is handled inside DataService.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GameConfig = require(ReplicatedStorage.Shared.GameConfig)

-- 1. Build the world FIRST so zones, prompts and spawns exist before any
--    service connects to them and before any player spawns.
local MapBuilder = require(script.Parent.World.MapBuilder)
MapBuilder.build()

-- 2. Remotes must exist before services register handlers against them.
local servicesFolder = script.Parent.Services
local RemoteService = require(servicesFolder.RemoteService)
RemoteService.init()

-- 3. Require all services, inject the services table, init all, start all.
local SERVICE_ORDER = {
	"DataService",
	"RemoteService",
	"ZoneService",
	"HustleService",
	"WorkerService",
	"UpgradeService",
	"RebirthService",
	"QuestService",
}

local services: { [string]: any } = {}
for _, name in SERVICE_ORDER do
	local moduleScript = servicesFolder:FindFirstChild(name)
	assert(moduleScript ~= nil, `[GameManager] Missing service module: Services.{name}`)
	services[name] = require(moduleScript)
end

for _, name in SERVICE_ORDER do
	local service = services[name]
	if typeof(service.init) == "function" then
		service.init(services)
	end
end

for _, name in SERVICE_ORDER do
	local service = services[name]
	if typeof(service.start) == "function" then
		service.start()
	end
end

local DataService = services.DataService

-- 4. Player lifecycle.
local function onPlayerAdded(player: Player)
	DataService.loadPlayer(player)
	DataService.sync(player)
end

local function onPlayerRemoving(player: Player)
	DataService.unloadPlayer(player)
	for _, name in SERVICE_ORDER do
		local service = services[name]
		if typeof(service.cleanupPlayer) == "function" then
			service.cleanupPlayer(player)
		end
	end
end

Players.PlayerAdded:Connect(onPlayerAdded)
Players.PlayerRemoving:Connect(onPlayerRemoving)

-- Handle players already present (Studio fast-start edge case).
for _, player in Players:GetPlayers() do
	task.spawn(onPlayerAdded, player)
end

-- 5. Auto-save loop.
task.spawn(function()
	while true do
		task.wait(GameConfig.Data.SaveInterval)
		DataService.saveAll()
	end
end)

print("[GameManager] Side Hustle Simulator server ready")
]]></string>
      </Properties>
    </Item>
    <Item class="Folder" referent="10">
      <Properties>
        <string name="Name">Services</string>
      </Properties>
      <Item class="ModuleScript" referent="11">
        <Properties>
          <string name="Name">DataService</string>
          <string name="Source"><![CDATA[--[[
	DataService.luau
	Persistence + the ONLY cash mutation API (ARCHITECTURE.md "Data schema").

	- UpdateAsync-based session locking: stored value is
	  { Data = PlayerData, Lock = { JobId = game.JobId, Time = os.time() }? }.
	- Load retry/kick flow when a foreign lock is fresh (SE-1).
	- 60s lock refresh loop for loaded players.
	- Validation before every save; corrupt data is never written.
	- Final save on leave clears the lock; BindToClose saves in parallel.
	- DataService is the ONLY creator of leaderstats (Cash, Rebirths IntValues).
]]

local Players = game:GetService("Players")
local DataStoreService = game:GetService("DataStoreService")
local HttpService = game:GetService("HttpService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GameConfig = require(ReplicatedStorage.Shared.GameConfig)
local Types = require(ReplicatedStorage.Shared.Types)

type PlayerData = Types.PlayerData

local DataService = {}

local LOAD_ATTEMPTS = 5
local LOAD_RETRY_DELAY = 2
local SAVE_ATTEMPTS = 3
local SAVE_RETRY_DELAY = 2
local SHUTDOWN_DEADLINE = 25 -- leave buffer before Roblox's 30s BindToClose hard limit

local LOCK_KICK_MESSAGE = "Your data is still saving from another server — rejoin in a minute."
local LOAD_FAIL_KICK_MESSAGE = "Failed to load your data. Please rejoin."

local dataStore = DataStoreService:GetDataStore(GameConfig.Data.StoreName)

local services: { [string]: any }? = nil
local loaded: { [Player]: PlayerData } = {}
local joinClocks: { [Player]: number } = {}
local started = false
local shuttingDown = false

-- Each load claims the lock under a unique session GUID, so a stale lock left
-- by the player's PREVIOUS session on this same server is still recognized as
-- not ours (JobId alone cannot tell the two apart on a fast same-server rejoin).
local sessionIds: { [number]: string } = {} -- UserId -> active session GUID
-- UserId -> true while that player's final (leave-time) save is in flight, so
-- a fast rejoin waits for it instead of loading a pre-save snapshot.
local savingUserIds: { [number]: boolean } = {}
-- Writes currently in flight anywhere (auto-save, leave, shutdown); BindToClose
-- holds the server open until this drains or the deadline passes.
local pendingSaves = 0

----------------------------------------------------------------------
-- Helpers
----------------------------------------------------------------------

local function keyFor(userId: number): string
	return "Player_" .. userId
end

local function isFiniteNumber(value: any): boolean
	return typeof(value) == "number"
		and value == value -- NaN check
		and value ~= math.huge
		and value ~= -math.huge
end

local function deepClone(original: { [any]: any }): { [any]: any }
	local clone = {}
	for key, value in original do
		if typeof(value) == "table" then
			clone[key] = deepClone(value)
		else
			clone[key] = value
		end
	end
	return clone
end

-- Fill missing keys recursively from the template (GameConfig.Data.Defaults()).
local function reconcile(data: { [any]: any }, template: { [any]: any })
	for key, default in template do
		if data[key] == nil then
			if typeof(default) == "table" then
				data[key] = deepClone(default)
			else
				data[key] = default
			end
		elseif typeof(default) == "table" and typeof(data[key]) == "table" then
			reconcile(data[key], default)
		end
	end
end

-- Reject corrupt data before it ever reaches the DataStore.
local function validate(data: any): boolean
	if typeof(data) ~= "table" then
		return false
	end
	if not isFiniteNumber(data.Cash) or data.Cash < 0 then
		return false
	end
	if not isFiniteNumber(data.CashThisLife) or data.CashThisLife < 0 then
		return false
	end
	if not isFiniteNumber(data.Rebirths) or data.Rebirths < 0 then
		return false
	end
	if typeof(data.UnlockedZones) ~= "table" then
		return false
	end
	if typeof(data.Upgrades) ~= "table" then
		return false
	end
	for _, level in data.Upgrades do
		if not isFiniteNumber(level) or level < 0 then
			return false
		end
	end
	if typeof(data.Workers) ~= "table" then
		return false
	end
	if typeof(data.Stats) ~= "table" then
		return false
	end
	for _, value in data.Stats do
		if not isFiniteNumber(value) then
			return false
		end
	end
	if typeof(data.ClaimedQuests) ~= "table" then
		return false
	end
	return true
end

local function updateLeaderstats(player: Player, data: PlayerData)
	local leaderstats = player:FindFirstChild("leaderstats")
	if not leaderstats then
		return
	end
	local cash = leaderstats:FindFirstChild("Cash")
	if cash and cash:IsA("IntValue") then
		cash.Value = math.floor(data.Cash)
	end
	local rebirths = leaderstats:FindFirstChild("Rebirths")
	if rebirths and rebirths:IsA("IntValue") then
		rebirths.Value = math.floor(data.Rebirths)
	end
end

-- DataService is the ONLY creator of leaderstats.
local function createLeaderstats(player: Player, data: PlayerData)
	if player:FindFirstChild("leaderstats") then
		updateLeaderstats(player, data)
		return
	end

	local leaderstats = Instance.new("Folder")
	leaderstats.Name = "leaderstats"

	local cash = Instance.new("IntValue")
	cash.Name = "Cash"
	cash.Value = math.floor(data.Cash)
	cash.Parent = leaderstats

	local rebirths = Instance.new("IntValue")
	rebirths.Name = "Rebirths"
	rebirths.Value = math.floor(data.Rebirths)
	rebirths.Parent = leaderstats

	leaderstats.Parent = player
end

----------------------------------------------------------------------
-- DataStore writes
----------------------------------------------------------------------

-- A stored lock blocks us when it belongs to a DIFFERENT session (by GUID)
-- and is still fresh. Sessions are compared by GUID, not JobId, so a stale
-- lock from the player's previous visit to this same server never passes.
local function isForeignLock(lock: any, sessionId: string): boolean
	return typeof(lock) == "table"
		and lock.SessionId ~= sessionId
		and typeof(lock.Time) == "number"
		and os.time() - lock.Time < GameConfig.Data.LockTimeout
end

-- Write a player's data under its session GUID. Keeps the session lock unless
-- clearLock is true, and never re-asserts a lock for a session that has ended
-- meanwhile (an auto-save finishing after the leave-time save must not lock
-- the key again). Never clobbers a fresh lock owned by another session.
local function writeDataInner(userId: number, data: PlayerData, sessionId: string, clearLock: boolean): boolean
	if not validate(data) then
		warn(`[DataService] Data for user {userId} failed validation, skipping save`)
		return false
	end

	data.LastSeen = os.time()
	local key = keyFor(userId)

	for attempt = 1, SAVE_ATTEMPTS do
		local foreignLock = false
		local ok, err = pcall(function()
			dataStore:UpdateAsync(key, function(stored)
				stored = if typeof(stored) == "table" then stored else {}
				if isForeignLock(stored.Lock, sessionId) then
					foreignLock = true
					return nil -- abort: another live session owns this key
				end

				local entry: { [string]: any } = { Data = data }
				if not clearLock and sessionIds[userId] == sessionId then
					entry.Lock = { JobId = game.JobId, SessionId = sessionId, Time = os.time() }
				end
				return entry
			end)
		end)

		if foreignLock then
			warn(`[DataService] Skipped save for user {userId}: session owned elsewhere`)
			return false
		end
		if ok then
			return true
		end

		warn(`[DataService] Save attempt {attempt}/{SAVE_ATTEMPTS} failed for user {userId}: {err}`)
		if attempt < SAVE_ATTEMPTS then
			task.wait(SAVE_RETRY_DELAY)
		end
	end

	warn(`[DataService] All save retries exhausted for user {userId}`)
	return false
end

local function writeData(userId: number, data: PlayerData, sessionId: string, clearLock: boolean): boolean
	pendingSaves += 1
	local ok, result = pcall(writeDataInner, userId, data, sessionId, clearLock)
	pendingSaves -= 1
	if not ok then
		warn(`[DataService] Save for user {userId} raised: {result}`)
		return false
	end
	return result
end

-- Release this session's lock without touching Data (player left during load).
local function releaseLock(userId: number, sessionId: string)
	pcall(function()
		dataStore:UpdateAsync(keyFor(userId), function(stored)
			if typeof(stored) ~= "table" then
				return nil
			end
			local lock = stored.Lock
			if typeof(lock) ~= "table" or lock.SessionId ~= sessionId then
				return nil -- not this session's lock; leave untouched
			end
			stored.Lock = nil
			return stored
		end)
	end)
end

-- Bump Lock.Time so other servers keep seeing this session as alive.
local function refreshLock(player: Player)
	local sessionId = sessionIds[player.UserId]
	if not sessionId then
		return
	end
	local ok, err = pcall(function()
		dataStore:UpdateAsync(keyFor(player.UserId), function(stored)
			if typeof(stored) ~= "table" then
				return nil
			end
			local lock = stored.Lock
			if typeof(lock) ~= "table" or lock.SessionId ~= sessionId then
				return nil -- we lost the lock; do not fight over it
			end
			lock.Time = os.time()
			return stored
		end)
	end)
	if not ok then
		warn(`[DataService] Lock refresh failed for {player.Name}: {err}`)
	end
end

----------------------------------------------------------------------
-- Public API
----------------------------------------------------------------------

function DataService.getData(player: Player): PlayerData?
	return loaded[player]
end

function DataService.getLoadedPlayers(): { Player }
	local result: { Player } = {}
	for player in loaded do
		table.insert(result, player)
	end
	return result
end

-- Fires the full data snapshot to the client and refreshes leaderstats.
function DataService.sync(player: Player)
	local data = loaded[player]
	if not data then
		return
	end
	updateLeaderstats(player, data)
	if services and services.RemoteService then
		services.RemoteService.fireClient("DataSync", player, data)
	end
end

-- Adds to Cash, CashThisLife and Stats.TotalCashEarned. Server-only.
function DataService.addCash(player: Player, amount: number)
	local data = loaded[player]
	if not data then
		return
	end
	if not isFiniteNumber(amount) or amount <= 0 then
		return
	end
	data.Cash += amount
	data.CashThisLife += amount
	data.Stats.TotalCashEarned += amount
	DataService.sync(player)
end

-- Returns false if the player cannot afford it. Server-only.
function DataService.spendCash(player: Player, amount: number): boolean
	local data = loaded[player]
	if not data then
		return false
	end
	if not isFiniteNumber(amount) or amount < 0 then
		return false
	end
	if data.Cash < amount then
		return false
	end
	data.Cash -= amount
	DataService.sync(player)
	return true
end

-- Claim the session lock (retrying against a fresh foreign lock), load,
-- reconcile against defaults, create leaderstats.
function DataService.loadPlayer(player: Player)
	if loaded[player] then
		return
	end

	local userId = player.UserId

	-- A leave-time save from this player's previous session on THIS server may
	-- still be in flight (it retries on DataStore errors). Wait for it so we
	-- never read the pre-save snapshot; bounded so a wedged save cannot block
	-- the join forever (the lock check below still guards correctness).
	local waitDeadline = os.clock() + SAVE_ATTEMPTS * (SAVE_RETRY_DELAY + 8)
	while savingUserIds[userId] and os.clock() < waitDeadline do
		task.wait(0.1)
	end
	if not player:IsDescendantOf(Players) then
		return
	end

	local key = keyFor(userId)
	local sessionId = HttpService:GenerateGUID(false)
	local lockBusy = false
	local storedData: any = nil
	local claimed = false

	for attempt = 1, LOAD_ATTEMPTS do
		lockBusy = false
		local ok, err = pcall(function()
			dataStore:UpdateAsync(key, function(stored)
				stored = if typeof(stored) == "table" then stored else {}
				if isForeignLock(stored.Lock, sessionId) then
					lockBusy = true
					return nil -- abort: session still owned elsewhere
				end
				stored.Lock = { JobId = game.JobId, SessionId = sessionId, Time = os.time() }
				storedData = stored.Data
				return stored
			end)
		end)

		if ok and not lockBusy then
			claimed = true
			break
		end

		if not ok then
			warn(`[DataService] Load attempt {attempt}/{LOAD_ATTEMPTS} failed for {player.Name}: {err}`)
		end
		if attempt < LOAD_ATTEMPTS then
			task.wait(LOAD_RETRY_DELAY)
		end
	end

	if not claimed then
		player:Kick(if lockBusy then LOCK_KICK_MESSAGE else LOAD_FAIL_KICK_MESSAGE)
		return
	end

	sessionIds[userId] = sessionId

	-- Player may have left during the async load: release the lock and bail.
	if not player:IsDescendantOf(Players) then
		if sessionIds[userId] == sessionId then
			sessionIds[userId] = nil
		end
		task.spawn(releaseLock, userId, sessionId)
		return
	end

	local data: PlayerData
	if typeof(storedData) == "table" then
		data = storedData :: PlayerData
	else
		data = GameConfig.Data.Defaults() :: PlayerData
	end
	reconcile(data :: any, GameConfig.Data.Defaults())

	loaded[player] = data
	joinClocks[player] = os.clock()
	createLeaderstats(player, data)
	print(`[DataService] Loaded data for {player.Name}`)
end

-- Fold in PlayTime, final save, clear the lock.
function DataService.unloadPlayer(player: Player)
	local data = loaded[player]
	loaded[player] = nil
	local joinedAt = joinClocks[player]
	joinClocks[player] = nil

	if not data then
		return
	end

	local userId = player.UserId
	local sessionId = sessionIds[userId]
	if not sessionId then
		return
	end

	if joinedAt then
		data.Stats.PlayTime += math.max(0, math.floor(os.clock() - joinedAt + 0.5))
	end

	-- Mark the final save in flight so a fast same-server rejoin waits for it
	-- instead of loading a stale snapshot. Clearing sessionIds first also stops
	-- any in-flight auto-save from re-asserting the lock after we clear it.
	savingUserIds[userId] = true
	sessionIds[userId] = nil
	writeData(userId, data, sessionId, true)
	savingUserIds[userId] = nil
	print(`[DataService] Unloaded data for {player.Name}`)
end

-- Auto-save every loaded player (keeps the session lock). Non-blocking.
function DataService.saveAll()
	for player, data in loaded do
		local sessionId = sessionIds[player.UserId]
		if sessionId then
			task.spawn(writeData, player.UserId, data, sessionId, false)
		end
	end
end

----------------------------------------------------------------------
-- Lifecycle
----------------------------------------------------------------------

function DataService.init(injectedServices: { [string]: any })
	services = injectedServices
end

function DataService.start()
	if started then
		return
	end
	started = true

	-- Session lock refresh loop (keeps Lock.Time fresh while we own the session).
	task.spawn(function()
		while not shuttingDown do
			task.wait(GameConfig.Data.LockRefreshInterval)
			if shuttingDown then
				break
			end
			for player in loaded do
				task.spawn(refreshLock, player)
			end
		end
	end)

	-- Shutdown: parallel final saves (clearing locks) with a deadline (SE-6).
	game:BindToClose(function()
		shuttingDown = true

		local toSave: { [Player]: PlayerData } = {}
		local total = 0
		for player, data in loaded do
			toSave[player] = data
			total += 1
		end
		if total == 0 then
			-- Nothing left to start, but saves begun from PlayerRemoving may
			-- still be in flight: drain them before letting the server close.
			local deadline = os.clock() + SHUTDOWN_DEADLINE
			while pendingSaves > 0 and os.clock() < deadline do
				task.wait(0.1)
			end
			return
		end

		local finished = 0
		for player, data in toSave do
			loaded[player] = nil
			local joinedAt = joinClocks[player]
			joinClocks[player] = nil
			local userId = player.UserId
			local sessionId = sessionIds[userId]
			sessionIds[userId] = nil
			task.spawn(function()
				if joinedAt then
					data.Stats.PlayTime += math.max(0, math.floor(os.clock() - joinedAt + 0.5))
				end
				if sessionId then
					writeData(userId, data, sessionId, true)
				end
				finished += 1
			end)
		end

		-- Hold the server open for this batch AND for saves already in flight
		-- elsewhere (a PlayerRemoving final save, a late auto-save) until they
		-- commit or the deadline passes.
		local deadline = os.clock() + SHUTDOWN_DEADLINE
		while (finished < total or pendingSaves > 0) and os.clock() < deadline do
			task.wait(0.1)
		end

		if finished < total then
			warn(`[DataService] Shutdown saved {finished}/{total} players before the deadline`)
		else
			print(`[DataService] Shutdown save complete ({total} players)`)
		end
	end)
end

return DataService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="12">
        <Properties>
          <string name="Name">HustleService</string>
          <string name="Source"><![CDATA[-- HustleService: handles the core "hustle" action via each zone's
-- HustleStation ProximityPrompt and applies the earnings math.
-- Contract: ARCHITECTURE.md "Map contract" + "Earnings math".
-- Hustle earn = floor(zone.HustleEarn * (1 + 0.25 * HustlePowerLevel) * rebirthMult).
-- Server-authoritative: validates data loaded, zone unlocked, per-player
-- per-zone cooldown (zone.HustleCooldown) and distance (< 20 studs).

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local GameConfig = require(ReplicatedStorage.Shared.GameConfig)

local HustleService = {}

-- Injected via init(services) -- never require sibling services directly.
local DataService
local RemoteService
local ZoneService

local MAX_PROMPT_DISTANCE = 20 -- studs; re-validated server-side per contract
local LOCKED_TOAST_THROTTLE = 2 -- seconds between "locked zone" toasts, per player
local MAP_WAIT_TIMEOUT = 30 -- MapBuilder runs before start(); this is a safety net
local CHILD_WAIT_TIMEOUT = 5

-- UserId -> zoneId -> os.clock() of the last successful hustle
local hustleCooldowns: { [number]: { [string]: number } } = {}
-- UserId -> os.clock() of the last "locked zone" toast
local lockedToastAt: { [number]: number } = {}

-- Fires a S->C RemoteEvent to one player. Prefers the RemoteService wrapper
-- (assumed API: RemoteService.fireClient(player, remoteName, ...)); falls back
-- to the contract-pinned ReplicatedStorage.Remotes folder so player feedback
-- never silently drops if the wrapper exposes a differently-named fire API.
local function fireClient(player: Player, remoteName: string, ...: any)
	if RemoteService ~= nil and typeof(RemoteService.fireClient) == "function" then
		RemoteService.fireClient(remoteName, player, ...)
		return
	end
	local remotes = ReplicatedStorage:FindFirstChild("Remotes")
	local remote = remotes and remotes:FindFirstChild(remoteName)
	if remote and remote:IsA("RemoteEvent") then
		remote:FireClient(player, ...)
	end
end

local function onHustleTriggered(zone: GameConfig.ZoneDef, promptPart: BasePart, player: Player)
	-- Data must be loaded.
	local data = DataService.getData(player)
	if not data then
		return
	end

	-- Zone must be unlocked. Locked-zone prompts stay visible on the client
	-- (ProximityPrompt.Enabled cannot be set per-player), so the server is the
	-- real gate: reject + toast, throttled to one toast per 2 s per player.
	if not ZoneService.isZoneUnlocked(player, zone.Id) then
		local now = os.clock()
		if now - (lockedToastAt[player.UserId] or 0) >= LOCKED_TOAST_THROTTLE then
			lockedToastAt[player.UserId] = now
			fireClient(player, "Toast", "Unlock this hustle first!", "error")
		end
		return
	end

	-- Per-player, per-zone cooldown; early triggers are silently ignored.
	local userCooldowns = hustleCooldowns[player.UserId]
	if not userCooldowns then
		userCooldowns = {}
		hustleCooldowns[player.UserId] = userCooldowns
	end
	local now = os.clock()
	if now - (userCooldowns[zone.Id] or 0) < zone.HustleCooldown then
		return
	end

	-- Re-validate distance server-side (< 20 studs), per contract.
	local character = player.Character
	local rootPart = character and character:FindFirstChild("HumanoidRootPart")
	if not rootPart or not rootPart:IsA("BasePart") then
		return
	end
	if (rootPart.Position - promptPart.Position).Magnitude >= MAX_PROMPT_DISTANCE then
		return
	end

	-- All checks passed: this attempt consumes the cooldown.
	userCooldowns[zone.Id] = now

	-- Earnings math (ARCHITECTURE.md): base * hustle-power multiplier * rebirth multiplier.
	local hustlePowerLevel = data.Upgrades.HustlePower or 0
	local amount = math.floor(
		zone.HustleEarn
			* (1 + GameConfig.HustlePowerPerLevel * hustlePowerLevel)
			* GameConfig.getRebirthMultiplier(data.Rebirths)
	)

	-- Bump the lifetime stat before addCash so the DataSync snapshot that
	-- addCash fires already carries the new HustleCount (quests read it).
	data.Stats.HustleCount += 1
	DataService.addCash(player, amount)

	-- Client plays money popup + coin sound off this (art & feel guide juice).
	fireClient(player, "HustleResult", zone.Id, amount)
end

-- Resolves one zone's hustle prompt and connects it. Each step uses
-- WaitForChild with a timeout and warns + skips on failure, so one missing
-- part never kills the server or the other zones.
local function connectHustleStation(zonesFolder: Instance, zone: GameConfig.ZoneDef)
	local zoneModel = zonesFolder:WaitForChild(zone.Id, CHILD_WAIT_TIMEOUT)
	if not zoneModel then
		warn("[HustleService] Zone model missing for " .. zone.Id .. "; hustle prompt skipped")
		return
	end

	local station = zoneModel:WaitForChild("HustleStation", CHILD_WAIT_TIMEOUT)
	if not station then
		warn("[HustleService] HustleStation missing for zone " .. zone.Id .. "; hustle prompt skipped")
		return
	end

	local promptPart = station:WaitForChild("PromptPart", CHILD_WAIT_TIMEOUT)
	if not promptPart or not promptPart:IsA("BasePart") then
		warn("[HustleService] HustleStation PromptPart missing for zone " .. zone.Id .. "; hustle prompt skipped")
		return
	end

	local prompt = promptPart:WaitForChild("HustlePrompt", CHILD_WAIT_TIMEOUT)
	if not prompt or not prompt:IsA("ProximityPrompt") then
		warn("[HustleService] HustlePrompt missing for zone " .. zone.Id .. "; hustle prompt skipped")
		return
	end

	-- Prompt connections live for the server's lifetime; per-player state is
	-- cleared in cleanupPlayer instead.
	prompt.Triggered:Connect(function(player: Player)
		onHustleTriggered(zone, promptPart, player)
	end)
end

function HustleService.init(services: { [string]: any })
	DataService = services.DataService
	RemoteService = services.RemoteService
	ZoneService = services.ZoneService
end

function HustleService.start()
	local map = Workspace:WaitForChild("SideHustleMap", MAP_WAIT_TIMEOUT)
	if not map then
		warn("[HustleService] Workspace.SideHustleMap missing; no hustle prompts connected")
		return
	end

	local zonesFolder = map:WaitForChild("Zones", CHILD_WAIT_TIMEOUT)
	if not zonesFolder then
		warn("[HustleService] SideHustleMap.Zones missing; no hustle prompts connected")
		return
	end

	-- EVERY zone has a hustle station, including the free starting zone.
	for _, zone in GameConfig.Zones do
		task.spawn(connectHustleStation, zonesFolder, zone)
	end
end

function HustleService.cleanupPlayer(player: Player)
	hustleCooldowns[player.UserId] = nil
	lockedToastAt[player.UserId] = nil
end

return HustleService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="13">
        <Properties>
          <string name="Name">QuestService</string>
          <string name="Source"><![CDATA[-- QuestService: one-time quest claiming. Progress is never tracked here --
-- quests read the lifetime Stats that other services already maintain
-- (HustleCount, TotalCashEarned, WorkersHired, ZonesUnlockedCount,
-- TotalRebirths), so the client renders progress straight from DataSync and
-- the server only validates claims.
-- Contract: ARCHITECTURE.md "Remotes" + GameConfig.Quests.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GameConfig = require(ReplicatedStorage.Shared.GameConfig)

local QuestService = {}

-- Injected via init(services) -- never require sibling services directly.
local DataService
local RemoteService

local started = false

----------------------------------------------------------------------
-- Helpers
----------------------------------------------------------------------

local function toast(player: Player, message: string, kind: string)
	RemoteService.fireClient("Toast", player, message, kind)
end

----------------------------------------------------------------------
-- Remote handler
----------------------------------------------------------------------

local function onClaimQuest(player: Player, questId: string)
	-- Data must be loaded.
	local data = DataService.getData(player)
	if not data then
		return
	end

	-- Existence re-checked here even though the validator already did (defense
	-- in depth; the handler must stand on its own).
	local quest = GameConfig.getQuest(questId)
	if not quest then
		return
	end

	-- One-time only. A legit client disables claimed rows, so drop silently.
	if data.ClaimedQuests[questId] then
		return
	end

	-- Progress comes from lifetime Stats (survive rebirth).
	local progress = data.Stats[quest.Stat]
	if typeof(progress) ~= "number" or progress < quest.Target then
		toast(player, "Quest not complete yet!", "error")
		return
	end

	-- Mark claimed BEFORE paying out so a re-entrant claim can never double-pay.
	data.ClaimedQuests[questId] = true
	DataService.addCash(player, quest.Reward)
	toast(player, "Quest complete: +$" .. quest.Reward .. "!", "success")
	DataService.sync(player)
end

----------------------------------------------------------------------
-- Lifecycle
----------------------------------------------------------------------

function QuestService.init(services: { [string]: any })
	DataService = services.DataService
	RemoteService = services.RemoteService
end

function QuestService.start()
	if started then
		return
	end
	started = true

	-- Cooldown per the ARCHITECTURE.md remotes table; RemoteService adds
	-- rate limiting and violation kicks on top.
	RemoteService.register({
		Name = "ClaimQuest",
		Cooldown = 0.3,
		Validator = function(_player: Player, questId: any): (boolean, string?)
			if typeof(questId) ~= "string" then
				return false, "questId must be a string"
			end
			if GameConfig.getQuest(questId) == nil then
				return false, "unknown questId"
			end
			return true
		end,
		Handler = onClaimQuest,
	})
end

function QuestService.cleanupPlayer(_player: Player)
	-- No per-player state here: cooldown/rate bookkeeping is owned by
	-- RemoteService, claim state by DataService. Kept for the uniform shape.
end

return QuestService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="14">
        <Properties>
          <string name="Name">RebirthService</string>
          <string name="Source"><![CDATA[-- RebirthService: rebirth validation, reset and multiplier queries.
-- Contract: ARCHITECTURE.md "Earnings math" + "Remotes".
-- Requirement = GameConfig.getRebirthRequirement(Rebirths), checked against
-- CashThisLife. Rebirth RESETS: Cash, CashThisLife, UnlockedZones (back to the
-- starting zone), all Upgrades to 0. KEEPS: Workers (equip state as-is),
-- Stats, ClaimedQuests. Rebirths += 1, Stats.TotalRebirths += 1.
-- C->S traffic goes through RemoteService.register (RequestRebirth, 2 s
-- cooldown, no args); result goes back on the RebirthResult RemoteEvent.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GameConfig = require(ReplicatedStorage.Shared.GameConfig)

local RebirthService = {}

-- Injected via init(services) -- never require sibling services directly.
local DataService
local RemoteService

-- Fires a S->C RemoteEvent to one player via RemoteService.fireClient(name,
-- player, ...); falls back to the contract-pinned ReplicatedStorage.Remotes
-- folder so player feedback never silently drops.
local function fireClient(player: Player, remoteName: string, ...: any)
	if RemoteService ~= nil and typeof(RemoteService.fireClient) == "function" then
		RemoteService.fireClient(remoteName, player, ...)
		return
	end
	local remotes = ReplicatedStorage:FindFirstChild("Remotes")
	local remote = remotes and remotes:FindFirstChild(remoteName)
	if remote and remote:IsA("RemoteEvent") then
		remote:FireClient(player, ...)
	end
end

local function onRequestRebirth(player: Player)
	-- Data must be loaded.
	local data = DataService.getData(player)
	if not data then
		return
	end

	local requirement = GameConfig.getRebirthRequirement(data.Rebirths)

	-- Must be below the rebirth cap and have earned enough THIS life.
	if data.Rebirths >= GameConfig.Rebirth.MaxRebirths or data.CashThisLife < requirement then
		fireClient(player, "RebirthResult", "INSUFFICIENT", requirement)
		return
	end

	-- Apply the reset (see header). Setting every existing upgrade key to 0
	-- (rather than replacing the table) keeps the schema's key set intact.
	data.Cash = 0
	data.CashThisLife = 0
	data.UnlockedZones = { GameConfig.StartingZoneId }
	for upgradeId in data.Upgrades do
		data.Upgrades[upgradeId] = 0
	end
	data.Rebirths += 1
	data.Stats.TotalRebirths += 1

	-- WorkerSlots just reset to 0, so the equip cap shrank back to the base.
	-- Unequip any workers beyond the new cap or they would keep earning
	-- against a cap the player no longer owns (WorkerService also clamps the
	-- income tick defensively, but the data should be honest too).
	local cap = GameConfig.Workers.BaseEquipSlots
	local equipped = 0
	for _, worker in data.Workers do
		if worker.Equipped then
			equipped += 1
			if equipped > cap then
				worker.Equipped = false
			end
		end
	end

	-- WalkSpeed upgrade just reset to level 0 -> back to base walk speed.
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		humanoid.WalkSpeed = GameConfig.BaseWalkSpeed
	end

	-- Push the fresh snapshot; sync also refreshes leaderstats (Cash, Rebirths).
	DataService.sync(player)

	-- RebirthWatcher plays the full-screen celebration off this.
	fireClient(
		player,
		"RebirthResult",
		"SUCCESS",
		data.Rebirths,
		GameConfig.getRebirthMultiplier(data.Rebirths)
	)
end

function RebirthService.init(services: { [string]: any })
	DataService = services.DataService
	RemoteService = services.RemoteService
end

function RebirthService.start()
	-- RemoteService.register handles type validation, the per-remote cooldown
	-- (2 s, per the remotes table), rate limiting and violation kicks.
	RemoteService.register({
		Name = "RequestRebirth",
		Cooldown = 2,
		Handler = onRequestRebirth,
	})
end

-- rebirthMult = 1 + GameConfig.Rebirth.BonusPerRebirth * rebirths.
-- Delegates to GameConfig so there is exactly one source of truth.
function RebirthService.getMultiplier(rebirths: number): number
	return GameConfig.getRebirthMultiplier(rebirths)
end

function RebirthService.cleanupPlayer(player: Player)
	-- No per-player state here: the RequestRebirth cooldown bookkeeping is
	-- owned by RemoteService. Kept for the uniform service module shape.
end

return RebirthService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="15">
        <Properties>
          <string name="Name">RemoteService</string>
          <string name="Source"><![CDATA[--[[
	RemoteService.luau
	Creates ReplicatedStorage.Remotes and every remote named in ARCHITECTURE.md,
	and wraps all C->S handlers with validation, per-remote cooldown, rate
	limiting (timestamps pruned over a 10s window) and violation kicks (SE-5).

	Usage from other services (in start()):
		services.RemoteService.register({
			Name = "BuyUpgrade",
			Cooldown = 0.3,
			Validator = function(player, upgradeId)
				return typeof(upgradeId) == "string", "upgradeId must be a string"
			end,
			Handler = function(player, upgradeId)
				...
			end,
		})
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local RemoteService = {}

export type RemoteConfig = {
	Name: string,
	Handler: (player: Player, ...any) -> (),
	-- Return false (optionally with a reason) to reject; rejections count as violations.
	Validator: ((player: Player, ...any) -> (boolean, string?))?,
	Cooldown: number?, -- seconds between accepted fires (default 0 = none)
	RateLimit: number?, -- max fires per RATE_WINDOW (default DEFAULT_MAX_PER_WINDOW)
}

local RATE_WINDOW = 10 -- seconds
-- Generous enough that honest button-mashing (e.g. equip spam at the 0.2 s
-- cooldown) never accrues violations; the cooldown runs first and absorbs it.
local DEFAULT_MAX_PER_WINDOW = 60
local KICK_AFTER_VIOLATIONS = 5

-- Every remote in the ARCHITECTURE.md table. All are RemoteEvents.
local REMOTE_NAMES = {
	-- S -> C
	"DataSync",
	"HustleResult",
	"Toast",
	"WorkerHired",
	"RebirthResult",
	-- C -> S
	"HireWorker",
	"EquipWorker",
	"UnequipWorker",
	"BuyUpgrade",
	"RequestRebirth",
	"ClaimQuest",
}

local initialized = false
local remotes: { [string]: RemoteEvent } = {}

-- Per-player, per-remote request timestamps within the rate window.
local rateTimestamps: { [Player]: { [string]: { number } } } = {}
-- Per-player, per-remote time of the last accepted fire.
local lastAccepted: { [Player]: { [string]: number } } = {}
-- Per-player violation counts (rate limit breaches + validator failures).
local violations: { [Player]: number } = {}

----------------------------------------------------------------------
-- Internals
----------------------------------------------------------------------

local function recordViolation(player: Player, remoteName: string, reason: string)
	local count = (violations[player] or 0) + 1
	violations[player] = count
	warn(`[RemoteService] {player.Name} violation #{count} on "{remoteName}": {reason}`)
	if count >= KICK_AFTER_VIOLATIONS then
		task.defer(function()
			player:Kick("Too many bad requests. Please rejoin.")
		end)
	end
end

local function checkRateLimit(player: Player, remoteName: string, maxPerWindow: number): boolean
	local now = os.clock()

	local perPlayer = rateTimestamps[player]
	if not perPlayer then
		perPlayer = {}
		rateTimestamps[player] = perPlayer
	end

	local timestamps = perPlayer[remoteName]
	if not timestamps then
		timestamps = {}
		perPlayer[remoteName] = timestamps
	end

	-- Prune timestamps that fell out of the window.
	local windowStart = now - RATE_WINDOW
	local pruned: { number } = {}
	for _, ts in timestamps do
		if ts > windowStart then
			table.insert(pruned, ts)
		end
	end
	perPlayer[remoteName] = pruned

	if #pruned >= maxPerWindow then
		recordViolation(player, remoteName, "rate limit exceeded")
		return false
	end

	table.insert(pruned, now)
	return true
end

-- Cooldown misses are dropped silently (double-clicks are not malicious).
local function checkCooldown(player: Player, remoteName: string, cooldown: number): boolean
	local now = os.clock()

	local perPlayer = lastAccepted[player]
	if not perPlayer then
		perPlayer = {}
		lastAccepted[player] = perPlayer
	end

	local last = perPlayer[remoteName]
	if last and now - last < cooldown then
		return false
	end
	perPlayer[remoteName] = now
	return true
end

----------------------------------------------------------------------
-- Public API
----------------------------------------------------------------------

-- Creates the Remotes folder and every remote. Idempotent: GameManager calls
-- this before service init, and it is called again via the services loop.
function RemoteService.init(_injectedServices: { [string]: any }?)
	if initialized then
		return
	end
	initialized = true

	local folder = ReplicatedStorage:FindFirstChild("Remotes")
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = "Remotes"
		folder.Parent = ReplicatedStorage
	end

	for _, name in REMOTE_NAMES do
		local existing = folder:FindFirstChild(name)
		if existing and existing:IsA("RemoteEvent") then
			remotes[name] = existing
		else
			local remote = Instance.new("RemoteEvent")
			remote.Name = name
			remote.Parent = folder
			remotes[name] = remote
		end
	end

	print(`[RemoteService] Created {#REMOTE_NAMES} remotes`)
end

function RemoteService.start() end

-- Wrap a C->S RemoteEvent handler with rate limit + cooldown + validation.
function RemoteService.register(config: RemoteConfig)
	local remote = remotes[config.Name]
	if not remote then
		error(`[RemoteService] register: unknown remote "{config.Name}" — add it to ARCHITECTURE.md and REMOTE_NAMES first`)
	end

	local cooldown = config.Cooldown or 0
	local maxPerWindow = config.RateLimit or DEFAULT_MAX_PER_WINDOW

	remote.OnServerEvent:Connect(function(player: Player, ...: any)
		-- Cooldown first: fires inside the cooldown are a normal result of fast
		-- clicking and drop silently, without ever counting toward the rate
		-- limit (which exists to catch floods, not enthusiastic players).
		if cooldown > 0 and not checkCooldown(player, config.Name, cooldown) then
			return
		end
		if not checkRateLimit(player, config.Name, maxPerWindow) then
			return
		end
		if config.Validator then
			local ok, reason = config.Validator(player, ...)
			if not ok then
				recordViolation(player, config.Name, reason or "invalid arguments")
				return
			end
		end
		config.Handler(player, ...)
	end)
end

-- S->C helper. Never errors on a missing remote; warns instead.
function RemoteService.fireClient(name: string, player: Player, ...: any)
	local remote = remotes[name]
	if not remote then
		warn(`[RemoteService] fireClient: unknown remote "{name}"`)
		return
	end
	remote:FireClient(player, ...)
end

-- Accessor for services that need the instance itself.
function RemoteService.get(name: string): RemoteEvent
	local remote = remotes[name]
	if not remote then
		error(`[RemoteService] get: unknown remote "{name}"`)
	end
	return remote
end

function RemoteService.cleanupPlayer(player: Player)
	rateTimestamps[player] = nil
	lastAccepted[player] = nil
	violations[player] = nil
end

return RemoteService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="16">
        <Properties>
          <string name="Name">UpgradeService</string>
          <string name="Source"><![CDATA[-- UpgradeService: upgrade purchases + multiplier queries, and the ONLY place
-- (besides RebirthService's reset) that applies the WalkSpeed upgrade to the
-- live Humanoid -- both on purchase and on every spawn.
-- Contract: ARCHITECTURE.md "Remotes" + "Earnings math".
-- cost = GameConfig.getUpgradeCost(id, level); nil means maxed.
-- humanoid WalkSpeed = GameConfig.BaseWalkSpeed + WalkSpeed level.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GameConfig = require(ReplicatedStorage.Shared.GameConfig)

local UpgradeService = {}

-- Injected via init(services) -- never require sibling services directly.
local DataService
local RemoteService

local started = false

local HUMANOID_WAIT_TIMEOUT = 10
local DATA_POLL_INTERVAL = 0.5
local DATA_POLL_TIMEOUT = 10 -- data loads via DataStore; give it up to ~10 s

-- Player -> CharacterAdded connection; disconnected in cleanupPlayer so no
-- connection outlives its player (contract convention).
local characterConnections: { [Player]: RBXScriptConnection } = {}

----------------------------------------------------------------------
-- Helpers
----------------------------------------------------------------------

local function toast(player: Player, message: string, kind: string)
	RemoteService.fireClient("Toast", player, message, kind)
end

local function setWalkSpeed(humanoid: Humanoid, walkSpeedLevel: number)
	humanoid.WalkSpeed = GameConfig.BaseWalkSpeed + walkSpeedLevel
end

-- Applies the WalkSpeed upgrade to a freshly spawned character. Data may
-- still be loading (DataStore), so poll briefly before giving up.
local function applyWalkSpeedOnSpawn(player: Player, character: Model)
	local humanoid = character:WaitForChild("Humanoid", HUMANOID_WAIT_TIMEOUT)
	if not humanoid or not humanoid:IsA("Humanoid") then
		return
	end

	local data = DataService.getData(player)
	local deadline = os.clock() + DATA_POLL_TIMEOUT
	while not data and os.clock() < deadline do
		task.wait(DATA_POLL_INTERVAL)
		if not player:IsDescendantOf(Players) then
			return -- player left while we waited
		end
		data = DataService.getData(player)
	end
	if not data then
		return -- data never loaded (DataService will have kicked the player)
	end

	-- The player may have respawned while we waited; only touch the humanoid
	-- if this character is still the live one.
	if player.Character == character and humanoid.Parent == character then
		setWalkSpeed(humanoid, data.Upgrades.WalkSpeed or 0)
	end
end

local function watchPlayer(player: Player)
	if characterConnections[player] then
		return
	end
	characterConnections[player] = player.CharacterAdded:Connect(function(character: Model)
		task.spawn(applyWalkSpeedOnSpawn, player, character)
	end)
	-- Character may already exist (players present before start()).
	if player.Character then
		task.spawn(applyWalkSpeedOnSpawn, player, player.Character)
	end
end

----------------------------------------------------------------------
-- Remote handler
----------------------------------------------------------------------

local function onBuyUpgrade(player: Player, upgradeId: string)
	-- Data must be loaded.
	local data = DataService.getData(player)
	if not data then
		return
	end

	-- Existence re-checked here even though the validator already did (defense
	-- in depth; the handler must stand on its own).
	local def = GameConfig.Upgrades[upgradeId]
	if not def then
		return
	end

	local level = data.Upgrades[upgradeId] or 0
	local cost = GameConfig.getUpgradeCost(upgradeId, level)
	if cost == nil then
		toast(player, "Maxed out!", "error")
		return
	end

	if not DataService.spendCash(player, cost) then
		toast(player, "Not enough cash!", "error")
		return
	end

	local newLevel = level + 1
	data.Upgrades[upgradeId] = newLevel

	-- Fast Shoes applies instantly to the live character (feel guide: every
	-- purchase should be felt immediately).
	if upgradeId == "WalkSpeed" then
		local character = player.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		if humanoid then
			setWalkSpeed(humanoid, newLevel)
		end
	end

	DataService.sync(player)
	toast(player, def.Name .. " is now level " .. newLevel .. "!", "success")
end

----------------------------------------------------------------------
-- Multiplier queries (ARCHITECTURE.md service description)
----------------------------------------------------------------------

function UpgradeService.getLevel(player: Player, upgradeId: string): number
	local data = DataService.getData(player)
	if not data then
		return 0
	end
	return data.Upgrades[upgradeId] or 0
end

-- 1 + 0.25 per HustlePower level.
function UpgradeService.getHustleMultiplier(player: Player): number
	return 1 + GameConfig.HustlePowerPerLevel * UpgradeService.getLevel(player, "HustlePower")
end

-- 1 + 0.2 per WorkerEfficiency level.
function UpgradeService.getWorkerEfficiencyMultiplier(player: Player): number
	return 1 + GameConfig.WorkerEfficiencyPerLevel * UpgradeService.getLevel(player, "WorkerEfficiency")
end

----------------------------------------------------------------------
-- Lifecycle
----------------------------------------------------------------------

function UpgradeService.init(services: { [string]: any })
	DataService = services.DataService
	RemoteService = services.RemoteService
end

function UpgradeService.start()
	if started then
		return
	end
	started = true

	-- Cooldown per the ARCHITECTURE.md remotes table; RemoteService adds
	-- rate limiting and violation kicks on top.
	RemoteService.register({
		Name = "BuyUpgrade",
		Cooldown = 0.3,
		Validator = function(_player: Player, upgradeId: any): (boolean, string?)
			if typeof(upgradeId) ~= "string" then
				return false, "upgradeId must be a string"
			end
			if GameConfig.Upgrades[upgradeId] == nil then
				return false, "unknown upgradeId"
			end
			return true
		end,
		Handler = onBuyUpgrade,
	})

	-- Apply the WalkSpeed upgrade on every spawn, for joiners and for players
	-- already present when the service starts.
	Players.PlayerAdded:Connect(watchPlayer)
	for _, player in Players:GetPlayers() do
		watchPlayer(player)
	end
end

function UpgradeService.cleanupPlayer(player: Player)
	local connection = characterConnections[player]
	if connection then
		connection:Disconnect()
		characterConnections[player] = nil
	end
end

return UpgradeService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="17">
        <Properties>
          <string name="Name">WorkerService</string>
          <string name="Source"><![CDATA[-- WorkerService: crate hiring (weighted RNG), equip/unequip, passive income tick.
-- Contract: ARCHITECTURE.md "Remotes" + "Earnings math" + "Data schema".
-- Worker income/sec = sum(getWorkerIncome(Rarity, Crate) for equipped)
--   * (1 + 0.2 * WorkerEfficiencyLevel) * rebirthMult, floored, applied every
--   GameConfig.Workers.IncomeTickSeconds via DataService.addCash (which syncs).
-- Server-authoritative: crate existence is checked in the validator (a crate id
-- outside GameConfig can only come from a tampered client), storage/cost/slot
-- caps re-checked in the handlers. All C->S traffic goes through
-- RemoteService.register (rate limit + per-remote cooldown + violation kicks).

local HttpService = game:GetService("HttpService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GameConfig = require(ReplicatedStorage.Shared.GameConfig)
local Types = require(ReplicatedStorage.Shared.Types)

type WorkerEntry = Types.WorkerEntry

local WorkerService = {}

-- Injected via init(services) -- never require sibling services directly.
local DataService
local RemoteService

local started = false

----------------------------------------------------------------------
-- Helpers
----------------------------------------------------------------------

local function toast(player: Player, message: string, kind: string)
	RemoteService.fireClient("Toast", player, message, kind)
end

-- Weighted RNG over crate.Weights. Weights need not sum to 100 (normalized
-- implicitly by rolling against their total). Iterates the ordered rarity
-- list so the roll is stable regardless of dictionary iteration order.
local function rollRarity(crate: GameConfig.CrateDef): GameConfig.RarityDef
	local total = 0
	for _, rarity in GameConfig.WorkerRarities do
		total += crate.Weights[rarity.Id] or 0
	end
	if total <= 0 then
		-- Misconfigured crate; fall back to the most common rarity.
		return GameConfig.WorkerRarities[1]
	end

	local roll = math.random() * total
	local cumulative = 0
	for _, rarity in GameConfig.WorkerRarities do
		cumulative += crate.Weights[rarity.Id] or 0
		if roll < cumulative then
			return rarity
		end
	end
	-- Float edge case (roll == total): rarest bucket.
	return GameConfig.WorkerRarities[#GameConfig.WorkerRarities]
end

local function findWorker(data: any, uid: string): WorkerEntry?
	for _, worker in data.Workers do
		if worker.Uid == uid then
			return worker
		end
	end
	return nil
end

local function countEquipped(data: any): number
	local count = 0
	for _, worker in data.Workers do
		if worker.Equipped then
			count += 1
		end
	end
	return count
end

-- Equipped worker cap = BaseEquipSlots + WorkerSlots upgrade level.
local function equipCap(data: any): number
	return GameConfig.Workers.BaseEquipSlots + (data.Upgrades.WorkerSlots or 0)
end

----------------------------------------------------------------------
-- Remote handlers
----------------------------------------------------------------------

local function onHireWorker(player: Player, crateId: string)
	-- Data must be loaded.
	local data = DataService.getData(player)
	if not data then
		return
	end

	-- Existence re-checked here even though the validator already did (defense
	-- in depth; the handler must stand on its own).
	local crate = GameConfig.WorkerCrates[crateId]
	if not crate then
		return
	end

	if #data.Workers >= GameConfig.Workers.MaxStorage then
		toast(player, "Worker storage full!", "error")
		return
	end

	if not DataService.spendCash(player, crate.Cost) then
		toast(player, "Not enough cash!", "error")
		return
	end

	local rarity = rollRarity(crate)
	local firstName = GameConfig.WorkerNames[math.random(#GameConfig.WorkerNames)]

	local worker: WorkerEntry = {
		Uid = HttpService:GenerateGUID(false),
		Id = rarity.Id, -- reserved for future distinct characters; currently rarity id
		Rarity = rarity.Id,
		Crate = crateId,
		Name = firstName .. " the " .. rarity.Name,
		Equipped = false,
	}

	-- Auto-equip when a slot is free: nicer first-time UX (hire -> instant income).
	if countEquipped(data) < equipCap(data) then
		worker.Equipped = true
	end

	table.insert(data.Workers, worker)
	data.Stats.WorkersHired += 1

	-- Client plays the crate-open juice off this (art & feel guide).
	RemoteService.fireClient("WorkerHired", player, worker)
	toast(player, "Hired " .. worker.Name .. "!", "success")
	DataService.sync(player)
end

local function onEquipWorker(player: Player, workerUid: string)
	local data = DataService.getData(player)
	if not data then
		return
	end

	local worker = findWorker(data, workerUid)
	if not worker or worker.Equipped then
		-- Unknown uid or already equipped: stale UI, drop silently.
		return
	end

	if countEquipped(data) >= equipCap(data) then
		toast(player, "No free worker slots!", "error")
		return
	end

	worker.Equipped = true
	DataService.sync(player)
end

local function onUnequipWorker(player: Player, workerUid: string)
	local data = DataService.getData(player)
	if not data then
		return
	end

	local worker = findWorker(data, workerUid)
	if not worker or not worker.Equipped then
		return
	end

	worker.Equipped = false
	DataService.sync(player)
end

----------------------------------------------------------------------
-- Passive income tick
----------------------------------------------------------------------

-- Income for one tick: sum of equipped workers' base income, scaled by the
-- WorkerEfficiency upgrade and the rebirth multiplier, floored.
local function computeTickIncome(data: any): number
	-- Count at most equipCap(data) equipped workers: saved data can hold more
	-- Equipped flags than the current cap (the WorkerSlots upgrade resets on
	-- rebirth), and the extra ones must not earn.
	local base = 0
	local counted = 0
	local cap = equipCap(data)
	for _, worker in data.Workers do
		if worker.Equipped then
			counted += 1
			if counted > cap then
				break
			end
			base += GameConfig.getWorkerIncome(worker.Rarity, worker.Crate)
		end
	end
	if base <= 0 then
		return 0
	end

	local efficiencyMult = 1 + GameConfig.WorkerEfficiencyPerLevel * (data.Upgrades.WorkerEfficiency or 0)
	return math.floor(base * efficiencyMult * GameConfig.getRebirthMultiplier(data.Rebirths))
end

----------------------------------------------------------------------
-- Lifecycle
----------------------------------------------------------------------

function WorkerService.init(services: { [string]: any })
	DataService = services.DataService
	RemoteService = services.RemoteService
end

function WorkerService.start()
	if started then
		return
	end
	started = true

	-- Cooldowns per the ARCHITECTURE.md remotes table; RemoteService adds
	-- rate limiting and violation kicks on top.
	RemoteService.register({
		Name = "HireWorker",
		Cooldown = 0.5,
		Validator = function(_player: Player, crateId: any): (boolean, string?)
			if typeof(crateId) ~= "string" then
				return false, "crateId must be a string"
			end
			if GameConfig.WorkerCrates[crateId] == nil then
				return false, "unknown crateId"
			end
			return true
		end,
		Handler = onHireWorker,
	})

	RemoteService.register({
		Name = "EquipWorker",
		Cooldown = 0.2,
		Validator = function(_player: Player, workerUid: any): (boolean, string?)
			if typeof(workerUid) ~= "string" then
				return false, "workerUid must be a string"
			end
			return true
		end,
		Handler = onEquipWorker,
	})

	RemoteService.register({
		Name = "UnequipWorker",
		Cooldown = 0.2,
		Validator = function(_player: Player, workerUid: any): (boolean, string?)
			if typeof(workerUid) ~= "string" then
				return false, "workerUid must be a string"
			end
			return true
		end,
		Handler = onUnequipWorker,
	})

	-- Passive income tick. addCash syncs (DataSync >= 1/s per player is fine
	-- per contract); players with zero income are skipped entirely.
	task.spawn(function()
		while true do
			task.wait(GameConfig.Workers.IncomeTickSeconds)
			for _, player in DataService.getLoadedPlayers() do
				local data = DataService.getData(player)
				if data then
					local income = computeTickIncome(data)
					if income > 0 then
						DataService.addCash(player, income)
					else
						-- Keep the >=1/s DataSync cadence even with no income,
						-- so clients whose listeners connected after the load-time
						-- snapshot still receive their data within a second.
						DataService.sync(player)
					end
				end
			end
		end
	end)
end

function WorkerService.cleanupPlayer(_player: Player)
	-- No per-player state here: cooldown/rate bookkeeping is owned by
	-- RemoteService, worker data by DataService. Kept for the uniform shape.
end

return WorkerService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="18">
        <Properties>
          <string name="Name">ZoneService</string>
          <string name="Source"><![CDATA[-- ZoneService: zone unlock purchases via gate ProximityPrompts.
-- Contract: ARCHITECTURE.md "Map contract" + "Gate behavior".
-- Server-authoritative: validates data loaded, not-already-unlocked,
-- sequential order (zone with Order-1 must be unlocked), distance and cost.
-- Gate visuals/collision for unlocked zones are handled client-side by
-- ZoneGateController reacting to DataSync; this service only mutates data.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local GameConfig = require(ReplicatedStorage.Shared.GameConfig)

local ZoneService = {}

-- Injected via init(services) -- never require sibling services directly.
local DataService
local RemoteService

local UNLOCK_DEBOUNCE = 0.5 -- seconds between unlock attempts, per player
local MAX_PROMPT_DISTANCE = 20 -- studs; re-validated server-side per contract
local MAP_WAIT_TIMEOUT = 30 -- MapBuilder runs before start(); this is a safety net
local CHILD_WAIT_TIMEOUT = 5

-- UserId -> os.clock() of the last unlock attempt (debounce)
local lastUnlockAttempt: { [number]: number } = {}

-- Zones indexed by Order, for the sequential-unlock check.
local zonesByOrder: { [number]: GameConfig.ZoneDef } = {}
for _, zone in GameConfig.Zones do
	zonesByOrder[zone.Order] = zone
end

-- Fires a S->C RemoteEvent to one player. Prefers the RemoteService wrapper
-- (assumed API: RemoteService.fireClient(player, remoteName, ...)); falls back
-- to the contract-pinned ReplicatedStorage.Remotes folder so player feedback
-- never silently drops if the wrapper exposes a differently-named fire API.
local function fireClient(player: Player, remoteName: string, ...: any)
	if RemoteService ~= nil and typeof(RemoteService.fireClient) == "function" then
		RemoteService.fireClient(remoteName, player, ...)
		return
	end
	local remotes = ReplicatedStorage:FindFirstChild("Remotes")
	local remote = remotes and remotes:FindFirstChild(remoteName)
	if remote and remote:IsA("RemoteEvent") then
		remote:FireClient(player, ...)
	end
end

local function toast(player: Player, message: string, kind: string)
	fireClient(player, "Toast", message, kind)
end

local function isUnlockedInData(data: any, zoneId: string): boolean
	for _, unlockedId in data.UnlockedZones do
		if unlockedId == zoneId then
			return true
		end
	end
	return false
end

local function onUnlockTriggered(zone: GameConfig.ZoneDef, promptPart: BasePart, player: Player)
	-- Debounce per player (0.5 s), on attempt.
	local now = os.clock()
	if now - (lastUnlockAttempt[player.UserId] or 0) < UNLOCK_DEBOUNCE then
		return
	end
	lastUnlockAttempt[player.UserId] = now

	-- Data must be loaded.
	local data = DataService.getData(player)
	if not data then
		return
	end

	-- Already owned? Nothing to do (client hides the prompt, but never trust it).
	if isUnlockedInData(data, zone.Id) then
		return
	end

	-- Re-validate distance server-side (< 20 studs), per contract.
	local character = player.Character
	local rootPart = character and character:FindFirstChild("HumanoidRootPart")
	if not rootPart or not rootPart:IsA("BasePart") then
		return
	end
	if (rootPart.Position - promptPart.Position).Magnitude >= MAX_PROMPT_DISTANCE then
		return
	end

	-- Sequential unlocking: the zone with Order-1 must already be unlocked.
	local previousZone = zonesByOrder[zone.Order - 1]
	if previousZone and not isUnlockedInData(data, previousZone.Id) then
		toast(player, "Unlock " .. previousZone.Name .. " first!", "error")
		return
	end

	-- Cost: spendCash is the only legal way to take cash (it syncs + updates leaderstats).
	if not DataService.spendCash(player, zone.UnlockCost) then
		toast(player, "Not enough cash!", "error")
		return
	end

	table.insert(data.UnlockedZones, zone.Id)
	data.Stats.ZonesUnlockedCount = math.max(data.Stats.ZonesUnlockedCount, #data.UnlockedZones)
	DataService.sync(player)
	toast(player, zone.Name .. " unlocked!", "success")
end

-- Resolves one zone's gate prompt and connects it. Each step uses WaitForChild
-- with a timeout and warns + skips on failure, so one missing part never kills
-- the server or the other zones.
local function connectZoneGate(zonesFolder: Instance, zone: GameConfig.ZoneDef)
	local zoneModel = zonesFolder:WaitForChild(zone.Id, CHILD_WAIT_TIMEOUT)
	if not zoneModel then
		warn("[ZoneService] Zone model missing for " .. zone.Id .. "; unlock prompt skipped")
		return
	end

	local gate = zoneModel:WaitForChild("Gate", CHILD_WAIT_TIMEOUT)
	if not gate then
		warn("[ZoneService] Gate missing for zone " .. zone.Id .. "; unlock prompt skipped")
		return
	end

	local promptPart = gate:WaitForChild("PromptPart", CHILD_WAIT_TIMEOUT)
	if not promptPart or not promptPart:IsA("BasePart") then
		warn("[ZoneService] Gate PromptPart missing for zone " .. zone.Id .. "; unlock prompt skipped")
		return
	end

	local prompt = promptPart:WaitForChild("UnlockPrompt", CHILD_WAIT_TIMEOUT)
	if not prompt or not prompt:IsA("ProximityPrompt") then
		warn("[ZoneService] UnlockPrompt missing for zone " .. zone.Id .. "; unlock prompt skipped")
		return
	end

	-- Prompt connections live for the server's lifetime; per-player state is
	-- cleared in cleanupPlayer instead.
	prompt.Triggered:Connect(function(player: Player)
		onUnlockTriggered(zone, promptPart, player)
	end)
end

function ZoneService.init(services: { [string]: any })
	DataService = services.DataService
	RemoteService = services.RemoteService
end

function ZoneService.start()
	local map = Workspace:WaitForChild("SideHustleMap", MAP_WAIT_TIMEOUT)
	if not map then
		warn("[ZoneService] Workspace.SideHustleMap missing; no unlock prompts connected")
		return
	end

	local zonesFolder = map:WaitForChild("Zones", CHILD_WAIT_TIMEOUT)
	if not zonesFolder then
		warn("[ZoneService] SideHustleMap.Zones missing; no unlock prompts connected")
		return
	end

	for _, zone in GameConfig.Zones do
		if zone.UnlockCost > 0 then
			task.spawn(connectZoneGate, zonesFolder, zone)
		end
	end
end

-- True when the player's loaded data contains zoneId. Used by HustleService
-- (via injection) to reject hustles in locked zones.
function ZoneService.isZoneUnlocked(player: Player, zoneId: string): boolean
	local data = DataService.getData(player)
	if not data then
		return false
	end
	return isUnlockedInData(data, zoneId)
end

function ZoneService.cleanupPlayer(player: Player)
	lastUnlockAttempt[player.UserId] = nil
end

return ZoneService
]]></string>
        </Properties>
      </Item>
    </Item>
    <Item class="Folder" referent="19">
      <Properties>
        <string name="Name">World</string>
      </Properties>
      <Item class="ModuleScript" referent="20">
        <Properties>
          <string name="Name">MapBuilder</string>
          <string name="Source"><![CDATA[--!nonstrict
-- MapBuilder: constructs the entire Side Hustle Simulator map from primitives
-- (Blocks / Balls / Cylinders / Wedges only — no meshes, no Toolbox) plus Lighting.
--
-- Contract (ARCHITECTURE.md "Map contract"):
--   Workspace.SideHustleMap (Folder)
--     Ground (Model), Plaza (Model with SpawnLocation + ring road)
--     Zones (Folder) > <ZoneId> (Model, attribute ZoneId)
--       HustleStation (Model) > PromptPart > ProximityPrompt "HustlePrompt"
--       Gate (Model, only UnlockCost > 0) > GateWall / SignPart / PromptPart > "UnlockPrompt"
--
-- Visual direction: docs/art-feel-guide.md — bright, chunky, cartoony,
-- SmoothPlastic + Neon, one signature color per zone, oversized props.
--
-- MapBuilder.build() is idempotent: it returns early if the map already exists,
-- and every Lighting effect is guarded with FindFirstChild.

local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local GameConfig = require(ReplicatedStorage.Shared.GameConfig)
local FormatNumber = require(ReplicatedStorage.Shared.FormatNumber)

local MapBuilder = {}

----------------------------------------------------------------------
-- Layout constants (ground top is world Y = 0)
----------------------------------------------------------------------

local GROUND_SIZE = 700
local ROAD_RADIUS = 120 -- ring road disc; plaza sits on top, pads touch its edge
local PLAZA_RADIUS = 55
local ZONE_RADIUS = 150 -- distance of each zone center from origin
local PAD_SIZE = 64
local PAD_TOP = 1.5 -- top of plaza disc and of every zone pad

local RAD_90 = math.rad(90)

-- Shared palette
local NAVY = Color3.fromRGB(4, 4, 53)
local WHITE = Color3.fromRGB(248, 248, 244)
local CREAM = Color3.fromRGB(247, 238, 214)
local WOOD = Color3.fromRGB(133, 94, 62)
local DARK_WOOD = Color3.fromRGB(96, 66, 42)
local GRASS_GREEN = Color3.fromRGB(106, 192, 86)
local ROAD_GRAY = Color3.fromRGB(94, 90, 100)
local STONE = Color3.fromRGB(225, 214, 188)
local WHEEL_DARK = Color3.fromRGB(38, 38, 42)
local LEAF_GREEN = Color3.fromRGB(76, 160, 66)

----------------------------------------------------------------------
-- Primitive helpers
----------------------------------------------------------------------

type PartProps = {
	name: string?,
	parent: Instance,
	size: Vector3?,
	cframe: CFrame,
	color: Color3,
	material: Enum.Material?,
	transparency: number?,
	canCollide: boolean?,
	diameter: number?,
	height: number?,
	axis: string?, -- cylinders: "Y" (default), "X", "Z"
}

local function applyCommon(part: BasePart, props: PartProps)
	part.Name = props.name or "Part"
	part.Color = props.color
	part.Material = props.material or Enum.Material.SmoothPlastic
	part.Transparency = props.transparency or 0
	part.CanCollide = if props.canCollide ~= nil then props.canCollide else true
	part.Anchored = true
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
end

local function makeBlock(props: PartProps): Part
	local part = Instance.new("Part")
	part.Shape = Enum.PartType.Block
	part.Size = props.size :: Vector3
	part.CFrame = props.cframe
	applyCommon(part, props)
	part.Parent = props.parent
	return part
end

local function makeBall(props: PartProps): Part
	local part = Instance.new("Part")
	part.Shape = Enum.PartType.Ball
	part.Size = props.size :: Vector3
	part.CFrame = props.cframe
	applyCommon(part, props)
	part.Parent = props.parent
	return part
end

-- Cylinder whose length axis is vertical ("Y", default), or along "X"/"Z".
local function makeCylinder(props: PartProps): Part
	local part = Instance.new("Part")
	part.Shape = Enum.PartType.Cylinder
	local diameter = props.diameter or 1
	local height = props.height or 1
	part.Size = Vector3.new(height, diameter, diameter)
	local axis = props.axis or "Y"
	if axis == "Y" then
		part.CFrame = props.cframe * CFrame.Angles(0, 0, RAD_90)
	elseif axis == "Z" then
		part.CFrame = props.cframe * CFrame.Angles(0, RAD_90, 0)
	else -- "X": native cylinder axis
		part.CFrame = props.cframe
	end
	applyCommon(part, props)
	part.Parent = props.parent
	return part
end

-- WedgePart: full height at local +Z (back face vertical), sloping down to -Z.
local function makeWedge(props: PartProps): WedgePart
	local part = Instance.new("WedgePart")
	part.Size = props.size :: Vector3
	part.CFrame = props.cframe
	applyCommon(part, props)
	part.Parent = props.parent
	return part
end

local function makeModel(name: string, parent: Instance): Model
	local model = Instance.new("Model")
	model.Name = name
	model.Parent = parent
	return model
end

-- Invisible anchored part that carries a ProximityPrompt.
local function makePromptPart(parent: Instance, cf: CFrame): Part
	local part = Instance.new("Part")
	part.Name = "PromptPart"
	part.Size = Vector3.new(2, 2, 2)
	part.CFrame = cf
	part.Transparency = 1
	part.CanCollide = false
	part.CanTouch = false
	part.Anchored = true
	part.Parent = parent
	return part
end

local function makePrompt(
	parent: BasePart,
	name: string,
	actionText: string,
	objectText: string,
	holdDuration: number,
	maxDistance: number
): ProximityPrompt
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = name
	prompt.ActionText = actionText
	prompt.ObjectText = objectText
	prompt.HoldDuration = holdDuration
	prompt.MaxActivationDistance = maxDistance
	prompt.RequiresLineOfSight = false
	prompt.Parent = parent
	return prompt
end

local function makeTextLabel(
	parent: Instance,
	text: string,
	font: Enum.Font,
	textColor: Color3,
	position: UDim2,
	size: UDim2
): TextLabel
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Position = position
	label.Size = size
	label.Font = font
	label.Text = text
	label.TextColor3 = textColor
	label.TextScaled = true
	label.TextStrokeColor3 = NAVY
	label.TextStrokeTransparency = 0
	label.Parent = parent
	return label
end

-- Chunky sign board with SurfaceGui text on its front face.
local function addSignBoard(
	parent: Instance,
	cf: CFrame,
	width: number,
	height: number,
	text: string,
	boardColor: Color3,
	textColor: Color3
): Part
	local board = makeBlock({
		name = "NameBoard",
		parent = parent,
		size = Vector3.new(width, height, 0.5),
		cframe = cf,
		color = boardColor,
	})
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 30
	gui.LightInfluence = 0
	gui.Parent = board
	makeTextLabel(gui, text, Enum.Font.FredokaOne, textColor, UDim2.fromScale(0.03, 0.05), UDim2.fromScale(0.94, 0.9))
	return board
end

-- CFrame at a zone's center on the ground plane, front (-Z) facing the plaza.
local function zoneGroundCF(order: number): CFrame
	local angle = math.rad((order - 1) * 45)
	local pos = Vector3.new(math.cos(angle) * ZONE_RADIUS, 0, math.sin(angle) * ZONE_RADIUS)
	return CFrame.lookAt(pos, Vector3.new(0, 0, 0))
end

----------------------------------------------------------------------
-- Ground
----------------------------------------------------------------------

local function buildGround(map: Folder): Model
	local ground = makeModel("Ground", map)
	makeBlock({
		name = "GroundSlab",
		parent = ground,
		size = Vector3.new(GROUND_SIZE, 8, GROUND_SIZE),
		cframe = CFrame.new(0, -4, 0),
		color = GRASS_GREEN,
	})
	return ground
end

----------------------------------------------------------------------
-- Plaza: ring road, plaza disc, spawn, coin statue, lamps, benches, billboard
----------------------------------------------------------------------

local function buildLampPost(parent: Instance, cf: CFrame)
	makeCylinder({
		name = "LampBase", parent = parent, diameter = 2, height = 0.5,
		cframe = cf * CFrame.new(0, 0.25, 0), color = Color3.fromRGB(70, 70, 80),
	})
	makeCylinder({
		name = "LampPole", parent = parent, diameter = 0.7, height = 8,
		cframe = cf * CFrame.new(0, 4.25, 0), color = Color3.fromRGB(70, 70, 80),
	})
	makeBall({
		name = "LampBulb", parent = parent, size = Vector3.new(2.4, 2.4, 2.4),
		cframe = cf * CFrame.new(0, 8.9, 0), color = Color3.fromRGB(255, 232, 170),
		material = Enum.Material.Neon, canCollide = false,
	})
end

local function buildBench(parent: Instance, cf: CFrame)
	makeBlock({
		name = "BenchSeat", parent = parent, size = Vector3.new(5.5, 0.55, 1.8),
		cframe = cf * CFrame.new(0, 1.35, 0), color = WOOD,
	})
	for _, xOff in { -2.2, 2.2 } do
		makeBlock({
			name = "BenchLeg", parent = parent, size = Vector3.new(0.5, 1.1, 1.6),
			cframe = cf * CFrame.new(xOff, 0.55, 0), color = DARK_WOOD,
		})
	end
	makeBlock({
		name = "BenchBack", parent = parent, size = Vector3.new(5.5, 1.6, 0.45),
		cframe = cf * CFrame.new(0, 2.3, 0.8) * CFrame.Angles(math.rad(-8), 0, 0), color = WOOD,
	})
end

local function buildCoinStatue(parent: Instance)
	local gold = Color3.fromRGB(235, 184, 52)
	local brightGold = Color3.fromRGB(255, 215, 95)
	local bronze = Color3.fromRGB(110, 78, 28)
	makeCylinder({
		name = "StatuePedestal", parent = parent, diameter = 10, height = 2,
		cframe = CFrame.new(0, PAD_TOP + 1, 0), color = Color3.fromRGB(205, 198, 182),
	})
	makeCylinder({
		name = "StatuePedestalTop", parent = parent, diameter = 7.5, height = 1.5,
		cframe = CFrame.new(0, PAD_TOP + 2.75, 0), color = Color3.fromRGB(190, 182, 165),
	})
	-- Giant gold coin standing on its edge (cylinder axis along X)
	local coinY = PAD_TOP + 8
	makeCylinder({
		name = "StatueCoin", parent = parent, diameter = 9, height = 1.4, axis = "X",
		cframe = CFrame.new(0, coinY, 0), color = gold,
	})
	makeCylinder({
		name = "StatueCoinCore", parent = parent, diameter = 6, height = 1.5, axis = "X",
		cframe = CFrame.new(0, coinY, 0), color = brightGold,
		material = Enum.Material.Neon, canCollide = false,
	})
	-- Dollar-sign-ish bar + serifs across the coin face
	makeBlock({
		name = "StatueDollarBar", parent = parent, size = Vector3.new(1.7, 7.5, 1),
		cframe = CFrame.new(0, coinY, 0), color = bronze, canCollide = false,
	})
	makeBlock({
		name = "StatueDollarTop", parent = parent, size = Vector3.new(1.8, 0.8, 2.4),
		cframe = CFrame.new(0, coinY + 3.1, -0.6), color = bronze, canCollide = false,
	})
	makeBlock({
		name = "StatueDollarBottom", parent = parent, size = Vector3.new(1.8, 0.8, 2.4),
		cframe = CFrame.new(0, coinY - 3.1, 0.6), color = bronze, canCollide = false,
	})
end

local function buildTitleBillboard(parent: Instance)
	local angle = math.rad(157.5)
	local pos = Vector3.new(math.cos(angle) * 47, 0, math.sin(angle) * 47)
	local baseCF = CFrame.lookAt(pos, Vector3.new(0, 0, 0))
	local postColor = Color3.fromRGB(60, 62, 110)
	for _, xOff in { -9, 9 } do
		makeBlock({
			name = "BillboardPost", parent = parent, size = Vector3.new(1.2, 9, 1.2),
			cframe = baseCF * CFrame.new(xOff, PAD_TOP + 4.5, 0), color = postColor,
		})
	end
	local board = makeBlock({
		name = "BillboardBoard", parent = parent, size = Vector3.new(24, 7, 1),
		cframe = baseCF * CFrame.new(0, PAD_TOP + 11.5, 0), color = Color3.fromRGB(24, 26, 64),
	})
	-- Neon trim around the board
	local trim = Color3.fromRGB(255, 212, 31)
	for _, yOff in { -3.8, 3.8 } do
		makeBlock({
			name = "BillboardTrim", parent = parent, size = Vector3.new(25.2, 0.6, 1.2),
			cframe = baseCF * CFrame.new(0, PAD_TOP + 11.5 + yOff, 0), color = trim,
			material = Enum.Material.Neon, canCollide = false,
		})
	end
	for _, xOff in { -12.3, 12.3 } do
		makeBlock({
			name = "BillboardTrim", parent = parent, size = Vector3.new(0.6, 8.2, 1.2),
			cframe = baseCF * CFrame.new(xOff, PAD_TOP + 11.5, 0), color = trim,
			material = Enum.Material.Neon, canCollide = false,
		})
	end
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 30
	gui.LightInfluence = 0
	gui.Parent = board
	makeTextLabel(
		gui,
		"SIDE HUSTLE\nSIMULATOR",
		Enum.Font.LuckiestGuy,
		Color3.fromRGB(255, 212, 31),
		UDim2.fromScale(0.03, 0.05),
		UDim2.fromScale(0.94, 0.9)
	)
end

local function buildPlaza(map: Folder)
	local plaza = makeModel("Plaza", map)

	-- Ring road (flattened disc; the plaza disc sits on top of it)
	makeCylinder({
		name = "RingRoad", parent = plaza, diameter = ROAD_RADIUS * 2, height = 0.5,
		cframe = CFrame.new(0, 0.25, 0), color = ROAD_GRAY,
	})
	-- Plaza disc
	makeCylinder({
		name = "PlazaFloor", parent = plaza, diameter = PLAZA_RADIUS * 2, height = 1,
		cframe = CFrame.new(0, 1, 0), color = STONE,
	})
	-- Decorative inner ring around the statue
	makeCylinder({
		name = "PlazaRing", parent = plaza, diameter = 28, height = 0.18,
		cframe = CFrame.new(0, PAD_TOP + 0.05, 0), color = Color3.fromRGB(240, 226, 180),
	})

	-- Spawn (Neutral, plain — no decal clutter), facing the statue
	local spawnLocation = Instance.new("SpawnLocation")
	spawnLocation.Name = "SpawnLocation"
	spawnLocation.Size = Vector3.new(12, 1, 12)
	spawnLocation.CFrame = CFrame.lookAt(Vector3.new(-20, PAD_TOP + 0.5, 0), Vector3.new(0, PAD_TOP + 0.5, 0))
	spawnLocation.Color = Color3.fromRGB(236, 228, 205)
	spawnLocation.Material = Enum.Material.SmoothPlastic
	spawnLocation.Anchored = true
	spawnLocation.TopSurface = Enum.SurfaceType.Smooth
	spawnLocation.BottomSurface = Enum.SurfaceType.Smooth
	spawnLocation.Neutral = true
	spawnLocation.Duration = 0
	spawnLocation.Parent = plaza

	buildCoinStatue(plaza)

	-- Lamp posts around the plaza
	for i = 0, 5 do
		local angle = math.rad(10 + i * 60)
		local cf = CFrame.new(math.cos(angle) * 44, PAD_TOP, math.sin(angle) * 44)
		buildLampPost(plaza, cf)
	end

	-- Benches facing the statue
	for _, deg in { 55, 185, 300 } do
		local angle = math.rad(deg)
		local pos = Vector3.new(math.cos(angle) * 30, PAD_TOP, math.sin(angle) * 30)
		buildBench(plaza, CFrame.lookAt(pos, Vector3.new(0, PAD_TOP, 0)))
	end

	buildTitleBillboard(plaza)
end

----------------------------------------------------------------------
-- Shared zone pieces: hustle station + unlock gate
----------------------------------------------------------------------

local function buildHustleStation(
	zoneModel: Model,
	zoneCF: CFrame,
	zone,
	localPos: Vector3,
	withCounter: boolean
)
	local station = makeModel("HustleStation", zoneModel)
	local baseCF = zoneCF * CFrame.new(localPos)
	if withCounter then
		makeBlock({
			name = "CounterBase", parent = station, size = Vector3.new(7, 3, 2.6),
			cframe = baseCF * CFrame.new(0, 1.5, 0), color = zone.SignColor,
		})
		makeBlock({
			name = "CounterTop", parent = station, size = Vector3.new(8, 0.5, 3.2),
			cframe = baseCF * CFrame.new(0, 3.25, 0), color = CREAM,
		})
		makeBlock({
			name = "CounterTrim", parent = station, size = Vector3.new(7.2, 0.6, 0.2),
			cframe = baseCF * CFrame.new(0, 1.9, -1.4), color = zone.AccentColor,
			material = Enum.Material.Neon, canCollide = false,
		})
	end
	local promptPart = makePromptPart(station, baseCF * CFrame.new(0, 3, -2.4))
	makePrompt(promptPart, "HustlePrompt", zone.HustleVerb .. "!", zone.Name, 0, 12)
end

local function buildGate(zoneModel: Model, zoneCF: CFrame, zone)
	local gate = makeModel("Gate", zoneModel)
	local costText = "$" .. FormatNumber.commas(zone.UnlockCost)

	makeBlock({
		name = "GateWall", parent = gate, size = Vector3.new(26, 11, 1.2),
		cframe = zoneCF * CFrame.new(0, 5.5, -30.5), color = zone.SignColor,
		transparency = 0.45, canCollide = true,
	})
	for _, xOff in { -13.4, 13.4 } do
		makeBlock({
			name = "GatePost", parent = gate, size = Vector3.new(1.5, 12.5, 1.5),
			cframe = zoneCF * CFrame.new(xOff, 6.25, -30.5), color = zone.SignColor,
			material = Enum.Material.Neon,
		})
	end
	makeBlock({
		name = "GateTopBar", parent = gate, size = Vector3.new(28.5, 1, 1),
		cframe = zoneCF * CFrame.new(0, 12.2, -30.5), color = zone.SignColor,
		material = Enum.Material.Neon, canCollide = false,
	})
	-- Low hedges flanking the gate along the pad's front edge
	for _, xOff in { -21.5, 21.5 } do
		makeBlock({
			name = "GateHedge", parent = gate, size = Vector3.new(15, 2.6, 1.8),
			cframe = zoneCF * CFrame.new(xOff, 1.3, -30.5), color = LEAF_GREEN,
		})
	end

	-- Price sign (billboard readable from across the map)
	local signPart = makeBlock({
		name = "SignPart", parent = gate, size = Vector3.new(11, 2.6, 0.9),
		cframe = zoneCF * CFrame.new(0, 14.2, -30.5), color = zone.SignColor,
		material = Enum.Material.Neon, canCollide = false,
	})
	local billboard = Instance.new("BillboardGui")
	billboard.Size = UDim2.fromScale(2.4, 3.2) -- scales with SignPart: ~26 x 8 studs
	billboard.StudsOffset = Vector3.new(0, 1.2, 0)
	billboard.MaxDistance = 400
	billboard.LightInfluence = 0
	billboard.AlwaysOnTop = false
	billboard.Parent = signPart
	makeTextLabel(
		billboard, zone.Name, Enum.Font.FredokaOne, WHITE,
		UDim2.fromScale(0, 0), UDim2.fromScale(1, 0.55)
	)
	makeTextLabel(
		billboard, costText .. " to unlock", Enum.Font.FredokaOne, WHITE,
		UDim2.fromScale(0, 0.55), UDim2.fromScale(1, 0.45)
	)

	local promptPart = makePromptPart(gate, zoneCF * CFrame.new(0, 3.5, -28.5))
	makePrompt(promptPart, "UnlockPrompt", "Unlock", costText, 0.5, 10)
end

----------------------------------------------------------------------
-- Zone 1: Lemonade Stand — wooden stand, striped canopy, giant lemon
----------------------------------------------------------------------

local function buildLemonadeStand(zoneModel: Model, zoneCF: CFrame, zone)
	local yellow = zone.SignColor
	makeBlock({
		name = "StandBase", parent = zoneModel, size = Vector3.new(10, 3.2, 2.6),
		cframe = zoneCF * CFrame.new(0, 1.6, 9), color = WOOD,
	})
	makeBlock({
		name = "StandTop", parent = zoneModel, size = Vector3.new(11, 0.5, 3.2),
		cframe = zoneCF * CFrame.new(0, 3.45, 9), color = CREAM,
	})
	-- Striped front skirt
	for i = 0, 4 do
		makeBlock({
			name = "StandStripe", parent = zoneModel, size = Vector3.new(1.9, 2.9, 0.2),
			cframe = zoneCF * CFrame.new(-3.8 + i * 1.9, 1.65, 7.65),
			color = if i % 2 == 0 then yellow else WHITE, canCollide = false,
		})
	end
	-- Canopy posts + striped canopy
	for _, xOff in { -4.6, 4.6 } do
		makeBlock({
			name = "CanopyPost", parent = zoneModel, size = Vector3.new(0.8, 8.4, 0.8),
			cframe = zoneCF * CFrame.new(xOff, 4.2, 10.2), color = DARK_WOOD,
		})
	end
	for i = 0, 4 do
		makeBlock({
			name = "CanopyStripe", parent = zoneModel, size = Vector3.new(2.3, 0.4, 6.5),
			cframe = zoneCF * CFrame.new(-4.6 + i * 2.3, 8.6, 9.1),
			color = if i % 2 == 0 then yellow else WHITE,
		})
	end
	-- GIANT lemon on the roof (squashed ball, slightly tilted)
	local lemonCF = zoneCF * CFrame.new(0, 12.2, 9.1) * CFrame.Angles(0, 0, math.rad(10))
	makeBall({
		name = "GiantLemon", parent = zoneModel, size = Vector3.new(9, 6.8, 6.8),
		cframe = lemonCF, color = yellow, canCollide = false,
	})
	for _, xOff in { -4.2, 4.2 } do
		makeBall({
			name = "LemonTip", parent = zoneModel, size = Vector3.new(1.6, 1.6, 1.6),
			cframe = lemonCF * CFrame.new(xOff, 0, 0), color = Color3.fromRGB(235, 190, 28),
			canCollide = false,
		})
	end
	-- Pitcher + cups on the counter
	makeCylinder({
		name = "Pitcher", parent = zoneModel, diameter = 1.5, height = 2.3,
		cframe = zoneCF * CFrame.new(2.6, 4.85, 9), color = CREAM, canCollide = false,
	})
	makeBlock({
		name = "PitcherHandle", parent = zoneModel, size = Vector3.new(0.35, 1.3, 0.9),
		cframe = zoneCF * CFrame.new(3.5, 4.85, 9), color = CREAM, canCollide = false,
	})
	for _, xOff in { -2.2, -3.1 } do
		makeCylinder({
			name = "LemonadeCup", parent = zoneModel, diameter = 0.8, height = 1,
			cframe = zoneCF * CFrame.new(xOff, 4.2, 8.8), color = yellow, canCollide = false,
		})
	end
	addSignBoard(zoneModel, zoneCF * CFrame.new(0, 7.6, 6.1), 9, 2, zone.Name, NAVY, yellow)
end

----------------------------------------------------------------------
-- Zone 2: Dog Walking — park, fence, dog house, giant bone, blocky dogs
----------------------------------------------------------------------

local function buildDog(parent: Instance, cf: CFrame, color: Color3)
	local darker = color:Lerp(Color3.new(0, 0, 0), 0.3)
	makeBlock({
		name = "DogBody", parent = parent, size = Vector3.new(1.5, 1.6, 2.8),
		cframe = cf * CFrame.new(0, 1.6, 0), color = color,
	})
	for _, offset in { Vector3.new(-0.45, 0.4, -0.95), Vector3.new(0.45, 0.4, -0.95), Vector3.new(-0.45, 0.4, 0.95), Vector3.new(0.45, 0.4, 0.95) } do
		makeBlock({
			name = "DogLeg", parent = parent, size = Vector3.new(0.45, 0.8, 0.45),
			cframe = cf * CFrame.new(offset), color = color, canCollide = false,
		})
	end
	makeBlock({
		name = "DogHead", parent = parent, size = Vector3.new(1.3, 1.2, 1.1),
		cframe = cf * CFrame.new(0, 2.7, -1.5), color = color,
	})
	makeBlock({
		name = "DogSnout", parent = parent, size = Vector3.new(0.7, 0.5, 0.6),
		cframe = cf * CFrame.new(0, 2.45, -2.3), color = darker, canCollide = false,
	})
	makeBall({
		name = "DogNose", parent = parent, size = Vector3.new(0.35, 0.35, 0.35),
		cframe = cf * CFrame.new(0, 2.5, -2.65), color = Color3.fromRGB(25, 22, 22), canCollide = false,
	})
	for _, xOff in { -0.4, 0.4 } do
		makeBlock({
			name = "DogEar", parent = parent, size = Vector3.new(0.35, 0.6, 0.2),
			cframe = cf * CFrame.new(xOff, 3.4, -1.4), color = darker, canCollide = false,
		})
	end
	makeBlock({
		name = "DogTail", parent = parent, size = Vector3.new(0.3, 1.1, 0.3),
		cframe = cf * CFrame.new(0, 2.5, 1.5) * CFrame.Angles(math.rad(30), 0, 0),
		color = darker, canCollide = false,
	})
end

local function buildDogWalking(zoneModel: Model, zoneCF: CFrame, zone)
	local fenceWhite = Color3.fromRGB(242, 240, 234)
	-- White fence along both sides of the park
	for _, xOff in { -28, 28 } do
		for z = -20, 20, 10 do
			makeBlock({
				name = "FencePost", parent = zoneModel, size = Vector3.new(0.7, 2.8, 0.7),
				cframe = zoneCF * CFrame.new(xOff, 1.4, z), color = fenceWhite,
			})
		end
		for _, yOff in { 1, 2 } do
			makeBlock({
				name = "FenceRail", parent = zoneModel, size = Vector3.new(0.4, 0.35, 42),
				cframe = zoneCF * CFrame.new(xOff, yOff, 0), color = fenceWhite, canCollide = false,
			})
		end
	end
	-- Red dog house with gabled roof
	local houseRed = Color3.fromRGB(196, 60, 54)
	local roofRed = Color3.fromRGB(140, 40, 36)
	makeBlock({
		name = "DogHouse", parent = zoneModel, size = Vector3.new(8, 6, 7),
		cframe = zoneCF * CFrame.new(10, 3, 14), color = houseRed,
	})
	makeWedge({
		name = "DogHouseRoof", parent = zoneModel, size = Vector3.new(7.5, 2, 4.5),
		cframe = zoneCF * CFrame.new(7.75, 7, 14) * CFrame.Angles(0, RAD_90, 0), color = roofRed,
	})
	makeWedge({
		name = "DogHouseRoof", parent = zoneModel, size = Vector3.new(7.5, 2, 4.5),
		cframe = zoneCF * CFrame.new(12.25, 7, 14) * CFrame.Angles(0, -RAD_90, 0), color = roofRed,
	})
	makeBlock({
		name = "DogHouseDoor", parent = zoneModel, size = Vector3.new(2.6, 3.4, 0.4),
		cframe = zoneCF * CFrame.new(10, 1.9, 10.4), color = Color3.fromRGB(30, 24, 22), canCollide = false,
	})
	-- Giant white bone (cylinder + two balls at each end)
	local boneWhite = Color3.fromRGB(250, 248, 240)
	makeCylinder({
		name = "BoneShaft", parent = zoneModel, diameter = 2, height = 7, axis = "X",
		cframe = zoneCF * CFrame.new(-8, 1.5, 2) * CFrame.Angles(0, math.rad(25), 0), color = boneWhite,
	})
	local boneCF = zoneCF * CFrame.new(-8, 1.5, 2) * CFrame.Angles(0, math.rad(25), 0)
	for _, xOff in { -3.5, 3.5 } do
		for _, zOff in { -0.9, 0.9 } do
			makeBall({
				name = "BoneKnob", parent = zoneModel, size = Vector3.new(3, 3, 3),
				cframe = boneCF * CFrame.new(xOff, 0, zOff), color = boneWhite,
			})
		end
	end
	-- Two tiny blocky dogs
	buildDog(zoneModel, zoneCF * CFrame.new(-14, 0, 12) * CFrame.Angles(0, math.rad(140), 0), Color3.fromRGB(150, 103, 60))
	buildDog(zoneModel, zoneCF * CFrame.new(4, 0, -4) * CFrame.Angles(0, math.rad(-35), 0), Color3.fromRGB(240, 238, 230))
	addSignBoard(zoneModel, zoneCF * CFrame.new(10, 9.3, 14), 10, 2.2, zone.Name, NAVY, zone.SignColor)
end

----------------------------------------------------------------------
-- Zone 3: Sneaker Street — purple storefront, giant sneaker on a pedestal
----------------------------------------------------------------------

local function buildSneakerFlipping(zoneModel: Model, zoneCF: CFrame, zone)
	local wallPurple = Color3.fromRGB(74, 64, 120)
	-- Storefront
	makeBlock({
		name = "StoreBody", parent = zoneModel, size = Vector3.new(22, 14, 12),
		cframe = zoneCF * CFrame.new(0, 7, 16), color = wallPurple,
	})
	makeBlock({
		name = "StoreRoof", parent = zoneModel, size = Vector3.new(23, 0.8, 13),
		cframe = zoneCF * CFrame.new(0, 14.4, 16), color = Color3.fromRGB(50, 42, 84),
	})
	makeBlock({
		name = "StoreWindow", parent = zoneModel, size = Vector3.new(12, 5.5, 0.5),
		cframe = zoneCF * CFrame.new(-2, 5.2, 9.8), color = Color3.fromRGB(25, 22, 48),
		transparency = 0.35, canCollide = false,
	})
	makeBlock({
		name = "StoreDoor", parent = zoneModel, size = Vector3.new(4, 7.5, 0.5),
		cframe = zoneCF * CFrame.new(7.5, 3.75, 9.8), color = NAVY, canCollide = false,
	})
	-- Neon purple trim
	makeBlock({
		name = "StoreTrim", parent = zoneModel, size = Vector3.new(22.8, 0.7, 0.7),
		cframe = zoneCF * CFrame.new(0, 14, 9.9), color = zone.SignColor,
		material = Enum.Material.Neon, canCollide = false,
	})
	for _, yOff in { 2.2, 8.2 } do
		makeBlock({
			name = "WindowTrim", parent = zoneModel, size = Vector3.new(12.6, 0.4, 0.3),
			cframe = zoneCF * CFrame.new(-2, yOff, 10), color = zone.SignColor,
			material = Enum.Material.Neon, canCollide = false,
		})
	end
	-- Giant sneaker on a display pedestal
	makeCylinder({
		name = "SneakerPedestal", parent = zoneModel, diameter = 7, height = 2.4,
		cframe = zoneCF * CFrame.new(-12, 1.2, -2), color = WHITE,
	})
	local shoeCF = zoneCF * CFrame.new(-12, 0, -2)
	makeBlock({
		name = "SneakerSole", parent = zoneModel, size = Vector3.new(7.5, 0.9, 3),
		cframe = shoeCF * CFrame.new(0, 2.85, 0), color = WHITE,
	})
	makeBlock({
		name = "SneakerHeel", parent = zoneModel, size = Vector3.new(2.4, 1.6, 2.9),
		cframe = shoeCF * CFrame.new(-2.3, 4.1, 0), color = zone.SignColor,
	})
	makeBlock({
		name = "SneakerBody", parent = zoneModel, size = Vector3.new(4.5, 2.1, 2.9),
		cframe = shoeCF * CFrame.new(-0.4, 4.35, 0), color = zone.SignColor,
	})
	makeWedge({
		name = "SneakerToe", parent = zoneModel, size = Vector3.new(2.9, 1.9, 2.4),
		cframe = shoeCF * CFrame.new(2.6, 4.25, 0) * CFrame.Angles(0, -RAD_90, 0), color = zone.SignColor,
	})
	makeBlock({
		name = "SneakerSwoosh", parent = zoneModel, size = Vector3.new(2.8, 0.5, 0.2),
		cframe = shoeCF * CFrame.new(0, 4.4, -1.55) * CFrame.Angles(0, 0, math.rad(-14)),
		color = zone.AccentColor, material = Enum.Material.Neon, canCollide = false,
	})
	addSignBoard(zoneModel, zoneCF * CFrame.new(0, 11.8, 9.85), 14, 2.6, zone.Name, NAVY, zone.AccentColor)
end

----------------------------------------------------------------------
-- Zone 4: Car Wash — aqua tunnel, roller brushes, blocky car with foam
----------------------------------------------------------------------

local function buildCarWash(zoneModel: Model, zoneCF: CFrame, zone)
	local aqua = zone.SignColor
	-- Tunnel: low front wall (so the inside is visible), full back wall, roof, columns
	makeBlock({
		name = "TunnelFrontWall", parent = zoneModel, size = Vector3.new(22, 4.5, 1.2),
		cframe = zoneCF * CFrame.new(0, 2.25, 2), color = aqua,
	})
	makeBlock({
		name = "TunnelBackWall", parent = zoneModel, size = Vector3.new(22, 9, 1.2),
		cframe = zoneCF * CFrame.new(0, 4.5, 14), color = aqua,
	})
	for _, xOff in { -10.5, 10.5 } do
		makeBlock({
			name = "TunnelColumn", parent = zoneModel, size = Vector3.new(1.6, 9, 1.6),
			cframe = zoneCF * CFrame.new(xOff, 4.5, 2), color = aqua,
		})
	end
	makeBlock({
		name = "TunnelRoof", parent = zoneModel, size = Vector3.new(23, 1.2, 14),
		cframe = zoneCF * CFrame.new(0, 9.6, 8), color = Color3.fromRGB(44, 150, 170),
	})
	makeBlock({
		name = "TunnelTrim", parent = zoneModel, size = Vector3.new(23, 0.8, 0.8),
		cframe = zoneCF * CFrame.new(0, 10.3, 1.4), color = zone.AccentColor,
		material = Enum.Material.Neon, canCollide = false,
	})
	-- Big roller brushes
	for _, offset in { Vector3.new(-6, 0, 5.4), Vector3.new(0, 0, 10.6), Vector3.new(6, 0, 5.4) } do
		makeCylinder({
			name = "RollerBrush", parent = zoneModel, diameter = 3, height = 7.5,
			cframe = zoneCF * CFrame.new(offset.X, 3.75, offset.Z), color = Color3.fromRGB(30, 70, 115),
		})
	end
	-- Chunky blocky car
	makeBlock({
		name = "CarBody", parent = zoneModel, size = Vector3.new(8, 2.2, 4.2),
		cframe = zoneCF * CFrame.new(1, 2.1, 8), color = Color3.fromRGB(224, 82, 72),
	})
	makeBlock({
		name = "CarCabin", parent = zoneModel, size = Vector3.new(4, 1.8, 3.8),
		cframe = zoneCF * CFrame.new(0.6, 4.1, 8), color = Color3.fromRGB(50, 70, 95), transparency = 0.25,
	})
	for _, xOff in { -2.8, 2.8 } do
		for _, zOff in { -2.3, 2.3 } do
			makeCylinder({
				name = "CarWheel", parent = zoneModel, diameter = 2, height = 0.8, axis = "Z",
				cframe = zoneCF * CFrame.new(1 + xOff, 1, 8 + zOff), color = WHEEL_DARK,
			})
		end
	end
	-- Foam bubbles on the car
	local bubbles = {
		{ Vector3.new(0, 3.6, 7), 1.8 },
		{ Vector3.new(2.4, 3.5, 9), 1.4 },
		{ Vector3.new(-1.5, 3.4, 8.8), 1.2 },
		{ Vector3.new(0.8, 5.3, 8.2), 1.6 },
		{ Vector3.new(3.2, 3.3, 6.6), 1.1 },
		{ Vector3.new(-2.6, 3.4, 7.4), 1.3 },
	}
	for _, bubble in bubbles do
		local offset, d = bubble[1], bubble[2]
		makeBall({
			name = "FoamBubble", parent = zoneModel, size = Vector3.new(d, d, d),
			cframe = zoneCF * CFrame.new(offset), color = Color3.fromRGB(250, 250, 255),
			transparency = 0.2, canCollide = false,
		})
	end
	addSignBoard(zoneModel, zoneCF * CFrame.new(0, 11.6, 2), 14, 2.4, zone.Name, NAVY, zone.AccentColor)
end

----------------------------------------------------------------------
-- Zone 5: Food Truck — orange truck with a HUGE burger on the roof
----------------------------------------------------------------------

local function buildFoodTruck(zoneModel: Model, zoneCF: CFrame, zone)
	local orange = zone.SignColor
	local truckCF = zoneCF * CFrame.new(0, 0, 8)
	makeBlock({
		name = "TruckBody", parent = zoneModel, size = Vector3.new(15, 5, 6),
		cframe = truckCF * CFrame.new(0, 3.9, 0), color = orange,
	})
	makeBlock({
		name = "TruckCab", parent = zoneModel, size = Vector3.new(4, 3.6, 5.6),
		cframe = truckCF * CFrame.new(-9.5, 3.2, 0), color = orange,
	})
	makeBlock({
		name = "TruckWindshield", parent = zoneModel, size = Vector3.new(0.5, 1.8, 4.4),
		cframe = truckCF * CFrame.new(-11.3, 4.2, 0), color = Color3.fromRGB(50, 70, 95),
		transparency = 0.3, canCollide = false,
	})
	for _, xOff in { -9, 5 } do
		for _, zOff in { -3.4, 3.4 } do
			makeCylinder({
				name = "TruckWheel", parent = zoneModel, diameter = 2.4, height = 0.9, axis = "Z",
				cframe = truckCF * CFrame.new(xOff, 1.2, zOff), color = WHEEL_DARK,
			})
		end
	end
	-- Serving window + counter lip + awning (front side, facing the plaza)
	makeBlock({
		name = "ServingWindow", parent = zoneModel, size = Vector3.new(6, 2.4, 0.4),
		cframe = truckCF * CFrame.new(0.5, 4.4, -3.05), color = Color3.fromRGB(40, 36, 36),
		transparency = 0.25, canCollide = false,
	})
	makeBlock({
		name = "WindowCounter", parent = zoneModel, size = Vector3.new(6.6, 0.4, 1),
		cframe = truckCF * CFrame.new(0.5, 3.1, -3.5), color = CREAM,
	})
	makeBlock({
		name = "Awning", parent = zoneModel, size = Vector3.new(7, 0.4, 2.4),
		cframe = truckCF * CFrame.new(0.5, 5.9, -3.8) * CFrame.Angles(math.rad(-20), 0, 0),
		color = zone.AccentColor, canCollide = false,
	})
	-- HUGE burger on the roof: bun / patty / cheese / lettuce / top bun
	makeCylinder({
		name = "BurgerBunBottom", parent = zoneModel, diameter = 7, height = 1.4,
		cframe = truckCF * CFrame.new(0, 7.1, 0), color = Color3.fromRGB(233, 170, 92), canCollide = false,
	})
	makeCylinder({
		name = "BurgerPatty", parent = zoneModel, diameter = 7.7, height = 1,
		cframe = truckCF * CFrame.new(0, 8.3, 0), color = Color3.fromRGB(118, 70, 36), canCollide = false,
	})
	makeBlock({
		name = "BurgerCheese", parent = zoneModel, size = Vector3.new(6.9, 0.35, 6.9),
		cframe = truckCF * CFrame.new(0, 8.95, 0) * CFrame.Angles(0, math.rad(20), 0),
		color = Color3.fromRGB(255, 196, 40), canCollide = false,
	})
	makeCylinder({
		name = "BurgerLettuce", parent = zoneModel, diameter = 8.1, height = 0.6,
		cframe = truckCF * CFrame.new(0, 9.4, 0), color = Color3.fromRGB(120, 212, 80), canCollide = false,
	})
	makeBall({
		name = "BurgerBunTop", parent = zoneModel, size = Vector3.new(7.2, 3.6, 7.2),
		cframe = truckCF * CFrame.new(0, 10.6, 0), color = Color3.fromRGB(233, 170, 92), canCollide = false,
	})
	for _, offset in { Vector3.new(-1.4, 12.1, 0.8), Vector3.new(1.2, 12.2, -0.6), Vector3.new(0.2, 12.3, 1.4) } do
		makeBall({
			name = "SesameSeed", parent = zoneModel, size = Vector3.new(0.5, 0.35, 0.5),
			cframe = truckCF * CFrame.new(offset), color = CREAM, canCollide = false,
		})
	end
	-- Menu board beside the truck
	addSignBoard(zoneModel, zoneCF * CFrame.new(10.5, 4, 2), 4.2, 3, "MENU", NAVY, CREAM)
	makeBlock({
		name = "MenuPost", parent = zoneModel, size = Vector3.new(0.4, 3.2, 0.4),
		cframe = zoneCF * CFrame.new(10.5, 1.6, 2), color = DARK_WOOD,
	})
	addSignBoard(zoneModel, truckCF * CFrame.new(-0.5, 2.1, -3.5), 8, 1.4, zone.Name, NAVY, CREAM)
end

----------------------------------------------------------------------
-- Zone 6: Creator Studio — pink neon, giant ring light, tripod, play button
----------------------------------------------------------------------

local function buildContentCreator(zoneModel: Model, zoneCF: CFrame, zone)
	local pink = zone.SignColor
	-- Studio building
	makeBlock({
		name = "StudioBody", parent = zoneModel, size = Vector3.new(20, 12, 12),
		cframe = zoneCF * CFrame.new(0, 6, 16), color = Color3.fromRGB(58, 48, 70),
	})
	makeBlock({
		name = "StudioRoof", parent = zoneModel, size = Vector3.new(21, 0.8, 13),
		cframe = zoneCF * CFrame.new(0, 12.4, 16), color = Color3.fromRGB(44, 36, 54),
	})
	makeBlock({
		name = "StudioWindow", parent = zoneModel, size = Vector3.new(9, 4.5, 0.5),
		cframe = zoneCF * CFrame.new(0, 6, 9.8), color = Color3.fromRGB(28, 22, 40),
		transparency = 0.3, canCollide = false,
	})
	makeBlock({
		name = "StudioTrim", parent = zoneModel, size = Vector3.new(20.6, 0.7, 0.7),
		cframe = zoneCF * CFrame.new(0, 12.1, 10), color = pink,
		material = Enum.Material.Neon, canCollide = false,
	})
	for _, xOff in { -10.1, 10.1 } do
		makeBlock({
			name = "StudioCornerTrim", parent = zoneModel, size = Vector3.new(0.7, 12.4, 0.7),
			cframe = zoneCF * CFrame.new(xOff, 6.2, 10), color = pink,
			material = Enum.Material.Neon, canCollide = false,
		})
	end
	-- Giant ring light on a stand
	makeCylinder({
		name = "RingLightBase", parent = zoneModel, diameter = 3, height = 0.5,
		cframe = zoneCF * CFrame.new(-9, 0.25, -2), color = Color3.fromRGB(40, 38, 45),
	})
	makeCylinder({
		name = "RingLightPole", parent = zoneModel, diameter = 0.7, height = 5.5,
		cframe = zoneCF * CFrame.new(-9, 3.25, -2), color = Color3.fromRGB(40, 38, 45),
	})
	makeCylinder({
		name = "RingLight", parent = zoneModel, diameter = 9, height = 0.8, axis = "Z",
		cframe = zoneCF * CFrame.new(-9, 7, -2), color = pink,
		material = Enum.Material.Neon, canCollide = false,
	})
	makeCylinder({
		name = "RingLightInner", parent = zoneModel, diameter = 6.8, height = 0.7, axis = "Z",
		cframe = zoneCF * CFrame.new(-9, 7, -2.15), color = Color3.fromRGB(40, 38, 45), canCollide = false,
	})
	-- Phone on a tripod, filming the ring light
	local tripodCF = zoneCF * CFrame.new(-9, 0, -8.5)
	for i = 0, 2 do
		makeBlock({
			name = "TripodLeg", parent = zoneModel, size = Vector3.new(0.35, 4.4, 0.35),
			cframe = tripodCF * CFrame.Angles(0, math.rad(i * 120), 0) * CFrame.new(0, 2.1, -1) * CFrame.Angles(math.rad(14), 0, 0),
			color = Color3.fromRGB(40, 38, 45),
		})
	end
	makeBlock({
		name = "TripodHead", parent = zoneModel, size = Vector3.new(0.8, 0.8, 0.8),
		cframe = tripodCF * CFrame.new(0, 4.3, 0), color = Color3.fromRGB(40, 38, 45), canCollide = false,
	})
	makeBlock({
		name = "Phone", parent = zoneModel, size = Vector3.new(1.9, 3.4, 0.4),
		cframe = tripodCF * CFrame.new(0, 6.1, 0), color = Color3.fromRGB(20, 20, 24), canCollide = false,
	})
	makeBlock({
		name = "PhoneScreen", parent = zoneModel, size = Vector3.new(1.6, 3, 0.12),
		cframe = tripodCF * CFrame.new(0, 6.1, 0.23), color = Color3.fromRGB(255, 160, 220),
		material = Enum.Material.Neon, canCollide = false,
	})
	-- Big play-button prop: white triangle (two mirrored wedges) on a pink cube
	makeBlock({
		name = "PlayButtonBase", parent = zoneModel, size = Vector3.new(7, 0.7, 7),
		cframe = zoneCF * CFrame.new(9, 0.35, -1), color = WHITE,
	})
	makeBlock({
		name = "PlayButtonCube", parent = zoneModel, size = Vector3.new(5.5, 5.5, 5.5),
		cframe = zoneCF * CFrame.new(9, 3.45, -1), color = pink,
	})
	makeWedge({
		name = "PlayTriangleTop", parent = zoneModel, size = Vector3.new(0.8, 1.4, 2.8),
		cframe = zoneCF * CFrame.new(9, 4.15, -4.15) * CFrame.Angles(0, -RAD_90, 0),
		color = WHITE, canCollide = false,
	})
	makeWedge({
		name = "PlayTriangleBottom", parent = zoneModel, size = Vector3.new(0.8, 1.4, 2.8),
		cframe = zoneCF * CFrame.new(9, 2.75, -4.15) * CFrame.Angles(0, -RAD_90, 0) * CFrame.Angles(0, 0, math.rad(180)),
		color = WHITE, canCollide = false,
	})
	addSignBoard(zoneModel, zoneCF * CFrame.new(0, 10.4, 9.85), 14, 2.5, zone.Name, NAVY, zone.AccentColor)
end

----------------------------------------------------------------------
-- Zone 7: Stock Desk — dark office, neon ticker screens, big up arrow
----------------------------------------------------------------------

local function buildStockDesk(zoneModel: Model, zoneCF: CFrame, zone)
	local neonGreen = Color3.fromRGB(70, 255, 130)
	local screenBlack = Color3.fromRGB(12, 12, 14)
	makeBlock({
		name = "OfficeBody", parent = zoneModel, size = Vector3.new(18, 12, 12),
		cframe = zoneCF * CFrame.new(0, 6, 14), color = Color3.fromRGB(30, 32, 36),
	})
	makeBlock({
		name = "OfficeRoof", parent = zoneModel, size = Vector3.new(19, 0.8, 13),
		cframe = zoneCF * CFrame.new(0, 12.4, 14), color = Color3.fromRGB(22, 24, 28),
	})
	makeBlock({
		name = "OfficeDoor", parent = zoneModel, size = Vector3.new(3.5, 6, 0.5),
		cframe = zoneCF * CFrame.new(0, 3, 7.8), color = screenBlack, canCollide = false,
	})
	makeBlock({
		name = "OfficeTrim", parent = zoneModel, size = Vector3.new(18.6, 0.6, 0.6),
		cframe = zoneCF * CFrame.new(0, 12.1, 8), color = zone.SignColor,
		material = Enum.Material.Neon, canCollide = false,
	})
	-- Green-on-black ticker screens on the front wall
	for _, xOff in { -4.5, 4.5 } do
		makeBlock({
			name = "TickerScreen", parent = zoneModel, size = Vector3.new(6.5, 3, 0.5),
			cframe = zoneCF * CFrame.new(xOff, 6.8, 7.8), color = screenBlack, canCollide = false,
		})
		makeBlock({
			name = "TickerLine", parent = zoneModel, size = Vector3.new(5.6, 0.4, 0.15),
			cframe = zoneCF * CFrame.new(xOff, 7.5, 7.5), color = neonGreen,
			material = Enum.Material.Neon, canCollide = false,
		})
		makeBlock({
			name = "TickerLine", parent = zoneModel, size = Vector3.new(4.2, 0.4, 0.15),
			cframe = zoneCF * CFrame.new(xOff - 0.6, 6.4, 7.5), color = neonGreen,
			material = Enum.Material.Neon, canCollide = false,
		})
	end
	-- Big green up arrow on the roof (block shaft + wedge head)
	makeBlock({
		name = "ArrowShaft", parent = zoneModel, size = Vector3.new(1.6, 6, 1.2),
		cframe = zoneCF * CFrame.new(0, 15.8, 14), color = zone.SignColor,
		material = Enum.Material.Neon, canCollide = false,
	})
	makeWedge({
		name = "ArrowHeadLeft", parent = zoneModel, size = Vector3.new(1.2, 2.8, 2.2),
		cframe = zoneCF * CFrame.new(-1.1, 20.2, 14) * CFrame.Angles(0, RAD_90, 0),
		color = zone.SignColor, material = Enum.Material.Neon, canCollide = false,
	})
	makeWedge({
		name = "ArrowHeadRight", parent = zoneModel, size = Vector3.new(1.2, 2.8, 2.2),
		cframe = zoneCF * CFrame.new(1.1, 20.2, 14) * CFrame.Angles(0, -RAD_90, 0),
		color = zone.SignColor, material = Enum.Material.Neon, canCollide = false,
	})
	addSignBoard(zoneModel, zoneCF * CFrame.new(0, 10.6, 7.85), 13, 2.5, zone.Name, screenBlack, zone.SignColor)
end

----------------------------------------------------------------------
-- Zone 8: Startup HQ — sleek tower with glass bands, logo cube, rocket
----------------------------------------------------------------------

local function buildStartupHQ(zoneModel: Model, zoneCF: CFrame, zone)
	local glassBlue = Color3.fromRGB(90, 150, 255)
	local towerCF = zoneCF * CFrame.new(0, 0, 18)
	local tiers = {
		{ size = Vector3.new(16, 5, 16), y = 2.5, color = WHITE, transparency = 0 },
		{ size = Vector3.new(16.4, 1.8, 16.4), y = 6.4, color = glassBlue, transparency = 0.4 },
		{ size = Vector3.new(14, 5, 14), y = 9.8, color = WHITE, transparency = 0 },
		{ size = Vector3.new(14.4, 1.8, 14.4), y = 13.2, color = glassBlue, transparency = 0.4 },
		{ size = Vector3.new(12, 5, 12), y = 16.6, color = WHITE, transparency = 0 },
		{ size = Vector3.new(10, 2, 10), y = 20.1, color = WHITE, transparency = 0 },
	}
	for _, tier in tiers do
		makeBlock({
			name = "TowerTier", parent = zoneModel, size = tier.size,
			cframe = towerCF * CFrame.new(0, tier.y, 0), color = tier.color,
			transparency = tier.transparency,
		})
	end
	makeBlock({
		name = "TowerDoor", parent = zoneModel, size = Vector3.new(3.5, 5.5, 0.6),
		cframe = towerCF * CFrame.new(0, 2.75, -8.1), color = Color3.fromRGB(40, 60, 100), canCollide = false,
	})
	-- Blue neon logo cube on a small pole, tilted like a diamond
	makeBlock({
		name = "LogoPole", parent = zoneModel, size = Vector3.new(0.4, 1.6, 0.4),
		cframe = towerCF * CFrame.new(0, 21.9, 0), color = WHITE, canCollide = false,
	})
	makeBlock({
		name = "LogoCube", parent = zoneModel, size = Vector3.new(2.8, 2.8, 2.8),
		cframe = towerCF * CFrame.new(0, 23.2, 0) * CFrame.Angles(math.rad(35), math.rad(45), 0),
		color = zone.AccentColor, material = Enum.Material.Neon, canCollide = false,
	})
	-- Small rocket statue: cylinder body, crossed-wedge nose cone, wedge fins
	local rocketCF = zoneCF * CFrame.new(-12, 0, -4)
	makeCylinder({
		name = "RocketPedestal", parent = zoneModel, diameter = 5.5, height = 1.2,
		cframe = rocketCF * CFrame.new(0, 0.6, 0), color = Color3.fromRGB(205, 198, 182),
	})
	makeCylinder({
		name = "RocketBody", parent = zoneModel, diameter = 3, height = 7,
		cframe = rocketCF * CFrame.new(0, 4.7, 0), color = Color3.fromRGB(244, 244, 248),
	})
	makeBall({
		name = "RocketWindow", parent = zoneModel, size = Vector3.new(1.3, 1.3, 1.3),
		cframe = rocketCF * CFrame.new(0, 5.6, -1.4), color = zone.AccentColor,
		material = Enum.Material.Neon, canCollide = false,
	})
	-- Nose cone: two crossed wedge pairs
	local noseY = 9.6
	makeWedge({
		name = "RocketNose", parent = zoneModel, size = Vector3.new(2.4, 2.8, 1.5),
		cframe = rocketCF * CFrame.new(-0.75, noseY, 0) * CFrame.Angles(0, RAD_90, 0),
		color = zone.AccentColor, canCollide = false,
	})
	makeWedge({
		name = "RocketNose", parent = zoneModel, size = Vector3.new(2.4, 2.8, 1.5),
		cframe = rocketCF * CFrame.new(0.75, noseY, 0) * CFrame.Angles(0, -RAD_90, 0),
		color = zone.AccentColor, canCollide = false,
	})
	makeWedge({
		name = "RocketNose", parent = zoneModel, size = Vector3.new(2.4, 2.8, 1.5),
		cframe = rocketCF * CFrame.new(0, noseY, -0.75),
		color = zone.AccentColor, canCollide = false,
	})
	makeWedge({
		name = "RocketNose", parent = zoneModel, size = Vector3.new(2.4, 2.8, 1.5),
		cframe = rocketCF * CFrame.new(0, noseY, 0.75) * CFrame.Angles(0, math.rad(180), 0),
		color = zone.AccentColor, canCollide = false,
	})
	-- Fins (vertical face against the body, sloping down and out)
	local finSpecs = {
		{ offset = Vector3.new(2.2, 2.6, 0), yaw = -RAD_90 },
		{ offset = Vector3.new(-2.2, 2.6, 0), yaw = RAD_90 },
		{ offset = Vector3.new(0, 2.6, 2.2), yaw = math.rad(180) },
		{ offset = Vector3.new(0, 2.6, -2.2), yaw = 0 },
	}
	for _, fin in finSpecs do
		makeWedge({
			name = "RocketFin", parent = zoneModel, size = Vector3.new(0.5, 2.8, 1.9),
			cframe = rocketCF * CFrame.new(fin.offset) * CFrame.Angles(0, fin.yaw, 0),
			color = zone.AccentColor, canCollide = false,
		})
	end
	addSignBoard(zoneModel, towerCF * CFrame.new(0, 8.5, -8.1), 12, 2.2, zone.Name, NAVY, zone.AccentColor)
end

----------------------------------------------------------------------
-- Generic fallback for any future zone id without a bespoke builder
----------------------------------------------------------------------

local function buildGenericZone(zoneModel: Model, zoneCF: CFrame, zone)
	makeBlock({
		name = "Building", parent = zoneModel, size = Vector3.new(20, 12, 12),
		cframe = zoneCF * CFrame.new(0, 6, 16), color = zone.SignColor,
	})
	addSignBoard(zoneModel, zoneCF * CFrame.new(0, 10, 9.8), 14, 2.5, zone.Name, NAVY, zone.AccentColor)
end

local ZONE_BUILDERS: { [string]: (Model, CFrame, any) -> () } = {
	LemonadeStand = buildLemonadeStand,
	DogWalking = buildDogWalking,
	SneakerFlipping = buildSneakerFlipping,
	CarWash = buildCarWash,
	FoodTruck = buildFoodTruck,
	ContentCreator = buildContentCreator,
	StockDesk = buildStockDesk,
	StartupHQ = buildStartupHQ,
}

-- Station counter position per zone (local to the zone, on the pad top)
local STATION_POS: { [string]: Vector3 } = {
	LemonadeStand = Vector3.new(0, 0, 7),
	DogWalking = Vector3.new(0, 0, -12),
	SneakerFlipping = Vector3.new(6, 0, -8),
	CarWash = Vector3.new(0, 0, -12),
	FoodTruck = Vector3.new(0, 0, -2),
	ContentCreator = Vector3.new(0, 0, -8),
	StockDesk = Vector3.new(0, 0, -8),
	StartupHQ = Vector3.new(6, 0, -8),
}

local function buildZone(zonesFolder: Folder, zone)
	local groundCF = zoneGroundCF(zone.Order)

	local zoneModel = Instance.new("Model")
	zoneModel.Name = zone.Id
	zoneModel:SetAttribute("ZoneId", zone.Id)
	zoneModel.Parent = zonesFolder

	-- Colored floor pad (signature color, desaturated enough to walk on)
	local padColor = zone.SignColor:Lerp(Color3.fromRGB(152, 148, 144), 0.6)
	-- 1.5 thick so the pad bottom meets the ground top (Y=0): no floating seam.
	makeBlock({
		name = "ZonePad", parent = zoneModel, size = Vector3.new(PAD_SIZE, 1.5, PAD_SIZE),
		cframe = groundCF * CFrame.new(0, 0.75, 0), color = padColor,
	})

	local zoneCF = groundCF * CFrame.new(0, PAD_TOP, 0)
	local builder = ZONE_BUILDERS[zone.Id] or buildGenericZone
	builder(zoneModel, zoneCF, zone)

	local stationPos = STATION_POS[zone.Id] or Vector3.new(0, 0, -10)
	buildHustleStation(zoneModel, zoneCF, zone, stationPos, zone.Id ~= "LemonadeStand")

	if zone.UnlockCost > 0 then
		buildGate(zoneModel, zoneCF, zone)
	end
end

----------------------------------------------------------------------
-- Decor: simple trees and bushes scattered between zones
----------------------------------------------------------------------

local function buildTree(parent: Instance, position: Vector3, scale: number)
	local cf = CFrame.new(position)
	makeCylinder({
		name = "TreeTrunk", parent = parent, diameter = 1.6 * scale, height = 6 * scale,
		cframe = cf * CFrame.new(0, 3 * scale, 0), color = DARK_WOOD,
	})
	makeBall({
		name = "TreeLeaves", parent = parent,
		size = Vector3.new(6, 6, 6) * scale,
		cframe = cf * CFrame.new(0, 6.5 * scale, 0), color = LEAF_GREEN, canCollide = false,
	})
	makeBall({
		name = "TreeLeaves", parent = parent,
		size = Vector3.new(4.6, 4.6, 4.6) * scale,
		cframe = cf * CFrame.new(1.2 * scale, 8 * scale, 0.8 * scale), color = Color3.fromRGB(88, 176, 74), canCollide = false,
	})
	makeBall({
		name = "TreeLeaves", parent = parent,
		size = Vector3.new(4, 4, 4) * scale,
		cframe = cf * CFrame.new(-1.4 * scale, 7.4 * scale, -0.6 * scale), color = Color3.fromRGB(96, 188, 80), canCollide = false,
	})
end

local function buildBush(parent: Instance, position: Vector3, scale: number)
	makeBall({
		name = "Bush", parent = parent,
		size = Vector3.new(3.6, 2.6, 3.6) * scale,
		cframe = CFrame.new(position + Vector3.new(0, 1 * scale, 0)), color = LEAF_GREEN, canCollide = false,
	})
end

local function buildDecor(parent: Instance)
	for i = 0, 7 do
		-- Trees between neighboring zones
		local betweenAngle = math.rad(i * 45 + 22.5)
		buildTree(parent, Vector3.new(math.cos(betweenAngle) * 152, 0, math.sin(betweenAngle) * 152), if i % 2 == 0 then 1 else 1.25)
		-- Outer tree ring
		local outerA = math.rad(i * 45 + 8)
		buildTree(parent, Vector3.new(math.cos(outerA) * 225, 0, math.sin(outerA) * 225), 1.4)
		local outerB = math.rad(i * 45 + 37)
		buildTree(parent, Vector3.new(math.cos(outerB) * 230, 0, math.sin(outerB) * 230), 1.1)
		-- Bushes along the road edge and further out
		local bushA = math.rad(i * 45 + 22.5)
		buildBush(parent, Vector3.new(math.cos(bushA) * 128, 0, math.sin(bushA) * 128), 1.1)
		local bushB = math.rad(i * 45 - 12)
		buildBush(parent, Vector3.new(math.cos(bushB) * 195, 0, math.sin(bushB) * 195), 1.3)
	end
end

----------------------------------------------------------------------
-- Lighting: bright cheerful day + gentle color pop + bloom for the neon
----------------------------------------------------------------------

local function setupLighting()
	Lighting.ClockTime = 12
	Lighting.Brightness = 3
	Lighting.GlobalShadows = true
	Lighting.ShadowSoftness = 1
	Lighting.Ambient = Color3.fromRGB(126, 118, 104)
	Lighting.OutdoorAmbient = Color3.fromRGB(166, 156, 136)

	if not Lighting:FindFirstChild("SideHustleColorCorrection") then
		local colorCorrection = Instance.new("ColorCorrectionEffect")
		colorCorrection.Name = "SideHustleColorCorrection"
		colorCorrection.Saturation = 0.15
		colorCorrection.Contrast = 0.05
		colorCorrection.Brightness = 0.02
		colorCorrection.Parent = Lighting
	end
	if not Lighting:FindFirstChild("SideHustleBloom") then
		local bloom = Instance.new("BloomEffect")
		bloom.Name = "SideHustleBloom"
		bloom.Intensity = 0.45
		bloom.Size = 24
		bloom.Threshold = 1.1
		bloom.Parent = Lighting
	end
end

----------------------------------------------------------------------
-- Public API
----------------------------------------------------------------------

function MapBuilder.build(): ()
	if Workspace:FindFirstChild("SideHustleMap") then
		return
	end

	local map = Instance.new("Folder")
	map.Name = "SideHustleMap"

	local ground = buildGround(map)
	buildPlaza(map)

	local zonesFolder = Instance.new("Folder")
	zonesFolder.Name = "Zones"
	zonesFolder.Parent = map

	for _, zone in GameConfig.Zones do
		buildZone(zonesFolder, zone)
	end

	buildDecor(ground)
	setupLighting()

	map.Parent = Workspace
end

return MapBuilder
