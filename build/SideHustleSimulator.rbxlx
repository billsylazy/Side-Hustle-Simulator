                <G>1</G>
                <B>1</B>
              </Color3>
              <bool name="TextScaled">true</bool>
              <int name="ZIndex">6</int>
            </Properties>
            <Item class="UIStroke" referent="541">
              <Properties>
                <string name="Name">UIStroke</string>
                <token name="ApplyStrokeMode">0</token>
                <Color3 name="Color">
                  <R>0.0156863</R>
                  <G>0.0156863</G>
                  <B>0.207843</B>
                </Color3>
                <float name="Thickness">3</float>
              </Properties>
            </Item>
            <Item class="UITextSizeConstraint" referent="542">
              <Properties>
                <string name="Name">UITextSizeConstraint</string>
                <int name="MaxTextSize">30</int>
              </Properties>
            </Item>
          </Item>
        </Item>
        <Item class="ImageButton" referent="543">
          <Properties>
            <string name="Name">CloseButton</string>
            <Vector2 name="AnchorPoint">
              <X>0.5</X>
              <Y>0.5</Y>
            </Vector2>
            <float name="BackgroundTransparency">1</float>
            <Content name="Image">
              <url>rbxassetid://0</url>
            </Content>
            <UDim2 name="Position">
              <XS>1</XS>
              <XO>-8</XO>
              <YS>0</YS>
              <YO>8</YO>
            </UDim2>
