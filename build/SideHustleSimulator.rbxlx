      <Item class="LocalScript" referent="544">
        <Properties>
          <string name="Name">WorkersController</string>
          <string name="Source"><![CDATA[-- WorkersController (LocalScript inside WorkersGui) — v2
-- Grid of owned workers cloned from the hidden WorkerCardTemplate.
-- EQUIP/UNEQUIP fire the EquipWorker/UnequipWorker remotes; WorkerService
-- validates everything (incl. the slot cap) and answers with a DataSync
-- snapshot, which is the only source of truth.
-- v2: slot cap = GameConfig.Workers.BaseEquipSlots + Perks.WorkerSlots, and the
-- per-worker income shown includes the WorkerEfficiency perk and the rebirth
-- cash multiplier (what WorkerService actually pays).
-- See ARCHITECTURE.md "Upgrades & perks" and "UI contract".

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared:WaitForChild("GameConfig"))
local FormatNumber = require(Shared:WaitForChild("FormatNumber"))
local ButtonFX = require(Shared:WaitForChild("ButtonFX"))
local ClientEffects = require(Shared:WaitForChild("ClientEffects"))

local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local DataSync = Remotes:WaitForChild("DataSync") :: RemoteEvent
local EquipWorker = Remotes:WaitForChild("EquipWorker") :: RemoteEvent
local UnequipWorker = Remotes:WaitForChild("UnequipWorker") :: RemoteEvent

local gui = script.Parent :: ScreenGui
local main = gui:WaitForChild("Main")
local panelScale = main:WaitForChild("PanelScale") :: UIScale
local panel = main:WaitForChild("Panel")
local slotsLabel = panel:WaitForChild("SlotsLabel") :: TextLabel
local items = panel:WaitForChild("Items") :: ScrollingFrame
local template = items:WaitForChild("WorkerCardTemplate") :: Frame
local emptyState = panel:WaitForChild("EmptyState") :: TextLabel
local closeButton = main:WaitForChild("CloseButton") :: GuiButton

template.Visible = false

local WHITE = Color3.fromRGB(255, 255, 255)
local SLOTS_FULL = Color3.fromRGB(135, 135, 145) -- multiplies the green toward gray
local EQUIP_GRADIENT = ColorSequence.new({
	ColorSequenceKeypoint.new(0, Color3.fromRGB(71, 198, 78)),
	ColorSequenceKeypoint.new(1, Color3.fromRGB(42, 147, 42)),
})
local UNEQUIP_GRADIENT = ColorSequence.new({
	ColorSequenceKeypoint.new(0, Color3.fromRGB(247, 55, 92)),
	ColorSequenceKeypoint.new(1, Color3.fromRGB(170, 19, 69)),
})

type CardEntry = {
	card: Frame,
	worker: any, -- Types.WorkerEntry
	income: TextLabel?,
	action: TextButton?,
}

local lastSnapshot: { [string]: any }? = nil
local lastSignature = ""
local cards: { CardEntry } = {}

local function numberOr(value: any, default: number): number
	return if typeof(value) == "number" and value == value then value else default
end

local function perkLevel(snapshot: { [string]: any }, perkId: string): number
	local perks = snapshot.Perks
	if typeof(perks) ~= "table" then
		return 0
	end
	return math.max(0, math.floor(numberOr(perks[perkId], 0)))
end

-- Equip cap = base slots + WorkerSlots perk level (WorkerService.equipCap).
local function equipCap(snapshot: { [string]: any }): number
	return GameConfig.Workers.BaseEquipSlots + perkLevel(snapshot, "WorkerSlots")
end

-- WorkerEfficiency perk x rebirth cash multiplier (WorkerService income tick).
local function incomeMultiplier(snapshot: { [string]: any }): number
	local efficiency = 1 + GameConfig.WorkerEfficiencyPerLevel * perkLevel(snapshot, "WorkerEfficiency")
	return efficiency * GameConfig.getRebirthCashMultiplier(numberOr(snapshot.Rebirths, 0))
end

-- Equipped first, then income desc, then Uid for a stable order.
local function sortedWorkers(workers: { any }): { any }
	local list = table.clone(workers)
	table.sort(list, function(a, b)
		if a.Equipped ~= b.Equipped then
			return a.Equipped == true
		end
		local incomeA = GameConfig.getWorkerIncome(a.Rarity, a.Crate)
		local incomeB = GameConfig.getWorkerIncome(b.Rarity, b.Crate)
		if incomeA ~= incomeB then
			return incomeA > incomeB
		end
		return tostring(a.Uid) < tostring(b.Uid)
	end)
	return list
end

local function buildCard(worker: any, layoutOrder: number): CardEntry
	local card = template:Clone()
	card.Name = "Card_" .. tostring(worker.Uid)
	card.LayoutOrder = layoutOrder
	card.Visible = true

	local rarity = GameConfig.getRarity(worker.Rarity)
	local rarityBar = card:FindFirstChild("RarityBar")
	if rarityBar and rarityBar:IsA("Frame") then
		if rarity then
			rarityBar.BackgroundColor3 = rarity.Color
		end
		local rarityLabel = rarityBar:FindFirstChild("RarityLabel")
		if rarityLabel and rarityLabel:IsA("TextLabel") then
			rarityLabel.Text = if rarity then rarity.Name else tostring(worker.Rarity)
		end
	end

	-- The card has a CHILD called "Name"; dot access would return the instance's
	-- own Name property, so FindFirstChild is required here.
	local nameLabel = card:FindFirstChild("Name")
	if nameLabel and nameLabel:IsA("TextLabel") then
		nameLabel.Text = tostring(worker.Name)
	end

	local incomeChild = card:FindFirstChild("Income")
	local actionChild = card:FindFirstChild("ActionButton")
	local entry: CardEntry = {
		card = card,
		worker = worker,
		income = if incomeChild and incomeChild:IsA("TextLabel") then incomeChild else nil,
		action = if actionChild and actionChild:IsA("TextButton") then actionChild else nil,
	}

	local action = entry.action
	if action then
		local equipped = worker.Equipped == true
		action.Text = if equipped then "UNEQUIP" else "EQUIP"
		local grad = action:FindFirstChild("ButtonGrad")
		if grad and grad:IsA("UIGradient") then
			grad.Color = if equipped then UNEQUIP_GRADIENT else EQUIP_GRADIENT
		end
		local uid = worker.Uid
		action.Activated:Connect(function()
			if equipped then
				UnequipWorker:FireServer(uid)
			else
				-- Fires even when slots look full: the server's "No free worker
				-- slots!" toast explains why nothing happened.
				EquipWorker:FireServer(uid)
				ClientEffects.sparkle(card)
			end
		end)
		ButtonFX.attach(action)
	end

	card.Parent = items
	return entry
end

local function refresh(snapshot: { [string]: any }?)
	if not snapshot then
		return
	end
	local workers = if typeof(snapshot.Workers) == "table" then snapshot.Workers else {}

	local equippedCount = 0
	for _, worker in workers do
		if worker.Equipped then
			equippedCount += 1
		end
	end
	local cap = equipCap(snapshot)
	slotsLabel.Text = "Equipped " .. equippedCount .. "/" .. cap
	emptyState.Visible = #workers == 0

	-- Only rebuild the grid when the roster actually changed; DataSync fires
	-- every second from the income tick and rebuilding would eat clicks.
	local list = sortedWorkers(workers)
	local parts = table.create(#list)
	for _, worker in list do
		parts[#parts + 1] = tostring(worker.Uid) .. (if worker.Equipped then "+" else "-")
	end
	local signature = table.concat(parts, "|")
	if signature ~= lastSignature then
		lastSignature = signature
		for _, entry in cards do
			entry.card:Destroy()
		end
		table.clear(cards)
		for index, worker in list do
			cards[#cards + 1] = buildCard(worker, index)
		end
	end

	-- Cheap per-sync updates (perks / rebirths change these without a rebuild).
	local multiplier = incomeMultiplier(snapshot)
	local slotsFull = equippedCount >= cap
	for _, entry in cards do
		if entry.income then
			local income = GameConfig.getWorkerIncome(entry.worker.Rarity, entry.worker.Crate) * multiplier
			entry.income.Text = FormatNumber.money(math.floor(income)) .. "/s"
		end
		if entry.action and entry.worker.Equipped ~= true then
			entry.action.BackgroundColor3 = if slotsFull then SLOTS_FULL else WHITE
		end
	end
end

local function bounceOpen()
	panelScale.Scale = 0.6
	TweenService:Create(
		panelScale,
		TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
		{ Scale = 1 }
	):Play()
end

gui:GetPropertyChangedSignal("Enabled"):Connect(function()
	if gui.Enabled then
		bounceOpen()
		refresh(lastSnapshot)
	end
end)

DataSync.OnClientEvent:Connect(function(snapshot: any)
	if typeof(snapshot) ~= "table" then
		return
	end
	lastSnapshot = snapshot
	if gui.Enabled then
		refresh(snapshot)
	end
end)

closeButton.Activated:Connect(function()
	gui.Enabled = false
end)
ButtonFX.attach(closeButton)
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="545">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="546">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="547">
        <Properties>
          <string name="Name">ClientMain</string>
          <string name="Source"><![CDATA[-- ClientMain: client bootstrapper. Waits for the shared contract to exist,
-- then requires and starts every controller module. A broken controller is
-- warned about and skipped so the rest of the client still works.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

-- The server creates Remotes at startup; Shared syncs in via Rojo/ReplicatedStorage.
ReplicatedStorage:WaitForChild("Shared")
ReplicatedStorage:WaitForChild("Remotes")

local controllersFolder = script.Parent:WaitForChild("Controllers")

for _, moduleScript in controllersFolder:GetChildren() do
	if not moduleScript:IsA("ModuleScript") then
		continue
	end

	local okRequire, controller = pcall(require, moduleScript)
	if not okRequire then
		warn(("[ClientMain] Failed to require controller %s: %s"):format(moduleScript.Name, tostring(controller)))
		continue
	end

	if type(controller) ~= "table" or type(controller.start) ~= "function" then
		warn(("[ClientMain] Controller %s does not expose start(); skipping"):format(moduleScript.Name))
		continue
	end

	local okStart, startError = pcall(controller.start)
	if not okStart then
		warn(("[ClientMain] Controller %s failed to start: %s"):format(moduleScript.Name, tostring(startError)))
	end
end
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="548">
        <Properties>
          <string name="Name">Controllers</string>
        </Properties>
        <Item class="ModuleScript" referent="549">
          <Properties>
            <string name="Name">AutomationVisualsController</string>
            <string name="Source"><![CDATA[-- AutomationVisualsController: one stationed chibi rig per zone where the
-- local player owns the zone's automation upgrade (Auto level > 0). Rigs are
-- built by ChibiRig, stand on HustleStation.AutoAnchor facing the PromptPart
-- and loop a per-mechanic "hustle" motion (Tap punches, Hold leans, Timing
-- watches the ticker, Charge hops then jumps). Auto HustleResults pop a
-- "+$X" world popup at the station's FeedbackPart.
--
-- Pure view layer, client-only: rigs live in a local Workspace Folder
-- ("AutomationRigs") and are driven by CFrame math on one Heartbeat.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local sharedFolder = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(sharedFolder:WaitForChild("GameConfig"))
local FormatNumber = require(sharedFolder:WaitForChild("FormatNumber"))
local ChibiRig = require(sharedFolder:WaitForChild("ChibiRig"))
local ClientEffects = require(sharedFolder:WaitForChild("ClientEffects"))

local RIG_FOLDER_NAME = "AutomationRigs"
local HIDDEN_CFRAME = CFrame.new(0, -500, 0)
local POP_DURATION = 0.35 -- little hop when an auto payout lands

type StationRefs = {
	anchor: BasePart,
	prompt: BasePart?,
	feedback: BasePart?,
}

type StationRig = {
	zoneId: string,
	model: Model,
	level: number,
	baseCF: CFrame, -- feet on the anchor, facing the prompt
	mechanic: string,
	phase: number, -- animation clock (seconds, randomized start)
	popT: number, -- remaining seconds of the payout hop
}

local stationRefs: { [string]: StationRefs } = {}
local resolving: { [string]: boolean } = {}
local warnedZones: { [string]: boolean } = {}
local rigs: { [string]: StationRig } = {}
local desiredLevels: { [string]: number } = {}
local hasSnapshot = false
local started = false

local AutomationVisualsController = {}

----------------------------------------------------------------------
-- Station lookup (WaitForChild with timeouts; zones may stream in late)
----------------------------------------------------------------------

local function getRigFolder(): Folder
	local existing = workspace:FindFirstChild(RIG_FOLDER_NAME)
	if existing and existing:IsA("Folder") then
		return existing
	end
	local folder = Instance.new("Folder")
	folder.Name = RIG_FOLDER_NAME
	folder.Parent = workspace
	return folder
end

local function warnOnce(zoneId: string, message: string)
	if warnedZones[zoneId] then
		return
	end
	warnedZones[zoneId] = true
	warn(("[AutomationVisualsController] %s: %s"):format(zoneId, message))
end

-- Resolves Workspace.SideHustleMap.Zones.<zoneId>.HustleStation.{AutoAnchor,
-- PromptPart, FeedbackPart}. Yields; nil when the station never appears.
local function resolveStation(zoneId: string): StationRefs?
	local cached = stationRefs[zoneId]
	if cached and cached.anchor:IsDescendantOf(workspace) then
		return cached
	end

	local map = workspace:WaitForChild("SideHustleMap", 60)
	if not map then
		warnOnce(zoneId, "Workspace.SideHustleMap never appeared")
		return nil
	end
	local zonesFolder = map:WaitForChild("Zones", 30)
	if not zonesFolder then
		warnOnce(zoneId, "SideHustleMap.Zones never appeared")
		return nil
	end
	local zoneModel = zonesFolder:WaitForChild(zoneId, 30)
	if not zoneModel then
		return nil -- not streamed in yet; ChildAdded retries
	end
	local station = zoneModel:WaitForChild("HustleStation", 20)
	if not station then
		warnOnce(zoneId, "zone has no HustleStation")
		return nil
	end
	local anchor = station:WaitForChild("AutoAnchor", 20)
	if not anchor or not anchor:IsA("BasePart") then
		warnOnce(zoneId, "HustleStation has no AutoAnchor part")
		return nil
	end
	local prompt = station:WaitForChild("PromptPart", 5)
	local feedback = station:WaitForChild("FeedbackPart", 5)

	local refs: StationRefs = {
		anchor = anchor,
		prompt = if prompt and prompt:IsA("BasePart") then prompt else nil,
		feedback = if feedback and feedback:IsA("BasePart") then feedback else nil,
	}
	stationRefs[zoneId] = refs
	return refs
end

-- Feet position for a rig standing on the anchor: the ground straight below
-- the anchor's center when a raycast finds it, else the anchor's bottom face.
local function findFeetPosition(anchor: BasePart): Vector3
	-- Only the world counts as ground: any player (not just the local one)
	-- standing on the anchor when the rig spawns must not become its floor.
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Include
	local include: { Instance } = { workspace.Terrain }
	local map = workspace:FindFirstChild("SideHustleMap")
	if map then
		table.insert(include, map)
	end
	params.FilterDescendantsInstances = include

	local origin = anchor.Position + Vector3.new(0, 2, 0)
	local result = workspace:Raycast(origin, Vector3.new(0, -12, 0), params)
	if result then
		return result.Position
	end
	return anchor.Position - Vector3.new(0, anchor.Size.Y * 0.5, 0)
end

-- Rig base: feet on the anchor, facing the PromptPart (fallback: the plaza).
local function computeBaseCFrame(refs: StationRefs): CFrame
	local feet = findFeetPosition(refs.anchor)
	local lookTarget: Vector3
	if refs.prompt and refs.prompt.Parent ~= nil then
		lookTarget = Vector3.new(refs.prompt.Position.X, feet.Y, refs.prompt.Position.Z)
	else
		lookTarget = Vector3.new(0, feet.Y, 0)
	end
	if (lookTarget - feet).Magnitude < 0.05 then
		lookTarget = feet + Vector3.new(0, 0, -1)
	end
	return CFrame.lookAt(feet, lookTarget)
end

----------------------------------------------------------------------
-- Rig lifecycle
----------------------------------------------------------------------

local function destroyRig(zoneId: string)
	local rig = rigs[zoneId]
	if rig then
		rigs[zoneId] = nil
		rig.model:Destroy()
	end
end

local function buildRig(zoneId: string, refs: StationRefs, level: number)
	local zone = GameConfig.getZone(zoneId)
	local autoDef = GameConfig.getZoneUpgradeByEffect(zoneId, "Auto")
	if not zone or not autoDef then
		return
	end

	local model = ChibiRig.build({
		Name = autoDef.Name, -- e.g. "Auto-Squeezer"
		Prop = "None",
		BodyColor = zone.SignColor,
		Label = "Lv " .. tostring(level),
	})
	model.Name = "AutoRig_" .. zoneId

	local baseCF = computeBaseCFrame(refs)
	ChibiRig.setPose(model, baseCF)
	model.Parent = getRigFolder()

	rigs[zoneId] = {
		zoneId = zoneId,
		model = model,
		level = level,
		baseCF = baseCF,
		mechanic = zone.Mechanic,
		phase = math.random() * 10,
		popT = 0,
	}
end

-- Kicks off (at most one) station lookup for the zone, then builds the rig
-- if the player still owns automation there once the station is found.
local function ensureRig(zoneId: string)
	if rigs[zoneId] or resolving[zoneId] then
		return
	end
	resolving[zoneId] = true
	task.spawn(function()
		local refs = resolveStation(zoneId)
		resolving[zoneId] = nil
		if not refs then
			return
		end
		local level = desiredLevels[zoneId] or 0
		if level <= 0 or rigs[zoneId] then
			return -- changed while we were waiting (rebirth, duplicate)
		end
		buildRig(zoneId, refs, level)
	end)
end

----------------------------------------------------------------------
-- DataSync: which zones are automated, and at what level
----------------------------------------------------------------------

local function applySnapshot(snapshot: any)
	if type(snapshot) ~= "table" then
		return
	end
	hasSnapshot = true
	local upgrades = snapshot.Upgrades

	for _, zone in GameConfig.Zones do
		local zoneId = zone.Id
		local level = GameConfig.getZoneEffectLevel(upgrades, zoneId, "Auto")
		desiredLevels[zoneId] = level

		local rig = rigs[zoneId]
		if level > 0 then
			if rig and rig.model.Parent == nil then
				destroyRig(zoneId) -- wiped externally; rebuild below
				rig = nil
			end
			if rig then
				if rig.level ~= level then
					rig.level = level
					ChibiRig.setLabel(rig.model, "Lv " .. tostring(level))
				end
			else
				ensureRig(zoneId)
			end
		elseif rig then
			destroyRig(zoneId) -- automation gone (rebirth)
		end
	end
end

----------------------------------------------------------------------
-- Auto payouts -> "+$X" world popup at the FeedbackPart + a little hop
----------------------------------------------------------------------

local function onHustleResult(zoneId: any, result: any)
	if type(zoneId) ~= "string" or type(result) ~= "table" or result.Kind ~= "Auto" then
		return
	end
	local amount = result.Amount
	if type(amount) ~= "number" or amount <= 0 then
		return
	end
	local zone = GameConfig.getZone(zoneId)
	if not zone then
		return
	end

	local rig = rigs[zoneId]
	if rig then
		rig.popT = POP_DURATION
	end

	local refs = stationRefs[zoneId]
	local position: Vector3? = nil
	if refs and refs.feedback and refs.feedback.Parent ~= nil then
		position = refs.feedback.Position
	elseif rig then
		position = rig.baseCF.Position + Vector3.new(0, ChibiRig.HEIGHT + 1, 0)
	end
	if position then
		ClientEffects.worldPopup(position, "+" .. FormatNumber.money(amount), zone.SignColor)
	end
end

----------------------------------------------------------------------
-- Heartbeat: per-mechanic hustle loops (a few CFrame ops per rig)
----------------------------------------------------------------------

local function animateRig(rig: StationRig, dt: number)
	local model = rig.model
	if model.Parent == nil then
		return
	end
	rig.phase += dt
	local t = rig.phase
	local base = rig.baseCF

	-- Payout hop layered on top of whatever the loop is doing.
	local popY = 0
	if rig.popT > 0 then
		rig.popT = math.max(rig.popT - dt, 0)
		popY = math.sin((1 - rig.popT / POP_DURATION) * math.pi) * 0.5
	end

	local mechanic = rig.mechanic
	if mechanic == "Tap" then
		-- Quick bob + alternating arm punches in rhythm.
		local beat = t * 7.5
		local s = math.sin(beat)
		local bob = math.abs(s) * 0.12
		local left = math.max(0, s)
		local right = math.max(0, -s)
		ChibiRig.setPose(model, base * CFrame.new(0, bob + popY, 0), {
			LeftArm = CFrame.new(0, 0.15 * left, -0.3 * left) * CFrame.Angles(math.rad(80) * left, 0, 0),
			RightArm = CFrame.new(0, 0.15 * right, -0.3 * right) * CFrame.Angles(math.rad(80) * right, 0, 0),
		})
	elseif mechanic == "Hold" then
		-- Slow lean back and forth about the feet, arms out front (holding on).
		local lean = math.sin(t * 1.6) * math.rad(9)
		local armPitch = math.rad(40) + math.sin(t * 1.6) * math.rad(6)
		ChibiRig.setPose(model, base * CFrame.new(0, popY, 0) * CFrame.Angles(lean, 0, 0), {
			LeftArm = CFrame.Angles(armPitch, 0, 0),
			RightArm = CFrame.Angles(armPitch, 0, 0),
		})
	elseif mechanic == "Timing" then
		-- Head turns left/right like watching a ticker; body follows a little.
		local yaw = math.sin(t * 2.2) * math.rad(38)
		local tilt = math.sin(t * 4.4) * math.rad(3)
		ChibiRig.setPose(model, base * CFrame.new(0, popY, 0) * CFrame.Angles(0, yaw * 0.15, 0), {
			Head = CFrame.Angles(0, yaw, tilt),
		})
	elseif mechanic == "Charge" then
		-- 3.2s cycle: four hops building height, then one big jump, then rest.
		local c = t % 3.2
		local y = 0
		local overrides: { [string]: CFrame }? = nil
		if c < 2.2 then
			local hopP = c / 0.55
			local hopIndex = math.floor(hopP)
			local f = hopP - hopIndex
			y = math.sin(f * math.pi) * (0.12 + hopIndex * 0.1)
		elseif c < 2.9 then
			local f = (c - 2.2) / 0.7
			y = math.sin(f * math.pi) * 2.2
			local up = math.rad(160) * math.sin(f * math.pi)
			overrides = {
				LeftArm = CFrame.Angles(up, 0, 0),
				RightArm = CFrame.Angles(up, 0, 0),
			}
		end
		ChibiRig.setPose(model, base * CFrame.new(0, y + popY, 0), overrides)
	else
		ChibiRig.setPose(model, base * CFrame.new(0, popY, 0))
	end
end

local function onHeartbeat(dt: number)
	if dt <= 0 then
		return
	end
	for _, rig in rigs do
		animateRig(rig, dt)
	end
end

----------------------------------------------------------------------
-- Entry point
----------------------------------------------------------------------

function AutomationVisualsController.start(): ()
	if started then
		return
	end
	started = true

	task.spawn(function()
		local remotes = ReplicatedStorage:WaitForChild("Remotes")
		local dataSync = remotes:WaitForChild("DataSync")
		dataSync.OnClientEvent:Connect(applySnapshot)
		local hustleResult = remotes:WaitForChild("HustleResult")
		hustleResult.OnClientEvent:Connect(onHustleResult)
	end)

	-- Zones that stream in (or get rebuilt) later: re-run the lookup for any
	-- automated zone that has no rig yet.
	task.spawn(function()
		local map = workspace:WaitForChild("SideHustleMap", 60)
		if not map then
			return -- resolveStation already warns
		end
		local zonesFolder = map:WaitForChild("Zones", 30)
		if not zonesFolder then
			return
		end
		zonesFolder.ChildAdded:Connect(function(child)
			local zoneId = child.Name
			if not hasSnapshot or (desiredLevels[zoneId] or 0) <= 0 then
				return
			end
			-- Drop a stale cache/rig for a zone model that was replaced.
			local cached = stationRefs[zoneId]
			if cached and not cached.anchor:IsDescendantOf(workspace) then
				stationRefs[zoneId] = nil
				destroyRig(zoneId)
			end
			ensureRig(zoneId)
		end)
	end)

	RunService.Heartbeat:Connect(onHeartbeat)
end

return AutomationVisualsController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="550">
          <Properties>
            <string name="Name">HoldPromptController</string>
            <string name="Source"><![CDATA[-- HoldPromptController: makes each Hold zone's hold last the player's current
-- cooldown, LOCALLY. The server prompt carries the shortest possible hold
-- (zone.HoldDuration = the cooldown at max Speed); here every Hold prompt is
-- stretched to Mechanics.cooldownFor(zone, upgrades), so a completed hold is
-- never inside the server cooldown (no silently eaten holds) and the zone's
-- Speed upgrade visibly shortens the hold. The server still enforces the
-- cooldown itself; this is purely about the player's local prompt.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared:WaitForChild("GameConfig"))
local Mechanics = require(Shared:WaitForChild("Mechanics"))

local WAIT_TIMEOUT = 20

local prompts: { [string]: ProximityPrompt } = {} -- zoneId -> HustlePrompt
local lastUpgrades: any = nil

local HoldPromptController = {}

local function holdFor(zone: GameConfig.ZoneDef): number
	return math.max(zone.HoldDuration, Mechanics.cooldownFor(zone, lastUpgrades))
end

local function apply(zoneId: string)
	local prompt = prompts[zoneId]
	local zone = GameConfig.getZone(zoneId)
	if not prompt or not zone or lastUpgrades == nil then
		return
	end
	local hold = holdFor(zone)
	if math.abs(prompt.HoldDuration - hold) > 1e-3 then
		prompt.HoldDuration = hold
	end
end

local function registerZone(zoneModel: Instance)
	local zone = GameConfig.getZone(zoneModel.Name)
	if not zone or zone.Mechanic ~= "Hold" or prompts[zone.Id] then
		return
	end
	task.spawn(function()
		local station = zoneModel:WaitForChild("HustleStation", WAIT_TIMEOUT)
		local promptPart = station and station:WaitForChild("PromptPart", WAIT_TIMEOUT)
		local prompt = promptPart and promptPart:WaitForChild("HustlePrompt", WAIT_TIMEOUT)
		if not prompt or not prompt:IsA("ProximityPrompt") then
			warn("[HoldPromptController] No HustlePrompt for " .. zone.Id)
			return
		end
		prompts[zone.Id] = prompt
		apply(zone.Id)
	end)
end

function HoldPromptController.start()
	local remotes = ReplicatedStorage:WaitForChild("Remotes")
	local dataSync = remotes:WaitForChild("DataSync") :: RemoteEvent

	dataSync.OnClientEvent:Connect(function(snapshot: any)
		if typeof(snapshot) ~= "table" or typeof(snapshot.Upgrades) ~= "table" then
			return
		end
		lastUpgrades = snapshot.Upgrades
		for zoneId in prompts do
			apply(zoneId)
		end
	end)

	task.spawn(function()
		local map = workspace:WaitForChild("SideHustleMap", 60)
		local zones = map and map:WaitForChild("Zones", 30)
		if not zones then
			warn("[HoldPromptController] SideHustleMap.Zones not found")
			return
		end
		for _, zoneModel in zones:GetChildren() do
			registerZone(zoneModel)
		end
		zones.ChildAdded:Connect(registerZone)
	end)
end

return HoldPromptController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="551">
          <Properties>
            <string name="Name">RebirthWatcher</string>
            <string name="Source"><![CDATA[-- RebirthWatcher: fires the big full-screen celebration when the server
-- confirms a rebirth. INSUFFICIENT and other variants are handled by the
-- Rebirth panel UI, not here.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local ClientEffects = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("ClientEffects"))

local RebirthWatcher = {}

function RebirthWatcher.start()
	task.spawn(function()
		local remotes = ReplicatedStorage:WaitForChild("Remotes")
		local rebirthResult = remotes:WaitForChild("RebirthResult")
		rebirthResult.OnClientEvent:Connect(function(status, newRebirths, _newMultiplier)
			if status ~= "SUCCESS" then
				return -- e.g. "INSUFFICIENT": the Rebirth panel shows that
			end
			if type(newRebirths) ~= "number" then
				return
			end
			ClientEffects.celebrate(newRebirths)
		end)
	end)
end

return RebirthWatcher
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="552">
          <Properties>
            <string name="Name">StationFeedbackController</string>
            <string name="Source"><![CDATA[-- StationFeedbackController: per-zone BillboardGui on HustleStation.FeedbackPart
-- showing the mechanic's live feedback:
--   Tap    - combo counter "x3" (shows at combo >= 2, fades after ComboWindow)
--   Hold   - the zone's verb hint ("Hold to Walk")
--   Timing - live hype meter: needle = Mechanics.marketFactor(zone, serverTime),
--            green PEAK region on the right where marketMult >= PeakThreshold
--   Charge - ChargeMax-segment charge bar lit per HustleResult Charge; all
--            segments flash on a Burst
-- Also fires ClientEffects.callout on Burst ("VIRAL!"/"FUNDED!") and Peak
-- ("PEAK FLIP!"/"PEAK TRADE!") results.
--
-- Performance: only the zone nearest the player plus zones with a manual
-- HustleResult in the last 3s are rendered (BillboardGui.Enabled); needles
-- update only while rendered. Zones may stream in late (WaitForChild timeouts).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local sharedFolder = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(sharedFolder:WaitForChild("GameConfig"))
local Mechanics = require(sharedFolder:WaitForChild("Mechanics"))
local ClientEffects = require(sharedFolder:WaitForChild("ClientEffects"))

local player = Players.LocalPlayer

-- Palette (UI contract: cream panels, #040435 strokes)
local NAVY = Color3.fromRGB(4, 4, 53)
local WHITE = Color3.fromRGB(255, 255, 255)
local GREEN = Color3.fromRGB(71, 198, 78)
local GOLD = Color3.fromRGB(255, 200, 40)
local RED = Color3.fromRGB(240, 48, 48)
local DIM = Color3.fromRGB(28, 28, 60)

local RECENT_WINDOW = 3 -- seconds a zone stays rendered after a manual result
local COMBO_WINDOW = GameConfig.Mechanics.Tap.ComboWindow
local COMBO_MAX = GameConfig.Mechanics.Tap.ComboMax
local TIMING = GameConfig.Mechanics.Timing
-- Needle factor at which marketMult reaches PeakThreshold (0.85 with defaults).
local PEAK_START = math.clamp(
	(TIMING.PeakThreshold - TIMING.MinMult) / math.max(TIMING.MaxMult - TIMING.MinMult, 1e-6),
	0,
	1
)

local BURST_TEXT: { [string]: string } = { ContentCreator = "VIRAL!", StartupHQ = "FUNDED!" }
local PEAK_TEXT: { [string]: string } = { SneakerFlipping = "PEAK FLIP!", StockDesk = "PEAK TRADE!" }
local METER_TITLE: { [string]: string } = { StockDesk = "MARKET", SneakerFlipping = "HYPE" }
local CHARGE_TITLE: { [string]: string } = { StartupHQ = "FUNDING", ContentCreator = "HYPE" }

type Station = {
	zoneId: string,
	zone: GameConfig.ZoneDef,
	mechanic: string,
	gui: BillboardGui,
	enabled: boolean,
	-- Tap
	comboLabel: TextLabel?,
	comboStroke: UIStroke?,
	comboScale: UIScale?,
	hintLabel: TextLabel?,
	hintStroke: UIStroke?,
	comboVisible: boolean,
	comboUntil: number,
	-- Timing
	needle: Frame?,
	meterTitle: TextLabel?,
	inPeak: boolean,
	-- Charge
	segments: { Frame },
	lit: number,
	flashing: boolean,
	pendingCharge: number?, -- charge that arrived during a burst flash
}

local stations: { [string]: Station } = {}
local registering: { [string]: boolean } = {}
local warnedZones: { [string]: boolean } = {}
local lastResultAt: { [string]: number } = {}
local currentHrp: BasePart? = nil
local started = false

local StationFeedbackController = {}

----------------------------------------------------------------------
-- GUI builders
----------------------------------------------------------------------

local function makeLabel(
	parent: Instance,
	name: string,
	text: string,
	font: Enum.Font,
	color: Color3,
	position: UDim2,
	size: UDim2,
	strokeThickness: number
): (TextLabel, UIStroke)
	local label = Instance.new("TextLabel")
	label.Name = name
	label.AnchorPoint = Vector2.new(0.5, 0.5)
	label.Position = position
	label.Size = size
	label.BackgroundTransparency = 1
	label.Font = font
	label.Text = text
	label.TextScaled = true
	label.TextColor3 = color
	label.ZIndex = 3

	local stroke = Instance.new("UIStroke")
	stroke.Color = NAVY
	stroke.Thickness = strokeThickness
	stroke.LineJoinMode = Enum.LineJoinMode.Round
	stroke.Parent = label

	label.Parent = parent
	return label, stroke
end

local function roundify(frame: GuiObject, radiusScale: number, strokeColor: Color3?, strokeThickness: number?)
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(radiusScale, 0)
	corner.Parent = frame
	if strokeColor then
		local stroke = Instance.new("UIStroke")
		stroke.Color = strokeColor
		stroke.Thickness = strokeThickness or 2
		stroke.Parent = frame
	end
end

-- A color readable on its own in world space: near-white sign colors (Startup
-- HQ) fall back to the zone accent.
local function zoneBrightColor(zone: GameConfig.ZoneDef): Color3
	local c = zone.SignColor
	local luminance = 0.299 * c.R + 0.587 * c.G + 0.114 * c.B
	return if luminance > 0.9 then zone.AccentColor else c
end

local function buildTap(station: Station, root: Frame)
	local zone = station.zone
	local combo, comboStroke = makeLabel(
		root, "Combo", "x2", Enum.Font.LuckiestGuy, zoneBrightColor(zone),
		UDim2.fromScale(0.5, 0.4), UDim2.fromScale(1, 0.72), 4
	)
	combo.TextTransparency = 1
	comboStroke.Transparency = 1
	local scale = Instance.new("UIScale")
	scale.Parent = combo

	local hint, hintStroke = makeLabel(
		root, "Hint", ("Mash %s!"):format(zone.HustleVerb:upper()), Enum.Font.FredokaOne, WHITE,
		UDim2.fromScale(0.5, 0.84), UDim2.fromScale(1, 0.3), 2.5
	)

	station.comboLabel = combo
	station.comboStroke = comboStroke
	station.comboScale = scale
	station.hintLabel = hint
	station.hintStroke = hintStroke
end

local function buildHold(station: Station, root: Frame)
	local zone = station.zone
	local hint = makeLabel(
		root, "Hint", ("Hold to %s"):format(zone.HustleVerb), Enum.Font.FredokaOne, WHITE,
		UDim2.fromScale(0.5, 0.5), UDim2.fromScale(1, 0.5), 3
	)
	-- Gentle breathing pulse: one looping tween, zero per-frame cost.
	local scale = Instance.new("UIScale")
	scale.Parent = hint
	TweenService:Create(
		scale,
		TweenInfo.new(0.9, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true),
		{ Scale = 1.07 }
	):Play()
	station.hintLabel = hint
end

local function buildTiming(station: Station, root: Frame)
	local zone = station.zone
	local bright = zoneBrightColor(zone)

	local title = makeLabel(
		root, "Title", METER_TITLE[zone.Id] or "HYPE", Enum.Font.LuckiestGuy, WHITE,
		UDim2.fromScale(0.36, 0.18), UDim2.fromScale(0.7, 0.3), 2.5
	)
	makeLabel(
		root, "PeakLabel", "PEAK", Enum.Font.LuckiestGuy, GREEN,
		UDim2.fromScale(0.86, 0.18), UDim2.fromScale(0.26, 0.26), 2
	)

	-- Track in zone colors (accent -> sign gradient) with a navy stroke
	local meter = Instance.new("Frame")
	meter.Name = "Meter"
	meter.AnchorPoint = Vector2.new(0.5, 0.5)
	meter.Position = UDim2.fromScale(0.5, 0.64)
	meter.Size = UDim2.fromScale(0.96, 0.34)
	meter.BackgroundColor3 = WHITE
	meter.BorderSizePixel = 0
	meter.ZIndex = 1
	roundify(meter, 0.5, NAVY, 2.5)
	local gradient = Instance.new("UIGradient")
	gradient.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, zone.AccentColor),
		ColorSequenceKeypoint.new(1, zone.SignColor),
	})
	gradient.Parent = meter
	meter.Parent = root

	-- Green PEAK region on the right end
	local peak = Instance.new("Frame")
	peak.Name = "PeakZone"
	peak.AnchorPoint = Vector2.new(1, 0.5)
	peak.Position = UDim2.fromScale(1, 0.5)
	peak.Size = UDim2.fromScale(1 - PEAK_START, 1)
	peak.BackgroundColor3 = GREEN
	peak.BorderSizePixel = 0
	peak.ZIndex = 2
	roundify(peak, 0.5)
	peak.Parent = meter

	-- Needle
	local needle = Instance.new("Frame")
	needle.Name = "Needle"
	needle.AnchorPoint = Vector2.new(0.5, 0.5)
	needle.Position = UDim2.fromScale(0, 0.5)
	needle.Size = UDim2.fromScale(0.05, 1.6)
	needle.BackgroundColor3 = WHITE
	needle.BorderSizePixel = 0
	needle.ZIndex = 4
	roundify(needle, 0.4, NAVY, 2)
	needle.Parent = meter

	station.needle = needle
	station.meterTitle = title
	station.inPeak = false
	title.TextColor3 = bright
end

local function buildCharge(station: Station, root: Frame)
	local zone = station.zone
	local count = math.max(math.floor(zone.ChargeMax), 1)

	makeLabel(
		root, "Title", CHARGE_TITLE[zone.Id] or "CHARGE", Enum.Font.LuckiestGuy, zoneBrightColor(zone),
		UDim2.fromScale(0.5, 0.18), UDim2.fromScale(1, 0.3), 2.5
	)

	local row = Instance.new("Frame")
	row.Name = "Segments"
	row.AnchorPoint = Vector2.new(0.5, 0.5)
	row.Position = UDim2.fromScale(0.5, 0.64)
	row.Size = UDim2.fromScale(0.96, 0.36)
	row.BackgroundTransparency = 1
	row.Parent = root

	local layout = Instance.new("UIListLayout")
	layout.FillDirection = Enum.FillDirection.Horizontal
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
	layout.VerticalAlignment = Enum.VerticalAlignment.Center
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Padding = UDim.new(0.025, 0)
	layout.Parent = row

	local gap = 0.025
	local width = (1 - gap * (count - 1)) / count
	for index = 1, count do
		local segment = Instance.new("Frame")
		segment.Name = "Segment" .. tostring(index)
		segment.LayoutOrder = index
		segment.Size = UDim2.fromScale(width, 1)
		segment.BackgroundColor3 = DIM
		segment.BackgroundTransparency = 0.35
		segment.BorderSizePixel = 0
		roundify(segment, 0.3, NAVY, 2)
		local scale = Instance.new("UIScale")
		scale.Parent = segment
		segment.Parent = row
		table.insert(station.segments, segment)
	end
end

local function buildStationGui(station: Station, feedbackPart: BasePart)
	local gui = Instance.new("BillboardGui")
	gui.Name = "StationFeedback"
	gui.Adornee = feedbackPart
	gui.Size = UDim2.new(6, 0, 2, 0) -- studs
	gui.AlwaysOnTop = false
	gui.MaxDistance = 120
	gui.LightInfluence = 0
	gui.Enabled = false
	gui.ResetOnSpawn = false

	local root = Instance.new("Frame")
	root.Name = "Root"
	root.Size = UDim2.fromScale(1, 1)
	root.BackgroundTransparency = 1
	root.Parent = gui

	local mechanic = station.mechanic
	if mechanic == "Tap" then
		buildTap(station, root)
	elseif mechanic == "Hold" then
		buildHold(station, root)
	elseif mechanic == "Timing" then
		buildTiming(station, root)
	elseif mechanic == "Charge" then
		buildCharge(station, root)
	else
		makeLabel(
			root, "Hint", station.zone.HustleVerb .. "!", Enum.Font.FredokaOne, WHITE,
			UDim2.fromScale(0.5, 0.5), UDim2.fromScale(1, 0.5), 3
		)
	end

	gui.Parent = feedbackPart
	station.gui = gui
end

----------------------------------------------------------------------
-- Per-mechanic updates
----------------------------------------------------------------------

local function showCombo(station: Station, combo: number, now: number)
	local label = station.comboLabel
	local stroke = station.comboStroke
	local scale = station.comboScale
	if not label or not stroke or not scale then
		return
	end
	local heat = math.clamp((combo - 2) / math.max(COMBO_MAX - 2, 1), 0, 1)
	label.Text = ("x%d"):format(math.floor(combo))
	label.TextColor3 = zoneBrightColor(station.zone):Lerp(RED, heat * 0.8)
	label.TextTransparency = 0
	stroke.Transparency = 0
	scale.Scale = 1.5
	TweenService:Create(scale, TweenInfo.new(0.22, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
		Scale = 1,
	}):Play()
	if station.hintLabel and station.hintStroke then
		station.hintLabel.TextTransparency = 1
		station.hintStroke.Transparency = 1
	end
	station.comboVisible = true
	station.comboUntil = now + COMBO_WINDOW
end

local function hideCombo(station: Station)
	if not station.comboVisible then
		return
	end
	station.comboVisible = false
	local label = station.comboLabel
	local stroke = station.comboStroke
	if label and stroke then
		local info = TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		TweenService:Create(label, info, { TextTransparency = 1 }):Play()
		TweenService:Create(stroke, info, { Transparency = 1 }):Play()
	end
	if station.hintLabel and station.hintStroke then
		local info = TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
		TweenService:Create(station.hintLabel, info, { TextTransparency = 0 }):Play()
		TweenService:Create(station.hintStroke, info, { Transparency = 0 }):Play()
	end
end

local function updateNeedle(station: Station, serverNow: number)
	local needle = station.needle
	if not needle then
		return
	end
	local factor = Mechanics.marketFactor(station.zone, serverNow)
	needle.Position = UDim2.fromScale(factor, 0.5)

	local inPeak = factor >= PEAK_START
	if inPeak ~= station.inPeak then
		station.inPeak = inPeak
		needle.BackgroundColor3 = if inPeak then GOLD else WHITE
		local title = station.meterTitle
		if title then
			if inPeak then
				title.Text = ("%s NOW!"):format(station.zone.HustleVerb:upper())
				title.TextColor3 = GOLD
			else
				title.Text = METER_TITLE[station.zoneId] or "HYPE"
				title.TextColor3 = zoneBrightColor(station.zone)
			end
		end
	end
end

local function setSegmentLit(station: Station, segment: Frame, lit: boolean, pop: boolean)
	segment.BackgroundColor3 = if lit then station.zone.SignColor else DIM
	segment.BackgroundTransparency = if lit then 0 else 0.35
	if pop then
		local scale = segment:FindFirstChildOfClass("UIScale")
		if scale then
			scale.Scale = 1.35
			TweenService:Create(scale, TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
				Scale = 1,
			}):Play()
		end
	end
end

local function setCharge(station: Station, charge: number)
	if station.flashing then
		-- A hit can land mid-flash (charge cooldown < flash length): keep it
		-- and apply it when the flash ends instead of dropping it.
		station.pendingCharge = charge
		return
	end
	local target = math.clamp(math.floor(charge), 0, #station.segments)
	for index, segment in station.segments do
		local lit = index <= target
		setSegmentLit(station, segment, lit, lit and index > station.lit)
	end
	station.lit = target
end

local function flashBurst(station: Station)
	if #station.segments == 0 then
		return
	end
	station.flashing = true
	for _, segment in station.segments do
		segment.BackgroundColor3 = station.zone.SignColor
		segment.BackgroundTransparency = 0
		TweenService:Create(segment, TweenInfo.new(0.08, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			BackgroundColor3 = WHITE,
		}):Play()
	end
	task.delay(0.45, function()
		if station.gui.Parent == nil then
			return
		end
		for _, segment in station.segments do
			TweenService:Create(segment, TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
				BackgroundColor3 = DIM,
				BackgroundTransparency = 0.35,
			}):Play()
		end
		station.lit = 0
		task.delay(0.35, function()
			station.flashing = false
			local pending = station.pendingCharge
			station.pendingCharge = nil
			if pending then
				setCharge(station, pending)
			end
		end)
	end)
end

----------------------------------------------------------------------
-- HustleResult -> feedback + callouts
----------------------------------------------------------------------

local function onHustleResult(zoneId: any, result: any)
	if type(zoneId) ~= "string" or type(result) ~= "table" then
		return
	end
	local zone = GameConfig.getZone(zoneId)
	if not zone then
		return
	end
	local kind = result.Kind
	local now = os.clock()

	-- Auto payouts are not player actions: they neither keep the station
	-- rendered nor touch the combo/charge displays.
	if kind == "Auto" then
		return
	end
	lastResultAt[zoneId] = now

	if kind == "Burst" then
		ClientEffects.callout(BURST_TEXT[zoneId] or "BURST!", zoneBrightColor(zone))
	elseif kind == "Peak" then
		ClientEffects.callout(PEAK_TEXT[zoneId] or "PEAK!", zoneBrightColor(zone))
	end

	local station = stations[zoneId]
	if not station or station.gui.Parent == nil then
		return
	end

	if station.mechanic == "Tap" then
		local combo = result.Combo
		if type(combo) == "number" and combo >= 2 then
			showCombo(station, combo, now)
		else
			hideCombo(station)
		end
	elseif station.mechanic == "Charge" then
		if kind == "Burst" then
			flashBurst(station)
		else
			local charge = result.Charge
			setCharge(station, if type(charge) == "number" then charge else 0)
		end
	end
end

----------------------------------------------------------------------
-- Heartbeat: render only the nearest zone + recently hustled zones
----------------------------------------------------------------------

local function onHeartbeat()
	local now = os.clock()
	local nearestId: string? = nil
	local hrp = currentHrp
	if hrp and hrp.Parent ~= nil then
		nearestId = Mechanics.nearestZoneId(hrp.Position)
	end
	local serverNow = workspace:GetServerTimeNow()

	for zoneId, station in stations do
		if station.gui.Parent == nil then
			continue -- streamed out; re-registered when the zone returns
		end
		local lastAt = lastResultAt[zoneId]
		local recent = lastAt ~= nil and now - lastAt < RECENT_WINDOW
		local active = zoneId == nearestId or recent
		if active ~= station.enabled then
			station.enabled = active
			station.gui.Enabled = active
		end
		if not active then
			continue
		end
		if station.mechanic == "Timing" then
			updateNeedle(station, serverNow)
		elseif station.mechanic == "Tap" then
			if station.comboVisible and now >= station.comboUntil then
				hideCombo(station)
			end
		end
	end
end

----------------------------------------------------------------------
-- Zone registration (WaitForChild with timeouts; zones may stream in late)
----------------------------------------------------------------------

local function warnOnce(zoneId: string, message: string)
	if warnedZones[zoneId] then
		return
	end
	warnedZones[zoneId] = true
	warn(("[StationFeedbackController] %s: %s"):format(zoneId, message))
end

local function registerZone(zoneModel: Instance)
	local zoneId = zoneModel.Name
	local zone = GameConfig.getZone(zoneId)
	if not zone then
		return -- not a zone model
	end
	local existing = stations[zoneId]
	if existing and existing.gui.Parent ~= nil then
		return -- alive already
	end
	if registering[zoneId] then
		return
	end
	registering[zoneId] = true

	local stationModel = zoneModel:WaitForChild("HustleStation", 20)
	local feedbackPart = if stationModel then stationModel:WaitForChild("FeedbackPart", 20) else nil
	registering[zoneId] = nil
	if not feedbackPart or not feedbackPart:IsA("BasePart") then
		warnOnce(zoneId, "HustleStation has no FeedbackPart")
		return
	end
	if zoneModel.Parent == nil then
		return -- streamed out while we waited; ChildAdded re-registers
	end

	if existing then
		existing.gui:Destroy()
		stations[zoneId] = nil
	end

	local station: Station = {
		zoneId = zoneId,
		zone = zone,
		mechanic = zone.Mechanic,
		gui = nil :: any, -- set by buildStationGui
		enabled = false,
		comboLabel = nil,
		comboStroke = nil,
		comboScale = nil,
		hintLabel = nil,
		hintStroke = nil,
		comboVisible = false,
		comboUntil = 0,
		needle = nil,
		meterTitle = nil,
		inPeak = false,
		segments = {},
		lit = 0,
		flashing = false,
	}
	buildStationGui(station, feedbackPart)
	stations[zoneId] = station
end

----------------------------------------------------------------------
-- Character tracking (nearest-zone test needs the HRP)
----------------------------------------------------------------------

local function onCharacterAdded(character: Model)
	currentHrp = nil
	task.spawn(function()
		local hrp = character:WaitForChild("HumanoidRootPart", 30)
		if hrp and hrp:IsA("BasePart") and character.Parent ~= nil and player.Character == character then
			currentHrp = hrp
		end
	end)
end

----------------------------------------------------------------------
-- Entry point
----------------------------------------------------------------------

function StationFeedbackController.start(): ()
	if started then
		return
	end
	started = true

	player.CharacterAdded:Connect(onCharacterAdded)
	player.CharacterRemoving:Connect(function()
		currentHrp = nil
	end)
	if player.Character then
		onCharacterAdded(player.Character)
	end

	task.spawn(function()
		local remotes = ReplicatedStorage:WaitForChild("Remotes")
		local hustleResult = remotes:WaitForChild("HustleResult")
		hustleResult.OnClientEvent:Connect(onHustleResult)
	end)

	task.spawn(function()
		local map = workspace:WaitForChild("SideHustleMap", 60)
		if not map then
			warn("[StationFeedbackController] Workspace.SideHustleMap never appeared")
			return
		end
		local zonesFolder = map:WaitForChild("Zones", 30)
		if not zonesFolder then
			warn("[StationFeedbackController] SideHustleMap.Zones never appeared")
			return
		end
		zonesFolder.ChildAdded:Connect(function(child)
			task.spawn(registerZone, child)
		end)
		for _, child in zonesFolder:GetChildren() do
			task.spawn(registerZone, child)
		end
	end)

	RunService.Heartbeat:Connect(onHeartbeat)
end

return StationFeedbackController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="553">
          <Properties>
            <string name="Name">WorkerVisualsController</string>
            <string name="Source"><![CDATA[-- WorkerVisualsController: renders the LOCAL player's equipped workers as cute
-- chibi rigs that waddle along behind the character (art & feel guide: "workers
-- waddling around doing the hustle animation in the background").
--
-- Pure view layer, client-only: rigs are built by ChibiRig (primitives), live in
-- a local-only Workspace folder ("WorkerRigs") and are driven purely by CFrame
-- math on a single RunService.Heartbeat connection - no physics, no server
-- instances. Equipped workers come from the DataSync snapshot (fires >=1/s)
-- and are diffed by Uid so rigs persist across syncs.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local sharedFolder = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(sharedFolder:WaitForChild("GameConfig"))
local FormatNumber = require(sharedFolder:WaitForChild("FormatNumber"))
local ChibiRig = require(sharedFolder:WaitForChild("ChibiRig"))

local RIG_FOLDER_NAME = "WorkerRigs"
local MAX_RIGS = GameConfig.Workers.BaseEquipSlots + GameConfig.Perks.WorkerSlots.MaxLevel -- 3 + 3

-- Slot fan behind/beside the player: angle in degrees (0 = directly behind,
-- negative = player's left) and radius in studs (contract: 5-7).
local SLOTS = {
	{ angle = 0, radius = 5 },
	{ angle = -38, radius = 5.6 },
	{ angle = 38, radius = 5.6 },
	{ angle = -72, radius = 6.4 },
	{ angle = 72, radius = 6.4 },
	{ angle = 0, radius = 7 },
}

-- Movement tuning
local FOLLOW_RATE = 4.5 -- exponential position smoothing per second
local TURN_RATE = 10 -- yaw smoothing per second
local WADDLE_SWAY = math.rad(8) -- +-8 degrees RotZ while moving
local WADDLE_BOB = 0.2 -- studs of up/down bob while moving
local ARM_SWING = math.rad(28) -- arm pitch swing while moving
local MOVE_THRESHOLD = 0.75 -- studs/s before a rig counts as moving
local HIDDEN_CFRAME = CFrame.new(0, -500, 0) -- parking spot before first placement

type RigState = {
	uid: string,
	model: Model,
	slotIndex: number,
	pos: Vector3?, -- nil until first placed (then snapped to its slot)
	yaw: number,
	phase: number, -- waddle sine phase
	sway: number, -- current RotZ
	bob: number, -- current bob height
	idleClock: number,
	idleWait: number,
	action: string?, -- "hop" | "spin"
	actionT: number,
	actionDur: number,
}

local rigs: { [string]: RigState } = {}

-- Local character tracking
local currentHrp: BasePart? = nil
local groundOffset = 3 -- HRP center -> feet distance; refined per character
local charToken = 0 -- invalidates stale WaitForChild setups on respawn
local charConnections: { RBXScriptConnection } = {}

local started = false

local WorkerVisualsController = {}

----------------------------------------------------------------------
-- Rig building (ChibiRig primitives; everything anchored + non-colliding)
----------------------------------------------------------------------

local function getRigFolder(): Folder
	local existing = workspace:FindFirstChild(RIG_FOLDER_NAME)
	if existing and existing:IsA("Folder") then
		return existing
	end
	-- Client-side creation is local-only; that is fine for a pure view layer.
	local folder = Instance.new("Folder")
	folder.Name = RIG_FOLDER_NAME
	folder.Parent = workspace
	return folder
end

-- Builds one chibi rig for a worker entry, then parks it underground until
-- the follow loop places it.
local function buildRigModel(entry: { [string]: any }): Model
	local rarity = GameConfig.getRarity(entry.Rarity)
	local income = GameConfig.getWorkerIncome(entry.Rarity, entry.Crate)
	local model = ChibiRig.build({
		Name = tostring(entry.Name),
		Rarity = entry.Rarity,
		Label = FormatNumber.money(income) .. "/s",
		LabelColor = if rarity then rarity.Color else nil,
	})
	model.Name = "WorkerRig_" .. tostring(entry.Name)
	ChibiRig.setPose(model, HIDDEN_CFRAME)
	model.Parent = getRigFolder()
	return model
end

local function createRig(entry: { [string]: any }, slotIndex: number): RigState
	local rig: RigState = {
		uid = entry.Uid,
		model = buildRigModel(entry),
		slotIndex = slotIndex,
		pos = nil,
		yaw = 0,
		phase = math.random() * math.pi * 2, -- desync waddles between rigs
		sway = 0,
		bob = 0,
		idleClock = 0,
		idleWait = 2 + math.random() * 3,
		action = nil,
		actionT = 0,
		actionDur = 1,
	}
	rigs[entry.Uid] = rig
	return rig
end

local function destroyRig(uid: string)
	local rig = rigs[uid]
	if rig then
		rigs[uid] = nil
		rig.model:Destroy()
	end
end

----------------------------------------------------------------------
-- DataSync diffing (by Uid; rigs persist across the ~1/s snapshots)
----------------------------------------------------------------------

local function applySnapshot(snapshot: any)
	if type(snapshot) ~= "table" or type(snapshot.Workers) ~= "table" then
		return
	end

	-- Equipped workers in snapshot order, capped at the rig limit.
	local desired: { { [string]: any } } = {}
	local desiredIndexByUid: { [string]: number } = {}
	for _, entry in snapshot.Workers do
		if #desired >= MAX_RIGS then
			break
		end
		if
			type(entry) == "table"
			and entry.Equipped == true
			and type(entry.Uid) == "string"
			and type(entry.Rarity) == "string"
			and type(entry.Crate) == "string"
			and type(entry.Name) == "string"
			and desiredIndexByUid[entry.Uid] == nil
		then
			table.insert(desired, entry)
			desiredIndexByUid[entry.Uid] = #desired
		end
	end

	-- Destroy rigs that were unequipped, plus any whose model got wiped
	-- externally (those rebuild below).
	local toRemove: { string } = {}
	for uid, rig in rigs do
		if desiredIndexByUid[uid] == nil or rig.model.Parent == nil then
			table.insert(toRemove, uid)
		end
	end
	for _, uid in toRemove do
		destroyRig(uid)
	end

	-- Create missing rigs; refresh slot assignments for survivors.
	for index, entry in desired do
		local rig = rigs[entry.Uid]
		if rig == nil then
			createRig(entry, index)
		else
			rig.slotIndex = index
		end
	end
end

----------------------------------------------------------------------
-- Follow + waddle loop (one Heartbeat connection, CFrame only)
----------------------------------------------------------------------

local function updateRig(rig: RigState, dt: number, hrpPos: Vector3?, playerYawCF: CFrame?, groundY: number)
	local model = rig.model
	if model.PrimaryPart == nil or model.Parent == nil then
		return
	end

	local moving = false
	local speed = 0

	if hrpPos and playerYawCF then
		local slot = SLOTS[math.clamp(rig.slotIndex, 1, #SLOTS)]
		local a = math.rad(slot.angle)
		-- 0 degrees = directly behind the player (+Z in player-local space).
		local worldDir = playerYawCF:VectorToWorldSpace(Vector3.new(math.sin(a), 0, math.cos(a)))
		local target = Vector3.new(hrpPos.X + worldDir.X * slot.radius, groundY, hrpPos.Z + worldDir.Z * slot.radius)

		local pos = rig.pos
		if pos == nil then
			-- First placement (or respawn re-anchor): snap straight to the slot.
			rig.pos = target
			rig.yaw = math.atan2(-worldDir.X, -worldDir.Z)
		else
			local alpha = 1 - math.exp(-dt * FOLLOW_RATE)
			local newPos = pos:Lerp(target, alpha)
			local vel = (newPos - pos) / dt
			speed = math.sqrt(vel.X * vel.X + vel.Z * vel.Z)
			moving = speed > MOVE_THRESHOLD
			rig.pos = newPos

			if moving then
				-- Face travel direction (shortest-arc yaw smoothing).
				local desiredYaw = math.atan2(-vel.X, -vel.Z)
				local delta = (desiredYaw - rig.yaw + math.pi) % (math.pi * 2) - math.pi
				rig.yaw += delta * math.min(dt * TURN_RATE, 1)
			end
		end
	end

	if rig.pos == nil then
		return -- never placed and no character yet; stay parked underground
	end

	-- WADDLE while moving; wind the sway/bob down when stopped.
	local hopY = 0
	local spinYaw = 0
	if moving then
		rig.action = nil
		rig.idleClock = 0
		rig.phase += dt * math.min(speed, 20) * 0.55
		rig.sway = math.sin(rig.phase) * WADDLE_SWAY
		rig.bob = math.abs(math.sin(rig.phase)) * WADDLE_BOB
	else
		local settle = math.min(dt * 6, 1)
		rig.sway += (0 - rig.sway) * settle
		rig.bob += (0 - rig.bob) * settle

		-- Idle "hustle" loop: tiny hops / a slow spin every few seconds.
		if rig.action then
			rig.actionT += dt
			local p = math.min(rig.actionT / rig.actionDur, 1)
			if rig.action == "hop" then
				hopY = math.abs(math.sin(p * math.pi * 2)) * 0.35 -- two tiny hops
			else
				local s = p * p * (3 - 2 * p) -- smoothstep: one eased full turn
				spinYaw = s * math.pi * 2
			end
			if p >= 1 then
				rig.action = nil
				rig.idleClock = 0
				rig.idleWait = 2 + math.random() * 3
			end
		else
			rig.idleClock += dt
			if rig.idleClock >= rig.idleWait then
				rig.actionT = 0
				if math.random() < 0.65 then
					rig.action = "hop"
					rig.actionDur = 0.7
				else
					rig.action = "spin"
					rig.actionDur = 1.3
				end
			end
		end
	end

	local pos = rig.pos :: Vector3
	local rootCF = CFrame.new(pos.X, pos.Y + rig.bob + hopY, pos.Z)
		* CFrame.Angles(0, rig.yaw + spinYaw, 0)
		* CFrame.Angles(0, 0, rig.sway)

	if moving then
		-- Arms swing opposite each other while waddling (2 extra CFrame ops).
		local swing = math.sin(rig.phase) * ARM_SWING
		ChibiRig.setPose(model, rootCF, {
			LeftArm = CFrame.Angles(swing, 0, 0),
			RightArm = CFrame.Angles(-swing, 0, 0),
		})
	else
		ChibiRig.setPose(model, rootCF)
	end
end

local function onHeartbeat(dt: number)
	if dt <= 0 then
		return
	end

	-- Shared per-frame data, computed once for all rigs.
	local hrp = currentHrp
	local hrpPos: Vector3? = nil
	local playerYawCF: CFrame? = nil
	local groundY = 0
	if hrp and hrp.Parent ~= nil then
		hrpPos = hrp.Position
		local look = hrp.CFrame.LookVector
		playerYawCF = CFrame.Angles(0, math.atan2(-look.X, -look.Z), 0)
		groundY = hrpPos.Y - groundOffset
	end

	for _, rig in rigs do
		updateRig(rig, dt, hrpPos, playerYawCF, groundY)
	end
end

----------------------------------------------------------------------
-- Character lifecycle (respawn re-anchors rigs; death pauses the follow)
----------------------------------------------------------------------

local function clearCharConnections()
	for _, connection in charConnections do
		connection:Disconnect()
	end
	table.clear(charConnections)
end

local function onCharacterAdded(character: Model)
	clearCharConnections()
	currentHrp = nil
	charToken += 1
	local token = charToken

	task.spawn(function()
		local hrp = character:WaitForChild("HumanoidRootPart", 30)
		local humanoid = character:WaitForChild("Humanoid", 30)
		if token ~= charToken or character.Parent == nil then
			return -- a newer character took over while we waited
		end
		if not (hrp and hrp:IsA("BasePart")) then
			return
		end

		groundOffset = 3
		if humanoid and humanoid:IsA("Humanoid") and humanoid.HipHeight > 0 then
			groundOffset = humanoid.HipHeight + hrp.Size.Y * 0.5
		end

		-- Re-anchor every rig to the new HumanoidRootPart: forget old
		-- positions so the next Heartbeat snaps them into their slots.
		for _, rig in rigs do
			rig.pos = nil
		end
		currentHrp = hrp

		if humanoid and humanoid:IsA("Humanoid") then
			table.insert(charConnections, humanoid.Died:Connect(function()
				if token == charToken then
					currentHrp = nil -- rigs idle in place until respawn
				end
			end))
		end
	end)
end

----------------------------------------------------------------------
-- Entry point
----------------------------------------------------------------------

function WorkerVisualsController.start(): ()
	if started then
		return
	end
	started = true

	local player = Players.LocalPlayer

	player.CharacterAdded:Connect(onCharacterAdded)
	player.CharacterRemoving:Connect(function()
		charToken += 1
		clearCharConnections()
		currentHrp = nil
	end)
	if player.Character then
		onCharacterAdded(player.Character)
	end

	task.spawn(function()
		local remotes = ReplicatedStorage:WaitForChild("Remotes")
		local dataSync = remotes:WaitForChild("DataSync")
		dataSync.OnClientEvent:Connect(applySnapshot)
	end)

	RunService.Heartbeat:Connect(onHeartbeat)
end

return WorkerVisualsController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="554">
          <Properties>
            <string name="Name">ZoneGateController</string>
            <string name="Source"><![CDATA[-- ZoneGateController: LOCAL-ONLY gate visuals for the zones the local player
-- has unlocked by level (v2: zone unlocked <=> snapshot.Level >= zone.UnlockLevel).
-- The server stays authoritative (it rejects hustles in locked zones), so these
-- are pure view changes: a walk-through GateWall and a hidden sign billboard.
-- Watches DataSync and re-applies on every snapshot, which also restores the
-- gates when the level drops after a rebirth. No UnlockPrompt exists in v2.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GameConfig = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("GameConfig"))

type GateRefs = {
	zoneId: string,
	unlockLevel: number,
	gateWall: BasePart,
	originalTransparency: number,
	originalCanCollide: boolean,
	billboards: { BillboardGui },
}

local gates: { [string]: GateRefs } = {}
local registering: { [string]: boolean } = {}
local currentLevel: number? = nil -- nil until the first DataSync snapshot

local ZoneGateController = {}

local function applyGate(refs: GateRefs)
	local level = currentLevel
	if level == nil then
		return -- never touch gates before the first snapshot
	end
	local gateWall = refs.gateWall
	if not gateWall:IsDescendantOf(workspace) then
		return -- streamed out / rebuilt; registration will pick it back up
	end
	if level >= refs.unlockLevel then
		-- Unlocked: open the gate locally.
		gateWall.CanCollide = false
		gateWall.Transparency = 1
		for _, billboard in refs.billboards do
			billboard.Enabled = false
		end
	else
		-- Locked (including re-locked after rebirth): restore the server look.
		gateWall.CanCollide = refs.originalCanCollide
		gateWall.Transparency = refs.originalTransparency
		for _, billboard in refs.billboards do
			billboard.Enabled = true
		end
	end
end

local function applyAll()
	for _, refs in gates do
		applyGate(refs)
	end
end

-- The gate sign's BillboardGui lives on SignPart inside the Gate model (map
-- contract). Scan descendants with a short retry window in case it appears late.
local function findGateBillboards(gate: Instance): { BillboardGui }
	local deadline = os.clock() + 5
	while true do
		local found: { BillboardGui } = {}
		for _, descendant in gate:GetDescendants() do
			if descendant:IsA("BillboardGui") then
				table.insert(found, descendant)
			end
		end
		if #found > 0 or os.clock() > deadline then
			return found
		end
		task.wait(0.25)
	end
end

local function registerZone(zoneModel: Instance)
	local zoneId = zoneModel.Name
	local zoneDef = GameConfig.getZone(zoneId)
	if not zoneDef or zoneDef.UnlockLevel <= 1 then
		return -- not a zone, or the starting zone (no gate)
	end
	local existing = gates[zoneId]
	if existing and existing.gateWall:IsDescendantOf(workspace) then
		return -- already registered and alive
	end
	if registering[zoneId] then
		return
	end
	registering[zoneId] = true

	local gate = zoneModel:WaitForChild("Gate", 20)
	if not gate then
		registering[zoneId] = nil
		warn(("[ZoneGateController] Zone %s has no Gate model"):format(zoneId))
		return
	end
	local gateWall = gate:WaitForChild("GateWall", 20)
	if not gateWall or not gateWall:IsA("BasePart") then
		registering[zoneId] = nil
		warn(("[ZoneGateController] Gate for %s has no GateWall part"):format(zoneId))
		return
	end

	local billboards = findGateBillboards(gate)
	registering[zoneId] = nil

	gates[zoneId] = {
		zoneId = zoneId,
		unlockLevel = zoneDef.UnlockLevel,
		gateWall = gateWall,
		originalTransparency = gateWall.Transparency,
		originalCanCollide = gateWall.CanCollide,
		billboards = billboards,
	}
	applyGate(gates[zoneId])
end

function ZoneGateController.start(): ()
	-- Keep the player's level in sync with the server.
	task.spawn(function()
		local remotes = ReplicatedStorage:WaitForChild("Remotes")
		local dataSync = remotes:WaitForChild("DataSync")
		dataSync.OnClientEvent:Connect(function(snapshot)
			if type(snapshot) ~= "table" or type(snapshot.Level) ~= "number" then
				return
			end
			currentLevel = snapshot.Level
			applyAll()
		end)
	end)

	-- Register every gated zone's gate, including ones that show up late.
	task.spawn(function()
		local map = workspace:WaitForChild("SideHustleMap", 60)
		if not map then
			warn("[ZoneGateController] Workspace.SideHustleMap never appeared")
			return
		end
		local zonesFolder = map:WaitForChild("Zones", 30)
		if not zonesFolder then
			warn("[ZoneGateController] SideHustleMap.Zones never appeared")
			return
		end
		zonesFolder.ChildAdded:Connect(function(child)
			task.spawn(registerZone, child)
		end)
		for _, child in zonesFolder:GetChildren() do
			task.spawn(registerZone, child)
		end
	end)
end

return ZoneGateController
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="Workspace" referent="555">
    <Properties>
      <string name="Name">Workspace</string>
      <bool name="NeedsPivotMigration">false</bool>
      <bool name="StreamingEnabled">false</bool>
    </Properties>
    <Item class="Terrain" referent="556">
      <Properties>
        <string name="Name">Terrain</string>
        <bool name="Decoration">true</bool>
      </Properties>
    </Item>
