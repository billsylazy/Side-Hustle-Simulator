      <Item class="ModuleScript" referent="3">
        <Properties>
          <string name="Name">ButtonFX</string>
          <string name="Source"><![CDATA[-- ButtonFX: press/hover bounce for every GuiButton (hud_example pattern).
-- Client-only: errors if required on the server. Idempotent per button.

local RunService = game:GetService("RunService")
if not RunService:IsClient() then
	error("ButtonFX is client-only and cannot be required on the server", 2)
end

local TweenService = game:GetService("TweenService")

local ClientEffects = require(script.Parent:WaitForChild("ClientEffects"))

local ATTACHED_ATTRIBUTE = "ButtonFXAttached"
local SCALE_NAME = "ButtonFXScale"

local HOVER_INFO = TweenInfo.new(0.1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
local PRESS_INFO = TweenInfo.new(0.08, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
local SPRING_INFO = TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out)

local ButtonFX = {}

function ButtonFX.attach(button: GuiButton)
	if typeof(button) ~= "Instance" or not button:IsA("GuiButton") then
		return
	end
	if button:GetAttribute(ATTACHED_ATTRIBUTE) then
		return -- already wired up
	end
	button:SetAttribute(ATTACHED_ATTRIBUTE, true)

	local scale = button:FindFirstChild(SCALE_NAME)
	if not scale or not scale:IsA("UIScale") then
		scale = Instance.new("UIScale")
		scale.Name = SCALE_NAME
		scale.Parent = button
	end

	local function tweenTo(target: number, info: TweenInfo)
		TweenService:Create(scale, info, { Scale = target }):Play()
	end

	button.MouseEnter:Connect(function()
		tweenTo(1.06, HOVER_INFO)
	end)
	button.MouseButton1Down:Connect(function()
		tweenTo(0.9, PRESS_INFO)
	end)
	button.MouseButton1Up:Connect(function()
		tweenTo(1, SPRING_INFO)
	end)
	button.MouseLeave:Connect(function()
		tweenTo(1, SPRING_INFO)
	end)
	button.Activated:Connect(function()
		ClientEffects.playSound("Click")
	end)
end

return ButtonFX
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="4">
        <Properties>
          <string name="Name">ClientEffects</string>
          <string name="Source"><![CDATA[-- ClientEffects: client-only juice API (money popups, screen pop, sparkle,
-- sounds, rebirth celebration). See ARCHITECTURE.md "UI contract".
-- Required by UI LocalScripts and client controllers. Errors if required on the server.

local RunService = game:GetService("RunService")
if not RunService:IsClient() then
	error("ClientEffects is client-only and cannot be required on the server", 2)
end

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local SoundService = game:GetService("SoundService")
local GuiService = game:GetService("GuiService")

local GameConfig = require(script.Parent:WaitForChild("GameConfig"))
local FormatNumber = require(script.Parent:WaitForChild("FormatNumber"))

local player = Players.LocalPlayer

-- Style palette (art-feel-guide: chunky text, thick navy strokes, gold coins)
local NAVY = Color3.fromRGB(4, 4, 53) -- #040435
local GREEN = Color3.fromRGB(71, 198, 78) -- #47c64e
local GOLD = Color3.fromRGB(255, 200, 40)
local WHITE = Color3.fromRGB(255, 255, 255)

local CONFETTI_COLORS = {
	Color3.fromRGB(255, 212, 31),
	Color3.fromRGB(88, 190, 72),
	Color3.fromRGB(128, 115, 255),
	Color3.fromRGB(64, 200, 224),
	Color3.fromRGB(255, 123, 34),
	Color3.fromRGB(255, 92, 180),
	Color3.fromRGB(60, 130, 255),
	Color3.fromRGB(255, 255, 255),
}

local ClientEffects = {}

----------------------------------------------------------------------
-- EffectsGui (lazily created, survives respawn, draws above panels)
----------------------------------------------------------------------

local effectsGui: ScreenGui? = nil

local function getEffectsGui(): ScreenGui
	if effectsGui and effectsGui.Parent then
		return effectsGui :: ScreenGui
	end
	local playerGui = player:WaitForChild("PlayerGui")
	local existing = playerGui:FindFirstChild("EffectsGui")
	if existing and existing:IsA("ScreenGui") then
		effectsGui = existing
		return existing
	end
	local gui = Instance.new("ScreenGui")
	gui.Name = "EffectsGui"
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = true
	gui.DisplayOrder = 50
	gui.Parent = playerGui
	effectsGui = gui
	return gui
end

----------------------------------------------------------------------
-- Sounds: cached templates in SoundService, play clones so they overlap
----------------------------------------------------------------------

local soundCache: { [string]: Sound } = {}

function ClientEffects.playSound(name: string)
	local soundId = GameConfig.Sounds[name]
	if soundId == nil or soundId == "" then
		return -- placeholder not filled in yet; never play an empty id
	end
	local template = soundCache[name]
	if not template or not template.Parent then
		template = Instance.new("Sound")
		template.Name = "FX_" .. name
		template.SoundId = soundId
		template.Volume = 0.6
		template.Parent = SoundService
		soundCache[name] = template
	end
	local clone = (template :: Sound):Clone()
	clone.PlaybackSpeed = 0.95 + math.random() * 0.1 -- tiny variation keeps spam fresh
	clone.Parent = SoundService
	clone:Play()
	clone.Ended:Once(function()
		clone:Destroy()
	end)
	task.delay(10, function()
		clone:Destroy() -- safety net; Destroy is idempotent
	end)
end

----------------------------------------------------------------------
-- moneyPopup: chunky "+$1.2K!" springing up with a burst of coin dots
----------------------------------------------------------------------

function ClientEffects.moneyPopup(amount: number)
	local gui = getEffectsGui()

	-- Anchor the whole effect to one slightly-random point upper-middle screen.
	local container = Instance.new("Frame")
	container.Name = "MoneyPopup"
	container.AnchorPoint = Vector2.new(0.5, 0.5)
	container.Position = UDim2.fromScale(
		0.5 + (math.random() - 0.5) * 0.16,
		0.3 + (math.random() - 0.5) * 0.1
	)
	container.Size = UDim2.fromOffset(0, 0)
	container.BackgroundTransparency = 1
	container.Parent = gui

	-- Coin dot burst (behind the text)
	for _ = 1, math.random(5, 8) do
		local coin = Instance.new("Frame")
		local coinSize = math.random(10, 16)
		coin.Size = UDim2.fromOffset(coinSize, coinSize)
		coin.AnchorPoint = Vector2.new(0.5, 0.5)
		coin.Position = UDim2.fromOffset(0, 0)
		coin.BackgroundColor3 = GOLD
		coin.BorderSizePixel = 0
		coin.ZIndex = 1

		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(1, 0)
		corner.Parent = coin

		local coinStroke = Instance.new("UIStroke")
		coinStroke.Color = NAVY
		coinStroke.Thickness = 2
		coinStroke.Parent = coin

		coin.Parent = container

		local angle = math.random() * math.pi * 2
		local distance = math.random(40, 110)
		local flyTime = 0.4 + math.random() * 0.3
		local flyInfo = TweenInfo.new(flyTime, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
		TweenService:Create(coin, flyInfo, {
			Position = UDim2.fromOffset(math.cos(angle) * distance, math.sin(angle) * distance - 20),
			BackgroundTransparency = 1,
		}):Play()
		TweenService:Create(coinStroke, flyInfo, { Transparency = 1 }):Play()
	end

	-- The "+$X!" label
	local label = Instance.new("TextLabel")
	label.Name = "Amount"
	label.AnchorPoint = Vector2.new(0.5, 0.5)
	label.Position = UDim2.fromOffset(0, 0)
	label.Size = UDim2.fromOffset(160, 60)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.FredokaOne
	label.Text = "+" .. FormatNumber.money(amount) .. "!"
	label.TextScaled = true
	label.TextColor3 = GREEN
	label.Rotation = math.random(-8, 8)
	label.ZIndex = 2

	local stroke = Instance.new("UIStroke")
	stroke.Color = NAVY
	stroke.Thickness = 4
	stroke.LineJoinMode = Enum.LineJoinMode.Round
	stroke.Parent = label

	label.Parent = container

	-- Spring ~80px up, then fade out in the second half.
	TweenService:Create(label, TweenInfo.new(0.7, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
		Position = UDim2.fromOffset(0, -80),
	}):Play()
	task.delay(0.35, function()
		if not container.Parent then
			return
		end
		local fadeInfo = TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		TweenService:Create(label, fadeInfo, { TextTransparency = 1 }):Play()
		TweenService:Create(stroke, fadeInfo, { Transparency = 1 }):Play()
	end)

	ClientEffects.playSound("Coin")

	task.delay(1, function()
		container:Destroy()
	end)
end

----------------------------------------------------------------------
-- screenPop: quick HUD punch on earnings
----------------------------------------------------------------------

function ClientEffects.screenPop()
	local playerGui = player:FindFirstChildOfClass("PlayerGui")
	if not playerGui then
		return
	end
	local hud = playerGui:FindFirstChild("MainHUD")
	if not hud or not hud:IsA("ScreenGui") then
		return -- no HUD yet; nothing to pop
	end
	local scale = hud:FindFirstChild("ScreenPopScale")
	if not scale or not scale:IsA("UIScale") then
		scale = Instance.new("UIScale")
		scale.Name = "ScreenPopScale"
		scale.Parent = hud
	end
	local up = TweenService:Create(
		scale,
		TweenInfo.new(0.08, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{ Scale = 1.035 }
	)
	up:Play()
	up.Completed:Once(function()
		TweenService:Create(
			scale,
			TweenInfo.new(0.18, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
			{ Scale = 1 }
		):Play()
	end)
end

----------------------------------------------------------------------
-- sparkle: little star dots popping off a GuiObject (upgrades, claims)
----------------------------------------------------------------------

function ClientEffects.sparkle(guiObject: GuiObject)
	if typeof(guiObject) ~= "Instance" or not guiObject:IsA("GuiObject") then
		return
	end
	local gui = getEffectsGui()

	-- EffectsGui ignores the gui inset, AbsolutePosition does not: convert.
	local inset = GuiService:GetGuiInset()
	local center = guiObject.AbsolutePosition + guiObject.AbsoluteSize / 2 + inset

	local container = Instance.new("Frame")
	container.Name = "Sparkle"
	container.AnchorPoint = Vector2.new(0.5, 0.5)
	container.Position = UDim2.fromOffset(center.X, center.Y)
	container.Size = UDim2.fromOffset(0, 0)
	container.BackgroundTransparency = 1
	container.Parent = gui

	local halfX = math.max(guiObject.AbsoluteSize.X / 2, 10)
	local halfY = math.max(guiObject.AbsoluteSize.Y / 2, 10)

	for _ = 1, math.random(6, 10) do
		local star = Instance.new("Frame")
		local starSize = math.random(6, 11)
		star.Size = UDim2.fromOffset(starSize, starSize)
		star.AnchorPoint = Vector2.new(0.5, 0.5)
		star.BackgroundColor3 = if math.random() < 0.5 then WHITE else GOLD
		star.BorderSizePixel = 0
		star.Rotation = math.random(0, 90)

		local angle = math.random() * math.pi * 2
		local startX = math.cos(angle) * halfX * 0.6
		local startY = math.sin(angle) * halfY * 0.6
		star.Position = UDim2.fromOffset(startX, startY)
		star.Parent = container

		local distance = math.random(25, 60)
		TweenService:Create(star, TweenInfo.new(0.6, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			Position = UDim2.fromOffset(
				startX + math.cos(angle) * distance,
				startY + math.sin(angle) * distance
			),
			Rotation = star.Rotation + math.random(90, 270),
			BackgroundTransparency = 1,
		}):Play()
	end

	task.delay(0.7, function()
		container:Destroy()
	end)
end

----------------------------------------------------------------------
-- celebrate: BIG full-screen rebirth celebration (~3.5s)
----------------------------------------------------------------------

local activeCelebration: Frame? = nil

function ClientEffects.celebrate(rebirths: number)
	local gui = getEffectsGui()

	if activeCelebration then
		activeCelebration:Destroy()
		activeCelebration = nil
	end

	local overlay = Instance.new("Frame")
	overlay.Name = "RebirthCelebration"
	overlay.Size = UDim2.fromScale(1, 1)
	overlay.BackgroundTransparency = 1
	overlay.ZIndex = 10
	overlay.ClipsDescendants = false
	overlay.Parent = gui
	activeCelebration = overlay

	ClientEffects.playSound("Rebirth")

	-- White flash
	local flash = Instance.new("Frame")
	flash.Name = "Flash"
	flash.Size = UDim2.fromScale(1, 1)
	flash.BackgroundColor3 = WHITE
	flash.BackgroundTransparency = 0
	flash.BorderSizePixel = 0
	flash.ZIndex = 11
	flash.Parent = overlay
	TweenService:Create(
		flash,
		TweenInfo.new(0.6, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{ BackgroundTransparency = 1 }
	):Play()

	-- Confetti rain: 40-60 colored rotated frames tumbling down, staggered
	for _ = 1, math.random(40, 60) do
		task.delay(math.random() * 0.8, function()
			if not overlay.Parent then
				return
			end
			local piece = Instance.new("Frame")
			piece.Size = UDim2.fromOffset(math.random(8, 16), math.random(10, 22))
			piece.BackgroundColor3 = CONFETTI_COLORS[math.random(#CONFETTI_COLORS)]
			piece.BorderSizePixel = 0
			piece.AnchorPoint = Vector2.new(0.5, 0.5)
			local startX = math.random()
			piece.Position = UDim2.fromScale(startX, -0.08)
			piece.Rotation = math.random(0, 360)
			piece.ZIndex = 12
			piece.Parent = overlay

			local fallTime = 1.4 + math.random() * 1.3
			local drift = (math.random() - 0.5) * 0.25
			local spin = math.random(180, 720) * (if math.random() < 0.5 then -1 else 1)
			TweenService:Create(piece, TweenInfo.new(fallTime, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
				Position = UDim2.fromScale(math.clamp(startX + drift, 0, 1), 1.12),
				Rotation = piece.Rotation + spin,
			}):Play()
		end)
	end

	-- Giant "REBIRTH!" slamming in
	local title = Instance.new("TextLabel")
	title.Name = "Title"
	title.AnchorPoint = Vector2.new(0.5, 0.5)
	title.Position = UDim2.fromScale(0.5, 0.42)
	title.Size = UDim2.fromScale(0.85, 0.22)
	title.BackgroundTransparency = 1
	title.Font = Enum.Font.LuckiestGuy
	title.Text = "REBIRTH!"
	title.TextScaled = true
	title.TextColor3 = GOLD
	title.TextTransparency = 1
	title.Rotation = -4
	title.ZIndex = 13

	local titleStroke = Instance.new("UIStroke")
	titleStroke.Color = NAVY
	titleStroke.Thickness = 6
	titleStroke.LineJoinMode = Enum.LineJoinMode.Round
	titleStroke.Transparency = 1
	titleStroke.Parent = title

	local titleScale = Instance.new("UIScale")
	titleScale.Scale = 3
	titleScale.Parent = title

	title.Parent = overlay

	local slamInfo = TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
	TweenService:Create(titleScale, slamInfo, { Scale = 1 }):Play()
	local appearInfo = TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	TweenService:Create(title, appearInfo, { TextTransparency = 0 }):Play()
	TweenService:Create(titleStroke, appearInfo, { Transparency = 0 }):Play()

	-- Subtitle: new multiplier
	local multiplier = GameConfig.getRebirthMultiplier(rebirths)
	local subtitle = Instance.new("TextLabel")
	subtitle.Name = "Subtitle"
	subtitle.AnchorPoint = Vector2.new(0.5, 0.5)
	subtitle.Position = UDim2.fromScale(0.5, 0.62)
	subtitle.Size = UDim2.fromScale(0.6, 0.07)
	subtitle.BackgroundTransparency = 1
	subtitle.Font = Enum.Font.FredokaOne
	subtitle.Text = "You are now x" .. tostring(multiplier) .. " faster!"
	subtitle.TextScaled = true
	subtitle.TextColor3 = WHITE
	subtitle.TextTransparency = 1
	subtitle.ZIndex = 13

	local subtitleStroke = Instance.new("UIStroke")
	subtitleStroke.Color = NAVY
	subtitleStroke.Thickness = 4
	subtitleStroke.LineJoinMode = Enum.LineJoinMode.Round
	subtitleStroke.Transparency = 1
	subtitleStroke.Parent = subtitle

	subtitle.Parent = overlay

	task.delay(0.45, function()
		if not overlay.Parent then
			return
		end
		local inInfo = TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
		TweenService:Create(subtitle, inInfo, {
			Position = UDim2.fromScale(0.5, 0.58),
			TextTransparency = 0,
		}):Play()
		TweenService:Create(subtitleStroke, inInfo, { Transparency = 0 }):Play()
	end)

	-- Fade everything out, then clean up fully.
	task.delay(2.9, function()
		if not overlay.Parent then
			return
		end
		local outInfo = TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		TweenService:Create(title, outInfo, { TextTransparency = 1 }):Play()
		TweenService:Create(titleStroke, outInfo, { Transparency = 1 }):Play()
		TweenService:Create(subtitle, outInfo, { TextTransparency = 1 }):Play()
		TweenService:Create(subtitleStroke, outInfo, { Transparency = 1 }):Play()
	end)

	task.delay(3.6, function()
		if activeCelebration == overlay then
			activeCelebration = nil
		end
		overlay:Destroy()
	end)
end

return ClientEffects
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="5">
        <Properties>
          <string name="Name">FormatNumber</string>
          <string name="Source"><![CDATA[--!strict
-- Number abbreviation for chunky simulator UI: 1234 -> "1.2K", money(1234) -> "$1.2K"

local FormatNumber = {}

local SUFFIXES = { "", "K", "M", "B", "T", "Qd", "Qn" }

function FormatNumber.abbreviate(n: number): string
	if n ~= n or n == math.huge then
		return "0"
	end
	local negative = n < 0
	n = math.abs(n)
	local index = 1
	-- The 999.95 clause keeps "%.1f" from rounding up to "1000.0K" at suffix
	-- boundaries (999,999 -> 1M, not 1000.0K).
	while index < #SUFFIXES and (n >= 1000 or (index > 1 and n >= 999.95)) do
		n /= 1000
		index += 1
	end
	local text: string
	if index == 1 then
		text = tostring(math.floor(n))
	else
		text = string.format("%.1f", n)
		text = (text:gsub("%.0$", "")) .. SUFFIXES[index]
	end
	if negative then
		text = "-" .. text
	end
	return text
end

function FormatNumber.money(n: number): string
	return "$" .. FormatNumber.abbreviate(n)
end

-- Full comma formatting for gate signs etc: 1234567 -> "1,234,567"
function FormatNumber.commas(n: number): string
	local text = tostring(math.floor(math.abs(n)))
	local formatted = text:reverse():gsub("(%d%d%d)", "%1,"):reverse():gsub("^,", "")
	if n < 0 then
		formatted = "-" .. formatted
	end
	return formatted
end

return FormatNumber
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="6">
        <Properties>
          <string name="Name">GameConfig</string>
          <string name="Source"><![CDATA[--!strict
-- GameConfig: single source of truth for ALL game tuning.
-- Server and client both read this. Balance lives here, logic lives in services.

local GameConfig = {}

----------------------------------------------------------------------
-- Zones (ordered). Every hustle is recognizable from across the map:
-- exaggerated shapes, one signature color per zone (art & feel guide).
----------------------------------------------------------------------

export type ZoneDef = {
	Id: string,
	Name: string,
	Order: number,
	UnlockCost: number, -- 0 = starting zone, no gate
	HustleEarn: number, -- base cash per hustle action
	HustleCooldown: number, -- seconds between hustles (server-enforced)
	SignColor: Color3, -- signature color
	AccentColor: Color3,
	HustleVerb: string, -- flavor on the prompt / popups
}

GameConfig.Zones = {
	{
		Id = "LemonadeStand",
		Name = "Lemonade Stand",
		Order = 1,
		UnlockCost = 0,
		HustleEarn = 5,
		HustleCooldown = 1,
		SignColor = Color3.fromRGB(255, 212, 31),
		AccentColor = Color3.fromRGB(255, 240, 120),
		HustleVerb = "Squeeze",
	},
	{
		Id = "DogWalking",
		Name = "Dog Walking",
		Order = 2,
		UnlockCost = 500,
		HustleEarn = 20,
		HustleCooldown = 1,
		SignColor = Color3.fromRGB(88, 190, 72),
		AccentColor = Color3.fromRGB(150, 230, 120),
		HustleVerb = "Walk",
	},
	{
		Id = "SneakerFlipping",
		Name = "Sneaker Street",
		Order = 3,
		UnlockCost = 5000,
		HustleEarn = 80,
		HustleCooldown = 1,
		SignColor = Color3.fromRGB(128, 115, 255),
		AccentColor = Color3.fromRGB(180, 160, 255),
		HustleVerb = "Flip",
	},
	{
		Id = "CarWash",
		Name = "Car Wash",
		Order = 4,
		UnlockCost = 25000,
		HustleEarn = 300,
		HustleCooldown = 1,
		SignColor = Color3.fromRGB(64, 200, 224),
		AccentColor = Color3.fromRGB(140, 230, 255),
		HustleVerb = "Scrub",
	},
	{
		Id = "FoodTruck",
		Name = "Food Truck",
		Order = 5,
		UnlockCost = 100000,
		HustleEarn = 1100,
		HustleCooldown = 1,
		SignColor = Color3.fromRGB(255, 123, 34),
		AccentColor = Color3.fromRGB(247, 55, 92),
		HustleVerb = "Grill",
	},
	{
		Id = "ContentCreator",
		Name = "Creator Studio",
		Order = 6,
		UnlockCost = 500000,
		HustleEarn = 4000,
		HustleCooldown = 1,
		SignColor = Color3.fromRGB(255, 92, 180),
		AccentColor = Color3.fromRGB(255, 160, 220),
		HustleVerb = "Stream",
	},
	{
		Id = "StockDesk",
		Name = "Stock Desk",
		Order = 7,
		UnlockCost = 2500000,
		HustleEarn = 15000,
		HustleCooldown = 1,
		SignColor = Color3.fromRGB(32, 200, 96),
		AccentColor = Color3.fromRGB(8, 12, 10),
		HustleVerb = "Trade",
	},
	{
		Id = "StartupHQ",
		Name = "Startup HQ",
		Order = 8,
		UnlockCost = 10000000,
		HustleEarn = 60000,
		HustleCooldown = 1,
		SignColor = Color3.fromRGB(240, 246, 255),
		AccentColor = Color3.fromRGB(60, 130, 255),
		HustleVerb = "Pitch",
	},
} :: { ZoneDef }

local zonesById: { [string]: ZoneDef } = {}
for _, zone in GameConfig.Zones do
	zonesById[zone.Id] = zone
end

function GameConfig.getZone(zoneId: string): ZoneDef?
	return zonesById[zoneId]
end

GameConfig.StartingZoneId = "LemonadeStand"

----------------------------------------------------------------------
-- Workers: cute chibi characters whose props show their rarity.
----------------------------------------------------------------------

export type RarityDef = {
	Id: string,
	Name: string,
	IncomePerSec: number, -- base, multiplied by crate Multiplier
	Color: Color3, -- rarity accent (cards, name tags)
	Prop: string, -- "CoffeeCup" | "None" | "Clipboard" | "GoldSuit"
}

-- Ordered common -> rarest
GameConfig.WorkerRarities = {
	{ Id = "Intern", Name = "Intern", IncomePerSec = 2, Color = Color3.fromRGB(170, 170, 180), Prop = "CoffeeCup" },
	{ Id = "Employee", Name = "Employee", IncomePerSec = 6, Color = Color3.fromRGB(88, 190, 72), Prop = "None" },
	{ Id = "Manager", Name = "Manager", IncomePerSec = 20, Color = Color3.fromRGB(64, 140, 255), Prop = "Clipboard" },
	{ Id = "CEO", Name = "CEO", IncomePerSec = 75, Color = Color3.fromRGB(255, 200, 40), Prop = "GoldSuit" },
} :: { RarityDef }

local raritiesById: { [string]: RarityDef } = {}
for _, rarity in GameConfig.WorkerRarities do
	raritiesById[rarity.Id] = rarity
end

function GameConfig.getRarity(rarityId: string): RarityDef?
	return raritiesById[rarityId]
end

export type CrateDef = {
	Id: string,
	Name: string,
	Cost: number,
	Multiplier: number, -- multiplies the rarity's IncomePerSec
	-- Weights by rarity Id; need not sum to 100, they are normalized.
	Weights: { [string]: number },
}

GameConfig.WorkerCrates = {
	StarterCrate = {
		Id = "StarterCrate",
		Name = "Starter Crate",
		Cost = 100,
		Multiplier = 1,
		Weights = { Intern = 60, Employee = 28, Manager = 10, CEO = 2 },
	},
	ProCrate = {
		Id = "ProCrate",
		Name = "Pro Crate",
		Cost = 10000,
		Multiplier = 12,
		Weights = { Intern = 40, Employee = 35, Manager = 18, CEO = 7 },
	},
	EliteCrate = {
		Id = "EliteCrate",
		Name = "Elite Crate",
		Cost = 1000000,
		Multiplier = 150,
		Weights = { Intern = 20, Employee = 35, Manager = 30, CEO = 15 },
	},
} :: { [string]: CrateDef }

-- First names give workers personality; full name = "<first> the <rarity>".
GameConfig.WorkerNames = {
	"Benny", "Pixel", "Mo", "Greta", "Ziggy", "Luna", "Chip", "Olive",
	"Rocco", "Daisy", "Felix", "Wanda", "Gus", "Penny", "Sunny", "Bram",
	"Coco", "Milo", "Trixie", "Alfie", "Nova", "Biscuit", "Pepper", "Scout",
}

GameConfig.Workers = {
	BaseEquipSlots = 3, -- + WorkerSlots upgrade level
	MaxStorage = 50,
	IncomeTickSeconds = 1,
}

-- Income/sec for one worker entry (before upgrades/rebirth multipliers).
function GameConfig.getWorkerIncome(rarityId: string, crateId: string): number
	local rarity = raritiesById[rarityId]
	local crate = GameConfig.WorkerCrates[crateId]
	if not rarity or not crate then
		return 0
	end
	return rarity.IncomePerSec * crate.Multiplier
end

----------------------------------------------------------------------
-- Upgrades (reset on rebirth). cost = BaseCost * CostMultiplier ^ level
----------------------------------------------------------------------

export type UpgradeDef = {
	Id: string,
	Name: string,
	Description: string,
	BaseCost: number,
	CostMultiplier: number,
	MaxLevel: number,
}

GameConfig.Upgrades = {
	HustlePower = {
		Id = "HustlePower",
		Name = "Hustle Power",
		Description = "+25% cash per hustle, per level",
		BaseCost = 100,
		CostMultiplier = 1.5,
		MaxLevel = 25,
	},
	WorkerEfficiency = {
		Id = "WorkerEfficiency",
		Name = "Worker Hustle",
		Description = "+20% worker income, per level",
		BaseCost = 250,
		CostMultiplier = 1.5,
		MaxLevel = 25,
	},
	WalkSpeed = {
		Id = "WalkSpeed",
		Name = "Fast Shoes",
		Description = "+1 walk speed, per level",
		BaseCost = 500,
		CostMultiplier = 2,
		MaxLevel = 8,
	},
	WorkerSlots = {
		Id = "WorkerSlots",
		Name = "Worker Slot",
		Description = "+1 equipped worker, per level",
		BaseCost = 25000,
		CostMultiplier = 8,
		MaxLevel = 3,
	},
} :: { [string]: UpgradeDef }

function GameConfig.getUpgradeCost(upgradeId: string, currentLevel: number): number?
	local def = GameConfig.Upgrades[upgradeId]
	if not def or currentLevel >= def.MaxLevel then
		return nil
	end
	return math.floor(def.BaseCost * def.CostMultiplier ^ currentLevel)
end

-- Multiplier contributions (used by HustleService / WorkerService)
GameConfig.HustlePowerPerLevel = 0.25
GameConfig.WorkerEfficiencyPerLevel = 0.2
GameConfig.BaseWalkSpeed = 16

----------------------------------------------------------------------
-- Rebirth
----------------------------------------------------------------------

GameConfig.Rebirth = {
	BaseRequirement = 25000, -- CashThisLife needed for first rebirth
	RequirementMultiplier = 4, -- requirement = Base * Mult ^ Rebirths
	BonusPerRebirth = 0.5, -- rebirthMult = 1 + Bonus * Rebirths
	MaxRebirths = 100,
}

function GameConfig.getRebirthRequirement(rebirths: number): number
	return math.floor(GameConfig.Rebirth.BaseRequirement * GameConfig.Rebirth.RequirementMultiplier ^ rebirths)
end

function GameConfig.getRebirthMultiplier(rebirths: number): number
	return 1 + GameConfig.Rebirth.BonusPerRebirth * rebirths
end

----------------------------------------------------------------------
-- Quests: one-time, progress read from lifetime Stats (survive rebirth).
-- Stat must be one of: HustleCount, TotalCashEarned, WorkersHired,
-- ZonesUnlockedCount, TotalRebirths.
----------------------------------------------------------------------

export type QuestDef = {
	Id: string,
	Name: string,
	Description: string,
	Stat: string,
	Target: number,
	Reward: number, -- cash
}

GameConfig.Quests = {
	{ Id = "FirstSqueeze", Name = "First Squeeze", Description = "Do 10 hustles", Stat = "HustleCount", Target = 10, Reward = 100 },
	{ Id = "Grinder", Name = "Grinder", Description = "Do 100 hustles", Stat = "HustleCount", Target = 100, Reward = 1000 },
	{ Id = "HustleMachine", Name = "Hustle Machine", Description = "Do 1,000 hustles", Stat = "HustleCount", Target = 1000, Reward = 25000 },
	{ Id = "FirstGrand", Name = "First Grand", Description = "Earn $1,000 total", Stat = "TotalCashEarned", Target = 1000, Reward = 250 },
	{ Id = "SixFigures", Name = "Six Figures", Description = "Earn $100,000 total", Stat = "TotalCashEarned", Target = 100000, Reward = 10000 },
	{ Id = "Millionaire", Name = "Millionaire", Description = "Earn $1,000,000 total", Stat = "TotalCashEarned", Target = 1000000, Reward = 100000 },
	{ Id = "FirstHire", Name = "First Hire", Description = "Hire a worker", Stat = "WorkersHired", Target = 1, Reward = 200 },
	{ Id = "TeamBuilder", Name = "Team Builder", Description = "Hire 10 workers", Stat = "WorkersHired", Target = 10, Reward = 5000 },
	{ Id = "Corporation", Name = "Corporation", Description = "Hire 25 workers", Stat = "WorkersHired", Target = 25, Reward = 100000 },
	{ Id = "NewVenture", Name = "New Venture", Description = "Unlock 3 hustles", Stat = "ZonesUnlockedCount", Target = 3, Reward = 2000 },
	{ Id = "Mogul", Name = "Mogul", Description = "Unlock every hustle", Stat = "ZonesUnlockedCount", Target = 8, Reward = 500000 },
	{ Id = "BornAgain", Name = "Born Again", Description = "Rebirth once", Stat = "TotalRebirths", Target = 1, Reward = 50000 },
} :: { QuestDef }

local questsById: { [string]: QuestDef } = {}
for _, quest in GameConfig.Quests do
	questsById[quest.Id] = quest
end

function GameConfig.getQuest(questId: string): QuestDef?
	return questsById[questId]
end

----------------------------------------------------------------------
-- Data persistence
----------------------------------------------------------------------

GameConfig.Data = {
	StoreName = "SideHustleData_v1",
	SaveInterval = 120, -- seconds
	LockTimeout = 120, -- seconds before a foreign session lock is considered dead
	LockRefreshInterval = 60,
}

function GameConfig.Data.Defaults(): { [string]: any }
	return {
		DataVersion = 1,
		Cash = 0,
		CashThisLife = 0,
		Rebirths = 0,
		UnlockedZones = { GameConfig.StartingZoneId },
		Upgrades = {
			HustlePower = 0,
			WorkerEfficiency = 0,
			WalkSpeed = 0,
			WorkerSlots = 0,
		},
		Workers = {},
		Stats = {
			HustleCount = 0,
			TotalCashEarned = 0,
			WorkersHired = 0,
			ZonesUnlockedCount = 1,
			TotalRebirths = 0,
			PlayTime = 0,
		},
		ClaimedQuests = {},
		LastSeen = 0,
	}
end

----------------------------------------------------------------------
-- Sounds: asset ids the user uploads/sources themselves.
-- Leave "" to disable a sound; ClientEffects.playSound no-ops on "".
-- TODO(user): paste your sound asset ids, e.g. "rbxassetid://123456789"
----------------------------------------------------------------------

GameConfig.Sounds = {
	Coin = "", -- TODO: short coin "cha-ching" for every hustle/earn
	Buy = "", -- TODO: purchase confirm
	Error = "", -- TODO: soft "nope" for failed actions
	LevelUp = "", -- TODO: upgrade purchased sparkle sound
	Hire = "", -- TODO: crate open / worker hired
	Rebirth = "", -- TODO: big celebration fanfare
	Click = "", -- TODO: UI button click
}

return GameConfig
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="7">
        <Properties>
          <string name="Name">Types</string>
          <string name="Source"><![CDATA[--!strict
-- Shared type definitions. See ARCHITECTURE.md "Data schema".

export type WorkerEntry = {
	Uid: string,
	Id: string, -- reserved for future distinct worker characters; currently rarity id
	Rarity: string, -- "Intern" | "Employee" | "Manager" | "CEO"
	Crate: string, -- crate id the worker was hired from
	Name: string,
	Equipped: boolean,
}

export type PlayerStats = {
	HustleCount: number,
	TotalCashEarned: number,
	WorkersHired: number,
	ZonesUnlockedCount: number,
	TotalRebirths: number,
	PlayTime: number,
}

export type PlayerData = {
	DataVersion: number,
	Cash: number,
	CashThisLife: number,
	Rebirths: number,
	UnlockedZones: { string },
	Upgrades: { [string]: number },
	Workers: { WorkerEntry },
	Stats: PlayerStats,
	ClaimedQuests: { [string]: boolean },
	LastSeen: number,
}

export type ToastKind = "error" | "info" | "success"

-- A ModuleScript must return exactly one non-nil value in Roblox; scripts that
-- `require` this module for its exported types get this empty table.
return {}
]]></string>
        </Properties>
      </Item>
