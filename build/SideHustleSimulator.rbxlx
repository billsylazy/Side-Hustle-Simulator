		Upgrades = upgrades(8000, {
			{ "InsiderNewsletter", "Insider Newsletter", "+25% cash per trade" },
			{ "MarketAnalyst", "Market Analyst", "+20% XP per trade" },
			{ "HotkeyTrading", "Hotkey Trading", "-8% trade cooldown" },
