      <Item class="ModuleScript" referent="8">
        <Properties>
          <string name="Name">Mechanics</string>
          <string name="Source"><![CDATA[--!strict
-- Mechanics: PURE helpers shared by server and client (no services, no state).
-- The server resolves outcomes with these; the client renders previews with
-- the same functions so what the player sees matches what they get paid.

local GameConfig = require(script.Parent.GameConfig)

local Mechanics = {}

-- 0..1 hype/market factor for a Timing zone at a given server time
-- (workspace:GetServerTimeNow()). Smooth sine; both sides compute identically.
function Mechanics.marketFactor(zone: GameConfig.ZoneDef, serverTime: number): number
	local period = zone.MarketPeriod
	if period <= 0 then
		return 1
	end
	local phase = (serverTime % period) / period
	return (math.sin(phase * math.pi * 2) + 1) / 2
end

-- Cash multiplier for a Timing zone at a given server time.
function Mechanics.marketMult(zone: GameConfig.ZoneDef, serverTime: number): number
	local timing = GameConfig.Mechanics.Timing
	local factor = Mechanics.marketFactor(zone, serverTime)
	return timing.MinMult + (timing.MaxMult - timing.MinMult) * factor
end

-- Ring position of a zone center on the ground plane (Y = 0).
-- MapBuilder MUST place zones with this so nearestZoneId is accurate.
function Mechanics.zoneCenter(zoneOrder: number): Vector3
	local angle = math.rad((zoneOrder - 1) * GameConfig.Map.ZoneAngleStep)
	local radius = GameConfig.Map.ZoneRadius
	return Vector3.new(math.cos(angle) * radius, 0, math.sin(angle) * radius)
end

-- CFrame at a zone's center with -Z facing the plaza (origin).
function Mechanics.zoneGroundCFrame(zoneOrder: number): CFrame
	local pos = Mechanics.zoneCenter(zoneOrder)
	return CFrame.lookAt(pos, Vector3.new(0, 0, 0))
end

-- Id of the zone whose center is closest to a world position (XZ plane).
function Mechanics.nearestZoneId(position: Vector3): string
	local bestId = GameConfig.StartingZoneId
	local bestDistance = math.huge
	local flat = Vector3.new(position.X, 0, position.Z)
	for _, zone in GameConfig.Zones do
		local distance = (Mechanics.zoneCenter(zone.Order) - flat).Magnitude
		if distance < bestDistance then
			bestDistance = distance
			bestId = zone.Id
		end
	end
	return bestId
end

-- Effective cooldown for a zone given the player's upgrades table.
function Mechanics.cooldownFor(zone: GameConfig.ZoneDef, upgradesTable: any): number
	local speed = GameConfig.UpgradeEffects.Speed
	local level = GameConfig.getZoneEffectLevel(upgradesTable, zone.Id, "Speed")
	local factor = math.max(speed.MinCooldownFactor, 1 - speed.PerLevel * level)
	return zone.HustleCooldown * factor
end

-- Automation payout fraction for an Auto upgrade level (0 when level is 0).
function Mechanics.autoPercent(autoLevel: number): number
	if autoLevel <= 0 then
		return 0
	end
	local auto = GameConfig.UpgradeEffects.Auto
	return auto.BasePercent + auto.PercentPerLevel * (autoLevel - 1)
end

return Mechanics
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="9">
        <Properties>
          <string name="Name">Types</string>
          <string name="Source"><![CDATA[--!strict
-- Shared type definitions (v2). See ARCHITECTURE.md "Data schema v2".

export type WorkerEntry = {
	Uid: string,
	Id: string, -- currently the rarity id
	Rarity: string, -- "Intern" | "Employee" | "Manager" | "CEO"
	Crate: string, -- crate id the worker was hired from
	Name: string,
	Equipped: boolean,
}

export type PlayerStats = {
	HustleCount: number,
	AutoHustleCount: number,
	TotalCashEarned: number,
	WorkersHired: number,
	HighestLevel: number,
	TotalRebirths: number,
	PlayTime: number,
}

export type PlayerData = {
	DataVersion: number,
	Cash: number,
	Level: number,
	Xp: number,
	Rebirths: number,
	Upgrades: { [string]: { [string]: number } }, -- zoneId -> upgradeId -> level
	Perks: { [string]: number },
	Workers: { WorkerEntry },
	Stats: PlayerStats,
	ClaimedQuests: { [string]: boolean },
	LastSeen: number,
}

export type HustleKind = "Manual" | "Auto" | "Burst" | "Peak"

export type HustleResultPayload = {
	Amount: number,
	Xp: number,
	Kind: HustleKind,
	Mult: number,
	Combo: number?,
	Charge: number?,
	ChargeMax: number?,
}

export type ToastKind = "error" | "info" | "success"

-- A ModuleScript must return exactly one non-nil value in Roblox.
return {}
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="10">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Script" referent="11">
      <Properties>
        <string name="Name">GameManager</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[--[[
	GameManager.server.luau (v2)
	Server entry point (ARCHITECTURE.md "Service pattern"):
	1. Build the map + lighting (MapBuilder.build(), idempotent).
	2. Create every remote (RemoteService.init()).
	3. Require all 9 services, init(services) all, then start() all.
	4. Player lifecycle: load/sync on join, unload + per-service cleanup on leave.
	5. Auto-save loop every GameConfig.Data.SaveInterval.
	game:BindToClose is handled inside DataService.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GameConfig = require(ReplicatedStorage.Shared.GameConfig)

-- 1. Build the world FIRST so zones, prompts and spawns exist before any
--    service connects to them and before any player spawns.
local MapBuilder = require(script.Parent.World.MapBuilder)
MapBuilder.build()

-- 2. Remotes must exist before services register handlers against them.
local servicesFolder = script.Parent.Services
local RemoteService = require(servicesFolder.RemoteService)
RemoteService.init()

-- 3. Require all services, inject the services table, init all, start all.
--    Order matters only loosely (DataService/RemoteService first so every
--    other service's start() can register remotes and query data; LevelService
--    before the services that delegate zone-unlock queries to it).
local SERVICE_ORDER = {
	"DataService",
	"RemoteService",
	"LevelService",
	"ZoneService",
	"HustleService",
	"WorkerService",
	"UpgradeService",
	"RebirthService",
	"QuestService",
}

local services: { [string]: any } = {}
for _, name in SERVICE_ORDER do
	local moduleScript = servicesFolder:FindFirstChild(name)
	assert(moduleScript ~= nil, `[GameManager] Missing service module: Services.{name}`)
	local service = require(moduleScript)
	assert(typeof(service) == "table", `[GameManager] Services.{name} must return a table`)
	services[name] = service
end

for _, name in SERVICE_ORDER do
	local service = services[name]
	if typeof(service.init) == "function" then
		service.init(services)
	end
end

for _, name in SERVICE_ORDER do
	local service = services[name]
	if typeof(service.start) == "function" then
		service.start()
	end
end

local DataService = services.DataService

-- 4. Player lifecycle.
local function onPlayerAdded(player: Player)
	DataService.loadPlayer(player)
	DataService.sync(player)
end

local function onPlayerRemoving(player: Player)
	DataService.unloadPlayer(player)
	for _, name in SERVICE_ORDER do
		local service = services[name]
		if typeof(service.cleanupPlayer) == "function" then
			service.cleanupPlayer(player)
		end
	end
end

Players.PlayerAdded:Connect(onPlayerAdded)
Players.PlayerRemoving:Connect(onPlayerRemoving)

-- Handle players already present (Studio fast-start edge case).
for _, player in Players:GetPlayers() do
	task.spawn(onPlayerAdded, player)
end

-- 5. Auto-save loop.
task.spawn(function()
	while true do
		task.wait(GameConfig.Data.SaveInterval)
		DataService.saveAll()
	end
end)

print(`[GameManager] Side Hustle Simulator v{GameConfig.Data.Version} server ready ({#SERVICE_ORDER} services)`)
]]></string>
      </Properties>
    </Item>
    <Item class="Folder" referent="12">
      <Properties>
        <string name="Name">Services</string>
      </Properties>
      <Item class="ModuleScript" referent="13">
        <Properties>
          <string name="Name">DataService</string>
          <string name="Source"><![CDATA[--[[
	DataService.luau (v2)
	Persistence + the ONLY cash mutation API (ARCHITECTURE.md "Data schema v2").

	- DataStore GameConfig.Data.StoreName ("SideHustleData_v2"), key "Player_" .. UserId.
	- UpdateAsync-based session locking: stored value is
	  { Data = PlayerData, Lock = { JobId, SessionId, Time }? } owned by SessionId.
	- Load retry/kick flow when a foreign lock is fresh (SE-1).
	- 60s lock refresh loop for loaded players.
	- Stored Data whose DataVersion ~= GameConfig.Data.Version is replaced by
	  GameConfig.Data.Defaults() (fresh game); everything else is reconciled
	  against the v2 defaults (Upgrades is a map of per-zone tables).
	- Validation before every save; corrupt data is never written.
	- Final save on leave clears the lock; BindToClose drains in-flight saves.
	- DataService is the ONLY creator of leaderstats (Cash, Level, Rebirths IntValues).
	- XP is written by LevelService only (contract); rebirth reset by RebirthService.
]]

local Players = game:GetService("Players")
local DataStoreService = game:GetService("DataStoreService")
local HttpService = game:GetService("HttpService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GameConfig = require(ReplicatedStorage.Shared.GameConfig)
local Types = require(ReplicatedStorage.Shared.Types)

type PlayerData = Types.PlayerData

local DataService = {}

local LOAD_ATTEMPTS = 5
local LOAD_RETRY_DELAY = 2
local SAVE_ATTEMPTS = 3
local SAVE_RETRY_DELAY = 2
local SHUTDOWN_DEADLINE = 25 -- leave buffer before Roblox's 30s BindToClose hard limit

local LOCK_KICK_MESSAGE = "Your data is still saving from another server — rejoin in a minute."
local LOAD_FAIL_KICK_MESSAGE = "Failed to load your data. Please rejoin."

local dataStore = DataStoreService:GetDataStore(GameConfig.Data.StoreName)

local services: { [string]: any }? = nil
local loaded: { [Player]: PlayerData } = {}
local joinClocks: { [Player]: number } = {}
local started = false
local shuttingDown = false

-- Each load claims the lock under a unique session GUID, so a stale lock left
-- by the player's PREVIOUS session on this same server is still recognized as
-- not ours (JobId alone cannot tell the two apart on a fast same-server rejoin).
local sessionIds: { [number]: string } = {} -- UserId -> active session GUID
-- UserId -> true while that player's final (leave-time) save is in flight, so
-- a fast rejoin waits for it instead of loading a pre-save snapshot.
local savingUserIds: { [number]: boolean } = {}
-- Writes currently in flight anywhere (auto-save, leave, shutdown); BindToClose
-- holds the server open until this drains or the deadline passes.
local pendingSaves = 0

----------------------------------------------------------------------
-- Helpers
----------------------------------------------------------------------

local function keyFor(userId: number): string
	return "Player_" .. userId
end

local function isFiniteNumber(value: any): boolean
	return typeof(value) == "number"
		and value == value -- NaN check
		and value ~= math.huge
		and value ~= -math.huge
end

local function deepClone(original: { [any]: any }): { [any]: any }
	local clone = {}
	for key, value in original do
		if typeof(value) == "table" then
			clone[key] = deepClone(value)
		else
			clone[key] = value
		end
	end
	return clone
end

-- Fill missing keys recursively from the template (GameConfig.Data.Defaults()).
-- v2: Upgrades is a map zoneId -> { upgradeId -> level }; the template holds
-- one empty table per zone, so recursing creates every missing zone table.
-- A stored value whose type does not match the template (or a non-finite
-- number) is replaced by the default rather than left to block every save.
local function reconcile(data: { [any]: any }, template: { [any]: any })
	for key, default in template do
		local value = data[key]
		if typeof(default) == "table" then
			if typeof(value) ~= "table" then
				data[key] = deepClone(default)
			else
				reconcile(value, default)
			end
		elseif typeof(default) == "number" then
			if not isFiniteNumber(value) then
				data[key] = default
			end
		elseif value == nil or typeof(value) ~= typeof(default) then
			data[key] = default
		end
	end
end

-- True when every value of a table is a finite, non-negative number.
local function allNonNegativeNumbers(levels: any): boolean
	if typeof(levels) ~= "table" then
		return false
	end
	for _, level in levels do
		if not isFiniteNumber(level) or level < 0 then
			return false
		end
	end
	return true
end

-- Reject corrupt data before it ever reaches the DataStore (v2 fields).
local function validate(data: any): boolean
	if typeof(data) ~= "table" then
		return false
	end
	if not isFiniteNumber(data.Cash) or data.Cash < 0 then
		return false
	end
	if not isFiniteNumber(data.Level) or data.Level < 1 then
		return false
	end
	if not isFiniteNumber(data.Xp) or data.Xp < 0 then
		return false
	end
	if not isFiniteNumber(data.Rebirths) or data.Rebirths < 0 then
		return false
	end
	-- Upgrades: zoneId -> { upgradeId -> level }
	if typeof(data.Upgrades) ~= "table" then
		return false
	end
	for _, zoneUpgrades in data.Upgrades do
		if not allNonNegativeNumbers(zoneUpgrades) then
			return false
		end
	end
	-- Perks: perkId -> level
	if not allNonNegativeNumbers(data.Perks) then
		return false
	end
	if typeof(data.Workers) ~= "table" then
		return false
	end
	if typeof(data.Stats) ~= "table" then
		return false
	end
	for _, value in data.Stats do
		if not isFiniteNumber(value) then
			return false
		end
	end
	if typeof(data.ClaimedQuests) ~= "table" then
		return false
	end
	return true
end

local function setIntValue(parent: Instance, name: string, value: number)
	local child = parent:FindFirstChild(name)
	if child and child:IsA("IntValue") then
		child.Value = math.floor(value)
	end
end

local function updateLeaderstats(player: Player, data: PlayerData)
	local leaderstats = player:FindFirstChild("leaderstats")
	if not leaderstats then
		return
	end
	setIntValue(leaderstats, "Cash", data.Cash)
	setIntValue(leaderstats, "Level", data.Level)
	setIntValue(leaderstats, "Rebirths", data.Rebirths)
end

local function newIntValue(name: string, value: number, parent: Instance)
	local intValue = Instance.new("IntValue")
	intValue.Name = name
	intValue.Value = math.floor(value)
	intValue.Parent = parent
end

-- DataService is the ONLY creator of leaderstats.
local function createLeaderstats(player: Player, data: PlayerData)
	if player:FindFirstChild("leaderstats") then
		updateLeaderstats(player, data)
		return
	end

	local leaderstats = Instance.new("Folder")
	leaderstats.Name = "leaderstats"

	newIntValue("Cash", data.Cash, leaderstats)
	newIntValue("Level", data.Level, leaderstats)
	newIntValue("Rebirths", data.Rebirths, leaderstats)

	leaderstats.Parent = player
end

----------------------------------------------------------------------
-- DataStore writes
----------------------------------------------------------------------

-- A stored lock blocks us when it belongs to a DIFFERENT session (by GUID)
-- and is still fresh. Sessions are compared by GUID, not JobId, so a stale
-- lock from the player's previous visit to this same server never passes.
local function isForeignLock(lock: any, sessionId: string): boolean
	return typeof(lock) == "table"
		and lock.SessionId ~= sessionId
		and typeof(lock.Time) == "number"
		and os.time() - lock.Time < GameConfig.Data.LockTimeout
end

-- Write a player's data under its session GUID. Keeps the session lock unless
-- clearLock is true, and never re-asserts a lock for a session that has ended
-- meanwhile (an auto-save finishing after the leave-time save must not lock
-- the key again). Never clobbers a fresh lock owned by another session.
local function writeDataInner(userId: number, data: PlayerData, sessionId: string, clearLock: boolean): boolean
	if not validate(data) then
		warn(`[DataService] Data for user {userId} failed validation, skipping save`)
		return false
	end

	data.LastSeen = os.time()
	local key = keyFor(userId)

	for attempt = 1, SAVE_ATTEMPTS do
		local foreignLock = false
		local ok, err = pcall(function()
			dataStore:UpdateAsync(key, function(stored)
				stored = if typeof(stored) == "table" then stored else {}
				if isForeignLock(stored.Lock, sessionId) then
					foreignLock = true
					return nil -- abort: another live session owns this key
				end

				local entry: { [string]: any } = { Data = data }
				if not clearLock and sessionIds[userId] == sessionId then
					entry.Lock = { JobId = game.JobId, SessionId = sessionId, Time = os.time() }
				end
				return entry
			end)
		end)

		if foreignLock then
			warn(`[DataService] Skipped save for user {userId}: session owned elsewhere`)
			return false
		end
		if ok then
			return true
		end

		warn(`[DataService] Save attempt {attempt}/{SAVE_ATTEMPTS} failed for user {userId}: {err}`)
		if attempt < SAVE_ATTEMPTS then
			task.wait(SAVE_RETRY_DELAY)
		end
	end

	warn(`[DataService] All save retries exhausted for user {userId}`)
	return false
end

local function writeData(userId: number, data: PlayerData, sessionId: string, clearLock: boolean): boolean
	pendingSaves += 1
	local ok, result = pcall(writeDataInner, userId, data, sessionId, clearLock)
	pendingSaves -= 1
	if not ok then
		warn(`[DataService] Save for user {userId} raised: {result}`)
		return false
	end
	return result
end

-- Release this session's lock without touching Data (player left during load).
local function releaseLock(userId: number, sessionId: string)
	pcall(function()
		dataStore:UpdateAsync(keyFor(userId), function(stored)
			if typeof(stored) ~= "table" then
				return nil
			end
			local lock = stored.Lock
			if typeof(lock) ~= "table" or lock.SessionId ~= sessionId then
				return nil -- not this session's lock; leave untouched
			end
			stored.Lock = nil
			return stored
		end)
	end)
end

-- Bump Lock.Time so other servers keep seeing this session as alive.
local function refreshLock(player: Player)
	local sessionId = sessionIds[player.UserId]
	if not sessionId then
		return
	end
	local ok, err = pcall(function()
		dataStore:UpdateAsync(keyFor(player.UserId), function(stored)
			if typeof(stored) ~= "table" then
				return nil
			end
			local lock = stored.Lock
			if typeof(lock) ~= "table" or lock.SessionId ~= sessionId then
				return nil -- we lost the lock; do not fight over it
			end
			lock.Time = os.time()
			return stored
		end)
	end)
	if not ok then
		warn(`[DataService] Lock refresh failed for {player.Name}: {err}`)
	end
end

----------------------------------------------------------------------
-- Public API
----------------------------------------------------------------------

function DataService.getData(player: Player): PlayerData?
	return loaded[player]
end

function DataService.getLoadedPlayers(): { Player }
	local result: { Player } = {}
	for player in loaded do
		table.insert(result, player)
	end
	return result
end

-- Fires the full data snapshot to the client and refreshes leaderstats
-- (Cash, Level, Rebirths).
function DataService.sync(player: Player)
	local data = loaded[player]
	if not data then
		return
	end
	updateLeaderstats(player, data)
	if services and services.RemoteService then
		services.RemoteService.fireClient("DataSync", player, data)
	end
end

-- Adds to Cash and Stats.TotalCashEarned, then syncs. Server-only.
-- Pass deferSync = true only when the caller syncs right after (e.g. a
-- LevelService.addXp that follows), so one action sends one DataSync.
function DataService.addCash(player: Player, amount: number, deferSync: boolean?)
	local data = loaded[player]
	if not data then
		return
	end
	if not isFiniteNumber(amount) or amount <= 0 then
		return
	end
	data.Cash += amount
	data.Stats.TotalCashEarned += amount
	if not deferSync then
		DataService.sync(player)
	end
end

-- Returns false if the player cannot afford it. Server-only.
function DataService.spendCash(player: Player, amount: number): boolean
	local data = loaded[player]
	if not data then
		return false
	end
	if not isFiniteNumber(amount) or amount < 0 then
		return false
	end
	if data.Cash < amount then
		return false
	end
	data.Cash -= amount
	DataService.sync(player)
	return true
end

-- Claim the session lock (retrying against a fresh foreign lock), load,
-- version-check + reconcile against defaults, create leaderstats.
function DataService.loadPlayer(player: Player)
	if loaded[player] then
		return
	end

	local userId = player.UserId

	-- A leave-time save from this player's previous session on THIS server may
	-- still be in flight (it retries on DataStore errors). Wait for it so we
	-- never read the pre-save snapshot; bounded so a wedged save cannot block
	-- the join forever (the lock check below still guards correctness).
	local waitDeadline = os.clock() + SAVE_ATTEMPTS * (SAVE_RETRY_DELAY + 8)
	while savingUserIds[userId] and os.clock() < waitDeadline do
		task.wait(0.1)
	end
	if not player:IsDescendantOf(Players) then
		return
	end

	local key = keyFor(userId)
	local sessionId = HttpService:GenerateGUID(false)
	local lockBusy = false
	local storedData: any = nil
	local claimed = false

	for attempt = 1, LOAD_ATTEMPTS do
		lockBusy = false
		local ok, err = pcall(function()
			dataStore:UpdateAsync(key, function(stored)
				stored = if typeof(stored) == "table" then stored else {}
				if isForeignLock(stored.Lock, sessionId) then
					lockBusy = true
					return nil -- abort: session still owned elsewhere
				end
				stored.Lock = { JobId = game.JobId, SessionId = sessionId, Time = os.time() }
				storedData = stored.Data
				return stored
			end)
		end)

		if ok and not lockBusy then
			claimed = true
			break
		end

		if not ok then
			warn(`[DataService] Load attempt {attempt}/{LOAD_ATTEMPTS} failed for {player.Name}: {err}`)
		end
		if attempt < LOAD_ATTEMPTS then
			task.wait(LOAD_RETRY_DELAY)
		end
	end

	if not claimed then
		player:Kick(if lockBusy then LOCK_KICK_MESSAGE else LOAD_FAIL_KICK_MESSAGE)
		return
	end

	sessionIds[userId] = sessionId

	-- Player may have left during the async load: release the lock and bail.
	if not player:IsDescendantOf(Players) then
		if sessionIds[userId] == sessionId then
			sessionIds[userId] = nil
		end
		task.spawn(releaseLock, userId, sessionId)
		return
	end

	-- v2 schema: anything stored under a different DataVersion (including a
	-- v1 table with no DataVersion at all) is a fresh game.
	local data: PlayerData
	if typeof(storedData) == "table" and storedData.DataVersion == GameConfig.Data.Version then
		data = storedData :: PlayerData
	else
		if typeof(storedData) == "table" then
			warn(`[DataService] {player.Name} had DataVersion {tostring(storedData.DataVersion)}; resetting to v{GameConfig.Data.Version} defaults`)
		end
		data = GameConfig.Data.Defaults() :: PlayerData
	end
	reconcile(data :: any, GameConfig.Data.Defaults())

	loaded[player] = data
	joinClocks[player] = os.clock()
	createLeaderstats(player, data)
	print(`[DataService] Loaded data for {player.Name}`)
end

-- Fold in PlayTime, final save, clear the lock.
function DataService.unloadPlayer(player: Player)
	local data = loaded[player]
	loaded[player] = nil
	local joinedAt = joinClocks[player]
	joinClocks[player] = nil

	if not data then
		return
	end

	local userId = player.UserId
	local sessionId = sessionIds[userId]
	if not sessionId then
		return
	end

	if joinedAt then
		data.Stats.PlayTime += math.max(0, math.floor(os.clock() - joinedAt + 0.5))
	end

	-- Mark the final save in flight so a fast same-server rejoin waits for it
	-- instead of loading a stale snapshot. Clearing sessionIds first also stops
	-- any in-flight auto-save from re-asserting the lock after we clear it.
	savingUserIds[userId] = true
	sessionIds[userId] = nil
	writeData(userId, data, sessionId, true)
	savingUserIds[userId] = nil
	print(`[DataService] Unloaded data for {player.Name}`)
end

-- Auto-save every loaded player (keeps the session lock). Non-blocking.
function DataService.saveAll()
	for player, data in loaded do
		local sessionId = sessionIds[player.UserId]
		if sessionId then
			task.spawn(writeData, player.UserId, data, sessionId, false)
		end
	end
end

----------------------------------------------------------------------
-- Lifecycle
----------------------------------------------------------------------

function DataService.init(injectedServices: { [string]: any })
	services = injectedServices
end

function DataService.start()
	if started then
		return
	end
	started = true

	-- Session lock refresh loop (keeps Lock.Time fresh while we own the session).
	task.spawn(function()
		while not shuttingDown do
			task.wait(GameConfig.Data.LockRefreshInterval)
			if shuttingDown then
				break
			end
			for player in loaded do
				task.spawn(refreshLock, player)
			end
		end
	end)

	-- Shutdown: parallel final saves (clearing locks) with a deadline (SE-6).
	game:BindToClose(function()
		shuttingDown = true

		local toSave: { [Player]: PlayerData } = {}
		local total = 0
		for player, data in loaded do
			toSave[player] = data
			total += 1
		end
		if total == 0 then
			-- Nothing left to start, but saves begun from PlayerRemoving may
			-- still be in flight: drain them before letting the server close.
			local deadline = os.clock() + SHUTDOWN_DEADLINE
			while pendingSaves > 0 and os.clock() < deadline do
				task.wait(0.1)
			end
			return
		end

		local finished = 0
		for player, data in toSave do
			loaded[player] = nil
			local joinedAt = joinClocks[player]
			joinClocks[player] = nil
			local userId = player.UserId
			local sessionId = sessionIds[userId]
			sessionIds[userId] = nil
			task.spawn(function()
				if joinedAt then
					data.Stats.PlayTime += math.max(0, math.floor(os.clock() - joinedAt + 0.5))
				end
				if sessionId then
					writeData(userId, data, sessionId, true)
				end
				finished += 1
			end)
		end

		-- Hold the server open for this batch AND for saves already in flight
		-- elsewhere (a PlayerRemoving final save, a late auto-save) until they
		-- commit or the deadline passes.
		local deadline = os.clock() + SHUTDOWN_DEADLINE
		while (finished < total or pendingSaves > 0) and os.clock() < deadline do
			task.wait(0.1)
		end

		if finished < total then
			warn(`[DataService] Shutdown saved {finished}/{total} players before the deadline`)
		else
			print(`[DataService] Shutdown save complete ({total} players)`)
		end
	end)
end

return DataService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="14">
        <Properties>
          <string name="Name">HustleService</string>
          <string name="Source"><![CDATA[-- HustleService: the core "hustle" action via each zone's HustleStation
-- ProximityPrompt, the four mechanics, cash/XP grants and the automation tick.
-- Contract: ARCHITECTURE.md "Earnings, XP and mechanics" + "Map contract".
--
-- Per zone: base = zone.HustleEarn, xpBase = zone.XpPerHustle, U = data.Upgrades[zoneId]
--   earnMult = 1 + Earn.PerLevel * U[Earn], xpMult = 1 + Xp.PerLevel * U[Xp]
--   cooldown = Mechanics.cooldownFor(zone, data.Upgrades)
--   manualCash = floor(base * earnMult * mechMult * rebirthCash)
--   manualXp   = floor(xpBase * xpMult * mechXpMult * rebirthXp)
-- Mechanics (all resolved HERE, never on the client):
--   Tap    - combo stacks while hits land within ComboWindow of the last ACCEPTED hit
--   Hold   - one hit per completed hold (prompt HoldDuration), mechMult = Hold.PayoutMult
--   Timing - shared server clock, mechMult = Mechanics.marketMult; >= PeakThreshold = "Peak"
--   Charge - every hit pays HitPercent of manual; the ChargeMax-th hit is the "Burst"
-- Automation: every Auto.Interval seconds each unlocked zone with Auto level > 0 pays
--   floor(manualCash_noMech * autoPercent) cash + the same fraction of XP, Kind "Auto".
-- Server-authoritative: validates data loaded, zone unlocked by level, distance
-- (< 20 studs from the prompt part) and per-player per-zone cooldown.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local GameConfig = require(ReplicatedStorage.Shared.GameConfig)
local Mechanics = require(ReplicatedStorage.Shared.Mechanics)
local Types = require(ReplicatedStorage.Shared.Types)

type HustleResultPayload = Types.HustleResultPayload
type PlayerData = Types.PlayerData

local HustleService = {}

-- Injected via init(services) -- never require sibling services directly.
local DataService
local RemoteService
local LevelService
local ZoneService

local started = false

local MAX_PROMPT_DISTANCE = 20 -- studs; re-validated server-side per contract
local LOCKED_TOAST_THROTTLE = 2 -- seconds between "locked zone" toasts, per player
local MAP_WAIT_TIMEOUT = 30 -- MapBuilder runs before start(); this is a safety net
local CHILD_WAIT_TIMEOUT = 5

-- Per-player per-zone mechanic state. lastHit doubles as the cooldown stamp:
-- it only ever records ACCEPTED hits, so an early (ignored) tap can neither
-- reset a combo nor extend a cooldown.
type ZoneState = {
	lastHit: number, -- os.clock() of the last accepted hit (0 = never)
	combo: number, -- Tap zones: current stack, 0..ComboMax
	charge: number, -- Charge zones: hits banked toward the next burst
}

-- Player -> zoneId -> ZoneState; cleared in cleanupPlayer.
local zoneStates: { [Player]: { [string]: ZoneState } } = {}
-- Player -> os.clock() of the last "locked zone" toast (throttle).
local lockedToastAt: { [Player]: number } = {}
-- Mechanic names we already warned about (unknown zone.Mechanic strings).
local warnedMechanics: { [string]: boolean } = {}

----------------------------------------------------------------------
-- Helpers
----------------------------------------------------------------------

-- Payouts round to nearest: flooring small bases (Lemonade's $5) would make
-- the first +25% upgrade and early combo stacks pay exactly nothing extra.
local function round(x: number): number
	return math.floor(x + 0.5)
end

local function toast(player: Player, message: string, kind: string)
	RemoteService.fireClient("Toast", player, message, kind)
end

local function fireHustleResult(player: Player, zoneId: string, payload: HustleResultPayload)
	RemoteService.fireClient("HustleResult", player, zoneId, payload)
end

local function getZoneState(player: Player, zoneId: string): ZoneState
	local perPlayer = zoneStates[player]
	if not perPlayer then
		perPlayer = {}
		zoneStates[player] = perPlayer
	end
	local state = perPlayer[zoneId]
	if not state then
		state = { lastHit = 0, combo = 0, charge = 0 }
		perPlayer[zoneId] = state
	end
	return state
end

-- Upgrade/rebirth multipliers for one zone (everything except the mechanic).
local function getZoneMultipliers(data: PlayerData, zoneId: string): (number, number, number, number)
	local effects = GameConfig.UpgradeEffects
	local earnLevel = GameConfig.getZoneEffectLevel(data.Upgrades, zoneId, "Earn")
	local xpLevel = GameConfig.getZoneEffectLevel(data.Upgrades, zoneId, "Xp")
	local earnMult = 1 + effects.Earn.PerLevel * earnLevel
	local xpMult = 1 + effects.Xp.PerLevel * xpLevel
	local rebirthCash = GameConfig.getRebirthCashMultiplier(data.Rebirths)
	local rebirthXp = GameConfig.getRebirthXpMultiplier(data.Rebirths)
	return earnMult, xpMult, rebirthCash, rebirthXp
end

-- manualCash / manualXp for a zone at the given mechanic multipliers.
local function computeManual(zone: GameConfig.ZoneDef, data: PlayerData, mechMult: number, mechXpMult: number): (number, number)
	local earnMult, xpMult, rebirthCash, rebirthXp = getZoneMultipliers(data, zone.Id)
	local cash = round(zone.HustleEarn * earnMult * mechMult * rebirthCash)
	local xp = round(zone.XpPerHustle * xpMult * mechXpMult * rebirthXp)
	return math.max(0, cash), math.max(0, xp)
end

-- Resolves the zone's mechanic for one accepted hit: mutates the per-zone
-- state and returns the full HustleResult payload (Amount/Xp included).
local function resolveMechanic(zone: GameConfig.ZoneDef, data: PlayerData, state: ZoneState, now: number): HustleResultPayload
	local mechanic = zone.Mechanic
	local params = GameConfig.Mechanics

	if mechanic == "Tap" then
		local tap = params.Tap
		-- Combo continues only when this hit lands within ComboWindow of the
		-- previous ACCEPTED hit; a first-ever hit (lastHit = 0) starts at 0.
		if state.lastHit > 0 and now - state.lastHit <= tap.ComboWindow then
			state.combo = math.min(state.combo + 1, tap.ComboMax)
		else
			state.combo = 0
		end
		local mechMult = 1 + tap.ComboBonusPerStack * state.combo
		local cash, xp = computeManual(zone, data, mechMult, 1)
		return {
			Amount = cash,
			Xp = xp,
			Kind = "Manual",
			Mult = mechMult,
			Combo = state.combo,
		}
	elseif mechanic == "Timing" then
		local timing = params.Timing
		-- Shared clock: the client previews the same curve with the same function.
		local marketMult = Mechanics.marketMult(zone, Workspace:GetServerTimeNow())
		local isPeak = marketMult >= timing.PeakThreshold
		-- Peak flips build a streak (stored in state.combo) that multiplies
		-- cash and XP; an off-peak flip sells cheap and resets it, so timing
		-- beats spamming at every cooldown.
		local mechMult: number
		local mechXpMult: number
		if isPeak then
			state.combo = math.min(state.combo + 1, timing.StreakMax)
			local streakMult = 1 + timing.StreakBonusPerStack * (state.combo - 1)
			mechMult = marketMult * streakMult
			mechXpMult = (1 + timing.PeakXpBonus) * streakMult
		else
			state.combo = 0
			mechMult = marketMult * timing.OffPeakMult
			mechXpMult = timing.OffPeakMult
		end
		local cash, xp = computeManual(zone, data, mechMult, mechXpMult)
		return {
			Amount = cash,
			Xp = xp,
			Kind = if isPeak then "Peak" else "Manual",
			Mult = mechMult,
			Combo = state.combo,
		}
	elseif mechanic == "Charge" then
		local charge = params.Charge
		local chargeMax = math.max(1, zone.ChargeMax)
		local manualCash, manualXp = computeManual(zone, data, 1, 1)
		state.charge += 1
		if state.charge >= chargeMax then
			-- The ChargeMax-th hit IS the burst: it pays the burst instead of a
			-- partial hit, then the bar empties.
			state.charge = 0
			local burstMult = chargeMax * charge.BurstMult
			return {
				Amount = round(manualCash * burstMult),
				Xp = round(manualXp * chargeMax * (1 + charge.BurstXpBonus)),
				Kind = "Burst",
				Mult = burstMult,
				Charge = 0,
				ChargeMax = chargeMax,
			}
		end
		return {
			Amount = round(manualCash * charge.HitPercent),
			Xp = round(manualXp * charge.HitPercent),
			Kind = "Manual",
			Mult = 1,
			Charge = state.charge,
			ChargeMax = chargeMax,
		}
	end

	-- Hold (and any unknown mechanic, which degrades to a plain hit).
	if mechanic ~= "Hold" and not warnedMechanics[mechanic] then
		warnedMechanics[mechanic] = true
		warn("[HustleService] Unknown Mechanic '" .. tostring(mechanic) .. "' on zone " .. zone.Id .. "; treating as Hold")
	end
	local mechMult = if mechanic == "Hold" then params.Hold.PayoutMult else 1
	local cash, xp = computeManual(zone, data, mechMult, 1)
	return {
		Amount = cash,
		Xp = xp,
		Kind = "Manual",
		Mult = mechMult,
	}
end

----------------------------------------------------------------------
-- Manual hustle (ProximityPrompt.Triggered)
----------------------------------------------------------------------

local function onHustleTriggered(zone: GameConfig.ZoneDef, promptPart: BasePart, player: Player)
	-- Data must be loaded.
	local data = DataService.getData(player)
	if not data then
		return
	end

	-- Zone must be unlocked by level. Locked-zone prompts stay visible on the
	-- client (ProximityPrompt.Enabled cannot be set per-player), so the server
	-- is the real gate: reject + toast, throttled to one toast per 2 s per player.
	if not ZoneService.isZoneUnlocked(player, zone.Id) then
		local now = os.clock()
		if now - (lockedToastAt[player] or 0) >= LOCKED_TOAST_THROTTLE then
			lockedToastAt[player] = now
			toast(player, "Reach level " .. zone.UnlockLevel .. " to unlock " .. zone.Name .. "!", "error")
		end
		return
	end

	-- Re-validate distance server-side (< 20 studs), per contract.
	local character = player.Character
	local rootPart = character and character:FindFirstChild("HumanoidRootPart")
	if not rootPart or not rootPart:IsA("BasePart") then
		return
	end
	if (rootPart.Position - promptPart.Position).Magnitude >= MAX_PROMPT_DISTANCE then
		return
	end

	-- Per-player, per-zone cooldown (Speed upgrade shortens it); early
	-- triggers are silently ignored and leave the mechanic state untouched.
	local state = getZoneState(player, zone.Id)
	local now = os.clock()
	local cooldown = Mechanics.cooldownFor(zone, data.Upgrades)
	if zone.Mechanic == "Hold" then
		-- HoldPromptController stretches the local hold to the full cooldown,
		-- so trigger-to-trigger is already >= cooldown on the client; this
		-- grace only absorbs network jitter between the two triggers.
		cooldown = math.max(0, cooldown - GameConfig.Mechanics.Hold.TriggerGrace)
	end
	if state.lastHit > 0 and now - state.lastHit < cooldown then
		return
	end

	-- All checks passed: resolve the mechanic, then stamp this accepted hit.
	local payload = resolveMechanic(zone, data, state, now)
	state.lastHit = now

	-- Bump the lifetime stat before addCash so the DataSync snapshot that
	-- addCash fires already carries the new HustleCount (quests read it).
	data.Stats.HustleCount += 1
	if payload.Amount > 0 then
		-- addXp below syncs, so skip addCash's own sync when XP follows.
		DataService.addCash(player, payload.Amount, payload.Xp > 0)
	end
	if payload.Xp > 0 then
		LevelService.addXp(player, payload.Xp)
	end
	if payload.Amount <= 0 and payload.Xp <= 0 then
		DataService.sync(player)
	end

	-- Client plays money popup / combo / peak / burst juice off this.
	fireHustleResult(player, zone.Id, payload)
end

-- Resolves one zone's hustle prompt and connects it. Each step uses
-- WaitForChild with a timeout and warns + skips on failure, so one missing
-- part never kills the server or the other zones.
local function connectHustleStation(zonesFolder: Instance, zone: GameConfig.ZoneDef)
	local zoneModel = zonesFolder:WaitForChild(zone.Id, CHILD_WAIT_TIMEOUT)
	if not zoneModel then
		warn("[HustleService] Zone model missing for " .. zone.Id .. "; hustle prompt skipped")
		return
	end

	local station = zoneModel:WaitForChild("HustleStation", CHILD_WAIT_TIMEOUT)
	if not station then
		warn("[HustleService] HustleStation missing for zone " .. zone.Id .. "; hustle prompt skipped")
		return
	end

	local promptPart = station:WaitForChild("PromptPart", CHILD_WAIT_TIMEOUT)
	if not promptPart or not promptPart:IsA("BasePart") then
		warn("[HustleService] HustleStation PromptPart missing for zone " .. zone.Id .. "; hustle prompt skipped")
		return
	end

	local prompt = promptPart:WaitForChild("HustlePrompt", CHILD_WAIT_TIMEOUT)
	if not prompt or not prompt:IsA("ProximityPrompt") then
		warn("[HustleService] HustlePrompt missing for zone " .. zone.Id .. "; hustle prompt skipped")
		return
	end

	-- Prompt connections live for the server's lifetime; per-player state is
	-- cleared in cleanupPlayer instead.
	prompt.Triggered:Connect(function(player: Player)
		onHustleTriggered(zone, promptPart, player)
	end)
end

----------------------------------------------------------------------
-- Automation tick
----------------------------------------------------------------------

-- One automation tick for one player: cash for ALL zones first (one addCash
-- -> one DataSync), then XP once with the total (one addXp -> one sync, plus
-- any level-ups), then one HustleResult per zone so the client can float a
-- "+$50" at each station.
local function tickAutomationFor(player: Player)
	local data = DataService.getData(player)
	if not data then
		return
	end

	local totalCash = 0
	local totalXp = 0
	local zonesTicked = 0
	local results: { { zoneId: string, payload: HustleResultPayload } } = {}

	for _, zone in GameConfig.Zones do
		local autoLevel = GameConfig.getZoneEffectLevel(data.Upgrades, zone.Id, "Auto")
		if autoLevel > 0 and LevelService.isZoneUnlocked(player, zone.Id) then
			local percent = Mechanics.autoPercent(autoLevel)
			local manualCash, manualXp = computeManual(zone, data, 1, 1)
			local amount = round(manualCash * percent)
			local xp = round(manualXp * percent)
			totalCash += amount
			totalXp += xp
			zonesTicked += 1
			table.insert(results, {
				zoneId = zone.Id,
				payload = {
					Amount = amount,
					Xp = xp,
					Kind = "Auto",
					Mult = 1,
				},
			})
		end
	end

	if zonesTicked == 0 then
		return
	end

	-- Stat first so the snapshot addCash fires already carries it.
	data.Stats.AutoHustleCount += zonesTicked
	if totalCash > 0 then
		DataService.addCash(player, totalCash, totalXp > 0)
	end
	if totalXp > 0 then
		LevelService.addXp(player, totalXp)
	end
	if totalCash <= 0 and totalXp <= 0 then
		-- Nothing else synced the stat bump; keep the client honest.
		DataService.sync(player)
	end

	for _, result in results do
		fireHustleResult(player, result.zoneId, result.payload)
	end
end

local function automationLoop()
	local interval = GameConfig.UpgradeEffects.Auto.Interval
	while true do
		task.wait(interval)
		for _, player in DataService.getLoadedPlayers() do
			-- One player's failure must never stall everyone else's rigs.
			local ok, err = pcall(tickAutomationFor, player)
			if not ok then
				warn("[HustleService] Automation tick failed for " .. player.Name .. ": " .. tostring(err))
			end
		end
	end
end

----------------------------------------------------------------------
-- Public API
----------------------------------------------------------------------

-- What ONE plain manual hit (mechMult 1) in this zone pays the player right
-- now, plus the effective cooldown. nil when the zone is unknown or the
-- player's data is not loaded. For UI/debug use.
function HustleService.getManualPreview(player: Player, zoneId: string): { Cash: number, Xp: number, Cooldown: number }?
	local zone = GameConfig.getZone(zoneId)
	if not zone then
		return nil
	end
	local data = DataService.getData(player)
	if not data then
		return nil
	end
	local cash, xp = computeManual(zone, data, 1, 1)
	return {
		Cash = cash,
		Xp = xp,
		Cooldown = Mechanics.cooldownFor(zone, data.Upgrades),
	}
end

----------------------------------------------------------------------
-- Lifecycle
----------------------------------------------------------------------

function HustleService.init(services: { [string]: any })
	DataService = services.DataService
	RemoteService = services.RemoteService
	LevelService = services.LevelService
	ZoneService = services.ZoneService
end

function HustleService.start()
	if started then
		return
	end
	started = true

	-- Automation runs regardless of whether the map resolved: it pays from
	-- data, not from world instances.
	task.spawn(automationLoop)

	local map = Workspace:WaitForChild("SideHustleMap", MAP_WAIT_TIMEOUT)
	if not map then
		warn("[HustleService] Workspace.SideHustleMap missing; no hustle prompts connected")
		return
	end

	local zonesFolder = map:WaitForChild("Zones", CHILD_WAIT_TIMEOUT)
	if not zonesFolder then
		warn("[HustleService] SideHustleMap.Zones missing; no hustle prompts connected")
		return
	end

	-- EVERY zone has a hustle station, including the free starting zone.
	for _, zone in GameConfig.Zones do
		task.spawn(connectHustleStation, zonesFolder, zone)
	end
end

function HustleService.cleanupPlayer(player: Player)
	zoneStates[player] = nil
	lockedToastAt[player] = nil
end

return HustleService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="15">
        <Properties>
          <string name="Name">LevelService</string>
          <string name="Source"><![CDATA[-- LevelService: XP + levels (ARCHITECTURE.md "Levels").
-- The ONLY writer of data.Xp / data.Level outside RebirthService's reset.
--   addXp(player, amount): Xp += amount; while Xp >= need and Level < MaxLevel:
--     Xp -= need, Level += 1, Stats.HighestLevel high-water mark, fire
--     LevelUp(newLevel, unlockedZoneId or nil) + Toast per level gained.
--     At MaxLevel XP is capped at need - 1. One DataService.sync at the end.
--   Zone unlock state is DERIVED: unlocked <=> data.Level >= zone.UnlockLevel.
-- WalkSpeed is untouched here (perks own it); level-ups never change it.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GameConfig = require(ReplicatedStorage.Shared.GameConfig)

local LevelService = {}

-- Injected via init(services) -- never require sibling services directly.
local DataService
local RemoteService

local started = false

----------------------------------------------------------------------
-- Helpers
----------------------------------------------------------------------

local function isFiniteNumber(value: any): boolean
	return typeof(value) == "number"
		and value == value -- NaN check
		and value ~= math.huge
		and value ~= -math.huge
end

local function toast(player: Player, message: string, kind: string)
	RemoteService.fireClient("Toast", player, message, kind)
end

-- Announces ONE gained level: LevelUp remote (with the zone that unlocks
-- exactly at this level, if any) and a success Toast.
local function announceLevel(player: Player, newLevel: number)
	local unlockedZone = GameConfig.getZoneUnlockedAtLevel(newLevel)
	local unlockedZoneId: string? = if unlockedZone then unlockedZone.Id else nil

	RemoteService.fireClient("LevelUp", player, newLevel, unlockedZoneId)

	if unlockedZone then
		toast(player, "Level " .. newLevel .. " - " .. unlockedZone.Name .. " unlocked!", "success")
	else
		toast(player, "Level " .. newLevel .. "!", "success")
	end
end

----------------------------------------------------------------------
-- Public API
----------------------------------------------------------------------

-- Grants XP and resolves every level-up it causes. Safe to call with any
-- amount: non-finite or non-positive amounts are ignored.
function LevelService.addXp(player: Player, amount: number)
	local data = DataService.getData(player)
	if not data then
		return
	end
	if not isFiniteNumber(amount) or amount <= 0 then
		return
	end

	local maxLevel = GameConfig.Levels.MaxLevel
	data.Xp += amount

	-- Multi-level loop: a single big grant (burst, auto tick) may cross
	-- several thresholds; each one fires its own LevelUp + Toast.
	local gainedLevels: { number } = {}
	while data.Level < maxLevel do
		local need = GameConfig.getXpForLevel(data.Level)
		if data.Xp < need then
			break
		end
		data.Xp -= need
		data.Level += 1
		table.insert(gainedLevels, data.Level)
	end

	-- At MaxLevel the bar can fill but never roll over.
	if data.Level >= maxLevel then
		data.Level = maxLevel
		local need = GameConfig.getXpForLevel(maxLevel)
		data.Xp = math.clamp(data.Xp, 0, math.max(0, need - 1))
	end

	if #gainedLevels > 0 then
		data.Stats.HighestLevel = math.max(data.Stats.HighestLevel or 1, data.Level)
		for _, newLevel in gainedLevels do
			announceLevel(player, newLevel)
		end
	end

	-- One snapshot per grant, after every level-up has been resolved, so the
	-- client's DataSync already carries the final Level/Xp/HighestLevel.
	DataService.sync(player)
end

-- Current level; 0 when the player's data is not loaded (so gates stay shut).
function LevelService.getLevel(player: Player): number
	local data = DataService.getData(player)
	if not data then
		return 0
	end
	return data.Level
end

-- unlocked <=> Level >= zone.UnlockLevel (unknown zone / unloaded data -> false).
function LevelService.isZoneUnlocked(player: Player, zoneId: string): boolean
	local data = DataService.getData(player)
	if not data then
		return false
	end
	return GameConfig.isZoneUnlockedAtLevel(zoneId, data.Level)
end

-- XP still needed to reach the next level (0 at MaxLevel or when unloaded).
function LevelService.xpToNext(player: Player): number
	local data = DataService.getData(player)
	if not data then
		return 0
	end
	if data.Level >= GameConfig.Levels.MaxLevel then
		return 0
	end
	local need = GameConfig.getXpForLevel(data.Level)
	return math.max(0, need - data.Xp)
end

----------------------------------------------------------------------
-- Lifecycle
----------------------------------------------------------------------

function LevelService.init(services: { [string]: any })
	DataService = services.DataService
	RemoteService = services.RemoteService
end

function LevelService.start()
	if started then
		return
	end
	started = true
	-- Stateless beyond player data; nothing to schedule.
end

function LevelService.cleanupPlayer(_player: Player)
	-- No per-player runtime state: everything lives in DataService's PlayerData.
end

return LevelService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="16">
        <Properties>
          <string name="Name">QuestService</string>
          <string name="Source"><![CDATA[-- QuestService (v2): one-time quest claiming. Progress is never tracked here --
-- quests read the lifetime Stats that other services already maintain via
-- quest.Stat, which must be one of the v2 stat names (HustleCount,
-- AutoHustleCount, TotalCashEarned, WorkersHired, HighestLevel, TotalRebirths),
-- so the client renders progress straight from DataSync and the server only
-- validates claims. Stats survive rebirth, so claimed quests stay claimed.
-- Contract: ARCHITECTURE.md "Remotes" + GameConfig.Quests.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GameConfig = require(ReplicatedStorage.Shared.GameConfig)

local QuestService = {}

-- Injected via init(services) -- never require sibling services directly.
local DataService
local RemoteService

local started = false

----------------------------------------------------------------------
-- Helpers
----------------------------------------------------------------------

local function toast(player: Player, message: string, kind: string)
	RemoteService.fireClient("Toast", player, message, kind)
end

-- Progress for a quest from the lifetime Stats table (missing/corrupt -> 0).
-- Generic over quest.Stat so adding a v2 stat name in GameConfig needs no
-- change here.
local function questProgress(data: any, quest: GameConfig.QuestDef): number
	local stats = data.Stats
	if typeof(stats) ~= "table" then
		return 0
	end
	local progress = stats[quest.Stat]
	return if typeof(progress) == "number" then progress else 0
end

----------------------------------------------------------------------
-- Remote handler
----------------------------------------------------------------------

local function onClaimQuest(player: Player, questId: string)
	-- Data must be loaded.
	local data = DataService.getData(player)
	if not data then
		return
	end

	-- Existence re-checked here even though the validator already did (defense
	-- in depth; the handler must stand on its own).
	local quest = GameConfig.getQuest(questId)
	if not quest then
		return
	end

	-- One-time only. A legit client disables claimed rows, so drop silently.
	if data.ClaimedQuests[questId] then
		return
	end

	-- Progress comes from lifetime Stats (survive rebirth).
	if questProgress(data, quest) < quest.Target then
		toast(player, "Quest not complete yet!", "error")
		return
	end

	-- Mark claimed BEFORE paying out so a re-entrant claim can never double-pay.
	data.ClaimedQuests[questId] = true
	DataService.addCash(player, quest.Reward)
	toast(player, "Quest complete: +$" .. quest.Reward .. "!", "success")
	DataService.sync(player)
end

----------------------------------------------------------------------
-- Lifecycle
----------------------------------------------------------------------

function QuestService.init(services: { [string]: any })
	DataService = services.DataService
	RemoteService = services.RemoteService
end

function QuestService.start()
	if started then
		return
	end
	started = true

	-- Cooldown per the ARCHITECTURE.md remotes table; RemoteService adds
	-- rate limiting and violation kicks on top.
	RemoteService.register({
		Name = "ClaimQuest",
		Cooldown = 0.3,
		Validator = function(_player: Player, questId: any): (boolean, string?)
			if typeof(questId) ~= "string" then
				return false, "questId must be a string"
			end
			if GameConfig.getQuest(questId) == nil then
				return false, "unknown questId"
			end
			return true
		end,
		Handler = onClaimQuest,
	})
end

function QuestService.cleanupPlayer(_player: Player)
	-- No per-player state here: cooldown/rate bookkeeping is owned by
	-- RemoteService, claim state by DataService. Kept for the uniform shape.
end

return QuestService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="17">
        <Properties>
          <string name="Name">RebirthService</string>
          <string name="Source"><![CDATA[-- RebirthService (v2): level-gated rebirth validation, reset and multiplier
-- queries. Contract: ARCHITECTURE.md "Rebirth" + "Remotes".
-- Requires Level >= GameConfig.Rebirth.RequiredLevel and Rebirths < MaxRebirths.
-- Rebirth RESETS: Cash, Level, Xp, Upgrades (fresh per-zone empty tables),
-- Perks (all 0), WalkSpeed back to base, workers unequipped beyond the base cap.
-- KEEPS: Workers, Stats, ClaimedQuests. Rebirths += 1, Stats.TotalRebirths += 1.
-- C->S traffic goes through RemoteService.register (RequestRebirth, 2 s
-- cooldown, no args); result goes back on the RebirthResult RemoteEvent:
--   "SUCCESS", newRebirths, cashMult   |   "INSUFFICIENT", requiredLevel

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GameConfig = require(ReplicatedStorage.Shared.GameConfig)

local RebirthService = {}

-- Injected via init(services) -- never require sibling services directly.
local DataService
local RemoteService

local started = false

-- Fires a S->C RemoteEvent to one player via RemoteService.fireClient(name,
-- player, ...); falls back to the contract-pinned ReplicatedStorage.Remotes
-- folder so player feedback never silently drops.
local function fireClient(player: Player, remoteName: string, ...: any)
	if RemoteService ~= nil and typeof(RemoteService.fireClient) == "function" then
		RemoteService.fireClient(remoteName, player, ...)
		return
	end
	local remotes = ReplicatedStorage:FindFirstChild("Remotes")
	local remote = remotes and remotes:FindFirstChild(remoteName)
	if remote and remote:IsA("RemoteEvent") then
		remote:FireClient(player, ...)
	end
end

local function onRequestRebirth(player: Player)
	-- Data must be loaded.
	local data = DataService.getData(player)
	if not data then
		return
	end

	local requiredLevel = GameConfig.Rebirth.RequiredLevel
	local level = if typeof(data.Level) == "number" then data.Level else 1

	-- Must be below the rebirth cap and have reached the required level.
	if data.Rebirths >= GameConfig.Rebirth.MaxRebirths or level < requiredLevel then
		fireClient(player, "RebirthResult", "INSUFFICIENT", requiredLevel)
		return
	end

	-- Apply the reset (see header). This is the contract's carve-out: the
	-- rebirth reset may assign data fields directly, then DataService.sync.
	local defaults = GameConfig.Data.Defaults()
	data.Cash = 0
	data.Level = 1
	data.Xp = 0
	data.Upgrades = defaults.Upgrades -- fresh per-zone empty tables
	data.Perks = defaults.Perks -- WalkSpeed / WorkerSlots / WorkerEfficiency = 0
	data.Rebirths += 1
	data.Stats.TotalRebirths += 1

	-- WorkerSlots just reset to 0, so the equip cap shrank back to the base.
	-- Unequip any workers beyond the new cap or they would keep earning
	-- against a cap the player no longer owns (WorkerService also clamps the
	-- income tick defensively, but the data should be honest too).
	local cap = GameConfig.Workers.BaseEquipSlots
	local equipped = 0
	for _, worker in data.Workers do
		if worker.Equipped then
			equipped += 1
			if equipped > cap then
				worker.Equipped = false
			end
		end
	end

	-- WalkSpeed perk just reset to level 0 -> back to base walk speed.
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		humanoid.WalkSpeed = GameConfig.BaseWalkSpeed
	end

	-- Push the fresh snapshot; sync also refreshes leaderstats (Cash, Level, Rebirths).
	DataService.sync(player)

	-- RebirthWatcher plays the full-screen celebration off this.
	fireClient(
		player,
		"RebirthResult",
		"SUCCESS",
		data.Rebirths,
		GameConfig.getRebirthCashMultiplier(data.Rebirths)
	)
end

function RebirthService.init(services: { [string]: any })
	DataService = services.DataService
	RemoteService = services.RemoteService
end

function RebirthService.start()
	if started then
		return
	end
	started = true

	-- RemoteService.register handles type validation, the per-remote cooldown
	-- (2 s, per the remotes table), rate limiting and violation kicks.
	RemoteService.register({
		Name = "RequestRebirth",
		Cooldown = 2,
		Handler = onRequestRebirth,
	})
end

-- cashMult = 1 + GameConfig.Rebirth.CashBonusPerRebirth * rebirths.
-- Delegates to GameConfig so there is exactly one source of truth.
function RebirthService.getCashMultiplier(rebirths: number): number
	return GameConfig.getRebirthCashMultiplier(rebirths)
end

-- xpMult = 1 + GameConfig.Rebirth.XpBonusPerRebirth * rebirths.
function RebirthService.getXpMultiplier(rebirths: number): number
	return GameConfig.getRebirthXpMultiplier(rebirths)
end

-- True when the player could rebirth right now (UI/other services may ask).
function RebirthService.canRebirth(player: Player): boolean
	local data = DataService.getData(player)
	if not data then
		return false
	end
	return data.Rebirths < GameConfig.Rebirth.MaxRebirths and data.Level >= GameConfig.Rebirth.RequiredLevel
end

function RebirthService.cleanupPlayer(_player: Player)
	-- No per-player state here: the RequestRebirth cooldown bookkeeping is
	-- owned by RemoteService. Kept for the uniform service module shape.
end

return RebirthService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="18">
        <Properties>
          <string name="Name">RemoteService</string>
          <string name="Source"><![CDATA[--[[
	RemoteService.luau
	Creates ReplicatedStorage.Remotes and every remote named in ARCHITECTURE.md,
	and wraps all C->S handlers with validation, per-remote cooldown, rate
	limiting (timestamps pruned over a 10s window) and violation kicks (SE-5).

	Usage from other services (in start()):
		services.RemoteService.register({
			Name = "BuyUpgrade",
			Cooldown = 0.3,
			Validator = function(player, upgradeId)
				return typeof(upgradeId) == "string", "upgradeId must be a string"
			end,
			Handler = function(player, upgradeId)
				...
			end,
		})
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local RemoteService = {}

export type RemoteConfig = {
	Name: string,
	Handler: (player: Player, ...any) -> (),
	-- Return false (optionally with a reason) to reject; rejections count as violations.
	Validator: ((player: Player, ...any) -> (boolean, string?))?,
	Cooldown: number?, -- seconds between accepted fires (default 0 = none)
	RateLimit: number?, -- max fires per RATE_WINDOW (default DEFAULT_MAX_PER_WINDOW)
}

local RATE_WINDOW = 10 -- seconds
-- Generous enough that honest button-mashing (e.g. equip spam at the 0.2 s
-- cooldown) never accrues violations; the cooldown runs first and absorbs it.
local DEFAULT_MAX_PER_WINDOW = 60
local KICK_AFTER_VIOLATIONS = 5

-- Every remote in the ARCHITECTURE.md table. All are RemoteEvents.
local REMOTE_NAMES = {
	-- S -> C
	"DataSync",
	"HustleResult",
	"LevelUp",
	"Toast",
	"WorkerHired",
	"RebirthResult",
	-- C -> S
	"HireWorker",
	"EquipWorker",
	"UnequipWorker",
	"BuyUpgrade",
	"BuyPerk",
	"RequestRebirth",
	"ClaimQuest",
}

local initialized = false
local remotes: { [string]: RemoteEvent } = {}

-- Per-player, per-remote request timestamps within the rate window.
local rateTimestamps: { [Player]: { [string]: { number } } } = {}
-- Per-player, per-remote time of the last accepted fire.
local lastAccepted: { [Player]: { [string]: number } } = {}
-- Per-player violation counts (rate limit breaches + validator failures).
local violations: { [Player]: number } = {}

----------------------------------------------------------------------
-- Internals
----------------------------------------------------------------------

local function recordViolation(player: Player, remoteName: string, reason: string)
	local count = (violations[player] or 0) + 1
	violations[player] = count
	warn(`[RemoteService] {player.Name} violation #{count} on "{remoteName}": {reason}`)
	if count >= KICK_AFTER_VIOLATIONS then
		task.defer(function()
			player:Kick("Too many bad requests. Please rejoin.")
		end)
	end
end

local function checkRateLimit(player: Player, remoteName: string, maxPerWindow: number): boolean
	local now = os.clock()

	local perPlayer = rateTimestamps[player]
	if not perPlayer then
		perPlayer = {}
		rateTimestamps[player] = perPlayer
	end

	local timestamps = perPlayer[remoteName]
	if not timestamps then
		timestamps = {}
		perPlayer[remoteName] = timestamps
	end

	-- Prune timestamps that fell out of the window.
	local windowStart = now - RATE_WINDOW
	local pruned: { number } = {}
	for _, ts in timestamps do
		if ts > windowStart then
			table.insert(pruned, ts)
		end
	end
	perPlayer[remoteName] = pruned

	if #pruned >= maxPerWindow then
		recordViolation(player, remoteName, "rate limit exceeded")
		return false
	end

	table.insert(pruned, now)
	return true
end

-- Cooldown misses are dropped silently (double-clicks are not malicious).
local function checkCooldown(player: Player, remoteName: string, cooldown: number): boolean
	local now = os.clock()

	local perPlayer = lastAccepted[player]
	if not perPlayer then
		perPlayer = {}
		lastAccepted[player] = perPlayer
	end

	local last = perPlayer[remoteName]
	if last and now - last < cooldown then
		return false
	end
	perPlayer[remoteName] = now
	return true
end

----------------------------------------------------------------------
-- Public API
----------------------------------------------------------------------

-- Creates the Remotes folder and every remote. Idempotent: GameManager calls
-- this before service init, and it is called again via the services loop.
function RemoteService.init(_injectedServices: { [string]: any }?)
	if initialized then
		return
	end
	initialized = true

	local folder = ReplicatedStorage:FindFirstChild("Remotes")
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = "Remotes"
		folder.Parent = ReplicatedStorage
	end

	for _, name in REMOTE_NAMES do
		local existing = folder:FindFirstChild(name)
		if existing and existing:IsA("RemoteEvent") then
			remotes[name] = existing
		else
			local remote = Instance.new("RemoteEvent")
			remote.Name = name
			remote.Parent = folder
			remotes[name] = remote
		end
	end

	print(`[RemoteService] Created {#REMOTE_NAMES} remotes`)
end

function RemoteService.start() end

-- Wrap a C->S RemoteEvent handler with rate limit + cooldown + validation.
function RemoteService.register(config: RemoteConfig)
	local remote = remotes[config.Name]
	if not remote then
		error(`[RemoteService] register: unknown remote "{config.Name}" — add it to ARCHITECTURE.md and REMOTE_NAMES first`)
	end

	local cooldown = config.Cooldown or 0
	local maxPerWindow = config.RateLimit or DEFAULT_MAX_PER_WINDOW

	remote.OnServerEvent:Connect(function(player: Player, ...: any)
		-- Cooldown first: fires inside the cooldown are a normal result of fast
		-- clicking and drop silently, without ever counting toward the rate
		-- limit (which exists to catch floods, not enthusiastic players).
		if cooldown > 0 and not checkCooldown(player, config.Name, cooldown) then
			return
		end
		if not checkRateLimit(player, config.Name, maxPerWindow) then
			return
		end
		if config.Validator then
			local ok, reason = config.Validator(player, ...)
			if not ok then
				recordViolation(player, config.Name, reason or "invalid arguments")
				return
			end
		end
		config.Handler(player, ...)
	end)
end

-- S->C helper. Never errors on a missing remote; warns instead.
function RemoteService.fireClient(name: string, player: Player, ...: any)
	local remote = remotes[name]
	if not remote then
		warn(`[RemoteService] fireClient: unknown remote "{name}"`)
		return
	end
	remote:FireClient(player, ...)
end

-- Accessor for services that need the instance itself.
function RemoteService.get(name: string): RemoteEvent
	local remote = remotes[name]
	if not remote then
		error(`[RemoteService] get: unknown remote "{name}"`)
	end
	return remote
end

function RemoteService.cleanupPlayer(player: Player)
	rateTimestamps[player] = nil
	lastAccepted[player] = nil
	violations[player] = nil
end

return RemoteService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="19">
        <Properties>
          <string name="Name">UpgradeService</string>
          <string name="Source"><![CDATA[-- UpgradeService (v2): per-zone hustle upgrades + global perks, and the ONLY
-- place (besides RebirthService's reset) that applies the WalkSpeed perk to
-- the live Humanoid -- both on purchase and on every spawn.
-- Contract: ARCHITECTURE.md "Remotes" + "Upgrades & perks".
--   BuyUpgrade(zoneId, upgradeId): zone unlocked by level, level < MaxLevel,
--     cost = GameConfig.getZoneUpgradeCost(zoneId, upgradeId, level) (nil = maxed),
--     data.Upgrades[zoneId][upgradeId] += 1.
--   BuyPerk(perkId): cost = GameConfig.getPerkCost(perkId, level) (nil = maxed),
--     data.Perks[perkId] += 1. humanoid WalkSpeed = BaseWalkSpeed + Perks.WalkSpeed.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GameConfig = require(ReplicatedStorage.Shared.GameConfig)

local UpgradeService = {}

-- Injected via init(services) -- never require sibling services directly.
local DataService
local RemoteService
local LevelService

local started = false

local HUMANOID_WAIT_TIMEOUT = 10
local DATA_POLL_INTERVAL = 0.5
-- A load can retry a busy lock and wait out a same-server leave save, so
-- allow well past the worst case before giving up on the spawn's WalkSpeed.
local DATA_POLL_TIMEOUT = 60

-- Player -> CharacterAdded connection; disconnected in cleanupPlayer so no
-- connection outlives its player (contract convention).
local characterConnections: { [Player]: RBXScriptConnection } = {}

----------------------------------------------------------------------
-- Helpers
----------------------------------------------------------------------

local function toast(player: Player, message: string, kind: string)
	RemoteService.fireClient("Toast", player, message, kind)
end

-- Perk level from a data table (missing/corrupt -> 0).
function UpgradeService.getPerkLevel(data: any, perkId: string): number
	if typeof(data) ~= "table" or typeof(data.Perks) ~= "table" then
		return 0
	end
	local level = data.Perks[perkId]
	return if typeof(level) == "number" then level else 0
end

-- Effective walk speed for a data table: BaseWalkSpeed + WalkSpeed perk level.
function UpgradeService.getWalkSpeed(data: any): number
	return GameConfig.BaseWalkSpeed + UpgradeService.getPerkLevel(data, "WalkSpeed")
end

local function applyWalkSpeed(humanoid: Humanoid, data: any)
	humanoid.WalkSpeed = UpgradeService.getWalkSpeed(data)
end

-- Zone unlock is derived from level. LevelService owns the query; fall back to
-- the identical GameConfig rule if it is not injected (never trust the client
-- either way).
local function isZoneUnlocked(player: Player, data: any, zoneId: string): boolean
	if LevelService ~= nil and typeof(LevelService.isZoneUnlocked) == "function" then
		return LevelService.isZoneUnlocked(player, zoneId) == true
	end
	local level = if typeof(data.Level) == "number" then data.Level else 1
	return GameConfig.isZoneUnlockedAtLevel(zoneId, level)
end

-- Applies the WalkSpeed perk to a freshly spawned character. Data may still
-- be loading (DataStore), so poll briefly before giving up.
local function applyWalkSpeedOnSpawn(player: Player, character: Model)
	local humanoid = character:WaitForChild("Humanoid", HUMANOID_WAIT_TIMEOUT)
	if not humanoid or not humanoid:IsA("Humanoid") then
		return
	end

	local data = DataService.getData(player)
	local deadline = os.clock() + DATA_POLL_TIMEOUT
	while not data and os.clock() < deadline do
		task.wait(DATA_POLL_INTERVAL)
		if not player:IsDescendantOf(Players) then
			return -- player left while we waited
		end
		data = DataService.getData(player)
	end
	if not data then
		return -- data never loaded (DataService will have kicked the player)
	end

	-- The player may have respawned while we waited; only touch the humanoid
	-- if this character is still the live one.
	if player.Character == character and humanoid.Parent == character then
		applyWalkSpeed(humanoid, data)
	end
end

local function watchPlayer(player: Player)
	if characterConnections[player] then
		return
	end
	characterConnections[player] = player.CharacterAdded:Connect(function(character: Model)
		task.spawn(applyWalkSpeedOnSpawn, player, character)
	end)
	-- Character may already exist (players present before start()).
	if player.Character then
		task.spawn(applyWalkSpeedOnSpawn, player, player.Character)
	end
end

----------------------------------------------------------------------
-- Remote handlers
----------------------------------------------------------------------

local function onBuyUpgrade(player: Player, zoneId: string, upgradeId: string)
	-- Data must be loaded.
	local data = DataService.getData(player)
	if not data then
		return
	end

	-- Existence re-checked here even though the validator already did (defense
	-- in depth; the handler must stand on its own).
	local zone = GameConfig.getZone(zoneId)
	local def = GameConfig.getZoneUpgrade(zoneId, upgradeId)
	if not zone or not def then
		return
	end

	-- Zone must be unlocked by level (the client hides locked tabs, but never
	-- trust it).
	if not isZoneUnlocked(player, data, zoneId) then
		toast(player, "Unlock " .. zone.Name .. " first!", "error")
		return
	end

	local level = GameConfig.getZoneUpgradeLevel(data.Upgrades, zoneId, upgradeId)
	local cost = GameConfig.getZoneUpgradeCost(zoneId, upgradeId, level)
	if cost == nil then
		toast(player, "Maxed out!", "error")
		return
	end

	if not DataService.spendCash(player, cost) then
		toast(player, "Not enough cash!", "error")
		return
	end

	-- Upgrades is a map zoneId -> upgradeId -> level; create the zone table on
	-- first purchase (reconcile normally pre-creates it, but stand alone).
	if typeof(data.Upgrades) ~= "table" then
		data.Upgrades = {}
	end
	local zoneUpgrades = data.Upgrades[zoneId]
	if typeof(zoneUpgrades) ~= "table" then
		zoneUpgrades = {}
		data.Upgrades[zoneId] = zoneUpgrades
	end

	local newLevel = level + 1
	zoneUpgrades[upgradeId] = newLevel

	DataService.sync(player)

	-- The automation tier going 0 -> 1 is a hire, everything else is a level.
	if def.Effect == "Auto" and newLevel == 1 then
		toast(player, def.Name .. " hired!", "success")
	else
		toast(player, def.Name .. " Lv " .. newLevel .. "!", "success")
	end
end

local function onBuyPerk(player: Player, perkId: string)
	-- Data must be loaded.
	local data = DataService.getData(player)
	if not data then
		return
	end

	-- Existence re-checked here (defense in depth).
	local def = GameConfig.Perks[perkId]
	if not def then
		return
	end

	local level = UpgradeService.getPerkLevel(data, perkId)
	local cost = GameConfig.getPerkCost(perkId, level)
	if cost == nil then
		toast(player, "Maxed out!", "error")
		return
	end

	if not DataService.spendCash(player, cost) then
		toast(player, "Not enough cash!", "error")
		return
	end

	if typeof(data.Perks) ~= "table" then
		data.Perks = {}
	end
	local newLevel = level + 1
	data.Perks[perkId] = newLevel

	-- Fast Shoes applies instantly to the live character (feel guide: every
	-- purchase should be felt immediately).
	if perkId == "WalkSpeed" then
		local character = player.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		if humanoid then
			applyWalkSpeed(humanoid, data)
		end
	end

	DataService.sync(player)
	toast(player, def.Name .. " Lv " .. newLevel .. "!", "success")
end

----------------------------------------------------------------------
-- Lifecycle
----------------------------------------------------------------------

function UpgradeService.init(services: { [string]: any })
	DataService = services.DataService
	RemoteService = services.RemoteService
	LevelService = services.LevelService
end

function UpgradeService.start()
	if started then
		return
	end
	started = true

	-- Cooldowns per the ARCHITECTURE.md remotes table; RemoteService adds
	-- rate limiting and violation kicks on top.
	RemoteService.register({
		Name = "BuyUpgrade",
		Cooldown = 0.25,
		Validator = function(_player: Player, zoneId: any, upgradeId: any): (boolean, string?)
			if typeof(zoneId) ~= "string" then
				return false, "zoneId must be a string"
			end
			if typeof(upgradeId) ~= "string" then
				return false, "upgradeId must be a string"
			end
			if GameConfig.getZoneUpgrade(zoneId, upgradeId) == nil then
				return false, "unknown zone upgrade"
			end
			return true
		end,
		Handler = onBuyUpgrade,
	})

	RemoteService.register({
		Name = "BuyPerk",
		Cooldown = 0.3,
		Validator = function(_player: Player, perkId: any): (boolean, string?)
			if typeof(perkId) ~= "string" then
				return false, "perkId must be a string"
			end
			if GameConfig.Perks[perkId] == nil then
				return false, "unknown perkId"
			end
			return true
		end,
		Handler = onBuyPerk,
	})

	-- Apply the WalkSpeed perk on every spawn, for joiners and for players
	-- already present when the service starts.
	Players.PlayerAdded:Connect(watchPlayer)
	for _, player in Players:GetPlayers() do
		watchPlayer(player)
	end
end

function UpgradeService.cleanupPlayer(player: Player)
	local connection = characterConnections[player]
	if connection then
		connection:Disconnect()
		characterConnections[player] = nil
	end
end

return UpgradeService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="20">
        <Properties>
          <string name="Name">WorkerService</string>
          <string name="Source"><![CDATA[-- WorkerService (v2): crate hiring (weighted RNG), equip/unequip, passive income tick.
-- Contract: ARCHITECTURE.md "Remotes" + "Upgrades & perks" + "Data schema v2".
-- Equip cap = GameConfig.Workers.BaseEquipSlots + data.Perks.WorkerSlots.
-- Worker income/sec = sum(getWorkerIncome(Rarity, Crate) for the first `cap`
--   equipped workers) * (1 + WorkerEfficiencyPerLevel * Perks.WorkerEfficiency)
--   * GameConfig.getRebirthCashMultiplier(Rebirths), floored, applied every
--   GameConfig.Workers.IncomeTickSeconds via DataService.addCash (which syncs).
-- Server-authoritative: crate existence is checked in the validator (a crate id
-- outside GameConfig can only come from a tampered client), storage/cost/slot
-- caps re-checked in the handlers. All C->S traffic goes through
-- RemoteService.register (rate limit + per-remote cooldown + violation kicks).

local HttpService = game:GetService("HttpService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GameConfig = require(ReplicatedStorage.Shared.GameConfig)
local Types = require(ReplicatedStorage.Shared.Types)

type WorkerEntry = Types.WorkerEntry

local WorkerService = {}

-- Injected via init(services) -- never require sibling services directly.
local DataService
local RemoteService

local started = false

----------------------------------------------------------------------
-- Helpers
----------------------------------------------------------------------

local function toast(player: Player, message: string, kind: string)
	RemoteService.fireClient("Toast", player, message, kind)
end

-- Perk level from a data table (missing/corrupt -> 0).
local function perkLevel(data: any, perkId: string): number
	local perks = data.Perks
	if typeof(perks) ~= "table" then
		return 0
	end
	local level = perks[perkId]
	return if typeof(level) == "number" then level else 0
end

-- Weighted RNG over crate.Weights. Weights need not sum to 100 (normalized
-- implicitly by rolling against their total). Iterates the ordered rarity
-- list so the roll is stable regardless of dictionary iteration order.
local function rollRarity(crate: GameConfig.CrateDef): GameConfig.RarityDef
	local total = 0
	for _, rarity in GameConfig.WorkerRarities do
		total += crate.Weights[rarity.Id] or 0
	end
	if total <= 0 then
		-- Misconfigured crate; fall back to the most common rarity.
		return GameConfig.WorkerRarities[1]
	end

	local roll = math.random() * total
	local cumulative = 0
	for _, rarity in GameConfig.WorkerRarities do
		cumulative += crate.Weights[rarity.Id] or 0
		if roll < cumulative then
			return rarity
		end
	end
	-- Float edge case (roll == total): rarest bucket.
	return GameConfig.WorkerRarities[#GameConfig.WorkerRarities]
end

local function findWorker(data: any, uid: string): WorkerEntry?
	for _, worker in data.Workers do
		if worker.Uid == uid then
			return worker
		end
	end
	return nil
end

local function countEquipped(data: any): number
	local count = 0
	for _, worker in data.Workers do
		if worker.Equipped then
			count += 1
		end
	end
	return count
end

-- Equipped worker cap = BaseEquipSlots + WorkerSlots perk level.
local function equipCap(data: any): number
	return GameConfig.Workers.BaseEquipSlots + perkLevel(data, "WorkerSlots")
end

-- Public so UI-facing services can show the cap; reads the loaded data only.
function WorkerService.getEquipCap(player: Player): number
	local data = DataService.getData(player)
	if not data then
		return GameConfig.Workers.BaseEquipSlots
	end
	return equipCap(data)
end

----------------------------------------------------------------------
-- Remote handlers
----------------------------------------------------------------------

local function onHireWorker(player: Player, crateId: string)
	-- Data must be loaded.
	local data = DataService.getData(player)
	if not data then
		return
	end

	-- Existence re-checked here even though the validator already did (defense
	-- in depth; the handler must stand on its own).
	local crate = GameConfig.WorkerCrates[crateId]
	if not crate then
		return
	end

	if #data.Workers >= GameConfig.Workers.MaxStorage then
		toast(player, "Worker storage full!", "error")
		return
	end

	if not DataService.spendCash(player, crate.Cost) then
		toast(player, "Not enough cash!", "error")
		return
	end

	local rarity = rollRarity(crate)
	local firstName = GameConfig.WorkerNames[math.random(#GameConfig.WorkerNames)]

	local worker: WorkerEntry = {
		Uid = HttpService:GenerateGUID(false),
		Id = rarity.Id, -- reserved for future distinct characters; currently rarity id
		Rarity = rarity.Id,
		Crate = crateId,
		Name = firstName .. " the " .. rarity.Name,
		Equipped = false,
	}

	-- Auto-equip when a slot is free: nicer first-time UX (hire -> instant income).
	if countEquipped(data) < equipCap(data) then
		worker.Equipped = true
	end

	table.insert(data.Workers, worker)
	data.Stats.WorkersHired += 1

	-- Client plays the crate-open juice off this (art & feel guide).
	RemoteService.fireClient("WorkerHired", player, worker)
	toast(player, "Hired " .. worker.Name .. "!", "success")
	DataService.sync(player)
end

local function onEquipWorker(player: Player, workerUid: string)
	local data = DataService.getData(player)
	if not data then
		return
	end

	local worker = findWorker(data, workerUid)
	if not worker or worker.Equipped then
		-- Unknown uid or already equipped: stale UI, drop silently.
		return
	end

	if countEquipped(data) >= equipCap(data) then
		toast(player, "No free worker slots!", "error")
		return
	end

	worker.Equipped = true
	DataService.sync(player)
end

local function onUnequipWorker(player: Player, workerUid: string)
	local data = DataService.getData(player)
	if not data then
		return
	end

	local worker = findWorker(data, workerUid)
	if not worker or not worker.Equipped then
		return
	end

	worker.Equipped = false
	DataService.sync(player)
end

----------------------------------------------------------------------
-- Passive income tick
----------------------------------------------------------------------

-- Income for one tick: sum of equipped workers' base income, scaled by the
-- WorkerEfficiency perk and the rebirth cash multiplier, floored.
local function computeTickIncome(data: any): number
	-- Count at most equipCap(data) equipped workers: saved data can hold more
	-- Equipped flags than the current cap (the WorkerSlots perk resets on
	-- rebirth), and the extra ones must not earn.
	local base = 0
	local counted = 0
	local cap = equipCap(data)
	for _, worker in data.Workers do
		if worker.Equipped then
			counted += 1
			if counted > cap then
				break
			end
			base += GameConfig.getWorkerIncome(worker.Rarity, worker.Crate)
		end
	end
	if base <= 0 then
		return 0
	end

	local efficiencyMult = 1 + GameConfig.WorkerEfficiencyPerLevel * perkLevel(data, "WorkerEfficiency")
	local rebirths = if typeof(data.Rebirths) == "number" then data.Rebirths else 0
	return math.floor(base * efficiencyMult * GameConfig.getRebirthCashMultiplier(rebirths))
end

-- Public query so UI/other services can show "$/s" without duplicating the math.
function WorkerService.getIncomePerTick(player: Player): number
	local data = DataService.getData(player)
	if not data then
		return 0
	end
	return computeTickIncome(data)
end

----------------------------------------------------------------------
-- Lifecycle
----------------------------------------------------------------------

function WorkerService.init(services: { [string]: any })
	DataService = services.DataService
	RemoteService = services.RemoteService
end

function WorkerService.start()
	if started then
		return
	end
	started = true

	-- Cooldowns per the ARCHITECTURE.md remotes table; RemoteService adds
	-- rate limiting and violation kicks on top.
	RemoteService.register({
		Name = "HireWorker",
		Cooldown = 0.5,
		Validator = function(_player: Player, crateId: any): (boolean, string?)
			if typeof(crateId) ~= "string" then
				return false, "crateId must be a string"
			end
			if GameConfig.WorkerCrates[crateId] == nil then
				return false, "unknown crateId"
			end
			return true
		end,
		Handler = onHireWorker,
	})

	RemoteService.register({
		Name = "EquipWorker",
		Cooldown = 0.2,
		Validator = function(_player: Player, workerUid: any): (boolean, string?)
			if typeof(workerUid) ~= "string" then
				return false, "workerUid must be a string"
			end
			return true
		end,
		Handler = onEquipWorker,
	})

	RemoteService.register({
		Name = "UnequipWorker",
		Cooldown = 0.2,
		Validator = function(_player: Player, workerUid: any): (boolean, string?)
			if typeof(workerUid) ~= "string" then
				return false, "workerUid must be a string"
			end
			return true
		end,
		Handler = onUnequipWorker,
	})

	-- Passive income tick. addCash syncs (DataSync >= 1/s per player is fine
	-- per contract); players with zero income still get a sync every tick.
	task.spawn(function()
		while true do
			task.wait(GameConfig.Workers.IncomeTickSeconds)
			for _, player in DataService.getLoadedPlayers() do
				local data = DataService.getData(player)
				if data then
					local income = computeTickIncome(data)
					if income > 0 then
						DataService.addCash(player, income)
					else
						-- Keep the >=1/s DataSync cadence even with no income,
						-- so clients whose listeners connected after the load-time
						-- snapshot still receive their data within a second.
						DataService.sync(player)
					end
				end
			end
		end
	end)
end

function WorkerService.cleanupPlayer(_player: Player)
	-- No per-player state here: cooldown/rate bookkeeping is owned by
	-- RemoteService, worker data by DataService. Kept for the uniform shape.
end

return WorkerService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="21">
        <Properties>
          <string name="Name">ZoneService</string>
          <string name="Source"><![CDATA[-- ZoneService: level-based zone unlock queries + nearest-zone helper.
-- Contract: ARCHITECTURE.md "Map contract" (v2: NO UnlockPrompt, no cash gates).
-- Zone unlock state is derived from the player's level, so this service owns
-- no data of its own: isZoneUnlocked delegates to LevelService and the gate
-- visuals open per-player on the client (ZoneGateController reacting to
-- DataSync). The server still rejects hustles in locked zones (HustleService).

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GameConfig = require(ReplicatedStorage.Shared.GameConfig)
local Mechanics = require(ReplicatedStorage.Shared.Mechanics)

local ZoneService = {}

-- Injected via init(services) -- never require sibling services directly.
local LevelService

----------------------------------------------------------------------
-- Public API
----------------------------------------------------------------------

-- unlocked <=> data.Level >= zone.UnlockLevel (unknown zone / unloaded -> false).
function ZoneService.isZoneUnlocked(player: Player, zoneId: string): boolean
	if GameConfig.getZone(zoneId) == nil then
		return false
	end
	return LevelService.isZoneUnlocked(player, zoneId)
end

-- Id of the zone whose ring center is closest to a world position.
function ZoneService.getZoneForPosition(position: Vector3): string
	return Mechanics.nearestZoneId(position)
end

-- Level a zone needs (nil for an unknown zone).
function ZoneService.getUnlockLevel(zoneId: string): number?
	local zone = GameConfig.getZone(zoneId)
	return if zone then zone.UnlockLevel else nil
end

----------------------------------------------------------------------
-- Lifecycle
----------------------------------------------------------------------

function ZoneService.init(services: { [string]: any })
	LevelService = services.LevelService
end

function ZoneService.start()
	-- v2 has no gate prompts to connect: gates are purely visual and open on
	-- the client once the player's level reaches zone.UnlockLevel.
end

function ZoneService.cleanupPlayer(_player: Player)
	-- No per-player state.
end

return ZoneService
]]></string>
        </Properties>
      </Item>
    </Item>
    <Item class="Folder" referent="22">
      <Properties>
        <string name="Name">World</string>
      </Properties>
      <Item class="ModuleScript" referent="23">
        <Properties>
          <string name="Name">MapBuilder</string>
          <string name="Source"><![CDATA[--!nonstrict
-- MapBuilder (v2): constructs the entire Side Hustle Simulator world from
-- primitives (Blocks / Balls / Cylinders / Wedges only — no meshes, no Toolbox,
-- no asset ids) plus Terrain, Lighting, PointLights and ParticleEmitters.
--
-- Contract (ARCHITECTURE.md "Map contract" + "Graphics"):
--   Workspace.SideHustleMap (Folder)
--     Ground (Model: terrain-backed island; decor lives here)
--     Plaza (Model with SpawnLocation, ring road, coin fountain, lamps, string lights)
--     Zones (Folder) > <ZoneId> (Model, attribute ZoneId)
--       HustleStation (Model)
--         PromptPart (Part) > ProximityPrompt "HustlePrompt"
--           (ActionText zone.HustleVerb.."!", ObjectText zone.Name,
--            HoldDuration = zone.HoldDuration, MaxActivationDistance 12, no LoS)
--         FeedbackPart (Part, invisible, ~6 studs above the counter; client billboard)
--         AutoAnchor (Part, invisible, beside the counter, facing it; client rig)
--       MechanicProp (Model) — static dressing that tells the mechanic from afar
--       Gate (Model, only UnlockLevel > 1) > GateWall / GatePost / SignPart (BillboardGui)
--   Every zone is placed with Mechanics.zoneGroundCFrame(zone.Order) so the
--   client's nearest-zone lookup matches the world exactly. No UnlockPrompt.
--
-- Graphics: Lighting (Technology = Future is set by the Rojo project) with
-- Atmosphere, SunRays, Bloom, ColorCorrection and the built-in Sky; a Terrain
-- island (Grass disc with animated blades, Sand beach rim, a shallow Water
-- ring over a sand seabed, a few low grass hills between the zones); per-zone
-- materials; ParticleEmitters that keep the default sparkle texture; warm
-- PointLights in every lamp and behind every neon sign. Bright and cartoony.
--
-- Heights: the terrain top is world Y = 0. The ring road disc tops out at
-- ROAD_TOP, the plaza floor and every zone pad at PAD_TOP. Terrain directly
-- under the road and the pads is painted Ground (not Grass) so the animated
-- grass blades can never poke up through the parts.
--
-- MapBuilder.build() is idempotent: it returns early if the map already exists
-- and every Lighting child is found by name/class before one is created.
-- Terrain runs once per server start (inside build) and is a handful of big
-- fills (well under 1s). Part count is ~1,150 incl. invisible markers
-- (budget ~3,500).

local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local GameConfig = require(ReplicatedStorage.Shared.GameConfig)
local Mechanics = require(ReplicatedStorage.Shared.Mechanics)

local MapBuilder = {}

----------------------------------------------------------------------
-- Layout constants (terrain top / ground is world Y = 0)
----------------------------------------------------------------------

local PAD_SIZE = 64
local PAD_TOP = 1.5 -- top of plaza disc and of every zone pad
local ROAD_TOP = 0.5
-- Ring road disc: reaches 2 studs under the front edge of every pad
-- (pad front = ZoneRadius - PAD_SIZE / 2 = 118 with the default config).
local ROAD_RADIUS = GameConfig.Map.ZoneRadius - PAD_SIZE / 2 + 2
local PLAZA_RADIUS = 55
local LAMP_RADIUS = 44 -- plaza lamp ring (string lights run between them)

-- Decor rings below (128 .. 316, beach palms at 345) are laid out for the
-- default ZoneRadius 150: pads cover radius 118 .. 185 around each zone axis.
local ISLAND_RADIUS = 330 -- grass disc (terrain top Y = 0)
local BEACH_RADIUS = 360 -- sand rim (terrain top Y = 0)
local WATER_HALF = 700 -- half-size of the water square
local WATER_TOP = -2 -- water surface sits a little below the beach
local SEABED_TOP = -10 -- sand floor under the water
local HILL_RING_RADIUS = 290 -- low grass hills near the rim, between zones

local ZONE_STEP = GameConfig.Map.ZoneAngleStep -- degrees between zones
local RAD_90 = math.rad(90)

-- Shared palette
local NAVY = Color3.fromRGB(4, 4, 53)
local WHITE = Color3.fromRGB(248, 248, 244)
local CREAM = Color3.fromRGB(247, 238, 214)
local WOOD = Color3.fromRGB(133, 94, 62)
local DARK_WOOD = Color3.fromRGB(96, 66, 42)
local GRASS_GREEN = Color3.fromRGB(106, 192, 86)
local ROAD_GRAY = Color3.fromRGB(118, 112, 122)
local ROAD_TRIM = Color3.fromRGB(176, 168, 170)
local STONE = Color3.fromRGB(225, 214, 188)
local STONE_LIGHT = Color3.fromRGB(242, 236, 222)
local METAL_DARK = Color3.fromRGB(60, 60, 70)
local WHEEL_DARK = Color3.fromRGB(38, 38, 42)
local LEAF_GREEN = Color3.fromRGB(76, 160, 66)
local LAMP_WARM = Color3.fromRGB(255, 220, 160)
local WIRE_DARK = Color3.fromRGB(48, 48, 56)

local FLOWER_COLORS = {
	Color3.fromRGB(255, 212, 31),
	Color3.fromRGB(255, 92, 180),
	Color3.fromRGB(64, 200, 224),
	Color3.fromRGB(255, 123, 34),
	Color3.fromRGB(180, 160, 255),
	Color3.fromRGB(250, 250, 255),
}

----------------------------------------------------------------------
-- Primitive helpers
----------------------------------------------------------------------

type PartProps = {
	name: string?,
	parent: Instance,
	size: Vector3?,
	cframe: CFrame,
	color: Color3,
	material: Enum.Material?,
	transparency: number?,
	reflectance: number?,
	canCollide: boolean?,
	diameter: number?,
	height: number?,
	axis: string?, -- cylinders: "Y" (default), "X", "Z"
}

local function applyCommon(part: BasePart, props: PartProps)
	part.Name = props.name or "Part"
	part.Color = props.color
	part.Material = props.material or Enum.Material.SmoothPlastic
	part.Transparency = props.transparency or 0
	part.Reflectance = props.reflectance or 0
	part.CanCollide = if props.canCollide ~= nil then props.canCollide else true
	part.Anchored = true
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
end

local function makeBlock(props: PartProps): Part
	local part = Instance.new("Part")
	part.Shape = Enum.PartType.Block
	part.Size = props.size :: Vector3
	part.CFrame = props.cframe
	applyCommon(part, props)
	part.Parent = props.parent
	return part
end

-- Balls are always uniform (Roblox keeps Ball parts spherical); pass `diameter`
-- or a uniform `size`.
local function makeBall(props: PartProps): Part
	local part = Instance.new("Part")
	part.Shape = Enum.PartType.Ball
	local d = props.diameter or (props.size :: Vector3).X
	part.Size = Vector3.new(d, d, d)
	part.CFrame = props.cframe
	applyCommon(part, props)
	part.Parent = props.parent
	return part
end

-- Cylinder whose length axis is vertical ("Y", default), or along "X"/"Z".
local function makeCylinder(props: PartProps): Part
	local part = Instance.new("Part")
	part.Shape = Enum.PartType.Cylinder
	local diameter = props.diameter or 1
	local height = props.height or 1
	part.Size = Vector3.new(height, diameter, diameter)
	local axis = props.axis or "Y"
	if axis == "Y" then
		part.CFrame = props.cframe * CFrame.Angles(0, 0, RAD_90)
	elseif axis == "Z" then
		part.CFrame = props.cframe * CFrame.Angles(0, RAD_90, 0)
	else -- "X": native cylinder axis
		part.CFrame = props.cframe
	end
	applyCommon(part, props)
	part.Parent = props.parent
	return part
end

-- WedgePart: full height at local +Z (back face vertical), sloping down to -Z.
local function makeWedge(props: PartProps): WedgePart
	local part = Instance.new("WedgePart")
	part.Size = props.size :: Vector3
	part.CFrame = props.cframe
	applyCommon(part, props)
	part.Parent = props.parent
	return part
end

local function makeModel(name: string, parent: Instance): Model
	local model = Instance.new("Model")
	model.Name = name
	model.Parent = parent
	return model
end

-- Invisible anchored part that carries a ProximityPrompt (keeps CanQuery so
-- the prompt behaves like any other prompt part).
local function makePromptPart(parent: Instance, cf: CFrame): Part
	local part = Instance.new("Part")
	part.Name = "PromptPart"
	part.Size = Vector3.new(2, 2, 2)
	part.CFrame = cf
	part.Transparency = 1
	part.CanCollide = false
	part.CanTouch = false
	part.CastShadow = false
	part.Anchored = true
	part.Parent = parent
	return part
end

-- Invisible, non-colliding, non-queryable anchor (FeedbackPart, AutoAnchor,
-- particle emitter volumes).
local function makeMarker(parent: Instance, name: string, cf: CFrame, size: Vector3?): Part
	local part = Instance.new("Part")
	part.Name = name
	part.Size = size or Vector3.new(1, 1, 1)
	part.CFrame = cf
	part.Transparency = 1
	part.CanCollide = false
	part.CanTouch = false
	part.CanQuery = false
	part.CastShadow = false
	part.Anchored = true
	part.Parent = parent
	return part
end

local function makePrompt(
	parent: BasePart,
	name: string,
	actionText: string,
	objectText: string,
	holdDuration: number,
	maxDistance: number
): ProximityPrompt
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = name
	prompt.ActionText = actionText
	prompt.ObjectText = objectText
	prompt.HoldDuration = holdDuration
	prompt.MaxActivationDistance = maxDistance
	prompt.RequiresLineOfSight = false
	prompt.Parent = parent
	return prompt
end

local function makeTextLabel(
	parent: Instance,
	text: string,
	font: Enum.Font,
	textColor: Color3,
	position: UDim2,
	size: UDim2
): TextLabel
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Position = position
	label.Size = size
	label.Font = font
	label.Text = text
	label.TextColor3 = textColor
	label.TextScaled = true
	label.TextStrokeColor3 = NAVY
	label.TextStrokeTransparency = 0
	label.Parent = parent
	return label
end

-- SurfaceGui text on one face of a part.
local function addSurfaceText(part: BasePart, text: string, font: Enum.Font, textColor: Color3, face: Enum.NormalId): SurfaceGui
	local gui = Instance.new("SurfaceGui")
	gui.Face = face
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 30
	gui.LightInfluence = 0
	gui.Parent = part
	makeTextLabel(gui, text, font, textColor, UDim2.fromScale(0.03, 0.05), UDim2.fromScale(0.94, 0.9))
	return gui
end

local function addPointLight(parent: BasePart, color: Color3, range: number, brightness: number): PointLight
	local light = Instance.new("PointLight")
	light.Color = color
	light.Range = range
	light.Brightness = brightness
	light.Shadows = false
	light.Parent = parent
	return light
end

type ParticleProps = {
	color: ColorSequence,
	size: NumberSequence,
	transparency: NumberSequence?,
	rate: number,
	lifetime: NumberRange,
	speed: NumberRange,
	spread: Vector2?,
	acceleration: Vector3?,
	lightEmission: number?,
	drag: number?,
	rotSpeed: NumberRange?,
}

-- The face of a part that currently points closest to world up. Cylinders
-- built upright are rotated 90 degrees about Z, so their "Top" points along
-- world X; emitters use this so smoke / sparkle always rises.
local FACE_NORMALS: { { face: Enum.NormalId, normal: Vector3 } } = {
	{ face = Enum.NormalId.Top, normal = Vector3.new(0, 1, 0) },
	{ face = Enum.NormalId.Bottom, normal = Vector3.new(0, -1, 0) },
	{ face = Enum.NormalId.Right, normal = Vector3.new(1, 0, 0) },
	{ face = Enum.NormalId.Left, normal = Vector3.new(-1, 0, 0) },
	{ face = Enum.NormalId.Back, normal = Vector3.new(0, 0, 1) },
	{ face = Enum.NormalId.Front, normal = Vector3.new(0, 0, -1) },
}

local function upwardFace(part: BasePart): Enum.NormalId
	local best = Enum.NormalId.Top
	local bestY = -math.huge
	for _, entry in FACE_NORMALS do
		local worldY = part.CFrame:VectorToWorldSpace(entry.normal).Y
		if worldY > bestY then
			best = entry.face
			bestY = worldY
		end
	end
	return best
end

-- ParticleEmitter that keeps the engine default (sparkle) texture.
local function addParticles(parent: BasePart, name: string, props: ParticleProps): ParticleEmitter
	local emitter = Instance.new("ParticleEmitter")
	emitter.Name = name
	emitter.Color = props.color
	emitter.Size = props.size
	emitter.Transparency = props.transparency or NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.2),
		NumberSequenceKeypoint.new(0.7, 0.4),
		NumberSequenceKeypoint.new(1, 1),
	})
	emitter.Rate = props.rate
	emitter.Lifetime = props.lifetime
	emitter.Speed = props.speed
	emitter.SpreadAngle = props.spread or Vector2.new(25, 25)
	emitter.Acceleration = props.acceleration or Vector3.new(0, 1.5, 0)
	emitter.LightEmission = if props.lightEmission ~= nil then props.lightEmission else 0.8
	emitter.LightInfluence = 0.2
	emitter.Drag = props.drag or 0.5
	emitter.RotSpeed = props.rotSpeed or NumberRange.new(-40, 40)
	emitter.Rotation = NumberRange.new(0, 360)
	emitter.EmissionDirection = upwardFace(parent)
	emitter.Parent = parent
	return emitter
end

-- Gentle two-color sparkle preset (motes drifting up).
local function addSparkle(parent: BasePart, name: string, colorA: Color3, colorB: Color3, rate: number, sizeMin: number, sizeMax: number)
	addParticles(parent, name, {
		color = ColorSequence.new(colorA, colorB),
		size = NumberSequence.new(sizeMin, sizeMax),
		rate = rate,
		lifetime = NumberRange.new(1.2, 2.0),
		speed = NumberRange.new(0.6, 1.6),
		lightEmission = 1,
	})
end

-- Chunky sign board with SurfaceGui text, a neon underline and a glow light.
local function addSignBoard(
	parent: Instance,
	cf: CFrame,
	width: number,
	height: number,
	text: string,
	boardColor: Color3,
	textColor: Color3
): Part
	local board = makeBlock({
		name = "NameBoard",
		parent = parent,
		size = Vector3.new(width, height, 0.5),
		cframe = cf,
		color = boardColor,
	})
	addSurfaceText(board, text, Enum.Font.FredokaOne, textColor, Enum.NormalId.Front)
	makeBlock({
		name = "NameBoardGlow", parent = parent, size = Vector3.new(width + 0.4, 0.3, 0.6),
		cframe = cf * CFrame.new(0, -height / 2 - 0.15, 0), color = textColor,
		material = Enum.Material.Neon, canCollide = false,
	})
	addPointLight(board, textColor, 12, 0.6)
	return board
end

-- Position on a ring around the origin (XZ plane).
local function ringPos(radius: number, degrees: number, y: number?): Vector3
	local angle = math.rad(degrees)
	return Vector3.new(math.cos(angle) * radius, y or 0, math.sin(angle) * radius)
end

----------------------------------------------------------------------
-- Lighting: bright cheerful day, soft blue haze, gentle bloom for the neon
----------------------------------------------------------------------

-- Returns the Lighting child with this name (and class), else any existing
-- instance of that class (so a place that already has e.g. a Bloom never ends
-- up with two stacked), else a new one. Properties are (re)applied by the
-- caller so repeat runs converge.
local function ensureLightingChild(className: string, name: string): Instance
	local existing = Lighting:FindFirstChild(name)
	if existing and existing.ClassName == className then
		return existing
	end
	local byClass = Lighting:FindFirstChildOfClass(className)
	if byClass then
		return byClass
	end
	local child = Instance.new(className)
	child.Name = name
	child.Parent = Lighting
	return child
end

local function setupLighting()
	-- Technology = Future comes from default.project.json (not scriptable).
	Lighting.ClockTime = 13
	Lighting.Brightness = 2.6
	Lighting.GlobalShadows = true
	Lighting.ShadowSoftness = 0.6
	Lighting.EnvironmentDiffuseScale = 0.6
	Lighting.EnvironmentSpecularScale = 0.6
	-- Warm, bright fill so shadows stay sunny instead of grey-blue.
	Lighting.Ambient = Color3.fromRGB(150, 138, 124)
	Lighting.OutdoorAmbient = Color3.fromRGB(186, 172, 154)
	Lighting.ExposureCompensation = 0.15

	local atmosphere = ensureLightingChild("Atmosphere", "SideHustleAtmosphere") :: Atmosphere
	atmosphere.Density = 0.32
	atmosphere.Offset = 0.3
	atmosphere.Color = Color3.fromRGB(199, 222, 255)
	atmosphere.Decay = Color3.fromRGB(255, 214, 170)
	atmosphere.Glare = 0.15
	atmosphere.Haze = 1.2

	local sunRays = ensureLightingChild("SunRaysEffect", "SideHustleSunRays") :: SunRaysEffect
	sunRays.Intensity = 0.08
	sunRays.Spread = 0.6

	-- Subtle: only the neon accents bloom, not the sunlit plastic.
	local bloom = ensureLightingChild("BloomEffect", "SideHustleBloom") :: BloomEffect
	bloom.Intensity = 0.35
	bloom.Size = 24
	bloom.Threshold = 1.5

	local colorCorrection = ensureLightingChild("ColorCorrectionEffect", "SideHustleColorCorrection") :: ColorCorrectionEffect
	colorCorrection.Saturation = 0.2
	colorCorrection.Contrast = 0.08
	colorCorrection.Brightness = 0.02
	colorCorrection.TintColor = Color3.fromRGB(255, 255, 255)

	local sky = ensureLightingChild("Sky", "SideHustleSky") :: Sky
	sky.SkyboxBk = "rbxasset://textures/sky/sky512_bk.tex"
	sky.SkyboxDn = "rbxasset://textures/sky/sky512_dn.tex"
	sky.SkyboxFt = "rbxasset://textures/sky/sky512_ft.tex"
	sky.SkyboxLf = "rbxasset://textures/sky/sky512_lf.tex"
	sky.SkyboxRt = "rbxasset://textures/sky/sky512_rt.tex"
	sky.SkyboxUp = "rbxasset://textures/sky/sky512_up.tex"
	sky.SunAngularSize = 18
	sky.MoonAngularSize = 8
	sky.StarCount = 0
	sky.CelestialBodiesShown = true
end

----------------------------------------------------------------------
-- Terrain: grass island, sand rim, water beyond, a few low hills
----------------------------------------------------------------------

-- One low hill per gap between zones, on the bisector (half a zone step off
-- every zone angle) near radius 290: outside the pads (<= 185), the decor
-- rings (<= 260) and inside the grass disc (330). `radius` is the sphere
-- radius; its center sits 0.6 * radius below ground, so each hill is a gentle
-- dome 0.4 * radius tall (8..13 studs) with a 0.8 * radius footprint.
local HILLS = {
	{ ring = 292, radius = 26 },
	{ ring = 286, radius = 32 },
	{ ring = 294, radius = 22 },
	{ ring = 288, radius = 29 },
	{ ring = 292, radius = 24 },
	{ ring = 285, radius = 32 },
	{ ring = 295, radius = 20 },
	{ ring = HILL_RING_RADIUS, radius = 28 },
}

local ISLAND_BOTTOM = -12

local function buildTerrain()
	local terrain = Workspace.Terrain
	terrain:Clear()

	local waterSize = WATER_HALF * 2
	-- Sand seabed, then shallow water above it (surface at WATER_TOP).
	terrain:FillBlock(
		CFrame.new(0, SEABED_TOP - 2, 0),
		Vector3.new(waterSize, 4, waterSize),
		Enum.Material.Sand
	)
	terrain:FillBlock(
		CFrame.new(0, (SEABED_TOP + WATER_TOP) / 2, 0),
		Vector3.new(waterSize, WATER_TOP - SEABED_TOP, waterSize),
		Enum.Material.Water
	)

	-- The island: Sand beach disc, Grass disc on top. Both span
	-- ISLAND_BOTTOM .. 0 so the terrain top is exactly world Y = 0.
	-- FillCylinder(cframe, height, radius, material); axis = cframe Y.
	local islandHeight = -ISLAND_BOTTOM
	local islandCF = CFrame.new(0, ISLAND_BOTTOM / 2, 0)
	terrain:FillCylinder(islandCF, islandHeight, BEACH_RADIUS, Enum.Material.Sand)
	terrain:FillCylinder(islandCF, islandHeight, ISLAND_RADIUS, Enum.Material.Grass)

	-- Paint the terrain hidden under the ring road and under every pad as
	-- Ground so animated grass blades never poke through those parts. Inset
	-- by a full voxel (4 studs) plus the rotation slack of the pads so the
	-- painted voxels stay entirely under the parts.
	terrain:FillCylinder(islandCF, islandHeight, ROAD_RADIUS - 4, Enum.Material.Ground)
	for _, zone in GameConfig.Zones do
		terrain:FillBlock(
			Mechanics.zoneGroundCFrame(zone.Order) * CFrame.new(0, ISLAND_BOTTOM / 2, 0),
			Vector3.new(PAD_SIZE - 16, islandHeight, PAD_SIZE - 16),
			Enum.Material.Ground
		)
	end

	-- Low grass hills: FillBall(center, radius, material).
	for index, hill in HILLS do
		local degrees = (index - 0.5) * ZONE_STEP
		local center = ringPos(hill.ring, degrees, -hill.radius * 0.6)
		terrain:FillBall(center, hill.radius, Enum.Material.Grass)
	end
end

-- Cartoon lagoon water: bright turquoise, clear, small lazy waves. Kept out of
-- buildTerrain so a styling error can never trigger the ground fallback.
-- (Animated grass, Terrain.Decoration, is not scriptable: the Rojo project
-- sets it on the place.)
local function styleWater()
	local terrain = Workspace.Terrain
	terrain.WaterColor = Color3.fromRGB(52, 182, 230)
	terrain.WaterTransparency = 0.55
	terrain.WaterWaveSize = 0.18
	terrain.WaterWaveSpeed = 14
	terrain.WaterReflectance = 0.35
end

----------------------------------------------------------------------
-- Ground: the terrain island is the visible ground; this model holds the
-- decor (and a flat grass slab only if terrain generation failed)
----------------------------------------------------------------------

local function buildGround(map: Folder, terrainOk: boolean): Model
	local ground = makeModel("Ground", map)
	if not terrainOk then
		-- Fallback only: a flat grass slab (top at Y = 0) so players never
		-- fall into the void if the terrain fills errored.
		makeCylinder({
			name = "FallbackGround", parent = ground, diameter = ISLAND_RADIUS * 2, height = 2,
			cframe = CFrame.new(0, -1, 0), color = GRASS_GREEN, material = Enum.Material.Grass,
		})
	end
	return ground
end

----------------------------------------------------------------------
-- Plaza pieces: lamp posts, benches, coin fountain, billboard, string lights
----------------------------------------------------------------------

local function buildLampPost(parent: Instance, cf: CFrame)
	makeCylinder({
		name = "LampBase", parent = parent, diameter = 2, height = 0.5,
		cframe = cf * CFrame.new(0, 0.25, 0), color = Color3.fromRGB(70, 70, 80),
		material = Enum.Material.Metal,
	})
	makeCylinder({
		name = "LampPole", parent = parent, diameter = 0.7, height = 8,
		cframe = cf * CFrame.new(0, 4.25, 0), color = Color3.fromRGB(70, 70, 80),
		material = Enum.Material.Metal,
	})
	local bulb = makeBall({
		name = "LampBulb", parent = parent, diameter = 2.4,
		cframe = cf * CFrame.new(0, 8.9, 0), color = Color3.fromRGB(255, 232, 170),
		material = Enum.Material.Neon, canCollide = false,
	})
	addPointLight(bulb, LAMP_WARM, 18, 0.9)
end

local function buildBench(parent: Instance, cf: CFrame)
	makeBlock({
		name = "BenchSeat", parent = parent, size = Vector3.new(5.5, 0.55, 1.8),
		cframe = cf * CFrame.new(0, 1.35, 0), color = WOOD, material = Enum.Material.WoodPlanks,
	})
	for _, xOff in { -2.2, 2.2 } do
		makeBlock({
			name = "BenchLeg", parent = parent, size = Vector3.new(0.5, 1.1, 1.6),
			cframe = cf * CFrame.new(xOff, 0.55, 0), color = DARK_WOOD, material = Enum.Material.Wood,
		})
	end
	makeBlock({
		name = "BenchBack", parent = parent, size = Vector3.new(5.5, 1.6, 0.45),
		cframe = cf * CFrame.new(0, 2.3, 0.8) * CFrame.Angles(math.rad(-8), 0, 0), color = WOOD,
		material = Enum.Material.WoodPlanks,
	})
end

-- Giant gold coin statue rising out of a marble fountain (plaza centerpiece).
local function buildCoinFountain(parent: Instance)
	local gold = Color3.fromRGB(235, 184, 52)
	local brightGold = Color3.fromRGB(255, 215, 95)
	local bronze = Color3.fromRGB(110, 78, 28)
	local marble = Color3.fromRGB(226, 220, 206)
	local waterColor = Color3.fromRGB(110, 205, 235)

	-- Basin floor + translucent water disc
	makeCylinder({
		name = "FountainFloor", parent = parent, diameter = 22, height = 0.6,
		cframe = CFrame.new(0, PAD_TOP + 0.3, 0), color = marble, material = Enum.Material.Marble,
	})
	makeCylinder({
		name = "FountainWater", parent = parent, diameter = 20.4, height = 0.8,
		cframe = CFrame.new(0, PAD_TOP + 1.0, 0), color = waterColor,
		material = Enum.Material.Glass, transparency = 0.35, reflectance = 0.2, canCollide = false,
	})
	-- Rim: 12 chunky marble blocks in a ring (local X radial, Z tangential)
	for i = 0, 11 do
		local angle = math.rad(i * 30)
		local pos = Vector3.new(math.cos(angle) * 10.6, PAD_TOP + 0.75, math.sin(angle) * 10.6)
		makeBlock({
			name = "FountainRim", parent = parent, size = Vector3.new(1.3, 1.5, 5.8),
			cframe = CFrame.new(pos) * CFrame.Angles(0, -angle, 0), color = marble,
			material = Enum.Material.Marble,
		})
	end
	-- Four water jets (rising spray that falls back into the basin)
	for i = 0, 3 do
		local angle = math.rad(45 + i * 90)
		local jet = makeMarker(
			parent, "FountainJet",
			CFrame.new(math.cos(angle) * 6.8, PAD_TOP + 1.4, math.sin(angle) * 6.8),
			Vector3.new(0.6, 0.4, 0.6)
		)
		addParticles(jet, "Spray", {
			color = ColorSequence.new(Color3.fromRGB(190, 235, 255), Color3.fromRGB(255, 255, 255)),
			size = NumberSequence.new(0.5, 0.9),
			transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 0.25),
				NumberSequenceKeypoint.new(0.8, 0.5),
				NumberSequenceKeypoint.new(1, 1),
			}),
			rate = 7,
			lifetime = NumberRange.new(1.1, 1.4),
			speed = NumberRange.new(12, 15),
			spread = Vector2.new(6, 6),
			acceleration = Vector3.new(0, -22, 0),
			lightEmission = 0.4,
			drag = 0,
		})
	end

	-- Pedestal rising out of the water
	makeCylinder({
		name = "StatuePedestal", parent = parent, diameter = 10, height = 2,
		cframe = CFrame.new(0, PAD_TOP + 1, 0), color = Color3.fromRGB(205, 198, 182),
		material = Enum.Material.Marble,
	})
	makeCylinder({
		name = "StatuePedestalTop", parent = parent, diameter = 7.5, height = 1.5,
		cframe = CFrame.new(0, PAD_TOP + 2.75, 0), color = Color3.fromRGB(190, 182, 165),
		material = Enum.Material.Marble,
	})
	-- Giant gold coin standing on its edge (cylinder axis along X)
	local coinY = PAD_TOP + 8
	makeCylinder({
		name = "StatueCoin", parent = parent, diameter = 9, height = 1.4, axis = "X",
		cframe = CFrame.new(0, coinY, 0), color = gold, material = Enum.Material.Metal,
	})
	local coinCore = makeCylinder({
		name = "StatueCoinCore", parent = parent, diameter = 6, height = 1.5, axis = "X",
		cframe = CFrame.new(0, coinY, 0), color = brightGold,
		material = Enum.Material.Neon, canCollide = false,
	})
	addPointLight(coinCore, brightGold, 16, 0.6)
	-- Dollar-sign-ish bar + serifs across the coin face
	makeBlock({
		name = "StatueDollarBar", parent = parent, size = Vector3.new(1.7, 7.5, 1),
		cframe = CFrame.new(0, coinY, 0), color = bronze, canCollide = false,
	})
	makeBlock({
		name = "StatueDollarTop", parent = parent, size = Vector3.new(1.8, 0.8, 2.4),
		cframe = CFrame.new(0, coinY + 3.1, -0.6), color = bronze, canCollide = false,
	})
	makeBlock({
		name = "StatueDollarBottom", parent = parent, size = Vector3.new(1.8, 0.8, 2.4),
		cframe = CFrame.new(0, coinY - 3.1, 0.6), color = bronze, canCollide = false,
	})
	-- Gentle gold sparkle above the coin
	local sparkle = makeMarker(parent, "CoinSparkle", CFrame.new(0, coinY + 5.6, 0), Vector3.new(7, 1.5, 3))
	addSparkle(sparkle, "GoldSparkle", brightGold, WHITE, 4, 0.4, 0.8)
end

local function buildTitleBillboard(parent: Instance)
	local baseCF = CFrame.lookAt(ringPos(47, 157.5), Vector3.new(0, 0, 0))
	local postColor = Color3.fromRGB(60, 62, 110)
	for _, xOff in { -9, 9 } do
		makeBlock({
			name = "BillboardPost", parent = parent, size = Vector3.new(1.2, 9, 1.2),
			cframe = baseCF * CFrame.new(xOff, PAD_TOP + 4.5, 0), color = postColor,
			material = Enum.Material.Metal,
		})
	end
	local board = makeBlock({
		name = "BillboardBoard", parent = parent, size = Vector3.new(24, 7, 1),
		cframe = baseCF * CFrame.new(0, PAD_TOP + 11.5, 0), color = Color3.fromRGB(24, 26, 64),
	})
	-- Neon trim around the board
	local trim = Color3.fromRGB(255, 212, 31)
	for _, yOff in { -3.8, 3.8 } do
		makeBlock({
			name = "BillboardTrim", parent = parent, size = Vector3.new(25.2, 0.6, 1.2),
			cframe = baseCF * CFrame.new(0, PAD_TOP + 11.5 + yOff, 0), color = trim,
			material = Enum.Material.Neon, canCollide = false,
		})
	end
	for _, xOff in { -12.3, 12.3 } do
		makeBlock({
			name = "BillboardTrim", parent = parent, size = Vector3.new(0.6, 8.2, 1.2),
			cframe = baseCF * CFrame.new(xOff, PAD_TOP + 11.5, 0), color = trim,
			material = Enum.Material.Neon, canCollide = false,
		})
	end
	addSurfaceText(board, "SIDE HUSTLE\nSIMULATOR", Enum.Font.LuckiestGuy, trim, Enum.NormalId.Front)
	addPointLight(board, trim, 16, 0.7)
end

-- Festive string lights: a sagging wire with neon beads between each pair of
-- plaza lamp posts (two straight segments per span).
local function buildStringLights(parent: Instance)
	local wireY = PAD_TOP + 7.9
	local sagY = PAD_TOP + 6.4
	local beadIndex = 0
	for i = 0, 5 do
		local p0 = ringPos(LAMP_RADIUS, 10 + i * 60, wireY)
		local p1 = ringPos(LAMP_RADIUS, 10 + (i + 1) * 60, wireY)
		local mid = (p0 + p1) / 2
		mid = Vector3.new(mid.X, sagY, mid.Z)
		for _, segment in { { p0, mid }, { mid, p1 } } do
			local from, to = segment[1], segment[2]
			local length = (to - from).Magnitude
			makeBlock({
				name = "StringWire", parent = parent, size = Vector3.new(0.12, 0.12, length),
				cframe = CFrame.lookAt((from + to) / 2, to), color = WIRE_DARK,
				material = Enum.Material.Metal, canCollide = false,
			})
			for k = 1, 5 do
				local pos = from:Lerp(to, k / 6) - Vector3.new(0, 0.3, 0)
				beadIndex += 1
				makeBall({
					name = "StringBead", parent = parent, diameter = 0.55,
					cframe = CFrame.new(pos), color = FLOWER_COLORS[(beadIndex - 1) % 5 + 1],
					material = Enum.Material.Neon, canCollide = false,
				})
			end
		end
	end
end

-- Low green mound with a few tiny neon flowers on top.
local function buildFlowerCluster(parent: Instance, position: Vector3, seed: number)
	makeBall({
		name = "FlowerBed", parent = parent, diameter = 2.4,
		cframe = CFrame.new(position + Vector3.new(0, 0.5, 0)), color = LEAF_GREEN, canCollide = false,
	})
	local offsets = {
		Vector3.new(0.5, 1.35, 0.3),
		Vector3.new(-0.6, 1.3, 0.4),
		Vector3.new(0.1, 1.5, -0.6),
		Vector3.new(-0.3, 1.2, -0.1),
	}
	for i, offset in offsets do
		makeBall({
			name = "Flower", parent = parent, diameter = 0.55,
			cframe = CFrame.new(position + offset),
			color = FLOWER_COLORS[(seed + i - 1) % #FLOWER_COLORS + 1],
			material = Enum.Material.Neon, canCollide = false,
		})
	end
end

local function buildPlaza(map: Folder)
	local plaza = makeModel("Plaza", map)

	-- Ring road: cobblestone disc with a lighter trim ring; both reach down
	-- into the terrain so animated grass never pokes through.
	makeCylinder({
		name = "RoadTrim", parent = plaza, diameter = (ROAD_RADIUS + 2.5) * 2, height = 1.8,
		cframe = CFrame.new(0, -0.6, 0), color = ROAD_TRIM, material = Enum.Material.Cobblestone,
	})
	makeCylinder({
		name = "RingRoad", parent = plaza, diameter = ROAD_RADIUS * 2, height = 2,
		cframe = CFrame.new(0, -0.5, 0), color = ROAD_GRAY, material = Enum.Material.Cobblestone,
	})
	-- Plaza disc (marble) with a lighter step ring
	makeCylinder({
		name = "PlazaTrim", parent = plaza, diameter = (PLAZA_RADIUS + 3) * 2, height = 1.2,
		cframe = CFrame.new(0, 0.7, 0), color = STONE_LIGHT, material = Enum.Material.Marble,
	})
	makeCylinder({
		name = "PlazaFloor", parent = plaza, diameter = PLAZA_RADIUS * 2, height = 1,
		cframe = CFrame.new(0, 1, 0), color = STONE, material = Enum.Material.Marble,
	})

	-- Spawn (Neutral, plain — no decal clutter): on the plaza floor between
	-- the fountain and the starting zone, facing that zone so a new player's
	-- first view is their first hustle (the coin statue stays behind them).
	-- 12x1x12 slab resting on the floor top (Y PAD_TOP .. PAD_TOP + 1), its
	-- near edge 2.4 studs clear of the fountain rim (radius ~11.6).
	local startZone = GameConfig.getZone(GameConfig.StartingZoneId) or GameConfig.Zones[1]
	local startCenter = Mechanics.zoneCenter(startZone.Order)
	local spawnDir = Vector3.new(startCenter.X, 0, startCenter.Z).Unit
	local spawnPos = spawnDir * 20 + Vector3.new(0, PAD_TOP + 0.5, 0)
	local spawnLocation = Instance.new("SpawnLocation")
	spawnLocation.Name = "SpawnLocation"
	spawnLocation.Size = Vector3.new(12, 1, 12)
	spawnLocation.CFrame = CFrame.lookAt(spawnPos, spawnPos + spawnDir)
	spawnLocation.Color = Color3.fromRGB(236, 228, 205)
	spawnLocation.Material = Enum.Material.Marble
	spawnLocation.Anchored = true
	spawnLocation.TopSurface = Enum.SurfaceType.Smooth
	spawnLocation.BottomSurface = Enum.SurfaceType.Smooth
	spawnLocation.Neutral = true
	spawnLocation.Duration = 0
	spawnLocation.Parent = plaza

	buildCoinFountain(plaza)

	-- Lamp posts around the plaza + string lights between them
	for i = 0, 5 do
		buildLampPost(plaza, CFrame.new(ringPos(LAMP_RADIUS, 10 + i * 60, PAD_TOP)))
	end
	buildStringLights(plaza)

	-- Benches facing the fountain
	for _, deg in { 55, 185, 300 } do
		local pos = ringPos(30, deg, PAD_TOP)
		buildBench(plaza, CFrame.lookAt(pos, Vector3.new(0, PAD_TOP, 0)))
	end

	-- Flower beds dotted around the plaza
	for i, deg in { 40, 100, 220, 280 } do
		buildFlowerCluster(plaza, ringPos(40, deg, PAD_TOP), i)
	end

	buildTitleBillboard(plaza)
end

----------------------------------------------------------------------
-- Shared zone pieces: hustle station + level gate
----------------------------------------------------------------------

type StationSpec = {
	pos: Vector3, -- counter center (zone-local, on the pad top)
	counter: boolean, -- build the generic counter (false when the zone prop is the counter)
	material: Enum.Material?,
	baseColor: Color3?,
	feedback: Vector3?, -- zone-local override for FeedbackPart
	anchor: Vector3?, -- zone-local override for AutoAnchor
	anchorLook: Vector3?, -- zone-local point the AutoAnchor faces
}

-- Neon accent for a zone: AccentColor, unless it is too dark to glow (Stock
-- Desk's accent is near-black), then the SignColor.
local function neonAccent(zone: GameConfig.ZoneDef): Color3
	local c = zone.AccentColor
	local luminance = 0.299 * c.R + 0.587 * c.G + 0.114 * c.B
	return if luminance < 0.25 then zone.SignColor else c
end

-- Default station layout around the counter center (zone-local offsets):
--   counter    7 wide base / 8 wide top, 3.5 tall, front face at -1.3 / -1.6
--   PromptPart 2.4 in front of the counter center at counter-top height
--   FeedbackPart 9.5 up = 6 studs above the counter top
--   AutoAnchor 8 to the side = 4.5 studs clear of the counter base, its
--     center 0.5 above the pad so its bottom rests on the pad (clients
--     raycast down from it and stand the rig on whatever they hit)
local DEFAULT_FEEDBACK_OFFSET = Vector3.new(0, 9.5, 0)
local DEFAULT_ANCHOR_OFFSET = Vector3.new(8, 0.5, 0)

local function buildHustleStation(zoneModel: Model, zoneCF: CFrame, zone: GameConfig.ZoneDef, spec: StationSpec)
	local station = makeModel("HustleStation", zoneModel)
	local baseCF = zoneCF * CFrame.new(spec.pos)
	if spec.counter then
		local material = spec.material or Enum.Material.SmoothPlastic
		makeBlock({
			name = "CounterBase", parent = station, size = Vector3.new(7, 3, 2.6),
			cframe = baseCF * CFrame.new(0, 1.5, 0), color = spec.baseColor or zone.SignColor,
			material = material,
		})
		makeBlock({
			name = "CounterTop", parent = station, size = Vector3.new(8, 0.5, 3.2),
			cframe = baseCF * CFrame.new(0, 3.25, 0), color = CREAM,
			material = if material == Enum.Material.WoodPlanks then material else Enum.Material.SmoothPlastic,
		})
		makeBlock({
			name = "CounterTrim", parent = station, size = Vector3.new(7.2, 0.6, 0.2),
			cframe = baseCF * CFrame.new(0, 1.5, -1.4), color = neonAccent(zone),
			material = Enum.Material.Neon, canCollide = false,
		})
		-- Verb plaque on the counter front ("WALK!", "TRADE!" ...)
		local plaque = makeBlock({
			name = "CounterPlaque", parent = station, size = Vector3.new(4.4, 1.0, 0.2),
			cframe = baseCF * CFrame.new(0, 2.5, -1.4), color = NAVY, canCollide = false,
		})
		addSurfaceText(plaque, string.upper(zone.HustleVerb) .. "!", Enum.Font.FredokaOne, zone.SignColor, Enum.NormalId.Front)
	end

	-- The prompt (server connects HustlePrompt.Triggered)
	local promptPart = makePromptPart(station, baseCF * CFrame.new(0, 3, -2.4))
	makePrompt(promptPart, "HustlePrompt", zone.HustleVerb .. "!", zone.Name, zone.HoldDuration or 0, 12)

	-- FeedbackPart: ~6 studs above the counter top; the client parents its
	-- market needle / charge bar / combo BillboardGui here.
	local feedbackLocal = spec.feedback or (spec.pos + DEFAULT_FEEDBACK_OFFSET)
	makeMarker(station, "FeedbackPart", zoneCF * CFrame.new(feedbackLocal))

	-- AutoAnchor: at ground level beside the counter, on open pad (nothing
	-- overhead), facing it; the client stands the automation rig here.
	local anchorLocal = spec.anchor or (spec.pos + DEFAULT_ANCHOR_OFFSET)
	local lookLocal = spec.anchorLook or (spec.pos + Vector3.new(0, 0.5, 0))
	local anchorWorld = zoneCF:PointToWorldSpace(anchorLocal)
	local lookWorld = zoneCF:PointToWorldSpace(lookLocal)
	makeMarker(station, "AutoAnchor", CFrame.lookAt(anchorWorld, lookWorld))
end

local function buildGate(zoneModel: Model, zoneCF: CFrame, zone: GameConfig.ZoneDef)
	local gate = makeModel("Gate", zoneModel)

	-- Translucent zone-colored energy wall (client opens it per player)
	makeBlock({
		name = "GateWall", parent = gate, size = Vector3.new(26, 11, 1.2),
		cframe = zoneCF * CFrame.new(0, 5.5, -30.5), color = zone.SignColor,
		material = Enum.Material.ForceField, transparency = 0.45, canCollide = true,
	})
	for _, xOff in { -13.4, 13.4 } do
		local post = makeBlock({
			name = "GatePost", parent = gate, size = Vector3.new(1.5, 12.5, 1.5),
			cframe = zoneCF * CFrame.new(xOff, 6.25, -30.5), color = zone.SignColor,
			material = Enum.Material.Neon,
		})
		addPointLight(post, zone.SignColor, 10, 0.5)
	end
	makeBlock({
		name = "GateTopBar", parent = gate, size = Vector3.new(28.5, 1, 1),
		cframe = zoneCF * CFrame.new(0, 12.2, -30.5), color = zone.SignColor,
		material = Enum.Material.Neon, canCollide = false,
	})
	-- Grassy hedges sealing the pad's front edge out to its corners
	for _, xOff in { -23, 23 } do
		makeBlock({
			name = "GateHedge", parent = gate, size = Vector3.new(18, 2.6, 1.8),
			cframe = zoneCF * CFrame.new(xOff, 1.3, -30.5), color = LEAF_GREEN,
			material = Enum.Material.Grass,
		})
	end

	-- Level sign: a neon crest on the arch (SignPart, Y 12.9..15.5 above the
	-- pad) carrying a BillboardGui that floats just above it, readable from
	-- across the map. ZoneGateController hides the billboard once unlocked.
	local signPart = makeBlock({
		name = "SignPart", parent = gate, size = Vector3.new(11, 2.6, 0.9),
		cframe = zoneCF * CFrame.new(0, 14.2, -30.5), color = zone.SignColor,
		material = Enum.Material.Neon, canCollide = false,
	})
	addPointLight(signPart, zone.SignColor, 14, 0.6)
	local billboard = Instance.new("BillboardGui")
	billboard.Name = "GateSign"
	-- BillboardGui Size scale is in studs: an 18 x 5.6 stud sign whose bottom
	-- edge (offset 4.3 - 2.8 = 1.5 above the part center) clears the crest.
	billboard.Size = UDim2.fromScale(18, 5.6)
	billboard.StudsOffset = Vector3.new(0, 4.3, 0)
	billboard.MaxDistance = 400
	billboard.LightInfluence = 0
	billboard.AlwaysOnTop = false
	billboard.Parent = signPart

	local panel = Instance.new("Frame")
	panel.Name = "Panel"
	panel.Size = UDim2.fromScale(1, 1)
	panel.BackgroundColor3 = NAVY
	panel.BackgroundTransparency = 0.15
	panel.BorderSizePixel = 0
	panel.Parent = billboard
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0.22, 0)
	corner.Parent = panel
	local stripe = Instance.new("Frame")
	stripe.Name = "Stripe"
	stripe.AnchorPoint = Vector2.new(0.5, 0)
	stripe.Position = UDim2.fromScale(0.5, 0.56)
	stripe.Size = UDim2.fromScale(0.86, 0.04)
	stripe.BackgroundColor3 = zone.SignColor
	stripe.BorderSizePixel = 0
	stripe.Parent = panel

	makeTextLabel(
		panel, zone.Name, Enum.Font.FredokaOne, WHITE,
		UDim2.fromScale(0.05, 0.06), UDim2.fromScale(0.9, 0.48)
	)
	makeTextLabel(
		panel, "\u{1F512} Reach Level " .. tostring(zone.UnlockLevel), Enum.Font.FredokaOne, zone.SignColor,
		UDim2.fromScale(0.08, 0.62), UDim2.fromScale(0.84, 0.32)
	)
end

----------------------------------------------------------------------
-- Mechanic props: static dressing so each hustle reads from afar
-- (the live feedback is a client BillboardGui on FeedbackPart)
----------------------------------------------------------------------

-- Tap: big chunky neon button on the counter top ("SQUEEZE!" / "GRILL!").
-- cf = counter-top center (top surface), -Z toward the player; the counter
-- top is 3.2 deep, so its front lip is 1.6 in front of cf. `withLabel` adds a
-- verb plaque on that lip (stations with a generic counter already have one).
local function buildTapButton(parent: Instance, cf: CFrame, zone: GameConfig.ZoneDef, withLabel: boolean)
	local domeColor = if zone.Id == "FoodTruck" then zone.AccentColor else zone.SignColor
	makeCylinder({
		name = "TapButtonBase", parent = parent, diameter = 3.2, height = 0.7,
		cframe = cf * CFrame.new(0, 0.35, 0), color = METAL_DARK, material = Enum.Material.Metal,
	})
	makeCylinder({
		name = "TapButtonRim", parent = parent, diameter = 3.0, height = 0.2,
		cframe = cf * CFrame.new(0, 0.8, 0), color = WHITE, material = Enum.Material.Neon, canCollide = false,
	})
	local dome = makeBall({
		name = "TapButtonDome", parent = parent, diameter = 2.8,
		cframe = cf * CFrame.new(0, 1.0, 0), color = domeColor,
		material = Enum.Material.Neon, canCollide = false,
	})
	addPointLight(dome, domeColor, 9, 0.7)
	if withLabel then
		-- Flush against the front face of the counter-top lip, facing the player.
		local plate = makeBlock({
			name = "TapButtonLabel", parent = parent, size = Vector3.new(3.8, 1.1, 0.3),
			cframe = cf * CFrame.new(0, -0.25, -1.75), color = NAVY, canCollide = false,
		})
		addSurfaceText(plate, string.upper(zone.HustleVerb) .. "!", Enum.Font.LuckiestGuy, domeColor, Enum.NormalId.Front)
	end
end

-- Hold (Dog Walking): a long sandy walking path with paw prints and
-- start/finish flags, running along X in front of the counter.
local function buildPawPath(parent: Instance, cf: CFrame, zone: GameConfig.ZoneDef)
	makeBlock({
		name = "WalkPath", parent = parent, size = Vector3.new(32, 0.3, 3.2),
		cframe = cf * CFrame.new(0, 0.35, 0), color = Color3.fromRGB(226, 208, 160),
		material = Enum.Material.Sand,
	})
	local pawColor = Color3.fromRGB(96, 66, 42)
	for i = 0, 6 do
		local pawCF = cf * CFrame.new(-12 + i * 4, 0.58, if i % 2 == 0 then -0.6 else 0.6)
		makeCylinder({
			name = "PawPad", parent = parent, diameter = 1.0, height = 0.16,
			cframe = pawCF, color = pawColor, canCollide = false,
		})
		for _, toe in { Vector3.new(-0.45, 0, -0.65), Vector3.new(0, 0, -0.8), Vector3.new(0.45, 0, -0.65) } do
			makeCylinder({
				name = "PawToe", parent = parent, diameter = 0.36, height = 0.14,
				cframe = pawCF * CFrame.new(toe), color = pawColor, canCollide = false,
			})
		end
	end
	for _, flag in { { x = -17, color = zone.SignColor }, { x = 17, color = WHITE } } do
		makeBlock({
			name = "FlagPost", parent = parent, size = Vector3.new(0.4, 3.4, 0.4),
			cframe = cf * CFrame.new(flag.x, 1.7, 0), color = DARK_WOOD, material = Enum.Material.Wood,
		})
		makeBlock({
			name = "Flag", parent = parent, size = Vector3.new(0.15, 1.1, 1.8),
			cframe = cf * CFrame.new(flag.x + 0.2, 2.85, 0.9), color = flag.color,
			material = Enum.Material.Neon, canCollide = false,
		})
	end
end

-- Hold (Car Wash): roller conveyor track running along X through the tunnel.
local function buildConveyor(parent: Instance, cf: CFrame, zone: GameConfig.ZoneDef)
	makeBlock({
		name = "ConveyorBase", parent = parent, size = Vector3.new(34, 0.5, 5),
		cframe = cf * CFrame.new(0, 0.25, 0), color = Color3.fromRGB(70, 72, 82),
		material = Enum.Material.DiamondPlate,
	})
	for i = 0, 8 do
		makeCylinder({
			name = "ConveyorRoller", parent = parent, diameter = 0.9, height = 4.6, axis = "Z",
			cframe = cf * CFrame.new(-16 + i * 4, 0.8, 0), color = Color3.fromRGB(120, 124, 136),
			material = Enum.Material.Metal,
		})
	end
	for _, zOff in { -2.7, 2.7 } do
		makeBlock({
			name = "ConveyorRail", parent = parent, size = Vector3.new(34, 0.3, 0.3),
			cframe = cf * CFrame.new(0, 0.65, zOff), color = zone.AccentColor,
			material = Enum.Material.Neon, canCollide = false,
		})
	end
	for _, xOff in { -17.3, 17.3 } do
		makeBlock({
			name = "ConveyorEnd", parent = parent, size = Vector3.new(1.2, 1.4, 5.4),
			cframe = cf * CFrame.new(xOff, 0.7, 0), color = Color3.fromRGB(50, 52, 60),
			material = Enum.Material.Metal,
		})
	end
end

-- Timing: tall black ticker/hype board with a climbing neon zig-zag and a
-- big arrow tip. cf = board base center on the pad top, front (-Z) to the plaza.
local function buildHypeBoard(parent: Instance, cf: CFrame, neon: Color3, title: string)
	local frame = Color3.fromRGB(48, 48, 58)
	for _, xOff in { -2.7, 2.7 } do
		makeBlock({
			name = "HypeBoardPost", parent = parent, size = Vector3.new(0.6, 9.4, 0.6),
			cframe = cf * CFrame.new(xOff, 4.7, 0), color = frame, material = Enum.Material.Metal,
		})
	end
	local board = makeBlock({
		name = "HypeBoard", parent = parent, size = Vector3.new(6.6, 6, 0.5),
		cframe = cf * CFrame.new(0, 7, 0), color = Color3.fromRGB(14, 14, 18),
	})
	addPointLight(board, neon, 14, 0.8)
	-- Zig-zag line climbing left to right across the front face
	local points = {
		Vector3.new(-2.6, 4.9, 0),
		Vector3.new(-1.4, 6.1, 0),
		Vector3.new(-0.4, 5.4, 0),
		Vector3.new(0.8, 7.2, 0),
		Vector3.new(1.8, 6.6, 0),
		Vector3.new(2.6, 8.7, 0),
	}
	for i = 1, #points - 1 do
		local a, b = points[i], points[i + 1]
		local mid = (a + b) / 2
		local delta = b - a
		makeBlock({
			name = "TickerStrip", parent = parent, size = Vector3.new(delta.Magnitude, 0.28, 0.2),
			cframe = cf * CFrame.new(mid.X, mid.Y, -0.35) * CFrame.Angles(0, 0, math.atan2(delta.Y, delta.X)),
			color = neon, material = Enum.Material.Neon, canCollide = false,
		})
	end
	-- Arrow tip (diamond) at the end of the line
	makeBlock({
		name = "HypeArrowTip", parent = parent, size = Vector3.new(1.1, 1.1, 0.2),
		cframe = cf * CFrame.new(2.6, 8.9, -0.35) * CFrame.Angles(0, 0, math.rad(45)),
		color = neon, material = Enum.Material.Neon, canCollide = false,
	})
	local plate = makeBlock({
		name = "HypeBoardTitle", parent = parent, size = Vector3.new(6.6, 1.2, 0.4),
		cframe = cf * CFrame.new(0, 10.6, 0), color = NAVY,
	})
	addSurfaceText(plate, title, Enum.Font.LuckiestGuy, neon, Enum.NormalId.Front)
end

-- Charge: hype meter column — 5 stacked neon segments on a dark core with a
-- glowing cap. cf = column base center on the pad top, front (-Z) to the plaza.
local function buildHypeColumn(parent: Instance, cf: CFrame, segColor: Color3, capColor: Color3, title: string, segments: number)
	local frame = Color3.fromRGB(40, 38, 45)
	makeCylinder({
		name = "HypeColumnBase", parent = parent, diameter = 3.4, height = 0.6,
		cframe = cf * CFrame.new(0, 0.3, 0), color = frame, material = Enum.Material.Metal,
	})
	makeBlock({
		name = "HypeColumnCore", parent = parent, size = Vector3.new(1.2, 9.2, 1.2),
		cframe = cf * CFrame.new(0, 5.2, 0), color = frame, material = Enum.Material.Metal,
	})
	-- One neon segment per charge step (zone.ChargeMax), packed into the
	-- same 8.5-stud span so the column height never changes.
	local count = math.max(1, segments)
	local step = 8.5 / count
	for i = 0, count - 1 do
		makeBlock({
			name = "HypeSegment", parent = parent, size = Vector3.new(2.4, step * 0.76, 1.5),
			cframe = cf * CFrame.new(0, 1.55 + step * (i + 0.5), 0),
			color = segColor:Lerp(WHITE, if count > 1 then i * 0.64 / (count - 1) else 0),
			material = Enum.Material.Neon, canCollide = false,
		})
	end
	local cap = makeBall({
		name = "HypeColumnCap", parent = parent, diameter = 1.9,
		cframe = cf * CFrame.new(0, 10.5, 0), color = capColor,
		material = Enum.Material.Neon, canCollide = false,
	})
	addPointLight(cap, segColor, 12, 0.8)
	local plate = makeBlock({
		name = "HypeColumnLabel", parent = parent, size = Vector3.new(3.0, 0.9, 0.25),
		cframe = cf * CFrame.new(0, 1.05, -0.75), color = NAVY, canCollide = false,
	})
	addSurfaceText(plate, title, Enum.Font.LuckiestGuy, segColor, Enum.NormalId.Front)
end

local function buildMechanicProp(zoneModel: Model, cf: CFrame, zone: GameConfig.ZoneDef, hasCounterPlaque: boolean)
	local props = makeModel("MechanicProp", zoneModel)
	if zone.Mechanic == "Tap" then
		buildTapButton(props, cf, zone, not hasCounterPlaque)
	elseif zone.Mechanic == "Hold" then
		if zone.Id == "CarWash" then
			buildConveyor(props, cf, zone)
		else
			buildPawPath(props, cf, zone)
		end
	elseif zone.Mechanic == "Timing" then
		local isStock = zone.Id == "StockDesk"
		buildHypeBoard(props, cf, if isStock then Color3.fromRGB(70, 255, 130) else zone.SignColor, if isStock then "TICKER" else "HYPE")
	elseif zone.Mechanic == "Charge" then
		local isStartup = zone.Id == "StartupHQ"
		buildHypeColumn(
			props, cf,
			if isStartup then zone.AccentColor else zone.SignColor,
			if isStartup then zone.SignColor else zone.AccentColor,
			if isStartup then "FUNDING" else "HYPE",
			zone.ChargeMax
		)
	end
end

----------------------------------------------------------------------
-- Zone 1: Lemonade Stand — wooden stand, fabric canopy, giant lemon
----------------------------------------------------------------------

local function buildLemonadeStand(zoneModel: Model, zoneCF: CFrame, zone: GameConfig.ZoneDef)
	local yellow = zone.SignColor
	makeBlock({
		name = "StandBase", parent = zoneModel, size = Vector3.new(10, 3.2, 2.6),
		cframe = zoneCF * CFrame.new(0, 1.6, 9), color = WOOD, material = Enum.Material.WoodPlanks,
	})
	makeBlock({
		name = "StandTop", parent = zoneModel, size = Vector3.new(11, 0.5, 3.2),
		cframe = zoneCF * CFrame.new(0, 3.45, 9), color = CREAM, material = Enum.Material.WoodPlanks,
	})
	-- Striped front skirt
	for i = 0, 4 do
		makeBlock({
			name = "StandStripe", parent = zoneModel, size = Vector3.new(1.9, 2.9, 0.2),
			cframe = zoneCF * CFrame.new(-3.8 + i * 1.9, 1.65, 7.65),
			color = if i % 2 == 0 then yellow else WHITE, canCollide = false,
		})
	end
	-- Canopy posts + striped fabric canopy
	for _, xOff in { -4.6, 4.6 } do
		makeBlock({
			name = "CanopyPost", parent = zoneModel, size = Vector3.new(0.8, 8.4, 0.8),
			cframe = zoneCF * CFrame.new(xOff, 4.2, 10.2), color = DARK_WOOD, material = Enum.Material.Wood,
		})
	end
	for i = 0, 4 do
		makeBlock({
			name = "CanopyStripe", parent = zoneModel, size = Vector3.new(2.3, 0.4, 6.5),
			cframe = zoneCF * CFrame.new(-4.6 + i * 2.3, 8.6, 9.1),
			color = if i % 2 == 0 then yellow else WHITE, material = Enum.Material.Fabric,
		})
	end
	-- GIANT lemon on the roof (ball + two tips, slightly tilted)
	local lemonCF = zoneCF * CFrame.new(0, 12.2, 9.1) * CFrame.Angles(0, 0, math.rad(10))
	makeBall({
		name = "GiantLemon", parent = zoneModel, diameter = 7.4,
		cframe = lemonCF, color = yellow, canCollide = false,
	})
	for _, xOff in { -4.0, 4.0 } do
		makeBall({
			name = "LemonTip", parent = zoneModel, diameter = 1.6,
			cframe = lemonCF * CFrame.new(xOff, 0, 0), color = Color3.fromRGB(235, 190, 28),
			canCollide = false,
		})
	end
	-- Glass pitcher of lemonade (with citrus sparkle) + cups on the counter
	local pitcher = makeCylinder({
		name = "Pitcher", parent = zoneModel, diameter = 1.5, height = 2.3,
		cframe = zoneCF * CFrame.new(2.6, 4.85, 9), color = Color3.fromRGB(255, 236, 150),
		material = Enum.Material.Glass, transparency = 0.3, canCollide = false,
	})
	addSparkle(pitcher, "CitrusSparkle", yellow, WHITE, 4, 0.25, 0.5)
	makeBlock({
		name = "PitcherHandle", parent = zoneModel, size = Vector3.new(0.35, 1.3, 0.9),
		cframe = zoneCF * CFrame.new(3.5, 4.85, 9), color = CREAM, canCollide = false,
	})
	for _, xOff in { -2.2, -3.1 } do
		makeCylinder({
			name = "LemonadeCup", parent = zoneModel, diameter = 0.8, height = 1,
			cframe = zoneCF * CFrame.new(xOff, 4.2, 8.8), color = yellow, canCollide = false,
		})
	end
	addSignBoard(zoneModel, zoneCF * CFrame.new(0, 7.6, 6.1), 9, 2, zone.Name, NAVY, yellow)
end

----------------------------------------------------------------------
-- Zone 2: Dog Walking — park lawn, fence, dog house, giant bone, blocky dogs
----------------------------------------------------------------------

local function buildDog(parent: Instance, cf: CFrame, color: Color3)
	local darker = color:Lerp(Color3.new(0, 0, 0), 0.3)
	makeBlock({
		name = "DogBody", parent = parent, size = Vector3.new(1.5, 1.6, 2.8),
		cframe = cf * CFrame.new(0, 1.6, 0), color = color,
	})
	for _, offset in { Vector3.new(-0.45, 0.4, -0.95), Vector3.new(0.45, 0.4, -0.95), Vector3.new(-0.45, 0.4, 0.95), Vector3.new(0.45, 0.4, 0.95) } do
		makeBlock({
			name = "DogLeg", parent = parent, size = Vector3.new(0.45, 0.8, 0.45),
			cframe = cf * CFrame.new(offset), color = color, canCollide = false,
		})
	end
	makeBlock({
		name = "DogHead", parent = parent, size = Vector3.new(1.3, 1.2, 1.1),
		cframe = cf * CFrame.new(0, 2.7, -1.5), color = color,
	})
	makeBlock({
		name = "DogSnout", parent = parent, size = Vector3.new(0.7, 0.5, 0.6),
		cframe = cf * CFrame.new(0, 2.45, -2.3), color = darker, canCollide = false,
	})
	makeBall({
		name = "DogNose", parent = parent, diameter = 0.35,
		cframe = cf * CFrame.new(0, 2.5, -2.65), color = Color3.fromRGB(25, 22, 22), canCollide = false,
	})
	for _, xOff in { -0.4, 0.4 } do
		makeBlock({
			name = "DogEar", parent = parent, size = Vector3.new(0.35, 0.6, 0.2),
			cframe = cf * CFrame.new(xOff, 3.4, -1.4), color = darker, canCollide = false,
		})
	end
	makeBlock({
		name = "DogTail", parent = parent, size = Vector3.new(0.3, 1.1, 0.3),
		cframe = cf * CFrame.new(0, 2.5, 1.5) * CFrame.Angles(math.rad(30), 0, 0),
		color = darker, canCollide = false,
	})
end

local function buildDogWalking(zoneModel: Model, zoneCF: CFrame, zone: GameConfig.ZoneDef)
	local fenceWhite = Color3.fromRGB(242, 240, 234)
	-- Real grass lawn inside the fence
	makeBlock({
		name = "ParkLawn", parent = zoneModel, size = Vector3.new(52, 0.2, 44),
		cframe = zoneCF * CFrame.new(0, 0.1, 0), color = Color3.fromRGB(98, 184, 82),
		material = Enum.Material.Grass,
	})
	-- White wooden fence along both sides of the park
	for _, xOff in { -28, 28 } do
		for z = -20, 20, 10 do
			makeBlock({
				name = "FencePost", parent = zoneModel, size = Vector3.new(0.7, 2.8, 0.7),
				cframe = zoneCF * CFrame.new(xOff, 1.4, z), color = fenceWhite, material = Enum.Material.Wood,
			})
		end
		for _, yOff in { 1, 2 } do
			makeBlock({
				name = "FenceRail", parent = zoneModel, size = Vector3.new(0.4, 0.35, 42),
				cframe = zoneCF * CFrame.new(xOff, yOff, 0), color = fenceWhite,
				material = Enum.Material.Wood, canCollide = false,
			})
		end
	end
	-- Red dog house with gabled roof
	local houseRed = Color3.fromRGB(196, 60, 54)
	local roofRed = Color3.fromRGB(140, 40, 36)
	makeBlock({
		name = "DogHouse", parent = zoneModel, size = Vector3.new(8, 6, 7),
		cframe = zoneCF * CFrame.new(10, 3, 14), color = houseRed, material = Enum.Material.WoodPlanks,
	})
	makeWedge({
		name = "DogHouseRoof", parent = zoneModel, size = Vector3.new(7.5, 2, 4.5),
		cframe = zoneCF * CFrame.new(7.75, 7, 14) * CFrame.Angles(0, RAD_90, 0), color = roofRed,
	})
	makeWedge({
		name = "DogHouseRoof", parent = zoneModel, size = Vector3.new(7.5, 2, 4.5),
		cframe = zoneCF * CFrame.new(12.25, 7, 14) * CFrame.Angles(0, -RAD_90, 0), color = roofRed,
	})
	makeBlock({
		name = "DogHouseDoor", parent = zoneModel, size = Vector3.new(2.6, 3.4, 0.4),
		cframe = zoneCF * CFrame.new(10, 1.9, 10.4), color = Color3.fromRGB(30, 24, 22), canCollide = false,
	})
	-- Giant white bone (cylinder + two balls at each end)
	local boneWhite = Color3.fromRGB(250, 248, 240)
	local boneCF = zoneCF * CFrame.new(-8, 1.5, 2) * CFrame.Angles(0, math.rad(25), 0)
	makeCylinder({
		name = "BoneShaft", parent = zoneModel, diameter = 2, height = 7, axis = "X",
		cframe = boneCF, color = boneWhite,
	})
	for _, xOff in { -3.5, 3.5 } do
		for _, zOff in { -0.9, 0.9 } do
			makeBall({
				name = "BoneKnob", parent = zoneModel, diameter = 3,
				cframe = boneCF * CFrame.new(xOff, 0, zOff), color = boneWhite,
			})
		end
	end
	-- Two tiny blocky dogs
	buildDog(zoneModel, zoneCF * CFrame.new(-14, 0, 12) * CFrame.Angles(0, math.rad(140), 0), Color3.fromRGB(150, 103, 60))
	buildDog(zoneModel, zoneCF * CFrame.new(12, 0, -4) * CFrame.Angles(0, math.rad(-35), 0), Color3.fromRGB(240, 238, 230))
	-- Pink heart-ish motes drifting over the lawn
	local motes = makeMarker(zoneModel, "HeartMotes", zoneCF * CFrame.new(0, 4, 4), Vector3.new(24, 3, 20))
	addParticles(motes, "Hearts", {
		color = ColorSequence.new(Color3.fromRGB(255, 120, 170), Color3.fromRGB(255, 190, 215)),
		size = NumberSequence.new(0.5, 0.9),
		rate = 4,
		lifetime = NumberRange.new(2, 3),
		speed = NumberRange.new(0.6, 1.2),
		acceleration = Vector3.new(0, 0.8, 0),
		lightEmission = 0.9,
	})
	addSignBoard(zoneModel, zoneCF * CFrame.new(10, 9.3, 14), 10, 2.2, zone.Name, NAVY, zone.SignColor)
end

----------------------------------------------------------------------
-- Zone 3: Sneaker Street — concrete storefront, glass window, giant sneaker
----------------------------------------------------------------------

local function buildSneakerFlipping(zoneModel: Model, zoneCF: CFrame, zone: GameConfig.ZoneDef)
	local wallPurple = Color3.fromRGB(74, 64, 120)
	makeBlock({
		name = "StoreBody", parent = zoneModel, size = Vector3.new(22, 14, 12),
		cframe = zoneCF * CFrame.new(0, 7, 16), color = wallPurple, material = Enum.Material.Concrete,
	})
	makeBlock({
		name = "StoreRoof", parent = zoneModel, size = Vector3.new(23, 0.8, 13),
		cframe = zoneCF * CFrame.new(0, 14.4, 16), color = Color3.fromRGB(50, 42, 84),
	})
	makeBlock({
		name = "StoreWindow", parent = zoneModel, size = Vector3.new(12, 5.5, 0.5),
		cframe = zoneCF * CFrame.new(-2, 5.2, 9.8), color = Color3.fromRGB(150, 170, 220),
		material = Enum.Material.Glass, transparency = 0.35, canCollide = false,
	})
	makeBlock({
		name = "StoreDoor", parent = zoneModel, size = Vector3.new(4, 7.5, 0.5),
		cframe = zoneCF * CFrame.new(7.5, 3.75, 9.8), color = NAVY, canCollide = false,
	})
	-- Neon purple trim
	makeBlock({
		name = "StoreTrim", parent = zoneModel, size = Vector3.new(22.8, 0.7, 0.7),
		cframe = zoneCF * CFrame.new(0, 14, 9.9), color = zone.SignColor,
		material = Enum.Material.Neon, canCollide = false,
	})
	for _, yOff in { 2.2, 8.2 } do
		makeBlock({
			name = "WindowTrim", parent = zoneModel, size = Vector3.new(12.6, 0.4, 0.3),
			cframe = zoneCF * CFrame.new(-2, yOff, 10), color = zone.SignColor,
			material = Enum.Material.Neon, canCollide = false,
		})
	end
	-- Giant sneaker on a marble display pedestal
	local pedestal = makeCylinder({
		name = "SneakerPedestal", parent = zoneModel, diameter = 7, height = 2.4,
		cframe = zoneCF * CFrame.new(-12, 1.2, -2), color = WHITE, material = Enum.Material.Marble,
	})
	addSparkle(pedestal, "HypeSparkle", zone.SignColor, zone.AccentColor, 2, 0.3, 0.6)
	local shoeCF = zoneCF * CFrame.new(-12, 0, -2)
	makeBlock({
		name = "SneakerSole", parent = zoneModel, size = Vector3.new(7.5, 0.9, 3),
		cframe = shoeCF * CFrame.new(0, 2.85, 0), color = WHITE,
	})
	makeBlock({
		name = "SneakerHeel", parent = zoneModel, size = Vector3.new(2.4, 1.6, 2.9),
		cframe = shoeCF * CFrame.new(-2.3, 4.1, 0), color = zone.SignColor,
	})
	makeBlock({
		name = "SneakerBody", parent = zoneModel, size = Vector3.new(4.5, 2.1, 2.9),
		cframe = shoeCF * CFrame.new(-0.4, 4.35, 0), color = zone.SignColor,
	})
	makeWedge({
		name = "SneakerToe", parent = zoneModel, size = Vector3.new(2.9, 1.9, 2.4),
		cframe = shoeCF * CFrame.new(2.6, 4.25, 0) * CFrame.Angles(0, -RAD_90, 0), color = zone.SignColor,
	})
	makeBlock({
		name = "SneakerSwoosh", parent = zoneModel, size = Vector3.new(2.8, 0.5, 0.2),
		cframe = shoeCF * CFrame.new(0, 4.4, -1.55) * CFrame.Angles(0, 0, math.rad(-14)),
		color = zone.AccentColor, material = Enum.Material.Neon, canCollide = false,
	})
	addSignBoard(zoneModel, zoneCF * CFrame.new(0, 11.8, 9.85), 14, 2.6, zone.Name, NAVY, zone.AccentColor)
end

----------------------------------------------------------------------
-- Zone 4: Car Wash — metal/glass tunnel, roller brushes, blocky car, foam
----------------------------------------------------------------------

local function buildCarWash(zoneModel: Model, zoneCF: CFrame, zone: GameConfig.ZoneDef)
	local aqua = zone.SignColor
	-- Tunnel: low front wall (so the inside is visible), full back wall, roof, columns
	makeBlock({
		name = "TunnelFrontWall", parent = zoneModel, size = Vector3.new(22, 4.5, 1.2),
		cframe = zoneCF * CFrame.new(0, 2.25, 2), color = aqua, material = Enum.Material.Metal,
	})
	makeBlock({
		name = "TunnelBackWall", parent = zoneModel, size = Vector3.new(22, 9, 1.2),
		cframe = zoneCF * CFrame.new(0, 4.5, 14), color = aqua, material = Enum.Material.Metal,
	})
	for _, xOff in { -10.5, 10.5 } do
		makeBlock({
			name = "TunnelColumn", parent = zoneModel, size = Vector3.new(1.6, 9, 1.6),
			cframe = zoneCF * CFrame.new(xOff, 4.5, 2), color = aqua, material = Enum.Material.Metal,
		})
	end
	makeBlock({
		name = "TunnelRoof", parent = zoneModel, size = Vector3.new(23, 1.2, 14),
		cframe = zoneCF * CFrame.new(0, 9.6, 8), color = Color3.fromRGB(44, 150, 170),
		material = Enum.Material.Metal,
	})
	makeBlock({
		name = "TunnelGlass", parent = zoneModel, size = Vector3.new(20, 3.6, 0.4),
		cframe = zoneCF * CFrame.new(0, 6.5, 2), color = Color3.fromRGB(160, 225, 245),
		material = Enum.Material.Glass, transparency = 0.45, canCollide = false,
	})
	makeBlock({
		name = "TunnelTrim", parent = zoneModel, size = Vector3.new(23, 0.8, 0.8),
		cframe = zoneCF * CFrame.new(0, 10.3, 1.4), color = zone.AccentColor,
		material = Enum.Material.Neon, canCollide = false,
	})
	-- Big fabric roller brushes hanging from the roof (Y 1.3..9.0): clear of
	-- the conveyor rollers (top 1.25) and of the car body (X -4..4, Z 5.9..10.1)
	for _, offset in { Vector3.new(-6, 0, 5.4), Vector3.new(0, 0, 11.7), Vector3.new(6, 0, 5.4) } do
		makeCylinder({
			name = "RollerBrush", parent = zoneModel, diameter = 3, height = 7.7,
			cframe = zoneCF * CFrame.new(offset.X, 5.15, offset.Z), color = Color3.fromRGB(30, 70, 115),
			material = Enum.Material.Fabric,
		})
	end
	-- Chunky blocky car riding the conveyor: raised 1.25 so the wheel bottoms
	-- (diameter 2 at local y 1) rest on the roller tops (0.8 + 0.45 = 1.25).
	local carCF = zoneCF * CFrame.new(0, 1.25, 0)
	makeBlock({
		name = "CarBody", parent = zoneModel, size = Vector3.new(8, 2.2, 4.2),
		cframe = carCF * CFrame.new(0, 2.1, 8), color = Color3.fromRGB(224, 82, 72),
	})
	makeBlock({
		name = "CarCabin", parent = zoneModel, size = Vector3.new(4, 1.8, 3.8),
		cframe = carCF * CFrame.new(-0.4, 4.1, 8), color = Color3.fromRGB(120, 170, 210),
		material = Enum.Material.Glass, transparency = 0.35,
	})
	for _, xOff in { -2.8, 2.8 } do
		for _, zOff in { -2.3, 2.3 } do
			makeCylinder({
				name = "CarWheel", parent = zoneModel, diameter = 2, height = 0.8, axis = "Z",
				cframe = carCF * CFrame.new(xOff, 1, 8 + zOff), color = WHEEL_DARK,
			})
		end
	end
	-- A few static foam blobs on the car + rising foam bubbles in the tunnel
	for _, bubble in { { Vector3.new(0, 3.6, 7), 1.8 }, { Vector3.new(2.4, 3.5, 9), 1.4 }, { Vector3.new(0.8, 5.3, 8.2), 1.6 }, { Vector3.new(-2.6, 3.4, 7.4), 1.3 } } do
		makeBall({
			name = "FoamBubble", parent = zoneModel, diameter = bubble[2],
			cframe = carCF * CFrame.new(bubble[1]), color = Color3.fromRGB(250, 250, 255),
			transparency = 0.2, canCollide = false,
		})
	end
	local foam = makeMarker(zoneModel, "FoamVolume", zoneCF * CFrame.new(0, 2.5, 8), Vector3.new(18, 2, 10))
	addParticles(foam, "FoamBubbles", {
		color = ColorSequence.new(Color3.fromRGB(255, 255, 255), Color3.fromRGB(225, 245, 255)),
		size = NumberSequence.new(0.6, 1.2),
		transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.15),
			NumberSequenceKeypoint.new(0.8, 0.3),
			NumberSequenceKeypoint.new(1, 1),
		}),
		rate = 8,
		lifetime = NumberRange.new(1.6, 2.4),
		speed = NumberRange.new(1, 2),
		acceleration = Vector3.new(0, 1.2, 0),
		lightEmission = 0.3,
	})
	addSignBoard(zoneModel, zoneCF * CFrame.new(0, 11.6, 2), 14, 2.4, zone.Name, NAVY, zone.AccentColor)
end

----------------------------------------------------------------------
-- Zone 5: Food Truck — metal truck, diamond-plate skirt, HUGE burger, smoke
----------------------------------------------------------------------

local function buildFoodTruck(zoneModel: Model, zoneCF: CFrame, zone: GameConfig.ZoneDef)
	local orange = zone.SignColor
	local truckCF = zoneCF * CFrame.new(0, 0, 8)
	makeBlock({
		name = "TruckBody", parent = zoneModel, size = Vector3.new(15, 5, 6),
		cframe = truckCF * CFrame.new(0, 3.9, 0), color = orange, material = Enum.Material.Metal,
	})
	makeBlock({
		name = "TruckSkirt", parent = zoneModel, size = Vector3.new(15.2, 1.0, 6.2),
		cframe = truckCF * CFrame.new(0, 1.7, 0), color = Color3.fromRGB(150, 150, 160),
		material = Enum.Material.DiamondPlate,
	})
	makeBlock({
		name = "TruckCab", parent = zoneModel, size = Vector3.new(4, 3.6, 5.6),
		cframe = truckCF * CFrame.new(-9.5, 3.2, 0), color = orange, material = Enum.Material.Metal,
	})
	makeBlock({
		name = "TruckWindshield", parent = zoneModel, size = Vector3.new(0.5, 1.8, 4.4),
		cframe = truckCF * CFrame.new(-11.3, 4.2, 0), color = Color3.fromRGB(120, 170, 210),
		material = Enum.Material.Glass, transparency = 0.3, canCollide = false,
	})
	for _, xOff in { -9, 5 } do
		for _, zOff in { -3.4, 3.4 } do
			makeCylinder({
				name = "TruckWheel", parent = zoneModel, diameter = 2.4, height = 0.9, axis = "Z",
				cframe = truckCF * CFrame.new(xOff, 1.2, zOff), color = WHEEL_DARK,
			})
		end
	end
	-- Serving window + counter lip + fabric awning (front side, facing the plaza)
	makeBlock({
		name = "ServingWindow", parent = zoneModel, size = Vector3.new(6, 2.4, 0.4),
		cframe = truckCF * CFrame.new(0.5, 4.4, -3.05), color = Color3.fromRGB(80, 90, 110),
		material = Enum.Material.Glass, transparency = 0.3, canCollide = false,
	})
	makeBlock({
		name = "WindowCounter", parent = zoneModel, size = Vector3.new(6.6, 0.4, 1),
		cframe = truckCF * CFrame.new(0.5, 3.1, -3.5), color = CREAM, material = Enum.Material.WoodPlanks,
	})
	makeBlock({
		name = "Awning", parent = zoneModel, size = Vector3.new(7, 0.4, 2.4),
		cframe = truckCF * CFrame.new(0.5, 5.9, -3.8) * CFrame.Angles(math.rad(-20), 0, 0),
		color = zone.AccentColor, material = Enum.Material.Fabric, canCollide = false,
	})
	-- Grill chimney with smoke
	local chimney = makeCylinder({
		name = "GrillChimney", parent = zoneModel, diameter = 1.2, height = 1.6,
		cframe = truckCF * CFrame.new(5.5, 7.2, 1.5), color = METAL_DARK, material = Enum.Material.Metal,
		canCollide = false,
	})
	addParticles(chimney, "GrillSmoke", {
		color = ColorSequence.new(Color3.fromRGB(150, 150, 155), Color3.fromRGB(205, 205, 210)),
		size = NumberSequence.new(1, 2.6),
		transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.4),
			NumberSequenceKeypoint.new(0.6, 0.7),
			NumberSequenceKeypoint.new(1, 1),
		}),
		rate = 5,
		lifetime = NumberRange.new(2, 3),
		speed = NumberRange.new(2, 3),
		spread = Vector2.new(10, 10),
		acceleration = Vector3.new(0, 1, 0),
		lightEmission = 0,
		rotSpeed = NumberRange.new(-20, 20),
	})
	-- HUGE burger on the roof: bun / patty / cheese / lettuce / dome bun
	makeCylinder({
		name = "BurgerBunBottom", parent = zoneModel, diameter = 7, height = 1.4,
		cframe = truckCF * CFrame.new(0, 7.1, 0), color = Color3.fromRGB(233, 170, 92), canCollide = false,
	})
	makeCylinder({
		name = "BurgerPatty", parent = zoneModel, diameter = 7.7, height = 1,
		cframe = truckCF * CFrame.new(0, 8.3, 0), color = Color3.fromRGB(118, 70, 36), canCollide = false,
	})
	makeBlock({
		name = "BurgerCheese", parent = zoneModel, size = Vector3.new(6.9, 0.35, 6.9),
		cframe = truckCF * CFrame.new(0, 8.95, 0) * CFrame.Angles(0, math.rad(20), 0),
		color = Color3.fromRGB(255, 196, 40), canCollide = false,
	})
	makeCylinder({
		name = "BurgerLettuce", parent = zoneModel, diameter = 8.1, height = 0.6,
		cframe = truckCF * CFrame.new(0, 9.4, 0), color = Color3.fromRGB(120, 212, 80), canCollide = false,
	})
	-- Dome bun: a sphere whose equator sits at the lettuce (lower half hidden)
	makeBall({
		name = "BurgerBunTop", parent = zoneModel, diameter = 6.6,
		cframe = truckCF * CFrame.new(0, 9.7, 0), color = Color3.fromRGB(233, 170, 92), canCollide = false,
	})
	for _, offset in { Vector3.new(-1.4, 12.5, 0.8), Vector3.new(1.2, 12.6, -0.6), Vector3.new(0.2, 12.8, 1.2) } do
		makeBall({
			name = "SesameSeed", parent = zoneModel, diameter = 0.45,
			cframe = truckCF * CFrame.new(offset), color = CREAM, canCollide = false,
		})
	end
	-- Menu board beside the truck
	addSignBoard(zoneModel, zoneCF * CFrame.new(10.5, 4, 2), 4.2, 3, "MENU", NAVY, CREAM)
	makeBlock({
		name = "MenuPost", parent = zoneModel, size = Vector3.new(0.4, 3.2, 0.4),
		cframe = zoneCF * CFrame.new(10.5, 1.6, 2), color = DARK_WOOD, material = Enum.Material.Wood,
	})
	-- Name sign on two posts left of the truck (in front of the cab, clear of
	-- the counter so it reads from the plaza; board Y 5.6..7.6 above the pad)
	for _, xOff in { -20, -12 } do
		makeBlock({
			name = "NameSignPost", parent = zoneModel, size = Vector3.new(0.5, 5.8, 0.5),
			cframe = zoneCF * CFrame.new(xOff, 2.9, 0), color = DARK_WOOD, material = Enum.Material.Wood,
		})
	end
	addSignBoard(zoneModel, zoneCF * CFrame.new(-16, 6.6, 0), 9, 2, zone.Name, NAVY, orange)
end

----------------------------------------------------------------------
-- Zone 6: Creator Studio — pink neon, glass window, giant ring light, tripod
----------------------------------------------------------------------

local function buildContentCreator(zoneModel: Model, zoneCF: CFrame, zone: GameConfig.ZoneDef)
	local pink = zone.SignColor
	local studioDark = Color3.fromRGB(40, 38, 45)
	makeBlock({
		name = "StudioBody", parent = zoneModel, size = Vector3.new(20, 12, 12),
		cframe = zoneCF * CFrame.new(0, 6, 16), color = Color3.fromRGB(58, 48, 70),
	})
	makeBlock({
		name = "StudioRoof", parent = zoneModel, size = Vector3.new(21, 0.8, 13),
		cframe = zoneCF * CFrame.new(0, 12.4, 16), color = Color3.fromRGB(44, 36, 54),
	})
	makeBlock({
		name = "StudioWindow", parent = zoneModel, size = Vector3.new(9, 4.5, 0.5),
		cframe = zoneCF * CFrame.new(0, 6, 9.8), color = Color3.fromRGB(220, 150, 220),
		material = Enum.Material.Glass, transparency = 0.35, canCollide = false,
	})
	makeBlock({
		name = "StudioTrim", parent = zoneModel, size = Vector3.new(20.6, 0.7, 0.7),
		cframe = zoneCF * CFrame.new(0, 12.1, 10), color = pink,
		material = Enum.Material.Neon, canCollide = false,
	})
	for _, xOff in { -10.1, 10.1 } do
		makeBlock({
			name = "StudioCornerTrim", parent = zoneModel, size = Vector3.new(0.7, 12.4, 0.7),
			cframe = zoneCF * CFrame.new(xOff, 6.2, 10), color = pink,
			material = Enum.Material.Neon, canCollide = false,
		})
	end
	-- Giant ring light on a stand
	makeCylinder({
		name = "RingLightBase", parent = zoneModel, diameter = 3, height = 0.5,
		cframe = zoneCF * CFrame.new(-9, 0.25, -2), color = studioDark, material = Enum.Material.Metal,
	})
	makeCylinder({
		name = "RingLightPole", parent = zoneModel, diameter = 0.7, height = 5.5,
		cframe = zoneCF * CFrame.new(-9, 3.25, -2), color = studioDark, material = Enum.Material.Metal,
	})
	local ring = makeCylinder({
		name = "RingLight", parent = zoneModel, diameter = 9, height = 0.8, axis = "Z",
		cframe = zoneCF * CFrame.new(-9, 7, -2), color = pink,
		material = Enum.Material.Neon, canCollide = false,
	})
	addPointLight(ring, pink, 16, 0.9)
	makeCylinder({
		name = "RingLightInner", parent = zoneModel, diameter = 6.8, height = 0.7, axis = "Z",
		cframe = zoneCF * CFrame.new(-9, 7, -2.15), color = studioDark, canCollide = false,
	})
	-- Pink neon motes around the ring light
	local motes = makeMarker(zoneModel, "NeonMotes", zoneCF * CFrame.new(-9, 6, -2), Vector3.new(10, 8, 8))
	addSparkle(motes, "PinkMotes", pink, Color3.fromRGB(255, 180, 230), 5, 0.3, 0.7)
	-- Phone on a tripod, filming the ring light
	local tripodCF = zoneCF * CFrame.new(-9, 0, -8.5)
	for i = 0, 2 do
		makeBlock({
			name = "TripodLeg", parent = zoneModel, size = Vector3.new(0.35, 4.4, 0.35),
			cframe = tripodCF * CFrame.Angles(0, math.rad(i * 120), 0) * CFrame.new(0, 2.1, -1) * CFrame.Angles(math.rad(14), 0, 0),
			color = studioDark, material = Enum.Material.Metal,
		})
	end
	makeBlock({
		name = "TripodHead", parent = zoneModel, size = Vector3.new(0.8, 0.8, 0.8),
		cframe = tripodCF * CFrame.new(0, 4.3, 0), color = studioDark, canCollide = false,
	})
	makeBlock({
		name = "Phone", parent = zoneModel, size = Vector3.new(1.9, 3.4, 0.4),
		cframe = tripodCF * CFrame.new(0, 6.1, 0), color = Color3.fromRGB(20, 20, 24), canCollide = false,
	})
	makeBlock({
		name = "PhoneScreen", parent = zoneModel, size = Vector3.new(1.6, 3, 0.12),
		cframe = tripodCF * CFrame.new(0, 6.1, 0.23), color = Color3.fromRGB(255, 160, 220),
		material = Enum.Material.Neon, canCollide = false,
	})
	-- Big play-button prop: white triangle (two mirrored wedges) on a pink cube
	makeBlock({
		name = "PlayButtonBase", parent = zoneModel, size = Vector3.new(7, 0.7, 7),
		cframe = zoneCF * CFrame.new(9, 0.35, -1), color = WHITE,
	})
	makeBlock({
		name = "PlayButtonCube", parent = zoneModel, size = Vector3.new(5.5, 5.5, 5.5),
		cframe = zoneCF * CFrame.new(9, 3.45, -1), color = pink,
	})
	-- Yaw +90 puts each wedge's tall back face at zone-local +X, so the apex
	-- points to -X = the right-hand side of a viewer looking from the plaza.
	makeWedge({
		name = "PlayTriangleTop", parent = zoneModel, size = Vector3.new(0.8, 1.4, 2.8),
		cframe = zoneCF * CFrame.new(9, 4.15, -4.15) * CFrame.Angles(0, RAD_90, 0),
		color = WHITE, canCollide = false,
	})
	makeWedge({
		name = "PlayTriangleBottom", parent = zoneModel, size = Vector3.new(0.8, 1.4, 2.8),
		cframe = zoneCF * CFrame.new(9, 2.75, -4.15) * CFrame.Angles(0, RAD_90, 0) * CFrame.Angles(0, 0, math.rad(180)),
		color = WHITE, canCollide = false,
	})
	addSignBoard(zoneModel, zoneCF * CFrame.new(0, 10.4, 9.85), 14, 2.5, zone.Name, NAVY, zone.AccentColor)
end

----------------------------------------------------------------------
-- Zone 7: Stock Desk — dark metal office, neon ticker screens, big up arrow
----------------------------------------------------------------------

local function buildStockDesk(zoneModel: Model, zoneCF: CFrame, zone: GameConfig.ZoneDef)
	local neonGreen = Color3.fromRGB(70, 255, 130)
	local screenBlack = Color3.fromRGB(12, 12, 14)
	makeBlock({
		name = "OfficeBody", parent = zoneModel, size = Vector3.new(18, 12, 12),
		cframe = zoneCF * CFrame.new(0, 6, 14), color = Color3.fromRGB(30, 32, 36), material = Enum.Material.Metal,
	})
	makeBlock({
		name = "OfficeRoof", parent = zoneModel, size = Vector3.new(19, 0.8, 13),
		cframe = zoneCF * CFrame.new(0, 12.4, 14), color = Color3.fromRGB(22, 24, 28), material = Enum.Material.Metal,
	})
	makeBlock({
		name = "OfficeDoor", parent = zoneModel, size = Vector3.new(3.5, 6, 0.5),
		cframe = zoneCF * CFrame.new(0, 3, 7.8), color = screenBlack, canCollide = false,
	})
	makeBlock({
		name = "OfficeTrim", parent = zoneModel, size = Vector3.new(18.6, 0.6, 0.6),
		cframe = zoneCF * CFrame.new(0, 12.1, 8), color = zone.SignColor,
		material = Enum.Material.Neon, canCollide = false,
	})
	for _, xOff in { -9.1, 9.1 } do
		makeBlock({
			name = "OfficeCornerStrip", parent = zoneModel, size = Vector3.new(0.6, 12.4, 0.6),
			cframe = zoneCF * CFrame.new(xOff, 6.2, 8), color = zone.SignColor,
			material = Enum.Material.Neon, canCollide = false,
		})
	end
	-- Green-on-black ticker screens on the front wall
	for _, xOff in { -4.5, 4.5 } do
		makeBlock({
			name = "TickerScreen", parent = zoneModel, size = Vector3.new(6.5, 3, 0.5),
			cframe = zoneCF * CFrame.new(xOff, 6.8, 7.8), color = screenBlack, canCollide = false,
		})
		makeBlock({
			name = "TickerLine", parent = zoneModel, size = Vector3.new(5.6, 0.4, 0.15),
			cframe = zoneCF * CFrame.new(xOff, 7.5, 7.5), color = neonGreen,
			material = Enum.Material.Neon, canCollide = false,
		})
		makeBlock({
			name = "TickerLine", parent = zoneModel, size = Vector3.new(4.2, 0.4, 0.15),
			cframe = zoneCF * CFrame.new(xOff - 0.6, 6.4, 7.5), color = neonGreen,
			material = Enum.Material.Neon, canCollide = false,
		})
	end
	-- Big green up arrow on the roof (block shaft + wedge head)
	makeBlock({
		name = "ArrowShaft", parent = zoneModel, size = Vector3.new(1.6, 6, 1.2),
		cframe = zoneCF * CFrame.new(0, 15.8, 14), color = zone.SignColor,
		material = Enum.Material.Neon, canCollide = false,
	})
	makeWedge({
		name = "ArrowHeadLeft", parent = zoneModel, size = Vector3.new(1.2, 2.8, 2.2),
		cframe = zoneCF * CFrame.new(-1.1, 20.2, 14) * CFrame.Angles(0, RAD_90, 0),
		color = zone.SignColor, material = Enum.Material.Neon, canCollide = false,
	})
	makeWedge({
		name = "ArrowHeadRight", parent = zoneModel, size = Vector3.new(1.2, 2.8, 2.2),
		cframe = zoneCF * CFrame.new(1.1, 20.2, 14) * CFrame.Angles(0, -RAD_90, 0),
		color = zone.SignColor, material = Enum.Material.Neon, canCollide = false,
	})
	-- Green money sparkle over the trading counter
	local sparkle = makeMarker(zoneModel, "MoneySparkle", zoneCF * CFrame.new(0, 7, -8), Vector3.new(8, 2, 4))
	addSparkle(sparkle, "MoneySparkle", Color3.fromRGB(60, 255, 120), Color3.fromRGB(180, 255, 200), 5, 0.4, 0.8)
	addSignBoard(zoneModel, zoneCF * CFrame.new(0, 10.6, 7.85), 13, 2.5, zone.Name, screenBlack, zone.SignColor)
end

----------------------------------------------------------------------
-- Zone 8: Startup HQ — sleek white tower with glass bands, logo cube, rocket
----------------------------------------------------------------------

local function buildStartupHQ(zoneModel: Model, zoneCF: CFrame, zone: GameConfig.ZoneDef)
	local glassBlue = Color3.fromRGB(90, 150, 255)
	local towerCF = zoneCF * CFrame.new(0, 0, 18)
	local tiers = {
		{ size = Vector3.new(16, 5, 16), y = 2.5, glass = false },
		{ size = Vector3.new(16.4, 1.8, 16.4), y = 6.4, glass = true },
		{ size = Vector3.new(14, 5, 14), y = 9.8, glass = false },
		{ size = Vector3.new(14.4, 1.8, 14.4), y = 13.2, glass = true },
		{ size = Vector3.new(12, 5, 12), y = 16.6, glass = false },
		{ size = Vector3.new(10, 2, 10), y = 20.1, glass = false },
	}
	for _, tier in tiers do
		makeBlock({
			name = if tier.glass then "TowerGlass" else "TowerTier", parent = zoneModel, size = tier.size,
			cframe = towerCF * CFrame.new(0, tier.y, 0),
			color = if tier.glass then glassBlue else WHITE,
			material = if tier.glass then Enum.Material.Glass else Enum.Material.SmoothPlastic,
			transparency = if tier.glass then 0.35 else 0,
		})
	end
	makeBlock({
		name = "TowerDoor", parent = zoneModel, size = Vector3.new(3.5, 5.5, 0.6),
		cframe = towerCF * CFrame.new(0, 2.75, -8.1), color = Color3.fromRGB(120, 170, 230),
		material = Enum.Material.Glass, transparency = 0.3, canCollide = false,
	})
	-- Blue neon logo cube on a small pole, tilted like a diamond
	makeBlock({
		name = "LogoPole", parent = zoneModel, size = Vector3.new(0.4, 1.6, 0.4),
		cframe = towerCF * CFrame.new(0, 21.9, 0), color = WHITE, canCollide = false,
	})
	local logo = makeBlock({
		name = "LogoCube", parent = zoneModel, size = Vector3.new(2.8, 2.8, 2.8),
		cframe = towerCF * CFrame.new(0, 23.2, 0) * CFrame.Angles(math.rad(35), math.rad(45), 0),
		color = zone.AccentColor, material = Enum.Material.Neon, canCollide = false,
	})
	addPointLight(logo, zone.AccentColor, 16, 0.8)
	-- Small rocket statue: cylinder body, crossed-wedge nose cone, wedge fins
	local rocketCF = zoneCF * CFrame.new(-12, 0, -4)
	makeCylinder({
		name = "RocketPedestal", parent = zoneModel, diameter = 5.5, height = 1.2,
		cframe = rocketCF * CFrame.new(0, 0.6, 0), color = Color3.fromRGB(205, 198, 182),
		material = Enum.Material.Marble,
	})
	makeCylinder({
		name = "RocketBody", parent = zoneModel, diameter = 3, height = 7,
		cframe = rocketCF * CFrame.new(0, 4.7, 0), color = Color3.fromRGB(244, 244, 248),
		material = Enum.Material.Metal,
	})
	makeBall({
		name = "RocketWindow", parent = zoneModel, diameter = 1.3,
		cframe = rocketCF * CFrame.new(0, 5.6, -1.4), color = zone.AccentColor,
		material = Enum.Material.Neon, canCollide = false,
	})
	-- Nose cone: two crossed wedge pairs
	local noseY = 9.6
	makeWedge({
		name = "RocketNose", parent = zoneModel, size = Vector3.new(2.4, 2.8, 1.5),
		cframe = rocketCF * CFrame.new(-0.75, noseY, 0) * CFrame.Angles(0, RAD_90, 0),
		color = zone.AccentColor, canCollide = false,
	})
	makeWedge({
		name = "RocketNose", parent = zoneModel, size = Vector3.new(2.4, 2.8, 1.5),
		cframe = rocketCF * CFrame.new(0.75, noseY, 0) * CFrame.Angles(0, -RAD_90, 0),
		color = zone.AccentColor, canCollide = false,
	})
	makeWedge({
		name = "RocketNose", parent = zoneModel, size = Vector3.new(2.4, 2.8, 1.5),
		cframe = rocketCF * CFrame.new(0, noseY, -0.75),
		color = zone.AccentColor, canCollide = false,
	})
	makeWedge({
		name = "RocketNose", parent = zoneModel, size = Vector3.new(2.4, 2.8, 1.5),
		cframe = rocketCF * CFrame.new(0, noseY, 0.75) * CFrame.Angles(0, math.rad(180), 0),
		color = zone.AccentColor, canCollide = false,
	})
	-- Fins (vertical face against the body, sloping down and out)
	local finSpecs = {
		{ offset = Vector3.new(2.2, 2.6, 0), yaw = -RAD_90 },
		{ offset = Vector3.new(-2.2, 2.6, 0), yaw = RAD_90 },
		{ offset = Vector3.new(0, 2.6, 2.2), yaw = math.rad(180) },
		{ offset = Vector3.new(0, 2.6, -2.2), yaw = 0 },
	}
	for _, fin in finSpecs do
		makeWedge({
			name = "RocketFin", parent = zoneModel, size = Vector3.new(0.5, 2.8, 1.9),
			cframe = rocketCF * CFrame.new(fin.offset) * CFrame.Angles(0, fin.yaw, 0),
			color = zone.AccentColor, canCollide = false,
		})
	end
	-- Blue sparkle around the rocket
	local sparkle = makeMarker(zoneModel, "RocketSparkle", rocketCF * CFrame.new(0, 5, 0), Vector3.new(5, 8, 5))
	addSparkle(sparkle, "BlueSparkle", zone.AccentColor, Color3.fromRGB(170, 210, 255), 5, 0.3, 0.7)
	addSignBoard(zoneModel, towerCF * CFrame.new(0, 8.5, -8.1), 12, 2.2, zone.Name, NAVY, zone.AccentColor)
end

----------------------------------------------------------------------
-- Generic fallback for any future zone id without a bespoke builder
----------------------------------------------------------------------

local function buildGenericZone(zoneModel: Model, zoneCF: CFrame, zone: GameConfig.ZoneDef)
	makeBlock({
		name = "Building", parent = zoneModel, size = Vector3.new(20, 12, 12),
		cframe = zoneCF * CFrame.new(0, 6, 16), color = zone.SignColor, material = Enum.Material.Concrete,
	})
	addSignBoard(zoneModel, zoneCF * CFrame.new(0, 10, 9.8), 14, 2.5, zone.Name, NAVY, zone.AccentColor)
end

local ZONE_BUILDERS: { [string]: (Model, CFrame, GameConfig.ZoneDef) -> () } = {
	LemonadeStand = buildLemonadeStand,
	DogWalking = buildDogWalking,
	SneakerFlipping = buildSneakerFlipping,
	CarWash = buildCarWash,
	FoodTruck = buildFoodTruck,
	ContentCreator = buildContentCreator,
	StockDesk = buildStockDesk,
	StartupHQ = buildStartupHQ,
}

-- Hustle station placement per zone (zone-local, on the pad top; -Z = plaza).
local STATIONS: { [string]: StationSpec } = {
	-- The stand itself is the counter (top Y 3.7, X -5.5..5.5, Z 7.4..10.6);
	-- PromptPart lands at (0, 3, 4.6) in front of it. FeedbackPart sits right
	-- above the prompt (6.3 over the stand top, in front of canopy + lemon);
	-- AutoAnchor stands on open pad 4 studs clear of the stand's +X side.
	LemonadeStand = {
		pos = Vector3.new(0, 0, 7), counter = false,
		feedback = Vector3.new(0, 10, 4.6),
		anchor = Vector3.new(9.5, 0.5, 8.5), anchorLook = Vector3.new(0, 0.5, 9),
	},
	DogWalking = { pos = Vector3.new(0, 0, -12), counter = true, material = Enum.Material.WoodPlanks, baseColor = WOOD },
	SneakerFlipping = { pos = Vector3.new(6, 0, -8), counter = true, material = Enum.Material.Concrete },
	CarWash = { pos = Vector3.new(0, 0, -12), counter = true, material = Enum.Material.Metal },
	FoodTruck = { pos = Vector3.new(0, 0, -2), counter = true, material = Enum.Material.DiamondPlate },
	ContentCreator = { pos = Vector3.new(0, 0, -8), counter = true, material = Enum.Material.SmoothPlastic },
	StockDesk = { pos = Vector3.new(0, 0, -8), counter = true, material = Enum.Material.Metal },
	StartupHQ = { pos = Vector3.new(6, 0, -8), counter = true, material = Enum.Material.SmoothPlastic, baseColor = WHITE },
}
local DEFAULT_STATION: StationSpec = { pos = Vector3.new(0, 0, -10), counter = true }

-- Mechanic prop anchor per zone (zone-local CFrame; see buildMechanicProp).
local MECHANIC_PROP_CF: { [string]: CFrame } = {
	LemonadeStand = CFrame.new(0, 3.7, 9), -- SQUEEZE! button on the stand top
	DogWalking = CFrame.new(0, 0, -19), -- paw-print path in front of the counter
	SneakerFlipping = CFrame.new(-4, 0, -6), -- hype board left of the counter
	CarWash = CFrame.new(0, 0, 8), -- roller conveyor through the tunnel
	FoodTruck = CFrame.new(0, 3.5, -2), -- GRILL! button on the counter top
	ContentCreator = CFrame.new(-6, 0, -9), -- hype meter column
	StockDesk = CFrame.new(-8, 0, -5), -- ticker board
	StartupHQ = CFrame.new(-1, 0, -9), -- funding meter column
}

local function buildZone(zonesFolder: Folder, zone: GameConfig.ZoneDef)
	-- Contract: the same function the client uses for nearest-zone lookups.
	local groundCF = Mechanics.zoneGroundCFrame(zone.Order)

	local zoneModel = Instance.new("Model")
	zoneModel.Name = zone.Id
	zoneModel:SetAttribute("ZoneId", zone.Id)
	zoneModel.Parent = zonesFolder

	-- Colored floor pad (signature color, desaturated enough to walk on).
	-- 3 thick centered on Y=0: top at PAD_TOP, bottom buried in the terrain so
	-- animated grass never pokes through.
	local padColor = zone.SignColor:Lerp(Color3.fromRGB(152, 148, 144), 0.6)
	makeBlock({
		name = "ZonePad", parent = zoneModel, size = Vector3.new(PAD_SIZE, PAD_TOP * 2, PAD_SIZE),
		cframe = groundCF, color = padColor,
	})
	local half = PAD_SIZE / 2 - 0.6
	for _, zOff in { -half, half } do
		makeBlock({
			name = "PadTrim", parent = zoneModel, size = Vector3.new(PAD_SIZE, 0.3, 1.2),
			cframe = groundCF * CFrame.new(0, PAD_TOP + 0.15, zOff), color = zone.SignColor, canCollide = false,
		})
	end
	for _, xOff in { -half, half } do
		makeBlock({
			name = "PadTrim", parent = zoneModel, size = Vector3.new(1.2, 0.3, PAD_SIZE - 2.4),
			cframe = groundCF * CFrame.new(xOff, PAD_TOP + 0.15, 0), color = zone.SignColor, canCollide = false,
		})
	end

	local zoneCF = groundCF * CFrame.new(0, PAD_TOP, 0)
	local builder = ZONE_BUILDERS[zone.Id] or buildGenericZone
	builder(zoneModel, zoneCF, zone)

	local stationSpec = STATIONS[zone.Id] or DEFAULT_STATION
	buildHustleStation(zoneModel, zoneCF, zone, stationSpec)
	buildMechanicProp(zoneModel, zoneCF * (MECHANIC_PROP_CF[zone.Id] or CFrame.new(-6, 0, -6)), zone, stationSpec.counter)

	-- Entrance lamps on the road just in front of the pad
	for _, xOff in { -16, 16 } do
		buildLampPost(zoneModel, groundCF * CFrame.new(xOff, ROAD_TOP, -35))
	end

	if zone.UnlockLevel > 1 then
		buildGate(zoneModel, zoneCF, zone)
	end
end

----------------------------------------------------------------------
-- Decor: trees (3 sizes), bushes, flower clusters, signposts
----------------------------------------------------------------------

local function buildTree(parent: Instance, position: Vector3, scale: number)
	local cf = CFrame.new(position)
	makeCylinder({
		name = "TreeTrunk", parent = parent, diameter = 1.6 * scale, height = 6 * scale,
		cframe = cf * CFrame.new(0, 3 * scale, 0), color = DARK_WOOD, material = Enum.Material.Wood,
	})
	if scale < 0.9 then
		-- Small: a single round puff
		makeBall({
			name = "TreeLeaves", parent = parent, diameter = 5.6 * scale,
			cframe = cf * CFrame.new(0, 6.6 * scale, 0), color = LEAF_GREEN, canCollide = false,
		})
	elseif scale < 1.5 then
		-- Medium: classic three-puff canopy
		makeBall({
			name = "TreeLeaves", parent = parent, diameter = 6 * scale,
			cframe = cf * CFrame.new(0, 6.5 * scale, 0), color = LEAF_GREEN, canCollide = false,
		})
		makeBall({
			name = "TreeLeaves", parent = parent, diameter = 4.6 * scale,
			cframe = cf * CFrame.new(1.2 * scale, 8 * scale, 0.8 * scale), color = Color3.fromRGB(88, 176, 74), canCollide = false,
		})
		makeBall({
			name = "TreeLeaves", parent = parent, diameter = 4 * scale,
			cframe = cf * CFrame.new(-1.4 * scale, 7.4 * scale, -0.6 * scale), color = Color3.fromRGB(96, 188, 80), canCollide = false,
		})
	else
		-- Large: tall stacked canopy
		makeBall({
			name = "TreeLeaves", parent = parent, diameter = 7 * scale,
			cframe = cf * CFrame.new(0, 6.4 * scale, 0), color = LEAF_GREEN, canCollide = false,
		})
		makeBall({
			name = "TreeLeaves", parent = parent, diameter = 5.2 * scale,
			cframe = cf * CFrame.new(0, 9.4 * scale, 0), color = Color3.fromRGB(88, 176, 74), canCollide = false,
		})
		makeBall({
			name = "TreeLeaves", parent = parent, diameter = 3.6 * scale,
			cframe = cf * CFrame.new(0, 11.6 * scale, 0), color = Color3.fromRGB(96, 188, 80), canCollide = false,
		})
	end
end

local function buildBush(parent: Instance, position: Vector3, scale: number)
	makeBall({
		name = "Bush", parent = parent, diameter = 3.2 * scale,
		cframe = CFrame.new(position + Vector3.new(0, 1 * scale, 0)), color = LEAF_GREEN, canCollide = false,
	})
end

-- Small wooden signpost: navy board with the zone name and a diamond arrow tip
-- on the board's +X end.
local function buildSignpost(parent: Instance, cf: CFrame, text: string, color: Color3)
	makeBlock({
		name = "SignpostPole", parent = parent, size = Vector3.new(0.5, 5.2, 0.5),
		cframe = cf * CFrame.new(0, 2.6, 0), color = DARK_WOOD, material = Enum.Material.Wood,
	})
	local board = makeBlock({
		name = "SignpostBoard", parent = parent, size = Vector3.new(6, 1.5, 0.35),
		cframe = cf * CFrame.new(1.2, 4.6, 0), color = NAVY, canCollide = false,
	})
	addSurfaceText(board, text, Enum.Font.FredokaOne, color, Enum.NormalId.Front)
	makeBlock({
		name = "SignpostTip", parent = parent, size = Vector3.new(1.06, 1.06, 0.35),
		cframe = cf * CFrame.new(4.2, 4.6, 0) * CFrame.Angles(0, 0, math.rad(45)), color = NAVY, canCollide = false,
	})
end

-- Cartoon palm on the beach: three cylinder trunk segments curving toward
-- `leanDir` (the sea), a crown of six drooping leaf slabs and three coconuts.
local function buildPalm(parent: Instance, position: Vector3, leanDir: Vector3, scale: number)
	local trunkColor = Color3.fromRGB(160, 116, 70)
	local segmentHeight = 3.2 * scale
	local lean = 0.45 * scale
	local points = { position }
	for k = 1, 3 do
		table.insert(points, position + Vector3.new(0, k * segmentHeight, 0) + leanDir * (lean * k * k))
	end
	for k = 1, 3 do
		local from, to = points[k], points[k + 1]
		-- Native cylinder axis is X; yaw +90 maps it onto the lookAt direction.
		makeCylinder({
			name = "PalmTrunk", parent = parent, diameter = (1.4 - 0.15 * k) * scale,
			height = (to - from).Magnitude + 0.3 * scale, axis = "X",
			cframe = CFrame.lookAt((from + to) / 2, to) * CFrame.Angles(0, RAD_90, 0),
			color = trunkColor:Lerp(DARK_WOOD, (k - 1) * 0.15), material = Enum.Material.Wood,
		})
	end
	local top = points[4]
	makeBall({
		name = "PalmHeart", parent = parent, diameter = 1.5 * scale,
		cframe = CFrame.new(top), color = LEAF_GREEN, canCollide = false,
	})
	for j = 0, 5 do
		makeBlock({
			name = "PalmLeaf", parent = parent, size = Vector3.new(1.6, 0.25, 5.4) * scale,
			cframe = CFrame.new(top) * CFrame.Angles(0, math.rad(j * 60 + 15), 0)
				* CFrame.Angles(math.rad(-24), 0, 0) * CFrame.new(0, 0, -2.6 * scale),
			color = if j % 2 == 0 then LEAF_GREEN else Color3.fromRGB(96, 188, 80), canCollide = false,
		})
	end
	for j = 0, 2 do
		local angle = math.rad(j * 120)
		makeBall({
			name = "Coconut", parent = parent, diameter = 0.8 * scale,
			cframe = CFrame.new(top + Vector3.new(math.cos(angle) * 0.7 * scale, -0.8 * scale, math.sin(angle) * 0.7 * scale)),
			color = Color3.fromRGB(110, 74, 40), canCollide = false,
		})
	end
end

local function buildDecor(parent: Instance)
	local half = ZONE_STEP / 2
	for i = 0, #GameConfig.Zones - 1 do
		local base = i * ZONE_STEP -- zone (i + 1)'s angle; `base + half` is the gap
		-- Trees between neighboring zones, then three sizes further out
		-- (all outside the 118..185 pad band and inside the hill clearance)
		buildTree(parent, ringPos(152, base + half), if i % 2 == 0 then 1.0 else 1.25)
		buildTree(parent, ringPos(196, base + 13.5), 0.75)
		buildTree(parent, ringPos(196, base + 31.5), 0.75)
		buildTree(parent, ringPos(210, base), 1.6) -- backdrop right behind the zone
		buildTree(parent, ringPos(225, base + 8), 1.4)
		buildTree(parent, ringPos(230, base + 37), 1.1)
		buildTree(parent, ringPos(255, base + 8.5), 1.55)
		buildTree(parent, ringPos(255, base + 36.5), 1.55)
		-- Outer ring near the beach, clear of the bisector hills
		buildTree(parent, ringPos(312, base + 6), 1.2)
		buildTree(parent, ringPos(316, base + 39), 0.85)
		-- Bushes along the road edge and further out
		buildBush(parent, ringPos(128, base + half), 1.1)
		buildBush(parent, ringPos(195, base - 12), 1.3)
		buildBush(parent, ringPos(240, base + 2.5), 1.0)
		buildBush(parent, ringPos(240, base + 42.5), 1.0)
		-- Flower clusters on the grass just outside the road trim
		buildFlowerCluster(parent, ringPos(128, base + half - 5), i)
		buildFlowerCluster(parent, ringPos(128, base + half + 5), i + 3)
		-- A palm on the sand rim in every gap, leaning out to sea
		local gapAngle = math.rad(base + half)
		buildPalm(
			parent,
			ringPos((ISLAND_RADIUS + BEACH_RADIUS) / 2, base + half),
			Vector3.new(math.cos(gapAngle), 0, math.sin(gapAngle)),
			if i % 2 == 0 then 1.0 else 1.15
		)
	end

	-- Road-side signposts: a few degrees past each zone, board facing the
	-- plaza, arrow tip swung back toward the zone's pad.
	for _, zone in GameConfig.Zones do
		local degrees = (zone.Order - 1) * ZONE_STEP + 12
		local pos = ringPos(108, degrees, ROAD_TOP)
		local cf = CFrame.lookAt(pos, Vector3.new(0, ROAD_TOP, 0)) * CFrame.Angles(0, math.rad(-30), 0)
		buildSignpost(parent, cf, zone.Name, zone.SignColor)
	end
end

----------------------------------------------------------------------
-- Public API
----------------------------------------------------------------------

function MapBuilder.build(): ()
	if Workspace:FindFirstChild("SideHustleMap") then
		return
	end

	setupLighting()

	local okTerrain, terrainErr = pcall(buildTerrain)
	if not okTerrain then
		warn("[MapBuilder] Terrain generation failed: " .. tostring(terrainErr))
	end
	local okWater, waterErr = pcall(styleWater)
	if not okWater then
		warn("[MapBuilder] Water styling failed: " .. tostring(waterErr))
	end

	local map = Instance.new("Folder")
	map.Name = "SideHustleMap"

	local ground = buildGround(map, okTerrain)
	buildPlaza(map)

	local zonesFolder = Instance.new("Folder")
	zonesFolder.Name = "Zones"
	zonesFolder.Parent = map

	for _, zone in GameConfig.Zones do
		buildZone(zonesFolder, zone)
	end

	buildDecor(ground)

	map.Parent = Workspace
end

return MapBuilder
