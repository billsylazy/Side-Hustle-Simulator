{
  "name": "SideHustleSimulator",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "Shared": {
        "$path": "src/ReplicatedStorage/Shared"
      }
    },
    "ServerScriptService": {
      "$className": "ServerScriptService",
      "GameManager": {
        "$path": "src/ServerScriptService/GameManager.server.luau"
      },
      "Services": {
        "$path": "src/ServerScriptService/Services"
      },
      "World": {
        "$path": "src/ServerScriptService/World"
      }
    },
    "StarterPlayer": {
      "$className": "StarterPlayer",
      "StarterPlayerScripts": {
        "$className": "StarterPlayerScripts",
        "ClientMain": {
          "$path": "src/StarterPlayerScripts/ClientMain.client.luau"
        },
        "Controllers": {
          "$path": "src/StarterPlayerScripts/Controllers"
        }
      }
    },
    "StarterGui": {
      "$className": "StarterGui",
      "MainHUD": {
        "$path": "ui/MainHUD/build/MainHUD.rbxmx"
      },
      "HustleGui": {
        "$path": "ui/HustleGui/build/HustleGui.rbxmx"
      },
      "ShopGui": {
        "$path": "ui/ShopGui/build/ShopGui.rbxmx"
      },
      "WorkersGui": {
        "$path": "ui/WorkersGui/build/WorkersGui.rbxmx"
      },
      "RebirthGui": {
        "$path": "ui/RebirthGui/build/RebirthGui.rbxmx"
      },
      "QuestsGui": {
        "$path": "ui/QuestsGui/build/QuestsGui.rbxmx"
      }
    },
    "Workspace": {
      "$className": "Workspace",
      "$properties": {
        "StreamingEnabled": false
      },
      "Terrain": {
        "$className": "Terrain",
        "$properties": {
          "Decoration": true
        }
      }
    },
    "Lighting": {
      "$className": "Lighting",
      "$properties": {
        "Technology": "Future",
        "ClockTime": 13,
        "Brightness": 2.6,
        "GlobalShadows": true,
        "ShadowSoftness": 0.6,
        "EnvironmentDiffuseScale": 0.6,
        "EnvironmentSpecularScale": 0.6
      }
    }
  }
}
