            <Font name="FontFace"><Family><url>rbxasset://fonts/families/LuckiestGuy.json</url></Family><Weight>400</Weight><Style>Normal</Style></Font>
            <int name="ZIndex">6</int>
            <string name="Name">Title</string>
          </Properties>
          <Item class="UIStroke" referent="RBX8AE8B33EECDD4B0F86F618DBF265C8A2">
            <Properties>
              <Color3 name="Color"><R>0.0156863</R><G>0.0156863</G><B>0.207843</B></Color3>
              <float name="Thickness">3</float>
              <token name="ApplyStrokeMode">0</token>
