      <Item class="ImageButton" referent="RBX872A5129C1B34B0187A9F4D57A4A1FFA">
        <Properties>
          <Vector2 name="AnchorPoint"><X>0.5</X><Y>0.5</Y></Vector2>
          <UDim2 name="Position"><XS>1</XS><XO>-8</XO><YS>0</YS><YO>8</YO></UDim2>
          <UDim2 name="Size"><XS>0</XS><XO>52</XO><YS>0</YS><YO>52</YO></UDim2>
          <float name="BackgroundTransparency">1</float>
